< !DOCTYPE html><html lang="en"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" /><title>Learn Python by Doing - Serplora Academy</title><link rel="preconnect" href="https://fonts.googleapis.com"><link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet"><style>

/* ─────────────────────────────────────
   TOKENS & THEME
───────────────────────────────────── */
:root {
    --white: #ffffff;
    --bg-main: #fdfdfd;
    --bg-dark: #10162f;
    --bg-darker: #0a0f24;
    --bg-muted: #f4f6f8;

    --border: #e2e8f0;
    --border-dark: #2a314d;

    --text-muted: #64748b;
    --text-body: #334155;
    --text-dark: #0f172a;
    --text-light: #f8fafc;
    --text-light-m: #94a3b8;

    --primary: #3b82f6;
    --accent: #ffd166;
    --accent-hover: #ffc233;
    --green: #10b981;
    --purple: #8b5cf6;

    --radius-sm: 6px;
    --radius: 12px;
    --radius-lg: 20px;

    --shadow-sm: 0 2px 4px rgba(16, 22, 47, 0.04);
    --shadow: 0 8px 24px rgba(16, 22, 47, 0.08);
    --shadow-lg: 0 12px 32px rgba(16, 22, 47, 0.12);

    --nav-h: 64px;
    --max: 1200px;
}

*,
*::before,
*::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html {
    scroll-behavior: smooth;
}

/* ─────────────────────────────────────
   GLOBAL & TYPOGRAPHY
───────────────────────────────────── */
body {
    font-family: 'Outfit', sans-serif;
    font-size: 17px;
    line-height: 1.65;
    color: var(--text-body);
    background: var(--bg-main);
    -webkit-font-smoothing: antialiased;
    /* Subtle dot pattern for the whole body */
    background-image: radial-gradient(var(--border) 1px, transparent 1px);
    background-size: 24px 24px;
}

img {
    max-width: 100%;
    display: block;
}

a {
    text-decoration: none;
    color: inherit;
}

.sec-title {
    font-size: 28px;
    font-weight: 800;
    color: var(--text-dark);
    letter-spacing: -0.5px;
    margin-bottom: 24px;
}

section.main-section {
    margin-bottom: 64px;
}

/* ─────────────────────────────────────
   NAV
───────────────────────────────────── */
.nav {
    position: sticky;
    top: 0;
    z-index: 200;
    height: var(--nav-h);
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
}

.nav-inner {
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 32px;
    width: 100%;
    display: flex;
    align-items: center;
    gap: 40px;
}

.logo {
    font-size: 20px;
    font-weight: 800;
    color: var(--text-dark);
    letter-spacing: -0.5px;
    flex-shrink: 0;
}

.logo span {
    color: var(--primary);
}

.nav-links {
    display: flex;
    gap: 8px;
    list-style: none;
}

.nav-links a {
    padding: 8px 14px;
    border-radius: var(--radius-sm);
    font-size: 15px;
    font-weight: 600;
    color: var(--text-muted);
    transition: all 0.2s;
}

.nav-links a:hover {
    background: var(--bg-muted);
    color: var(--text-dark);
}

.nav-right {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 12px;
}

.btn-nav-ghost {
    padding: 10px 20px;
    border-radius: var(--radius-sm);
    font-size: 15px;
    font-weight: 600;
    color: var(--text-dark);
    background: transparent;
    cursor: pointer;
    border: none;
}

.btn-nav-ghost:hover {
    background: var(--bg-muted);
}

.btn-nav-solid {
    padding: 10px 24px;
    border-radius: var(--radius-sm);
    background: var(--bg-dark);
    color: var(--white);
    font-size: 15px;
    font-weight: 600;
    border: none;
    cursor: pointer;
    transition: background 0.2s;
}

.btn-nav-solid:hover {
    background: var(--primary);
}

/* ─────────────────────────────────────
   PAGE LAYOUT
───────────────────────────────────── */
.page-wrapper {
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 32px;
    display: grid;
    grid-template-columns: 1fr 360px;
    grid-template-areas:
        "hero sidebar"
        "main sidebar";
    gap: 0 64px;
    align-items: start;
}

.bottom-wrapper {
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 32px 80px;
}

/* ─────────────────────────────────────
   HERO SECTION (DARK & PATTERNED)
───────────────────────────────────── */
.hero-section {
    grid-area: hero;
    position: relative;
    padding: 80px 0 64px;
}

.hero-bg-spanner {
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(-1 * (max((100vw - var(--max)) / 2, 0px) + 32px));
    width: 100vw;
    background-color: var(--bg-dark);
    /* Blueprint/Grid Pattern */
    background-image:
        linear-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
    background-size: 40px 40px;
    border-bottom: 1px solid var(--border-dark);
    z-index: -1;
}

.hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(139, 92, 246, 0.15);
    color: #c4b5fd;
    border: 1px solid rgba(139, 92, 246, 0.3);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    padding: 6px 12px;
    border-radius: 4px;
    margin-bottom: 24px;
}

.hero-section h1 {
    font-size: clamp(36px, 5vw, 64px);
    font-weight: 800;
    color: var(--white);
    line-height: 1.1;
    letter-spacing: -1.5px;
    margin-bottom: 20px;
}

.hero-section h1 em {
    font-style: normal;
    color: var(--accent);
    position: relative;
}

.hero-sub {
    font-size: 19px;
    color: var(--text-light-m);
    max-width: 560px;
    margin-bottom: 32px;
    line-height: 1.6;
}

/* rating row */
.rating-row {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 32px;
    flex-wrap: wrap;
}

.stars {
    display: flex;
    gap: 3px;
}

.stars svg {
    color: var(--accent);
}

.rating-val {
    font-size: 16px;
    font-weight: 700;
    color: var(--white);
}

.rating-count {
    font-size: 15px;
    color: var(--text-light-m);
}

.pill {
    display: flex;
    align-items: center;
    gap: 6px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    font-size: 14px;
    color: var(--text-light);
    padding: 6px 14px;
    border-radius: 20px;
}

.pill svg {
    flex-shrink: 0;
    color: var(--primary);
}

.hero-meta-text {
    font-size: 14px;
    color: var(--text-light-m);
    margin: -10px 0 32px;
    display: flex;
    align-items: center;
    gap: 8px;
}

.hero-meta-text svg {
    color: var(--green);
}

/* includes quick list */
.hero-includes {
    padding: 32px 0 0;
    border-top: 1px solid var(--border-dark);
}

.hero-includes h4 {
    font-size: 13px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--text-light-m);
    font-weight: 700;
    margin-bottom: 20px;
}

.hi-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
}

.hi-item {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 15px;
    color: var(--text-light);
}

.hi-item svg {
    color: var(--primary);
    flex-shrink: 0;
}

/* ─────────────────────────────────────
   ENROLL CARD (sticky)
───────────────────────────────────── */
.right-col {
    grid-area: sidebar;
    padding-top: 64px;
    align-self: stretch;
}

.sticky-card {
    position: sticky;
    top: calc(var(--nav-h) + 32px);
}

.enroll-card {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
}

.card-top {
    background: var(--bg-darker);
    padding: 24px;
    border-bottom: 1px solid var(--border);
}

.term-dots {
    display: flex;
    gap: 6px;
    margin-bottom: 16px;
}

.term-dots span {
    width: 12px;
    height: 12px;
    border-radius: 50%;
}

.term-dots span:nth-child(1) {
    background: #ff5f56;
}

.term-dots span:nth-child(2) {
    background: #ffbd2e;
}

.term-dots span:nth-child(3) {
    background: #27c93f;
}

.code-block {
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    line-height: 1.8;
}

.ln {
    color: #475569;
    margin-right: 16px;
    user-select: none;
}

.kw {
    color: #c678dd;
}

.fn {
    color: #61afef;
}

.st {
    color: #98c379;
}

.cm {
    color: #5c6370;
}

.nm {
    color: #e5c07b;
}

.card-body {
    padding: 32px 24px;
}

.card-price {
    font-size: 36px;
    font-weight: 800;
    color: var(--text-dark);
    margin-bottom: 4px;
    letter-spacing: -1px;
}

.card-price small {
    font-size: 15px;
    font-weight: 500;
    color: var(--text-muted);
}

.card-pricing-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 24px;
    font-size: 14px;
    color: var(--text-muted);
    font-weight: 500;
}

.cpm-item {
    display: flex;
    align-items: center;
    gap: 6px;
}

.cpm-item svg {
    color: var(--green);
}

.cpm-sep {
    color: var(--border);
}

.btn-enroll {
    width: 100%;
    padding: 18px;
    background: var(--accent);
    color: var(--text-dark);
    font-family: 'Outfit', sans-serif;
    font-size: 18px;
    font-weight: 800;
    border: none;
    border-radius: var(--radius);
    cursor: pointer;
    transition: all 0.2s;
    display: flex;
    justify-content: center;
    align-items: center;
}

.btn-enroll:hover {
    background: var(--accent-hover);
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(255, 209, 102, 0.3);
}

.student-discount {
    text-align: center;
    font-size: 13px;
    color: var(--text-muted);
    margin-bottom: 12px;
}

.student-discount .verify-link {
    color: var(--primary);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 0.2s;
}

.student-discount .verify-link:hover {
    color: var(--text-dark);
}

/* ─────────────────────────────────────
   MAIN CONTENT COLUMNS
───────────────────────────────────── */
.main-col {
    grid-area: main;
    padding: 80px 0;
}

.about-text {
    font-size: 18px;
    color: var(--text-body);
    line-height: 1.8;
}

/* ─────────────────────────────────────
   OUTCOMES / SKILLS
───────────────────────────────────── */
.outcomes-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
}

.outcome-row {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    padding: 20px;
    background: var(--white);
    border-radius: var(--radius);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-sm);
}

.oc-icon {
    width: 24px;
    height: 24px;
    border-radius: 6px;
    background: rgba(59, 130, 246, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 2px;
}

.oc-icon svg {
    color: var(--primary);
}

.outcome-row p {
    font-size: 16px;
    font-weight: 500;
    color: var(--text-dark);
    line-height: 1.5;
}

/* ─────────────────────────────────────
   FORMAT CARDS
───────────────────────────────────── */
.format-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
}

.format-card {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 24px;
    box-shadow: var(--shadow-sm);
    transition: transform 0.2s, box-shadow 0.2s;
}

.format-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow);
}

.fc-icon {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    margin-bottom: 20px;
}

.format-card:nth-child(1) .fc-icon {
    background: #fee2e2;
    color: #ef4444;
}

.format-card:nth-child(2) .fc-icon {
    background: #e0e7ff;
    color: #6366f1;
}

.format-card:nth-child(3) .fc-icon {
    background: #dcfce7;
    color: #22c55e;
}

.format-card h3 {
    font-size: 18px;
    font-weight: 800;
    color: var(--text-dark);
    margin-bottom: 8px;
}

.format-card p {
    font-size: 15px;
    color: var(--text-muted);
    line-height: 1.6;
}

/* ─────────────────────────────────────
   FEATURES (WHY THIS COURSE)
───────────────────────────────────── */
.features-list {
    display: flex;
    flex-direction: column;
    gap: 24px;
}

.feat-row {
    display: flex;
    gap: 24px;
    align-items: flex-start;
    padding: 24px;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
}

.feat-ico {
    width: 56px;
    height: 56px;
    border-radius: 16px;
    background: var(--bg-muted);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    flex-shrink: 0;
}

.feat-content h3 {
    font-size: 19px;
    font-weight: 800;
    color: var(--text-dark);
    margin-bottom: 8px;
}

.feat-content p {
    font-size: 16px;
    color: var(--text-body);
    line-height: 1.7;
}

.feat-content p strong {
    color: var(--text-dark);
    font-weight: 700;
}

/* ─────────────────────────────────────
   SYLLABUS ACCORDION
───────────────────────────────────── */
.syllabus-meta {
    font-size: 16px;
    color: var(--text-muted);
    font-weight: 500;
    margin-bottom: 24px;
}

.module-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.module {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--white);
    overflow: hidden;
}

.mod-header {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 20px 24px;
    cursor: pointer;
    background: var(--white);
    transition: background 0.2s;
    user-select: none;
}

.mod-header:hover {
    background: var(--bg-muted);
}

.mod-num {
    font-family: 'JetBrains Mono', monospace;
    font-size: 14px;
    font-weight: 700;
    color: var(--primary);
    background: rgba(59, 130, 246, 0.1);
    padding: 6px 10px;
    border-radius: 6px;
}

.mod-title {
    flex: 1;
    font-size: 17px;
    font-weight: 700;
    color: var(--text-dark);
}

.mod-meta {
    font-size: 14px;
    color: var(--text-muted);
    font-weight: 500;
    margin-right: 12px;
}

.mod-arrow {
    font-size: 12px;
    color: var(--text-muted);
    transition: transform 0.2s;
}

.module.open .mod-arrow {
    transform: rotate(180deg);
}

.mod-body {
    display: none;
    border-top: 1px solid var(--border);
    background: var(--bg-main);
}

.module.open .mod-body {
    display: block;
}

.lesson-row {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 14px 24px 14px 64px;
    border-bottom: 1px solid var(--border);
    font-size: 15px;
    font-weight: 500;
    color: var(--text-body);
}

.lesson-row:last-child {
    border-bottom: none;
}

.lesson-type-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
}

.lesson-row.video .lesson-type-dot {
    background: #ef4444;
}

.lesson-row.exercise .lesson-type-dot {
    background: var(--green);
}

.lesson-row.quiz .lesson-type-dot {
    background: var(--primary);
}

.lesson-row.project .lesson-type-dot {
    background: var(--purple);
}

.lesson-name {
    flex: 1;
}

.lesson-tag {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    font-weight: 700;
    color: var(--text-muted);
}

/* ─────────────────────────────────────
   PREREQ
───────────────────────────────────── */
.prereq-card {
    background: rgba(16, 185, 129, 0.05);
    border: 1px solid rgba(16, 185, 129, 0.2);
    border-radius: var(--radius);
    padding: 24px;
    display: flex;
    gap: 20px;
    align-items: flex-start;
}

.prereq-card .ico {
    font-size: 28px;
}

.prereq-card h3 {
    font-size: 18px;
    font-weight: 800;
    color: var(--text-dark);
    margin-bottom: 8px;
}

.prereq-card p {
    font-size: 16px;
    color: var(--text-body);
    line-height: 1.6;
}

/* ─────────────────────────────────────
   CERTIFICATE SECTION
───────────────────────────────────── */
.cert-card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: center;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 40px;
    box-shadow: var(--shadow-sm);
}

.cert-mock {
    background: var(--white);
    border: 2px solid var(--border);
    border-radius: var(--radius);
    padding: 32px 24px;
    text-align: center;
    box-shadow: var(--shadow);
    position: relative;
}

.cert-mock::before {
    content: '';
    position: absolute;
    inset: 6px;
    border: 1px dashed var(--text-light-m);
    border-radius: 8px;
    pointer-events: none;
}

.cert-seal {
    font-size: 40px;
    margin-bottom: 12px;
}

.cert-mock-title {
    font-size: 11px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--text-muted);
    font-weight: 700;
    margin-bottom: 12px;
}

.cert-mock-course {
    font-family: 'Outfit', sans-serif;
    font-weight: 800;
    font-size: 20px;
    color: var(--text-dark);
    margin-bottom: 16px;
}

.cert-mock-name {
    font-size: 16px;
    color: var(--text-muted);
    font-weight: 500;
    border-top: 1px solid var(--border);
    padding-top: 16px;
    margin-bottom: 12px;
}

.cert-info {
    display: flex;
    flex-direction: column;
    gap: 24px;
}

.cert-point {
    display: flex;
    gap: 16px;
    align-items: flex-start;
}

.cert-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--green);
    flex-shrink: 0;
    margin-top: 8px;
}

.cert-point strong {
    display: block;
    font-size: 17px;
    font-weight: 800;
    color: var(--text-dark);
    margin-bottom: 4px;
}

.cert-point p {
    font-size: 15px;
    color: var(--text-body);
}

/* ─────────────────────────────────────
   RESPONSIVE
───────────────────────────────────── */
@media (max-width: 960px) {
    .page-wrapper {
        grid-template-columns: 1fr;
        grid-template-areas: "hero" "sidebar" "main";
        gap: 0;
    }

    .right-col {
        padding: 0 0 40px;
    }

    .sticky-card {
        position: static;
    }

    .format-grid {
        grid-template-columns: 1fr;
    }

    .outcomes-grid {
        grid-template-columns: 1fr;
    }

    .cert-card {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 680px) {

    .nav-links,
    .nav-right {
        display: none;
    }

    .hamburger {
        display: flex;
    }

    .hero-section h1 {
        font-size: 32px !important;
    }
}

