---
// src/components/ui/UtilityActions.astro

interface Props {
    githubUrl?: string | null;
    showShare?: boolean;
    showNewsletter?: boolean;
    showGoogle?: boolean;
}

const { 
    githubUrl, 
    showShare = true, 
    showNewsletter = true,
    showGoogle = true
} = Astro.props;
---

<div class="flex items-center gap-2">
    {showGoogle && (
        <a href="https://www.google.com/preferences/source?q=serplora.com" target="_blank" rel="noopener noreferrer" class="w-10 h-10 md:w-11 md:h-11 rounded-full border border-subtle bg-surface text-tx-muted flex items-center justify-center hover:text-tx-main hover:border-tx-main hover:-translate-y-0.5 transition-all shadow-sm group relative" aria-label="Follow on Google">
            <svg class="w-4 h-4 md:w-5 md:h-5" viewBox="0 0 24 24" fill="currentColor">
                <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" />
                <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" />
                <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" />
                <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" />
            </svg>
            <span class="absolute bottom-[-30px] text-[12px] bg-tx-main text-main px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap pointer-events-none z-10">Follow on Google</span>
        </a>
    )}

    {githubUrl && (
        <a href={githubUrl} target="_blank" rel="noopener noreferrer" class="w-9 h-9 md:w-11 md:h-11 rounded-full border border-subtle bg-surface text-tx-muted flex items-center justify-center hover:text-tx-main hover:border-tx-main hover:-translate-y-0.5 transition-all shadow-sm group relative" aria-label="View Code">
            <svg class="w-4 h-4 md:w-5 md:h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
            <span class="absolute bottom-[-30px] text-[12px] bg-tx-main text-main px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap pointer-events-none z-10">View Code</span>
        </a>
    )}

    {showNewsletter && (
        <button class="newsletter-btn w-10 h-10 md:w-11 md:h-11 rounded-full border border-subtle bg-surface text-tx-muted flex items-center justify-center hover:text-tx-main hover:border-tx-main hover:-translate-y-0.5 transition-all shadow-sm group relative" aria-label="Get Updates">
            <svg class="w-4 h-4 md:w-5 md:h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            <span class="absolute bottom-[-30px] text-[12px] bg-tx-main text-main px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap pointer-events-none z-10">Newsletter</span>
        </button>
    )}

    {showShare && (
        <div class="relative share-wrapper">
            <button class="share-toggle-btn w-10 h-10 md:w-11 md:h-11 rounded-full border border-subtle bg-surface text-tx-muted flex items-center justify-center hover:text-tx-main hover:border-tx-main hover:-translate-y-0.5 transition-all shadow-sm group relative" aria-label="Share">
                <svg class="w-4 h-4 md:w-5 md:h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line></svg>
                <span class="share-tooltip absolute bottom-[-30px] text-[12px] bg-tx-main text-main px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap pointer-events-none z-10">Share</span>
            </button>

            <div class="share-dropdown absolute top-[calc(100%+8px)] right-0 md:-right-2 bg-surface border border-subtle rounded-xl shadow-lg p-1.5 flex flex-col min-w-[160px] z-[100] hidden">
                
                <a href="#" class="x-share flex items-center gap-3 px-3 py-2.5 text-[14px] font-[500] text-tx-muted hover:text-tx-main hover:bg-main rounded-lg transition-colors w-full text-left" target="_blank" rel="noopener noreferrer">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 24.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                    X (Twitter)
                </a>
                
                <a href="#" class="linkedin-share flex items-center gap-3 px-3 py-2.5 text-[14px] font-[500] text-tx-muted hover:text-tx-main hover:bg-main rounded-lg transition-colors w-full text-left" target="_blank" rel="noopener noreferrer">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                    LinkedIn
                </a>
                
                <a href="#" class="reddit-share flex items-center gap-3 px-3 py-2.5 text-[14px] font-[500] text-tx-muted hover:text-tx-main hover:bg-main rounded-lg transition-colors w-full text-left" target="_blank" rel="noopener noreferrer">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0zm5.01 4.744c.688 0 1.25.561 1.25 1.249a1.25 1.25 0 0 1-2.498.056l-2.597-.547-.8 3.747c1.824.07 3.48.632 4.674 1.488.308-.309.73-.491 1.207-.491.968 0 1.754.786 1.754 1.754 0 .716-.435 1.333-1.01 1.614a3.111 3.111 0 0 1 .042.52c0 2.694-3.13 4.87-7.004 4.87-3.874 0-7.004-2.176-7.004-4.87 0-.183.015-.366.043-.534A1.748 1.748 0 0 1 4.028 12c0-.968.786-1.754 1.754-1.754.463 0 .898.196 1.207.49 1.207-.883 2.878-1.43 4.744-1.487l.885-4.182a.342.342 0 0 1 .14-.197.35.35 0 0 1 .238-.042l2.906.617a1.214 1.214 0 0 1 1.108-.701zM9.25 12C8.561 12 8 12.562 8 13.25c0 .687.561 1.248 1.25 1.248.687 0 1.248-.561 1.248-1.249 0-.688-.561-1.249-1.248-1.249zm5.5 0c-.687 0-1.248.561-1.248 1.25 0 .687.561 1.248 1.249 1.248.688 0 1.249-.561 1.249-1.249 0-.687-.562-1.249-1.25-1.249zm-2.752 4.432c-1.514 0-2.616-.482-2.736-.535a.346.346 0 0 1-.186-.319.349.349 0 0 1 .536-.264c.036.023.957.433 2.386.433 1.428 0 2.348-.41 2.384-.433a.35.35 0 0 1 .475.068.35.35 0 0 1-.068.475c-.12.053-1.222.535-2.736.535z"/></svg>
                    Reddit
                </a>
                
                <a href="#" class="facebook-share flex items-center gap-3 px-3 py-2.5 text-[14px] font-[500] text-tx-muted hover:text-tx-main hover:bg-main rounded-lg transition-colors w-full text-left" target="_blank" rel="noopener noreferrer">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.469h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.469h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                    Facebook
                </a>
                
                <div class="h-px bg-subtle my-1 w-full"></div>

                <button class="copy-link-btn flex items-center gap-3 px-3 py-2.5 text-[14px] font-[500] text-tx-muted hover:text-tx-main hover:bg-main rounded-lg transition-colors w-full text-left">
                    <svg class="copy-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
                    <span class="copy-text">Copy Link</span>
                </button>
            </div>
        </div>
    )}
</div>

<script>
    // Handle Newsletter Modal
    const newsletterBtns = document.querySelectorAll('.newsletter-btn');
    newsletterBtns.forEach(btn => {
        btn.addEventListener('click', () => {
            window.dispatchEvent(new CustomEvent('open-newsletter-modal'));
        });
    });

    // Handle Share Dropdowns
    const shareWrappers = document.querySelectorAll('.share-wrapper');
    
    shareWrappers.forEach(wrapper => {
        const toggleBtn = wrapper.querySelector('.share-toggle-btn');
        const dropdown = wrapper.querySelector('.share-dropdown');
        const tooltip = wrapper.querySelector('.share-tooltip');
        
        const copyBtn = wrapper.querySelector('.copy-link-btn');
        const copyText = copyBtn?.querySelector('.copy-text');
        const copyIcon = copyBtn?.querySelector('.copy-icon');
        
        const xShare = wrapper.querySelector('.x-share');
        const linkedinShare = wrapper.querySelector('.linkedin-share');
        const redditShare = wrapper.querySelector('.reddit-share');
        const facebookShare = wrapper.querySelector('.facebook-share');

        // Toggle dropdown open/close
        toggleBtn?.addEventListener('click', (e) => {
            e.stopPropagation();
            
            // Close any other open dropdowns first
            document.querySelectorAll('.share-dropdown:not(.hidden)').forEach(d => {
                if (d !== dropdown) {
                    d.classList.add('hidden');
                    const otherTooltip = d.parentElement?.querySelector('.share-tooltip');
                    if (otherTooltip) (otherTooltip as HTMLElement).style.display = '';
                }
            });

            // Tailwind classes naturally override when 'hidden' is removed
            dropdown?.classList.toggle('hidden');
            
            // Hide the hovering tooltip so it doesn't overlap the menu
            if (tooltip) {
                (tooltip as HTMLElement).style.display = dropdown?.classList.contains('hidden') ? '' : 'none';
            }
            
            // Generate dynamic URLs for whatever page the user is currently on
            const url = encodeURIComponent(window.location.href);
            const title = encodeURIComponent(document.title);
            
            if(xShare) xShare.setAttribute('href', `https://twitter.com/intent/tweet?url=${url}&text=${title}`);
            if(linkedinShare) linkedinShare.setAttribute('href', `https://www.linkedin.com/shareArticle?mini=true&url=${url}&title=${title}`);
            if(redditShare) redditShare.setAttribute('href', `https://reddit.com/submit?url=${url}&title=${title}`);
            if(facebookShare) facebookShare.setAttribute('href', `https://www.facebook.com/sharer/sharer.php?u=${url}`);
        });

        // Copy Link Action with Visual Feedback
        copyBtn?.addEventListener('click', async (e) => {
            e.stopPropagation();
            try {
                await navigator.clipboard.writeText(window.location.href);
                
                if (copyText) copyText.textContent = 'Copied!';
                if (copyIcon) copyIcon.innerHTML = `<polyline points="20 6 9 17 4 12"></polyline>`;
                
                // Revert icon and close menu after 2 seconds
                setTimeout(() => { 
                    if (copyText) copyText.textContent = 'Copy Link';
                    if (copyIcon) copyIcon.innerHTML = `<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>`;
                    dropdown?.classList.add('hidden'); 
                    if (tooltip) (tooltip as HTMLElement).style.display = '';
                }, 2000);
            } catch (err) {
                console.error('Failed to copy', err);
            }
        });
    });

    // Global listener to close dropdowns when clicking anywhere outside
    document.addEventListener('click', (e) => {
        document.querySelectorAll('.share-dropdown:not(.hidden)').forEach(dropdown => {
            if (!dropdown.contains(e.target as Node)) {
                dropdown.classList.add('hidden');
                const tooltip = dropdown.parentElement?.querySelector('.share-tooltip');
                if (tooltip) (tooltip as HTMLElement).style.display = '';
            }
        });
    });
</script>