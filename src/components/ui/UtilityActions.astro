---
// src/components/ui/UtilityActions.astro
import AuthWidget from '../auth/AuthWidget.astro';

interface Props {
    githubUrl?: string | null;
    showShare?: boolean;
    showNewsletter?: boolean;
    showGoogle?: boolean;
}

const { 
    githubUrl, 
    showShare = true, 
    showNewsletter = true,
    showGoogle = true
} = Astro.props;
---

<div class="flex items-center gap-3">
    {/* 1. GOOGLE BUTTON */}
    {showGoogle && (
        <a href="https://www.google.com/preferences/source?q=serplora.com" target="_blank" rel="noopener noreferrer" class="w-10 h-10 md:w-11 md:h-11 rounded-full border border-subtle bg-surface text-tx-muted flex items-center justify-center hover:text-tx-main hover:border-tx-main hover:-translate-y-0.5 transition-all shadow-sm group relative" aria-label="Follow on Google">
            <svg class="w-4 h-4 md:w-5 md:h-5" viewBox="0 0 24 24" fill="currentColor">
                <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" />
                <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" />
                <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" />
                <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" />
            </svg>
            <span class="absolute bottom-[-30px] text-[12px] bg-tx-main text-main px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap pointer-events-none z-10">Follow on Google</span>
        </a>
    )}

    {/* 2. GITHUB BUTTON */}
    {githubUrl && (
        <a href={githubUrl} target="_blank" rel="noopener noreferrer" class="w-9 h-9 md:w-11 md:h-11 rounded-full border border-subtle bg-surface text-tx-muted flex items-center justify-center hover:text-tx-main hover:border-tx-main hover:-translate-y-0.5 transition-all shadow-sm group relative" aria-label="View Code">
            <svg class="w-4 h-4 md:w-5 md:h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
            <span class="absolute bottom-[-30px] text-[12px] bg-tx-main text-main px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap pointer-events-none z-10">View Code</span>
        </a>
    )}

    {/* 3. NEWSLETTER MODAL WITH BACKDROP */}
    {showNewsletter && (
        <div class="newsletter-wrapper">
            <button class="newsletter-toggle-btn w-10 h-10 md:w-11 md:h-11 rounded-full border border-subtle bg-surface text-tx-muted flex items-center justify-center hover:text-tx-main hover:border-tx-main hover:-translate-y-0.5 transition-all shadow-sm group relative" aria-label="Get Updates">
                <svg class="w-4 h-4 md:w-5 md:h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                <span class="newsletter-tooltip absolute bottom-[-30px] text-[12px] bg-tx-main text-main px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap pointer-events-none z-10">Newsletter</span>
            </button>

            <!-- Blur Backdrop -->
            <div class="newsletter-backdrop fixed inset-0 z-[100] flex items-end md:items-center justify-center bg-black/40 dark:bg-black/60 backdrop-blur-[4px] opacity-0 pointer-events-none transition-opacity duration-300">
                
                <div class="newsletter-popup w-full md:w-[420px] bg-surface border-t md:border border-subtle md:rounded-2xl rounded-t-3xl shadow-2xl p-6 md:p-8 transform translate-y-full md:translate-y-8 md:scale-95 opacity-0 transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] flex flex-col text-left relative max-h-[90vh] overflow-y-auto">
                    
                    <button class="newsletter-close-btn absolute top-4 right-4 md:top-5 md:right-5 p-2 text-tx-muted hover:text-tx-main bg-main hover:bg-tx-muted/10 rounded-full transition-colors outline-none z-50" aria-label="Close">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                    </button>
                    
                    <!-- Dynamic Empty Container for JS Injection -->
                    <div class="newsletter-dynamic-content relative w-full min-h-[170px] flex flex-col justify-center">
                        <!-- Content injected here via innerHTML or template cloning -->
                    </div>
                </div>
            </div>

            <!-- ZERO DOM COST TEMPLATE: Browser parses this but does NOT render it or count it in CWV until cloned -->
            <template id="nl-guest-template">
                <div class="flex-col w-full animate-fade-in flex">
                    <div class="mb-5 text-center px-4">
                        <h3 class="text-[22px] font-[800] text-tx-main tracking-tight">Newsletter</h3>
                        <p class="text-[14.5px] text-tx-muted mt-1 leading-relaxed">Sign in to subscribe to our weekly updates.</p>
                    </div>
                    <div class="-mx-4 md:mx-0">
                        <AuthWidget mode="modal" returnUrl={Astro.url.pathname} />
                    </div>
                </div>
            </template>
        </div>
    )}

    {/* 4. SHARE COMPONENT WITH NATIVE API INTERCEPT */}
    {showShare && (
        <div class="relative share-wrapper">
            <button class="share-toggle-btn w-10 h-10 md:w-11 md:h-11 rounded-full border border-subtle bg-surface text-tx-muted flex items-center justify-center hover:text-tx-main hover:border-tx-main hover:-translate-y-0.5 transition-all shadow-sm group relative" aria-label="Share">
                <svg class="w-4 h-4 md:w-5 md:h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line></svg>
                <span class="share-tooltip absolute bottom-[-30px] text-[12px] bg-tx-main text-main px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap pointer-events-none z-10">Share</span>
            </button>

            <!-- Fallback Dropdown -->
            <div class="share-dropdown absolute top-[calc(100%+8px)] right-0 md:-right-2 bg-surface border border-subtle rounded-xl shadow-lg p-1.5 flex flex-col min-w-[160px] z-[100] hidden">
                <a href="#" class="x-share flex items-center gap-3 px-3 py-2.5 text-[14px] font-[500] text-tx-muted hover:text-tx-main hover:bg-main rounded-lg transition-colors w-full text-left" target="_blank" rel="noopener noreferrer"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 24.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>X (Twitter)</a>
                <a href="#" class="linkedin-share flex items-center gap-3 px-3 py-2.5 text-[14px] font-[500] text-tx-muted hover:text-tx-main hover:bg-main rounded-lg transition-colors w-full text-left" target="_blank" rel="noopener noreferrer"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>LinkedIn</a>
                <a href="#" class="reddit-share flex items-center gap-3 px-3 py-2.5 text-[14px] font-[500] text-tx-muted hover:text-tx-main hover:bg-main rounded-lg transition-colors w-full text-left" target="_blank" rel="noopener noreferrer"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0zm5.01 4.744c.688 0 1.25.561 1.25 1.249a1.25 1.25 0 0 1-2.498.056l-2.597-.547-.8 3.747c1.824.07 3.48.632 4.674 1.488.308-.309.73-.491 1.207-.491.968 0 1.754.786 1.754 1.754 0 .716-.435 1.333-1.01 1.614a3.111 3.111 0 0 1 .042.52c0 2.694-3.13 4.87-7.004 4.87-3.874 0-7.004-2.176-7.004-4.87 0-.183.015-.366.043-.534A1.748 1.748 0 0 1 4.028 12c0-.968.786-1.754 1.754-1.754.463 0 .898.196 1.207.49 1.207-.883 2.878-1.43 4.744-1.487l.885-4.182a.342.342 0 0 1 .14-.197.35.35 0 0 1 .238-.042l2.906.617a1.214 1.214 0 0 1 1.108-.701zM9.25 12C8.561 12 8 12.562 8 13.25c0 .687.561 1.248 1.25 1.248.687 0 1.248-.561 1.248-1.249 0-.688-.561-1.249-1.248-1.249zm5.5 0c-.687 0-1.248.561-1.248 1.25 0 .687.561 1.248 1.249 1.248.688 0 1.249-.561 1.249-1.249 0-.687-.562-1.249-1.25-1.249zm-2.752 4.432c-1.514 0-2.616-.482-2.736-.535a.346.346 0 0 1-.186-.319.349.349 0 0 1 .536-.264c.036.023.957.433 2.386.433 1.428 0 2.348-.41 2.384-.433a.35.35 0 0 1 .475.068.35.35 0 0 1-.068.475c-.12.053-1.222.535-2.736.535z"/></svg>Reddit</a>
                <a href="#" class="facebook-share flex items-center gap-3 px-3 py-2.5 text-[14px] font-[500] text-tx-muted hover:text-tx-main hover:bg-main rounded-lg transition-colors w-full text-left" target="_blank" rel="noopener noreferrer"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.469h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.469h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>Facebook</a>
                <div class="h-px bg-subtle my-1 w-full"></div>
                <button class="copy-link-btn flex items-center gap-3 px-3 py-2.5 text-[14px] font-[500] text-tx-muted hover:text-tx-main hover:bg-main rounded-lg transition-colors w-full text-left">
                    <svg class="copy-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
                    <span class="copy-text">Copy Link</span>
                </button>
            </div>
        </div>
    )}
</div>

<script>
    import { authClient } from '../../lib/auth-client';

    // Global UI Controls
    function closeAllPopovers() {
        document.querySelectorAll('.share-dropdown:not(.hidden)').forEach(d => {
            d.classList.add('hidden');
            const tooltip = d.parentElement?.querySelector('.share-tooltip');
            if (tooltip) (tooltip as HTMLElement).style.display = '';
        });

        document.querySelectorAll('.newsletter-backdrop.opacity-100').forEach(backdrop => {
            backdrop.classList.remove('opacity-100', 'pointer-events-auto');
            backdrop.classList.add('opacity-0', 'pointer-events-none');
            
            const popup = backdrop.querySelector('.newsletter-popup');
            if (popup) {
                popup.classList.remove('translate-y-0', 'md:translate-y-0', 'md:scale-100', 'opacity-100');
                popup.classList.add('translate-y-full', 'md:translate-y-8', 'md:scale-95', 'opacity-0');
            }
        });
    }

    // --- NEWSLETTER DYNAMIC INJECTION ENGINE ---
    const newsletterWrappers = document.querySelectorAll('.newsletter-wrapper');
    newsletterWrappers.forEach(wrapper => {
        const toggleBtn = wrapper.querySelector('.newsletter-toggle-btn');
        const backdrop = wrapper.querySelector('.newsletter-backdrop');
        const popup = wrapper.querySelector('.newsletter-popup');
        const closeBtn = wrapper.querySelector('.newsletter-close-btn');
        const tooltip = wrapper.querySelector('.newsletter-tooltip');
        
        // Single container for all content injection
        const contentDiv = wrapper.querySelector('.newsletter-dynamic-content');
        if (!contentDiv) return;

        // Listen for internal success from AuthWidget
        contentDiv.querySelector('#action-subscribe-btn')?.addEventListener('click', async () => {
                renderLoading();
                try {
                    const res = await fetch('/api/newsletter', { method: 'POST' });
                    if (!res.ok) throw new Error('Server rejected subscription');
                    renderSubscribed();
                } catch (err) {
                    renderSubscribe(name);
                }
            });

        const openPopup = () => {
            closeAllPopovers();
            if (backdrop) {
                backdrop.classList.remove('opacity-0', 'pointer-events-none');
                backdrop.classList.add('opacity-100', 'pointer-events-auto');
            }
            if (popup) {
                popup.classList.remove('translate-y-full', 'md:translate-y-8', 'md:scale-95', 'opacity-0');
                popup.classList.add('translate-y-0', 'md:translate-y-0', 'md:scale-100', 'opacity-100');
            }
            if (tooltip) (tooltip as HTMLElement).style.display = 'none';
        };

        const closePopup = () => {
            if (backdrop) {
                backdrop.classList.remove('opacity-100', 'pointer-events-auto');
                backdrop.classList.add('opacity-0', 'pointer-events-none');
            }
            if (popup) {
                popup.classList.remove('translate-y-0', 'md:translate-y-0', 'md:scale-100', 'opacity-100');
                popup.classList.add('translate-y-full', 'md:translate-y-8', 'md:scale-95', 'opacity-0');
            }
            if (tooltip) (tooltip as HTMLElement).style.display = '';
        };

        // UI INJECTION STATES
        const renderLoading = () => {
            contentDiv.innerHTML = `
                <div class="flex flex-col items-center justify-center py-6 gap-3 w-full animate-fade-in">
                    <svg class="animate-spin w-8 h-8 text-tx-muted" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                </div>
            `;
        };

        const renderGuest = () => {
            contentDiv.innerHTML = '';
            const tpl = document.getElementById('nl-guest-template') as HTMLTemplateElement;
            if (tpl) contentDiv.appendChild(tpl.content.cloneNode(true));
        };

        const renderSubscribe = (name: string) => {
            const safeName = name ? name.split(' ')[0] : 'Developer';
            contentDiv.innerHTML = `
                <div class="flex flex-col w-full animate-fade-in">
                    <h3 class="text-[22px] font-[800] text-tx-main mb-2 tracking-tight">Welcome, ${safeName}!</h3>
                    <p class="text-[14.5px] text-tx-muted mb-6 leading-relaxed pr-6">Subscribe to our weekly newsletter to get the latest technical guides and updates.</p>
                    <button id="action-subscribe-btn" class="w-full bg-tx-main text-main font-[600] text-[15px] px-4 py-3 rounded-xl hover:opacity-90 active:scale-[0.98] transition-all">Subscribe Now</button>
                </div>
            `;
            
            contentDiv.querySelector('#action-subscribe-btn')?.addEventListener('click', async () => {
                renderLoading();
                try {
                    await fetch('/api/newsletter', { method: 'POST' });
                    renderSubscribed();
                } catch (err) {
                    renderSubscribe(name);
                }
            });
        };

        const renderSubscribed = () => {
            contentDiv.innerHTML = `
                <div class="flex flex-col items-center text-center py-3 w-full animate-fade-in">
                    <div class="w-14 h-14 bg-emerald-500/10 text-emerald-500 border border-emerald-500/20 rounded-full flex items-center justify-center mb-5">
                        <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M20 6L9 17l-5-5"></path></svg>
                    </div>
                    <h3 class="text-[20px] font-[800] text-tx-main mb-2 tracking-tight">You're Subscribed!</h3>
                    <p class="text-[14px] text-tx-muted mb-7">Thanks for joining. We'll keep you updated.</p>
                    <button id="action-unsubscribe-btn" class="text-[13px] text-tx-muted hover:text-rose-500 font-medium flex items-center gap-1.5 transition-colors outline-none bg-surface border border-subtle px-3 py-1.5 rounded-md hover:border-rose-500/30 hover:bg-rose-500/5">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                        Unsubscribe
                    </button>
                </div>
            `;

            contentDiv.querySelector('#action-unsubscribe-btn')?.addEventListener('click', async () => {
                renderLoading();
                try {
                    await fetch('/api/newsletter', { method: 'DELETE' });
                    initNewsletterState();
                } catch (err) {
                    initNewsletterState();
                }
            });
        };

        // Core API Logic & Events
        const initNewsletterState = async () => {
            renderLoading();
            try {
                const { data: sessionData } = await authClient.getSession();
                
                if (!sessionData || !sessionData.user) {
                    renderGuest();
                    return;
                }

                if (localStorage.getItem('intentToSubscribe') === 'true') {
                    await fetch('/api/newsletter', { method: 'POST' });
                    localStorage.removeItem('intentToSubscribe');
                    renderSubscribed();
                    openPopup();
                    return;
                }

                const res = await fetch('/api/newsletter');
                const { isSubscribed } = await res.json();
                isSubscribed ? renderSubscribed() : renderSubscribe(sessionData.user.name || '');

            } catch (error) {
                console.error("Newsletter initialization failed", error);
                renderGuest();
            }
        };

        // Trigger Listeners
        toggleBtn?.addEventListener('click', (e) => {
            e.stopPropagation();
            if (backdrop?.classList.contains('opacity-0')) { openPopup(); } else { closePopup(); }
        });
        
        closeBtn?.addEventListener('click', (e) => {
            e.stopPropagation();
            closePopup();
        });

        popup?.addEventListener('click', (e) => e.stopPropagation());
        backdrop?.addEventListener('click', (e) => {
            if (e.target === backdrop) closePopup();
        });

        // Boot
        initNewsletterState();
    });

    // --- SHARE INTERCEPT & DROPDOWN ---
    const shareWrappers = document.querySelectorAll('.share-wrapper');
    shareWrappers.forEach(wrapper => {
        const toggleBtn = wrapper.querySelector('.share-toggle-btn');
        const dropdown = wrapper.querySelector('.share-dropdown');
        const tooltip = wrapper.querySelector('.share-tooltip');
        
        const copyBtn = wrapper.querySelector('.copy-link-btn');
        const copyText = copyBtn?.querySelector('.copy-text');
        const copyIcon = copyBtn?.querySelector('.copy-icon');
        
        const xShare = wrapper.querySelector('.x-share');
        const linkedinShare = wrapper.querySelector('.linkedin-share');
        const redditShare = wrapper.querySelector('.reddit-share');
        const facebookShare = wrapper.querySelector('.facebook-share');

        toggleBtn?.addEventListener('click', async (e) => {
            e.stopPropagation();
            if (navigator.share) {
                try {
                    await navigator.share({ title: document.title, url: window.location.href });
                    return; 
                } catch (err) { return; }
            }

            const isCurrentlyHidden = dropdown?.classList.contains('hidden');
            closeAllPopovers();

            if (isCurrentlyHidden) {
                dropdown?.classList.remove('hidden');
                if (tooltip) (tooltip as HTMLElement).style.display = 'none';
            }
            
            const url = encodeURIComponent(window.location.href);
            const title = encodeURIComponent(document.title);
            
            if(xShare) xShare.setAttribute('href', `https://twitter.com/intent/tweet?url=${url}&text=${title}`);
            if(linkedinShare) linkedinShare.setAttribute('href', `https://www.linkedin.com/shareArticle?mini=true&url=${url}&title=${title}`);
            if(redditShare) redditShare.setAttribute('href', `https://reddit.com/submit?url=${url}&title=${title}`);
            if(facebookShare) facebookShare.setAttribute('href', `https://www.facebook.com/sharer/sharer.php?u=${url}`);
        });

        copyBtn?.addEventListener('click', async (e) => {
            e.stopPropagation();
            try {
                await navigator.clipboard.writeText(window.location.href);
                if (copyText) copyText.textContent = 'Copied!';
                if (copyIcon) copyIcon.innerHTML = `<polyline points="20 6 9 17 4 12"></polyline>`;
                setTimeout(() => { 
                    if (copyText) copyText.textContent = 'Copy Link';
                    if (copyIcon) copyIcon.innerHTML = `<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>`;
                    dropdown?.classList.add('hidden'); 
                    if (tooltip) (tooltip as HTMLElement).style.display = '';
                }, 2000);
            } catch (err) { console.error('Failed to copy', err); }
        });
    });

    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeAllPopovers(); });
</script>

<style>
    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(4px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>