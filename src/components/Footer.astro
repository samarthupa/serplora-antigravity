---
import { getEntry } from 'astro:content';

const footerEntry = await getEntry('footer', 'data');

const brand = footerEntry?.data?.brand ?? { show: false };
const description = footerEntry?.data?.description || 'Building state-of-the-art tools for the web.';
const columns = footerEntry?.data?.columns || [
  {
    title: 'Product',
    links: [
      { label: 'Features', url: '#' },
      { label: 'Pricing', url: '#' },
      { label: 'Tutorials', url: '/tutorials' }
    ]
  },
  {
    title: 'Company',
    links: [
      { label: 'About Us', url: '#' },
      { label: 'Contact', url: '#' },
      { label: 'Careers', url: '#' }
    ]
  }
];
const socialLinks = footerEntry?.data?.socialLinks || [
  { platform: 'twitter', url: '#' },
  { platform: 'github', url: '#' }
];
const copyrightText = footerEntry?.data?.copyrightText || '© 2026 Serplora. All rights reserved.';

// Helper icon mapping for social links
const platformIcons: Record<string, string> = {
  twitter: '<path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"/>',
  github: '<path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/>',
  linkedin: '<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/>',
  youtube: '<path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"/><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"/>',
  facebook: '<path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3.61l.39-4H14V7a1 1 0 0 1 1-1h3z"/>',
  instagram: '<rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>',
};
---

<footer class="bg-surface border-t border-subtle font-['Outfit',sans-serif] mt-auto">
  <div class="max-w-[1200px] mx-auto px-8 py-12 md:py-16">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-8">
      
      {/* Brand & Description */}
      <div class="md:col-span-4 flex flex-col gap-4">
        {brand.show && (
          <a href="/" class="text-[20px] font-[800] text-tx-main tracking-[-0.5px] outline-none flex items-center gap-2">
            {brand.logo && <img src={brand.logo} alt={brand.text || 'Home'} class="h-8 w-auto object-contain" />}
            {!brand.logo && brand.text && <>{brand.text}<span class="text-blue-500">.</span></>}
          </a>
        )}
        <p class="text-[15px] font-[400] text-tx-muted leading-relaxed max-w-[300px]">
          {description}
        </p>
        
        {/* Social Links */}
        <div class="flex items-center gap-4 mt-2">
          {socialLinks.map((social) => {
            const iconSvg = platformIcons[social.platform] || platformIcons.twitter;
            return (
              <a 
                href={social.url} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="text-tx-muted hover:text-tx-main transition-colors duration-200"
                aria-label={`Visit our ${social.platform}`}
              >
                <svg 
                  class="w-5 h-5" 
                  viewBox="0 0 24 24" 
                  fill="none" 
                  stroke="currentColor" 
                  stroke-width="2" 
                  stroke-linecap="round" 
                  stroke-linejoin="round"
                  set:html={iconSvg} 
                />
              </a>
            );
          })}
        </div>
      </div>

      {/* Columns */}
      <div class="md:col-span-8 grid grid-cols-2 sm:grid-cols-3 gap-8 md:gap-10">
        {columns.map((col) => (
          <div class="flex flex-col gap-4">
            <h3 class="text-[15px] font-[600] text-tx-main tracking-tight">{col.title}</h3>
            <ul class="flex flex-col gap-3 list-none p-0 m-0">
              {col.links.map((link) => (
                <li>
                  <a 
                    href={link.url} 
                    class="text-[14px] font-[500] text-tx-muted hover:text-blue-500 transition-colors duration-200"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    {/* Copyright */}
    <div class="mt-12 md:mt-16 pt-8 border-t border-subtle flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-[14px] font-[400] text-tx-muted">
        {copyrightText}
      </p>
    </div>
  </div>
</footer>