---
const { questions } = Astro.props;
---

{questions && questions.length > 0 ? (
  <div id="interactive-quiz-wrapper" class="w-full max-w-2xl mx-auto my-12 font-['Outfit',sans-serif] relative">
    
    {/* Shared Mode Banner */}
    <div id="quiz-shared-banner" class="hidden mb-8 w-full rounded-xl bg-blue-500/10 border border-blue-500/20 text-blue-700 dark:text-blue-300 p-4 text-center text-[15px] font-medium flex-col sm:flex-row items-center justify-center gap-2 sm:gap-3 shadow-sm">
      <div class="flex items-center gap-2">
        <svg class="w-5 h-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
        <span>You are viewing a shared result.</span>
      </div>
      <a href="#" id="quiz-take-yourself" class="underline hover:text-blue-800 dark:hover:text-blue-200 font-bold">Take it yourself</a>
    </div>

    {/* Header Section */}
    <div id="quiz-header-section">
      <div class="mb-4 flex items-center justify-between">
        <span id="quiz-progress-text" class="text-xs font-bold tracking-widest uppercase text-tx-muted">
          Loading...
        </span>
        <div class="flex items-center gap-4">
          <button type="button" id="quiz-restart-btn" class="hidden text-xs font-bold tracking-widest uppercase text-tx-muted hover:text-rose-500 transition-colors">
            Restart
          </button>
          <span id="quiz-score-text" class="text-xs font-bold tracking-widest uppercase text-tx-muted transition-opacity duration-300">
            Score: 0
          </span>
        </div>
      </div>
      <div class="w-full h-1.5 bg-surface border border-subtle rounded-full overflow-hidden mb-10">
        <div id="quiz-progress-bar" class="h-full bg-blue-600 transition-all duration-500 ease-out" style="width: 0%;"></div>
      </div>
    </div>

    {/* Quiz Interactive Area */}
    <div id="quiz-main-area" class="relative flex flex-col min-h-[450px]">
      
      {/* Dynamic Content Container */}
      <div id="quiz-dynamic-content" class="quiz-styled-content flex-1 w-full transition-opacity duration-200 ease-in-out flex flex-col">
        </div>

      {/* Action Buttons */}
      <div id="quiz-footer-actions" class="mt-auto pt-8 flex justify-between items-center border-t border-subtle border-opacity-50">
        <button type="button" id="quiz-prev-btn" class="hidden px-5 py-2.5 text-tx-main bg-surface border border-subtle text-sm font-semibold rounded-lg hover:border-tx-main/40 hover:bg-tx-main/5 active:scale-[0.98] transition-all shadow-sm">
          &larr; Previous
        </button>
        <div class="flex-1"></div>
        <button type="button" id="quiz-next-btn" class="hidden px-6 py-2.5 bg-blue-600 text-white text-sm font-semibold rounded-lg hover:bg-blue-700 active:scale-[0.98] transition-all shadow-md">
          Skip &rarr;
        </button>
      </div>

    </div>

    {/* Share Modal Overlay */}
    <div id="quiz-share-modal" class="fixed inset-0 z-[100] bg-main/80 backdrop-blur-sm hidden items-center justify-center opacity-0 transition-opacity duration-300 p-4">
      <div class="bg-surface border border-subtle rounded-2xl shadow-xl w-full max-w-md p-6 transform scale-95 transition-transform duration-300" id="quiz-share-modal-card">
        <h3 class="text-xl font-bold text-tx-main mb-2">Share Results</h3>
        <p class="text-tx-muted text-sm mb-6">Anyone with this link can view your score and answers for 3 days.</p>
        <div class="flex gap-2">
          <input type="text" id="quiz-share-input" readonly class="flex-1 bg-main border border-subtle text-tx-main rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:border-blue-500 font-['JetBrains_Mono',monospace]">
          <button type="button" id="quiz-copy-btn" class="bg-blue-600 text-white px-5 py-2.5 rounded-lg text-sm font-semibold hover:bg-blue-700 transition-colors shrink-0">Copy</button>
        </div>
        <button type="button" id="quiz-close-modal" class="w-full mt-5 py-2.5 bg-transparent border border-subtle rounded-lg text-tx-main text-sm font-semibold hover:bg-tx-main/5 transition-colors">Close</button>
      </div>
    </div>

  </div>

  <script is:inline define:vars={{ questions }}>
    document.addEventListener('DOMContentLoaded', async () => {
      // Configuration & State
      const shareApiUrl = "https://api.serplora.com/share-quizzes";
      const storageKey = `quiz_state_${window.location.pathname}`;
      
      let quizData = questions; 
      let userAnswers = new Array(quizData.length).fill(null);
      let currentIndex = 0;
      let isReviewMode = false;
      let isSharedMode = false;
      let isFinished = false;
      let hasChecked = false;

      // DOM Elements
      const wrapper = document.getElementById('interactive-quiz-wrapper');
      const contentDiv = document.getElementById('quiz-dynamic-content');
      const headerSection = document.getElementById('quiz-header-section');
      const footerActions = document.getElementById('quiz-footer-actions');
      const nextBtn = document.getElementById('quiz-next-btn');
      const prevBtn = document.getElementById('quiz-prev-btn');
      const restartBtn = document.getElementById('quiz-restart-btn');
      const progressBar = document.getElementById('quiz-progress-bar');
      const progressText = document.getElementById('quiz-progress-text');
      const scoreText = document.getElementById('quiz-score-text');
      
      // Modal Elements
      const modal = document.getElementById('quiz-share-modal');
      const modalCard = document.getElementById('quiz-share-modal-card');
      const modalInput = document.getElementById('quiz-share-input');
      const modalCopyBtn = document.getElementById('quiz-copy-btn');
      const modalCloseBtn = document.getElementById('quiz-close-modal');

      /* --- INITIALIZATION & API FETCH --- */
      const hash = window.location.hash.substring(1);
      
      if (hash) {
        progressText.textContent = "Loading shared results...";
        try {
          const res = await fetch(`${shareApiUrl}?id=${hash}`);
          const apiData = await res.json();
          if (apiData && apiData.files) {
            const content = JSON.parse(apiData.files);
            quizData = content.questions;
            userAnswers = content.userAnswers;
            isSharedMode = true;
            isFinished = true;
          }
        } catch (e) {
          console.error("Could not load shared quiz data.", e);
        }
      } else {
        // Restore Local Storage State
        const savedJSON = localStorage.getItem(storageKey);
        if (savedJSON) {
          try {
            const state = JSON.parse(savedJSON);
            if (state.questions && state.questions.length === quizData.length) {
              currentIndex = state.currentIndex;
              userAnswers = state.userAnswers;
              isFinished = state.isFinished;
            }
          } catch(e) {}
        }
      }

      if (isSharedMode) {
        document.getElementById('quiz-shared-banner').classList.remove('hidden');
        document.getElementById('quiz-shared-banner').classList.add('flex');
        showResults();
      } else if (isFinished) {
        showResults();
      } else {
        renderQuestion();
      }

      /* --- CORE LOGIC --- */

      function calculateScore() {
        let currentScore = 0;
        userAnswers.forEach((ans, idx) => {
          if (ans !== null && quizData[idx].options[ans].isCorrect) currentScore++;
        });
        return currentScore;
      }

      function updateLiveScore() {
        scoreText.textContent = `Score: ${calculateScore()}`;
      }

      function saveState() {
        if (isSharedMode) return;
        const state = {
          currentIndex,
          userAnswers,
          isFinished,
          questions: quizData
        };
        localStorage.setItem(storageKey, JSON.stringify(state));
      }

      function renderQuestion() {
        headerSection.style.display = 'block';
        footerActions.style.display = 'flex';
        const q = quizData[currentIndex];
        
        // --- Navigation Setup ---
        const progressPercent = ((currentIndex) / quizData.length) * 100;
        progressBar.style.width = `${progressPercent}%`;

        // Restart logic
        if (!isSharedMode && !isFinished && (currentIndex > 0 || userAnswers[0] !== null)) {
            restartBtn.classList.remove('hidden');
        } else {
            restartBtn.classList.add('hidden');
        }

        if (currentIndex > 0) prevBtn.classList.remove('hidden');
        else prevBtn.classList.add('hidden');

        nextBtn.classList.remove('hidden');
        
        if (isReviewMode) {
          progressText.innerHTML = `<span class="text-blue-500">Reviewing</span> &bull; Question ${currentIndex + 1} of ${quizData.length}`;
          scoreText.classList.add('opacity-0');
          nextBtn.textContent = (currentIndex === quizData.length - 1) ? "Finish Review" : "Next \u2192";
          restartBtn.classList.add('hidden');
        } else {
          progressText.textContent = `Question ${currentIndex + 1} of ${quizData.length}`;
          scoreText.classList.remove('opacity-0');
          updateLiveScore();
          
          if (userAnswers[currentIndex] === null) {
            nextBtn.textContent = (currentIndex === quizData.length - 1) ? "Skip & Finish" : "Skip \u2192";
            nextBtn.classList.replace('bg-blue-600', 'bg-surface');
            nextBtn.classList.replace('text-white', 'text-tx-main');
            nextBtn.classList.replace('hover:bg-blue-700', 'hover:bg-surface');
            nextBtn.classList.add('border', 'border-subtle');
          } else {
            nextBtn.textContent = (currentIndex === quizData.length - 1) ? "See Results" : "Next \u2192";
            nextBtn.classList.replace('bg-surface', 'bg-blue-600');
            nextBtn.classList.replace('text-tx-main', 'text-white');
            nextBtn.classList.replace('hover:bg-surface', 'hover:bg-blue-700');
            nextBtn.classList.remove('border', 'border-subtle');
          }
        }

        // --- Build Options HTML ---
        let optionsHtml = '';
        q.options.forEach((opt, idx) => {
          optionsHtml += `
            <button 
              type="button"
              data-index="${idx}" 
              class="quiz-option w-full text-left p-4 md:p-5 rounded-xl border-2 border-subtle bg-surface text-[16px] text-tx-main hover:border-blue-500/50 transition-all flex items-center justify-between group cursor-pointer shadow-sm"
            >
              <div class="flex items-center gap-4 flex-1">
                <div class="w-5 h-5 rounded-full border-2 border-subtle flex items-center justify-center transition-colors indicator-circle shrink-0">
                  <div class="w-2.5 h-2.5 rounded-full bg-blue-500 scale-0 transition-transform inner-dot"></div>
                </div>
                <span class="leading-snug">${opt.text}</span>
              </div>
              <div class="status-icon w-6 h-6 shrink-0 opacity-0 transition-opacity flex items-center justify-center"></div>
            </button>
          `;
        });

        // --- Inject HTML ---
        contentDiv.innerHTML = `
          <h3 class="text-2xl md:text-[1.65rem] font-semibold text-tx-main mb-8 leading-[1.35] tracking-tight">${q.questionText}</h3>
          <div class="flex flex-col gap-3.5 mb-6">
            ${optionsHtml}
          </div>
          <div id="quiz-explanation" class="hidden mt-auto p-5 rounded-xl border text-[15px] leading-relaxed">
            <strong id="quiz-explanation-title" class="block mb-2 text-lg"></strong>
            <span class="text-tx-main opacity-90">${q.explanation || 'No further explanation provided.'}</span>
          </div>
        `;

        // --- Handle State Rules ---
        if (isReviewMode) {
          hasChecked = true;
          applyVisualFeedback(userAnswers[currentIndex]);
        } else {
          if (userAnswers[currentIndex] !== null) {
            hasChecked = true;
            applyVisualFeedback(userAnswers[currentIndex]);
          } else {
            hasChecked = false;
            document.querySelectorAll('.quiz-option').forEach(btn => {
              btn.addEventListener('click', (e) => handleAnswer(e.currentTarget));
            });
          }
        }
      }

      function handleAnswer(selectedBtn) {
        if (hasChecked || isSharedMode) return; 
        hasChecked = true;

        const selectedIndex = parseInt(selectedBtn.getAttribute('data-index'));
        userAnswers[currentIndex] = selectedIndex; 
        
        applyVisualFeedback(selectedIndex);
        updateLiveScore();
        saveState();

        nextBtn.textContent = (currentIndex === quizData.length - 1) ? "See Results" : "Next \u2192";
        nextBtn.classList.replace('bg-surface', 'bg-blue-600');
        nextBtn.classList.replace('text-tx-main', 'text-white');
        nextBtn.classList.replace('hover:bg-surface', 'hover:bg-blue-700');
        nextBtn.classList.remove('border', 'border-subtle');
        restartBtn.classList.remove('hidden');
      }

      function applyVisualFeedback(selectedIndex) {
        const q = quizData[currentIndex];
        const allButtons = document.querySelectorAll('.quiz-option');
        const explanationBox = document.getElementById('quiz-explanation');
        const explanationTitle = document.getElementById('quiz-explanation-title');
        
        let isCorrect = false;
        let isSkipped = (selectedIndex === null || selectedIndex === undefined);

        allButtons.forEach((btn, idx) => {
          btn.classList.remove('hover:border-blue-500/50', 'cursor-pointer');
          btn.classList.add('opacity-60', 'cursor-default'); 
          
          const circle = btn.querySelector('.indicator-circle');
          const dot = btn.querySelector('.inner-dot');
          const statusIcon = btn.querySelector('.status-icon');
          
          const isCorrectOption = q.options[idx].isCorrect;
          
          if (isCorrectOption) {
            btn.classList.remove('border-subtle', 'border-blue-500', 'opacity-60', 'bg-surface', 'bg-blue-500/5');
            btn.classList.add('border-emerald-500', 'bg-emerald-500/10', 'opacity-100');
            circle.classList.remove('border-subtle', 'border-blue-500');
            circle.classList.add('border-emerald-500');
            if(idx === selectedIndex) {
               dot.classList.remove('bg-blue-500');
               dot.classList.add('bg-emerald-500', 'scale-100');
            }
            statusIcon.innerHTML = `<svg class="w-6 h-6 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>`;
            statusIcon.classList.remove('opacity-0');
            statusIcon.classList.add('opacity-100');
          }

          if (idx === selectedIndex && !isCorrectOption && !isSkipped) {
            btn.classList.remove('border-subtle', 'border-blue-500', 'opacity-60', 'bg-surface', 'bg-blue-500/5');
            btn.classList.add('border-rose-500', 'bg-rose-500/10', 'opacity-100');
            circle.classList.remove('border-subtle', 'border-blue-500');
            circle.classList.add('border-rose-500');
            dot.classList.remove('bg-blue-500');
            dot.classList.add('bg-rose-500', 'scale-100');
            statusIcon.innerHTML = `<svg class="w-6 h-6 text-rose-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M6 18L18 6M6 6l12 12"/></svg>`;
            statusIcon.classList.remove('opacity-0');
            statusIcon.classList.add('opacity-100');
          }

          if (idx === selectedIndex && isCorrectOption) isCorrect = true;
        });

        explanationBox.classList.remove('hidden');
        explanationBox.classList.add('fade-in');
        
        if (isSkipped) {
          explanationBox.classList.add('bg-surface', 'border-subtle');
          explanationTitle.textContent = "Skipped";
          explanationTitle.classList.add('text-tx-muted');
        } else if (isCorrect) {
          explanationBox.classList.add('bg-emerald-500/10', 'border-emerald-500/30');
          explanationTitle.textContent = "Correct!";
          explanationTitle.classList.add('text-emerald-600', 'dark:text-emerald-400');
        } else {
          explanationBox.classList.add('bg-rose-500/10', 'border-rose-500/30');
          explanationTitle.textContent = "Incorrect";
          explanationTitle.classList.add('text-rose-600', 'dark:text-rose-400');
        }
      }

      function showResults() {
        headerSection.style.display = 'none';
        footerActions.style.display = 'none';

        const finalScore = calculateScore();
        const percentage = Math.round((finalScore / quizData.length) * 100);
        
        let message = "Good effort!";
        if (percentage >= 80) message = "Excellent work!";
        if (percentage === 100) message = "Perfect Score!";

        const titleText = isSharedMode ? "Shared Results" : "Quiz Completed";

        contentDiv.innerHTML = `
          <div class="flex flex-col items-center justify-center text-center py-6 fade-in m-auto w-full">
            <span class="text-xs font-bold tracking-widest uppercase text-tx-muted mb-6">${titleText}</span>
            
            <div class="text-[5.5rem] font-black text-tx-main leading-none mb-3 tracking-tighter">
              ${percentage}%
            </div>
            
            <h3 class="text-xl font-medium text-tx-muted mb-10">${message} ${isSharedMode ? 'They' : 'You'} got ${finalScore} out of ${quizData.length} correct.</h3>
            
            <div class="flex flex-col gap-3 w-full max-w-[320px]">
              
              ${!isSharedMode ? `
                <button type="button" id="btn-retake" class="w-full px-6 py-3.5 bg-tx-main text-main text-[15px] font-semibold rounded-xl hover:scale-[1.02] transition-all shadow-sm flex items-center justify-center gap-2.5">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                  Retake Module
                </button>
              ` : ''}

              <button type="button" id="btn-review" class="w-full px-6 py-3.5 bg-surface border border-subtle text-tx-main text-[15px] font-semibold rounded-xl hover:border-tx-main/30 hover:bg-tx-main/5 transition-all shadow-sm flex items-center justify-center gap-2.5">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
                Review Answers
              </button>

              ${!isSharedMode ? `
                <button type="button" id="btn-share" class="w-full px-6 py-3 text-tx-muted text-[15px] font-medium rounded-xl hover:text-tx-main hover:bg-surface transition-all flex items-center justify-center gap-2.5 mt-1">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" /></svg>
                  Share Result
                </button>
              ` : ''}

            </div>
          </div>
        `;

        if (!isSharedMode) {
          document.getElementById('btn-retake').addEventListener('click', () => {
            isFinished = false;
            currentIndex = 0;
            isReviewMode = false;
            userAnswers.fill(null);
            updateLiveScore();
            saveState();
            transitionToQuestion();
          });

          document.getElementById('btn-share').addEventListener('click', async (e) => {
            const btn = e.currentTarget;
            const originalHTML = btn.innerHTML;
            btn.innerHTML = `<span class="animate-pulse">Generating Link...</span>`;
            btn.disabled = true;

            const payload = {
              scoreC: finalScore,
              scoreW: quizData.length - finalScore,
              userAnswers: userAnswers,
              questions: quizData
            };

            try {
              const res = await fetch(shareApiUrl, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                  files: JSON.stringify(payload),
                  createdAt: Date.now()
                })
              });
              const data = await res.json();
              modalInput.value = `${window.location.origin}${window.location.pathname}#${data.name}`;
              
              modal.classList.remove('hidden');
              modal.classList.add('flex');
              setTimeout(() => {
                modal.classList.remove('opacity-0');
                modalCard.classList.remove('scale-95');
              }, 10);
            } catch (err) {
              alert("Failed to generate share link.");
            }
            btn.innerHTML = originalHTML;
            btn.disabled = false;
          });
        }

        document.getElementById('btn-review').addEventListener('click', () => {
          isReviewMode = true;
          currentIndex = 0;
          transitionToQuestion();
        });
      }

      function transitionToQuestion() {
        contentDiv.classList.add('opacity-0');
        
        if (wrapper.getBoundingClientRect().top < 0) {
            window.scrollBy({ top: wrapper.getBoundingClientRect().top - 80, behavior: 'smooth' });
        }

        setTimeout(() => {
          renderQuestion();
          contentDiv.classList.remove('opacity-0');
        }, 200);
      }

      function processRestart() {
        if(confirm("Are you sure you want to restart? Your current progress will be lost.")) {
          isFinished = false;
          currentIndex = 0;
          isReviewMode = false;
          userAnswers.fill(null);
          updateLiveScore();
          saveState();
          transitionToQuestion();
        }
      }

      /* --- EVENT LISTENERS --- */

      nextBtn.addEventListener('click', () => {
        if (currentIndex < quizData.length - 1) {
          currentIndex++;
          saveState();
          transitionToQuestion();
        } else {
          isFinished = true;
          saveState();
          showResults();
        }
      });

      prevBtn.addEventListener('click', () => {
        if (currentIndex > 0) {
          currentIndex--;
          saveState();
          transitionToQuestion();
        }
      });

      restartBtn.addEventListener('click', processRestart);

      document.getElementById('quiz-take-yourself').addEventListener('click', (e) => {
        e.preventDefault();
        history.pushState("", document.title, window.location.pathname + window.location.search);
        window.location.reload();
      });

      // Modal Controls
      modalCloseBtn.addEventListener('click', () => {
        modal.classList.add('opacity-0');
        modalCard.classList.add('scale-95');
        setTimeout(() => {
          modal.classList.add('hidden');
          modal.classList.remove('flex');
        }, 300);
      });

      modalCopyBtn.addEventListener('click', () => {
        modalInput.select();
        navigator.clipboard.writeText(modalInput.value);
        modalCopyBtn.textContent = "Copied!";
        setTimeout(() => modalCopyBtn.textContent = "Copy", 2000);
      });

      // Keyboard & Swipe Controls
      document.addEventListener('keydown', (e) => {
        if (contentDiv.style.display !== 'none' && !contentDiv.classList.contains('opacity-0')) {
          if (e.key === "ArrowRight") nextBtn.click();
          if (e.key === "ArrowLeft") prevBtn.click();
        }
      });

      let touchStartX = 0;
      let touchEndX = 0;
      wrapper.addEventListener('touchstart', e => { touchStartX = e.changedTouches[0].screenX; }, {passive: true});
      wrapper.addEventListener('touchend', e => {
        touchEndX = e.changedTouches[0].screenX;
        if (contentDiv.style.display === 'none' || contentDiv.classList.contains('opacity-0')) return;
        const xDiff = touchStartX - touchEndX;
        if (Math.abs(xDiff) > 50) {
          if (xDiff > 0) nextBtn.click();
          else prevBtn.click();
        }
      });

    });
  </script>

  <style is:global>
    .fade-in { animation: fadeIn 0.4s cubic-bezier(0.4, 0, 0.2, 1); }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }

    /* HTML Styling Rules */
    .quiz-styled-content b, .quiz-styled-content strong { font-weight: 700; color: var(--color-tx-main); }
    .quiz-styled-content i, .quiz-styled-content em { font-style: italic; }
    .quiz-styled-content code {
      font-family: 'JetBrains Mono', monospace; font-size: 0.85em; color: #ef4444; 
      background-color: var(--color-bg-surface); border: 1px solid var(--color-border-subtle);
