---
import { getEntry } from 'astro:content';
import { authClient } from '../../lib/auth-client';

// 🟢 Define Props
interface Props {
  disableStickyHeader?: boolean;
}

// 🟢 Extract the prop
const { disableStickyHeader = false } = Astro.props;

const headerEntry = await getEntry('header', 'data');
const siteTitle = headerEntry?.data?.siteTitle || 'Serplora';
const logo = headerEntry?.data?.logo;
const logoDark = headerEntry?.data?.logoDark || logo;
const navItems = headerEntry?.data?.navItems || [];

const primaryBtn = {
  label: headerEntry?.data?.primaryButton?.label || 'Sign up for free',
  show: headerEntry?.data?.primaryButton?.show !== false
};

// 🟢 SERVER-SIDE AUTH CHECK
// Fetches session data before the HTML is built, eliminating the layout flash.
let sessionUser: any = null;
try {
  const { data } = await authClient.getSession({
    fetchOptions: {
      headers: Astro.request.headers,
    },
  });
  sessionUser = data?.user || null;
} catch (e) {
  sessionUser = null;
}
---

<header 
  id="site-header" 
  data-disable-sticky={disableStickyHeader ? "true" : "false"}
  class={`inset-x-0 w-full z-[200] h-[58px] md:h-[58px] bg-main/95 backdrop-blur-[12px] shadow-sm border-b border-transparent dark:border-white/6 flex items-center justify-center font-sans transition-transform duration-300 ${disableStickyHeader ? 'relative' : 'sticky top-0'}`}
>
  <div class="w-full px-3 md:px-4 flex items-center gap-2 md:gap-4">
    
    <!-- Hamburger Menu Icon (Elevated z-index to stay above the mobile overlay) -->
    <button
      type="button"
      class="relative z-[210] flex justify-center items-center w-[30px] h-[30px] md:w-[28px] md:h-[28px] rounded-[10px] transition-colors focus:outline-none cursor-pointer shrink-0 border-none p-0 text-tx-main"
      id="mobile-menu-btn"
      aria-label="Toggle navigation menu"
    >
      <svg
        class="w-[24px] h-[24px] md:w-[22px] md:h-[22px] fill-current transition-transform duration-200 active:scale-95"
        viewBox="0 0 24 24"
        xmlns="http://www.w3.org/2000/svg"
      >
        <rect x="2" y="4" width="20" height="2" rx="1" />
        <rect x="2" y="11" width="20" height="2" rx="1" />
        <rect x="2" y="18" width="20" height="2" rx="1" />
      </svg>
    </button>

    <a href="/" class="flex flex-col items-start justify-center gap-1 shrink-0 outline-none focus-visible:ring-2 focus-visible:ring-tx-muted rounded mr-auto md:mr-0">
      <div class="flex items-center">
        {logo && (
          <>
            <img src={logo} alt={siteTitle} width="110" height="38" class="h-9 md:h-10 w-auto object-contain dark:hidden" />
            <img src={logoDark} alt={siteTitle} width="110" height="38" class="h-9 md:h-10 w-auto object-contain hidden dark:block" />
          </>
        )}
        {!logo && <span class="text-[18px] md:text-[20px] font-[800] text-tx-main tracking-[-0.5px]">{siteTitle}</span>}
      </div>
    </a>

    <div class="flex items-center justify-end gap-1.5 md:gap-4 md:ml-auto">
      
      <!-- Search Triggers -->
      <button id="search-trigger" class="flex items-center justify-center md:justify-start w-[36px] h-[36px] rounded-[10px] text-tx-main hover:bg-tx-muted/10 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-tx-muted cursor-pointer shrink-0 md:w-[200px] md:h-[32px] md:px-3 md:bg-tx-muted/5 md:border md:border-subtle/20 md:rounded-[8px] md:text-tx-muted md:hover:bg-tx-muted/10" aria-label="Open Search">
        <svg width="20" height="20" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 md:opacity-70">
          <circle cx="7.5" cy="7.5" r="4.75"></circle>
          <line x1="11" y1="11" x2="16" y2="16"></line>
        </svg>
        <span class="hidden md:block text-[14px] truncate text-left w-full ml-2 opacity-80">Search...</span>
        <span class="hidden md:flex items-center justify-center border border-subtle/60 rounded-[4px] px-1.5 py-0.5 text-[10px] font-mono opacity-60">⌘K</span>
      </button>

      <!-- 🟢 THEME TOGGLE (Fixed with pure CSS classes) -->
      <button class="theme-toggle-btn flex items-center justify-center w-[36px] h-[36px] md:w-[32px] md:h-[32px] rounded-full text-tx-muted hover:bg-main hover:text-tx-main transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-tx-muted cursor-pointer" aria-label="Toggle theme">
        <svg class="block dark:hidden w-5 h-5 transition-transform duration-300 hover:rotate-12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path></svg>
        <svg class="hidden dark:block w-5 h-5 transition-transform duration-300 hover:rotate-90" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
      </button>

      <!-- 🟢 SERVER-RENDERED AUTH SLOT (No Layout Shift) -->
      <div class="flex items-center">
        {sessionUser ? (
          <a href="/account" class="ml-2 md:ml-4 flex items-center justify-center h-[36px] md:h-[32px] px-2.5 md:px-3 rounded-[8px] bg-transparent text-tx-main text-[13px] md:text-[14px] font-[600] hover:bg-tx-muted/10 transition-colors focus-visible:ring-2 focus-visible:ring-offset-2 outline-none whitespace-nowrap">
            {sessionUser.image ? (
              <img src={sessionUser.image} alt="Profile" class="w-6 h-6 rounded-full object-cover shrink-0" />
            ) : (
              <div class="w-7 h-7 rounded-full bg-cta text-cta-text flex items-center justify-center font-extrabold text-[12px] shrink-0">
                {(sessionUser.name || sessionUser.email || 'U').charAt(0).toUpperCase()}
              </div>
            )}
            <span class="hidden md:inline ml-2.5">Profile</span>
          </a>
        ) : (
          primaryBtn.show && (
            <button id="dynamic-signin-btn" type="button" class="ml-2 md:ml-4 flex items-center justify-center h-[30px] px-3 md:px-4 rounded-[8px] bg-cta text-cta-text text-[13px] md:text-[14px] font-[700] tracking-tight transition-all shadow-sm hover:shadow-md hover:bg-cta-hover hover:-translate-y-[1px] active:translate-y-0 cursor-pointer focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-cta outline-none whitespace-nowrap">
              <span>{primaryBtn.label}</span>
            </button>
          )
        )}
      </div>

    </div>

    <!-- Navigation Dropdown (Sleek Split-Pane) -->
    <div 
      id="mobile-menu" 
      class="hidden absolute top-0 md:top-[58px] left-0 w-full bg-main flex-col h-[100dvh] md:h-[calc(100dvh-58px)] pt-[58px] md:pt-0 overflow-hidden z-[200] md:z-[190] border-t-0 md:border-t md:border-subtle/15 opacity-0 -translate-y-1.5 transition-[opacity,transform] duration-250 ease-out"
    >
      <div class="flex flex-col md:flex-row h-full w-full max-w-[1200px] mx-auto">

        <!-- LEFT PANE: Categories Sidebar -->
        <div id="menu-sidebar" class="w-full md:w-[250px] lg:w-[280px] h-full overflow-y-auto md:border-r md:border-subtle/12 py-3 md:py-8 px-3 md:px-4 shrink-0 flex flex-col gap-1">
          {navItems.map((item: any, index: number) => {
            const isFirst = index === 0;
            const hasSubItems = item.subItems && item.subItems.length > 0;
            const activeClasses = 'is-active text-tx-main font-[600] md:bg-tx-muted/5';
            const inactiveClasses = 'text-tx-muted';
            
            return (
              <button
                type="button"
                data-target={`submenu-${index}`}
                data-has-sub={hasSubItems ? "true" : "false"}
                data-url={item.url || '#'}
                class={`menu-category-btn flex items-center justify-between w-full text-left pl-4 pr-3 py-2.5 rounded-md font-[500] text-[15px] transition-colors focus:outline-none md:hover:bg-tx-muted/5 hover:text-tx-main ${isFirst ? activeClasses : inactiveClasses}`}
              >
                <span>{item.label}</span>
                {hasSubItems && (
                  <svg class={`menu-arrow w-4 h-4 shrink-0 transition-opacity duration-200 ${isFirst ? 'text-tx-main opacity-100' : 'text-tx-muted opacity-100 md:opacity-0'}`} fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                  </svg>
                )}
              </button>
            );
          })}
        </div>

        <!-- RIGHT PANE: Bullet Lists & View All Link -->
        <div id="menu-content" class="hidden md:flex flex-1 flex-col h-full overflow-y-auto bg-main p-6 md:px-12 md:py-10">

          <!-- Mobile "Back" Button -->
          <button id="mobile-back-btn" class="md:hidden flex items-center gap-1.5 text-tx-muted hover:text-tx-main font-[500] text-[14px] mb-5 pb-4 border-b border-subtle/15 w-fit focus:outline-none cursor-pointer">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
            Back
          </button>

          <!-- Render a panel for each category -->
          {navItems.map((item: any, index: number) => {
            const hasSubItems = item.subItems && item.subItems.length > 0;
            const isHidden = index === 0 ? "flex" : "hidden";

            return (
              <div id={`submenu-${index}`} class={`submenu-panel flex-col h-full ${isHidden}`}>
                
                {hasSubItems ? (
                  <div class="flex flex-col h-full">
                    {/* 🟢 Vertical-first Grid Layout */}
                    <ul class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-[none] md:grid-rows-4 md:grid-flow-col md:auto-cols-fr gap-x-8 gap-y-3 list-disc list-inside marker:text-tx-main mb-8 w-full">
                      {item.subItems.map((subItem: any) => (
                        <li class="text-tx-muted">
                          <a href={subItem.url || '#'} class="inline-block text-[15px] font-[450] text-tx-muted hover:text-tx-main transition-colors">
                            {subItem.label}
                          </a>
                        </li>
                      ))}
                    </ul>
                    
                    {/* 🟢 Centered View All Link */}
                    <div class="mt-2 pt-4 border-t border-subtle/10 w-full flex justify-center">
                    <a href={item.url || '#'} class="group inline-flex items-center gap-1.5 text-[15px] font-[600] text-tx-main hover:text-tx-muted transition-colors py-2">

                        View all {item.label} 
                        <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
                      </a>
                    </div>
                  </div>
                ) : (
                  <div class="flex flex-col h-full w-full">
                    {/* 🟢 Left-aligned View All Link (Empty Category) */}
                    <a href={item.url || '#'} class="group mr-auto inline-flex items-center gap-1.5 text-[15px] font-[600] text-tx-main hover:text-tx-muted transition-colors mt-2 w-fit">
                      View all {item.label} 
                      <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
                    </a>
                  </div>
                )}
                
              </div>
            );
          })}
        </div>
      </div>
    </div>
  </div>
</header>

<!-- 🟢 MINIMALIST SEARCH OVERLAY -->
<div id="minimal-search-overlay" class="fixed inset-0 z-[300] bg-surface/95 backdrop-blur-md opacity-0 invisible pointer-events-none transition-all duration-300 flex flex-col pt-[12vh] px-5">
  <div class="absolute inset-0" id="search-overlay-backdrop"></div>

  <div
    id="search-overlay-content"
    class="relative z-10 w-full max-w-2xl mx-auto transform scale-95 opacity-0 transition-all duration-500 ease-out"
  >

    <!-- 🟢 BACKWARD ARROW (Aligned with search bar) -->
    <div class="mb-12 flex">
      <button 
        id="close-search-overlay" 
        type="button" 
        class="inline-flex items-center justify-center p-2.5 -ml-3 text-tx-muted hover:text-tx-main hover:bg-tx-muted/10 rounded-full transition-colors cursor-pointer outline-none focus-visible:ring-2 focus-visible:ring-tx-main/50"
        aria-label="Close search"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
      </button>
    </div>

    <!-- Search Form -->
    <form action="/search" method="GET" class="w-full">
      <div class="border-b border-tx-muted/20 pb-3 focus-within:border-tx-main transition-colors">
        <input
          type="search"
          name="q"
          id="overlay-search-input"
          placeholder="Search..."
          autocomplete="off"
          spellcheck="true"
          autocorrect="on"
          autocapitalize="off"
          class="w-full bg-transparent border-none outline-none appearance-none p-0 text-2xl md:text-3xl font-semibold tracking-tight text-tx-main placeholder:text-tx-muted/40"
        />
      </div>

      <!-- Search Button (Hidden by default) -->
      <div id="search-submit-container" class="mt-6 flex justify-end opacity-0 invisible transition-all duration-200">
        <button
          type="submit"
          class="inline-flex items-center gap-2 rounded-sm border border-subtle px-4 py-2 text-sm font-medium text-tx-main transition-all duration-200 hover:border-tx-main hover:bg-surface-secondary focus:outline-none focus:ring-2 focus:ring-tx-main/20"
        >
          <svg
            class="h-4 w-4"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
            />
          </svg>
          <span>Search</span>
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  // 🟢 FIXED THEME TOGGLE LOGIC (Added try/catch for Brave Shields)
  const themeToggleBtns = document.querySelectorAll('.theme-toggle-btn');

  if (themeToggleBtns.length > 0) {
    themeToggleBtns.forEach(btn => {
      btn.addEventListener('click', function() {
        const isCurrentlyDark = document.documentElement.classList.contains('dark');

        if (isCurrentlyDark) {
          document.documentElement.classList.remove('dark');
          try { localStorage.setItem('theme', 'light'); } catch (e) {}
        } else {
          document.documentElement.classList.add('dark');
          try { localStorage.setItem('theme', 'dark'); } catch (e) {}
        }
      });
    });
  }

  // --- MINIMAL SEARCH OVERLAY LOGIC ---
  const searchTrigger = document.getElementById('search-trigger');
  const searchOverlay = document.getElementById('minimal-search-overlay');
  const searchBackdrop = document.getElementById('search-overlay-backdrop');
  const searchContent = document.getElementById('search-overlay-content');
  const searchInput = document.getElementById('overlay-search-input') as HTMLInputElement;
  const closeSearchBtn = document.getElementById('close-search-overlay');
  const searchSubmitContainer = document.getElementById('search-submit-container');

  function openSearch() {
    searchOverlay?.classList.remove('opacity-0', 'invisible', 'pointer-events-none');
    searchContent?.classList.remove('scale-95', 'opacity-0');
    searchContent?.classList.add('scale-100', 'opacity-100');
    document.body.style.overflow = 'hidden';
    
    setTimeout(() => {
      searchInput?.focus();
    }, 100);
  }

  function closeSearch() {
    searchOverlay?.classList.add('opacity-0', 'invisible', 'pointer-events-none');
    searchContent?.classList.remove('scale-100', 'opacity-100');
    searchContent?.classList.add('scale-95', 'opacity-0');
    document.body.style.overflow = '';
  }

  // 🟢 FIXED SEARCH MEMORY LOGIC (Added try/catch for Brave Shields)
  function restoreSearchState() {
    const urlParams = new URLSearchParams(window.location.search);
    const queryFromUrl = urlParams.get('q');
    
    let savedQuery = null;
    try {
      savedQuery = sessionStorage.getItem('lastSearchQuery');
    } catch (e) {
      // Catch Brave Shield strict mode error
    }

    if (queryFromUrl) {
      if (searchInput) searchInput.value = queryFromUrl;
      try { sessionStorage.setItem('lastSearchQuery', queryFromUrl); } catch (e) {}
      searchSubmitContainer?.classList.remove('opacity-0', 'invisible');
    } else if (savedQuery) {
      if (searchInput) searchInput.value = savedQuery;
      searchSubmitContainer?.classList.remove('opacity-0', 'invisible');
    }
  }

  searchInput?.addEventListener('input', () => {
    if (searchInput) {
      try { sessionStorage.setItem('lastSearchQuery', searchInput.value); } catch (e) {}
      
      if (searchInput.value.trim().length > 0) {
        searchSubmitContainer?.classList.remove('opacity-0', 'invisible');
      } else {
        searchSubmitContainer?.classList.add('opacity-0', 'invisible');
      }
    }
  });

  restoreSearchState();

  searchTrigger?.addEventListener('click', openSearch);
  searchBackdrop?.addEventListener('click', closeSearch);
  closeSearchBtn?.addEventListener('click', closeSearch);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeSearch();
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      openSearch();
    }
  });

  // --- SPLIT-PANE MEGA MENU LOGIC ---
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const categoryBtns = document.querySelectorAll('.menu-category-btn');
  const submenuPanels = document.querySelectorAll('.submenu-panel');
  const menuSidebar = document.getElementById('menu-sidebar');
  const menuContent = document.getElementById('menu-content');
  const backBtn = document.getElementById('mobile-back-btn');

  // Arrays to easily toggle the active/inactive classes
  const MENU_ACTIVE_CLASSES = ['is-active', 'text-tx-main', 'font-[600]', 'md:bg-tx-muted/5'];
  const MENU_INACTIVE_CLASSES = ['text-tx-muted'];

  function resetMobileMenuView() {
    if (window.innerWidth < 768) {
      if (menuSidebar) {
        menuSidebar.classList.remove('hidden');
        menuSidebar.classList.add('flex');
      }
      if (menuContent) {
        menuContent.classList.remove('flex');
        menuContent.classList.add('hidden');
      }
    }
  }

  function openMegaMenu() {
    if (!menu || !btn) return;
    menu.classList.remove('hidden');
    menu.classList.add('flex');
    // force a reflow so the transition fires reliably
    void menu.offsetWidth;
    menu.classList.remove('opacity-0', '-translate-y-1.5');
    document.body.style.overflow = 'hidden';
    btn.classList.remove('text-tx-main');
    btn.classList.add('text-cta');
  }

  function closeMegaMenu() {
    if (!menu || !btn) return;
    menu.classList.add('opacity-0', '-translate-y-1.5');
    document.body.style.overflow = '';
    btn.classList.remove('text-cta');
    btn.classList.add('text-tx-main');

    window.setTimeout(() => {
      menu.classList.add('hidden');
      menu.classList.remove('flex');
      resetMobileMenuView();
    }, 250);
  }

  if (btn && menu) {
    btn.addEventListener('click', () => {
      const isOpen = !menu.classList.contains('hidden') && !menu.classList.contains('opacity-0');
      if (isOpen) {
        closeMegaMenu();
      } else {
        openMegaMenu();
      }
    });
  }

  // Handle clicking a category on the left sidebar
  categoryBtns.forEach(categoryBtn => {
    categoryBtn.addEventListener('click', () => {
      const targetId = categoryBtn.getAttribute('data-target');
      const hasSub = categoryBtn.getAttribute('data-has-sub') === 'true';
      const url = categoryBtn.getAttribute('data-url');

      // If mobile and NO sub-items, act as a direct navigation link
      if (window.innerWidth < 768 && !hasSub) {
        if (url) window.location.href = url;
        return;
      }

      // 1. Reset all category buttons to the quiet, inactive state, and adjust arrows
      categoryBtns.forEach(c => {
        c.classList.remove(...MENU_ACTIVE_CLASSES);
        c.classList.add(...MENU_INACTIVE_CLASSES);
        const arrow = c.querySelector('.menu-arrow');
        if(arrow) {
          arrow.classList.remove('text-tx-main', 'md:opacity-100');
          arrow.classList.add('text-tx-muted', 'md:opacity-0');
        }
      });

      // 2. Mark the clicked button active, and highlight its arrow
      categoryBtn.classList.remove(...MENU_INACTIVE_CLASSES);
      categoryBtn.classList.add(...MENU_ACTIVE_CLASSES);
      const activeArrow = categoryBtn.querySelector('.menu-arrow');
      if(activeArrow) {
        activeArrow.classList.remove('text-tx-muted', 'md:opacity-0');
        activeArrow.classList.add('text-tx-main', 'md:opacity-100');
      }

      // 3. Hide all right-side panels, then show the specific target panel
      submenuPanels.forEach(p => {
        p.classList.remove('flex');
        p.classList.add('hidden');
      });
      
      const targetPanel = document.getElementById(targetId || '');
      if (targetPanel) {
        targetPanel.classList.remove('hidden');
        targetPanel.classList.add('flex');
      }

      // 4. Mobile specific: Hide the sidebar entirely and show the content pane
      if (window.innerWidth < 768 && menuSidebar && menuContent && hasSub) {
        menuSidebar.classList.add('hidden');
        menuSidebar.classList.remove('flex');
        menuContent.classList.remove('hidden');
        menuContent.classList.add('flex');
      }
    });
  });

  // Handle the Mobile "Back" button
  if (backBtn && menuSidebar && menuContent) {
    backBtn.addEventListener('click', () => {
      // Hide content pane, show sidebar again
      menuContent.classList.remove('flex');
      menuContent.classList.add('hidden');
      menuSidebar.classList.remove('hidden');
      menuSidebar.classList.add('flex');
    });
  }

  // --- DYNAMICs SIGN-IN ROUTING ---
  const dynamicSigninBtn = document.getElementById('dynamic-signin-btn');
  if (dynamicSigninBtn) {
    dynamicSigninBtn.addEventListener('click', () => {
      const currentPath = window.location.pathname + window.location.search;
      window.location.href = `/login?returnUrl=${encodeURIComponent(currentPath)}`;
    });
  }
</script>