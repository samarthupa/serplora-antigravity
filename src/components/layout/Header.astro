---
import { getEntry } from 'astro:content';

// 🟢 Define Props
interface Props {
  disableStickyHeader?: boolean;
}

const { disableStickyHeader = false } = Astro.props;

const headerEntry = await getEntry('header', 'data');
const siteTitle = headerEntry?.data?.siteTitle || 'Serplora';
const logo = headerEntry?.data?.logo;
const logoDark = headerEntry?.data?.logoDark || logo;
const navItems = headerEntry?.data?.navItems || [];

const primaryBtn = {
  label: headerEntry?.data?.primaryButton?.label || 'Sign up for free',
  show: headerEntry?.data?.primaryButton?.show !== false
};
---

<!-- 🟢 INSTANT PAINT SCRIPT (Prevents layout shift before HTML loads) -->
<script is:inline>
  try {
    if (localStorage.getItem('auth_valid') === 'true') {
      document.documentElement.classList.add('is-auth');
    }
  } catch(e) {}
</script>

<style>
  /* 🟢 CSS TOGGLE LOGIC */
  #auth-signin-header { display: block; }
  #auth-profile-header { display: none; }
  
  html.is-auth #auth-signin-header { display: none !important; }
  html.is-auth #auth-profile-header { display: block !important; }

  /* Custom scrollbar for sidebar links */
  .styled-scrollbar::-webkit-scrollbar { width: 4px; }
  .styled-scrollbar::-webkit-scrollbar-track { background: transparent; }
  .styled-scrollbar::-webkit-scrollbar-thumb { background: rgba(150,150,150,0.3); border-radius: 4px; }
</style>

<!-- 🟢 UNIFIED CLAUDE TOGGLE BUTTON -->
<button
  type="button"
  id="universal-sidebar-btn"
  class="fixed top-4 left-4 z-[210] flex justify-center items-center w-[36px] h-[36px] rounded-[8px] bg-main/80 backdrop-blur-md shadow-sm border border-subtle/20 text-tx-main hover:bg-tx-muted/10 transition-colors focus:outline-none cursor-pointer"
  aria-label="Toggle Sidebar"
>
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
    <line x1="9" y1="3" x2="9" y2="21"></line>
  </svg>
</button>

<!-- 🟢 MAIN SIDEBAR -->
<header 
  id="site-header" 
  class="fixed top-0 left-0 z-[250] w-[260px] h-[100dvh] bg-main/95 backdrop-blur-[12px] shadow-2xl border-r border-subtle/10 flex flex-col font-sans transition-transform duration-300 ease-out -translate-x-full"
>
  <!-- Sidebar Header: Logo & Close Button -->
  <div class="flex items-center justify-between px-4 py-4 shrink-0 border-b border-subtle/10">
    <a href="/" class="flex items-center gap-1 shrink-0 outline-none focus-visible:ring-2 focus-visible:ring-tx-muted rounded">
      {logo && (
        <>
          <img src={logo} alt={siteTitle} width="110" height="38" class="h-7 w-auto object-contain dark:hidden" />
          <img src={logoDark} alt={siteTitle} width="110" height="38" class="h-7 w-auto object-contain hidden dark:block" />
        </>
      )}
      {!logo && <span class="text-[18px] font-[800] text-tx-main tracking-[-0.5px]">{siteTitle}</span>}
    </a>

    <button id="close-sidebar-btn" class="p-1.5 text-tx-muted hover:text-tx-main rounded-md transition-colors cursor-pointer">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <!-- Search Button -->
  <div class="px-3 pt-4 shrink-0">
    <button id="search-trigger" class="flex items-center w-full h-[36px] px-3 bg-tx-muted/5 border border-subtle/20 rounded-[8px] text-tx-muted hover:bg-tx-muted/10 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-tx-muted cursor-pointer" aria-label="Open Search">
      <svg width="16" height="16" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 opacity-70">
        <circle cx="7.5" cy="7.5" r="4.75"></circle>
        <line x1="11" y1="11" x2="16" y2="16"></line>
      </svg>
      <span class="text-[14px] ml-2 w-full text-left opacity-80">Search...</span>
      <span class="flex items-center justify-center border border-subtle/60 rounded-[4px] px-1.5 py-0.5 text-[10px] font-mono opacity-60">⌘K</span>
    </button>
  </div>

  <!-- Scrollable Navigation Area (Submenus Removed) -->
  <div class="flex-1 overflow-y-auto px-3 py-4 styled-scrollbar mt-2">
    <div class="flex flex-col gap-0.5">
      {navItems.map((item: any) => (
        <a href={item.url || '#'} class="flex items-center px-3 py-2 rounded-md font-[500] text-[14px] text-tx-main hover:bg-tx-muted/5 transition-colors outline-none focus-visible:ring-2 focus-visible:ring-tx-muted">
          {item.label}
        </a>
      ))}
    </div>
  </div>

  <!-- 🟢 Bottom Section: Theme Icon & Auth (Inline) -->
  <div class="shrink-0 border-t border-subtle/10 p-3 bg-main/50 flex items-center justify-between gap-2">
    
    <!-- Theme Toggle (Icon Only) -->
    <button class="theme-toggle-btn flex items-center justify-center w-[34px] h-[34px] shrink-0 rounded-[6px] text-tx-muted hover:bg-tx-muted/10 hover:text-tx-main transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-tx-muted cursor-pointer" aria-label="Toggle theme">
      <svg class="block dark:hidden w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path></svg>
      <svg class="hidden dark:block w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
    </button>

    <!-- Auth Containers (Takes up remaining width next to theme button) -->
    <div class="flex-1 overflow-hidden">
      
      <!-- Logged Out State (Subtle Claude-style button) -->
      <div id="auth-signin-header" class="w-full">
        {primaryBtn.show && (
          <button id="dynamic-signin-btn" type="button" class="w-full flex items-center justify-center h-[34px] rounded-[6px] bg-transparent border border-subtle/30 text-tx-main hover:bg-tx-muted/5 text-[13px] font-[500] transition-colors cursor-pointer outline-none focus-visible:ring-2 focus-visible:ring-tx-muted">
            <span class="truncate">{primaryBtn.label}</span>
          </button>
        )}
      </div>

      <!-- Logged In State (Profile Block) -->
      <div id="auth-profile-header" class="w-full">
        <a href="/account" class="flex items-center w-full h-[34px] px-2 rounded-[6px] bg-transparent hover:bg-tx-muted/5 transition-colors outline-none cursor-pointer group focus-visible:ring-2 focus-visible:ring-tx-muted">
          <img id="profile-avatar-img-header" src="" alt="Profile" class="w-6 h-6 rounded-md object-cover shrink-0 hidden" />
          <div id="profile-avatar-header" class="w-6 h-6 rounded-md bg-tx-muted/10 text-tx-muted flex items-center justify-center font-bold text-[11px] shrink-0 border border-subtle/10">
            <svg id="profile-avatar-fallback-icon" class="w-3.5 h-3.5 opacity-60" fill="currentColor" viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
          </div>
          <span class="ml-2.5 text-[13px] font-[500] truncate text-tx-muted group-hover:text-tx-main transition-colors">My Account</span>
        </a>
      </div>

    </div>
  </div>
</header>

<!-- Overlay Backdrop for Sidebar -->
<div id="sidebar-backdrop" class="fixed inset-0 bg-surface/80 backdrop-blur-sm z-[240] opacity-0 pointer-events-none transition-opacity duration-300"></div>


<!-- 🟢 INSTANT PROFILE RENDER SCRIPT -->
<script is:inline>
  try {
    if (localStorage.getItem('auth_valid') === 'true') {
      const avatarUrl = localStorage.getItem('auth_avatar');
      const initialStr = localStorage.getItem('auth_initial');
      
      if (avatarUrl) {
        const img = document.getElementById('profile-avatar-img-header');
        const fallback = document.getElementById('profile-avatar-header');
        const fallbackIcon = document.getElementById('profile-avatar-fallback-icon');
        if (img && fallback) {
          img.src = avatarUrl;
          img.classList.remove('hidden');
          fallback.classList.add('hidden');
          if (fallbackIcon) fallbackIcon.remove();
        }
      } else if (initialStr) {
        const fallback = document.getElementById('profile-avatar-header');
        const fallbackIcon = document.getElementById('profile-avatar-fallback-icon');
        if (fallback) {
          fallback.textContent = initialStr;
          if (fallbackIcon) fallbackIcon.remove();
        }
      }
    }
  } catch(e) {}
</script>

<!-- 🟢 EXACT ORIGINAL SEARCH OVERLAY -->
<div id="minimal-search-overlay" class="fixed inset-0 z-[300] bg-surface/95 backdrop-blur-md opacity-0 invisible pointer-events-none transition-all duration-300 flex flex-col pt-[12vh] px-5">
  <div class="absolute inset-0" id="search-overlay-backdrop"></div>
  <div id="search-overlay-content" class="relative z-10 w-full max-w-2xl mx-auto transform scale-95 opacity-0 transition-all duration-500 ease-out">
    <div class="mb-12 flex">
      <button id="close-search-overlay" type="button" class="inline-flex items-center justify-center p-2.5 -ml-3 text-tx-muted hover:text-tx-main hover:bg-tx-muted/10 rounded-full transition-colors cursor-pointer outline-none focus-visible:ring-2 focus-visible:ring-tx-main/50" aria-label="Close search">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
      </button>
    </div>
    <form action="/search" method="GET" class="w-full">
      <div class="border-b border-tx-muted/20 pb-3 focus-within:border-tx-main transition-colors">
        <input type="search" name="q" id="overlay-search-input" placeholder="Search..." autocomplete="off" spellcheck="true" autocorrect="on" autocapitalize="off" class="w-full bg-transparent border-none outline-none appearance-none p-0 text-2xl md:text-3xl font-semibold tracking-tight text-tx-main placeholder:text-tx-muted/40" />
      </div>
      <div id="search-submit-container" class="mt-6 flex justify-end opacity-0 invisible transition-all duration-200">
        <button type="submit" class="inline-flex items-center gap-2 rounded-sm border border-subtle px-4 py-2 text-sm font-medium text-tx-main transition-all duration-200 hover:border-tx-main hover:bg-surface-secondary focus:outline-none focus:ring-2 focus:ring-tx-main/20">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
          <span>Search</span>
        </button>
      </div>
    </form>
  </div>
</div>

<!-- 🟢 EXACT ORIGINAL JAVASCRIPT LOGIC + SIMPLE SIDEBAR TOGGLE -->
<script>
  import { authClient } from '../../lib/auth-client';
  
  // 1. ORIGINAL BACKGROUND SYNC
  async function syncAuth() {
    try {
      const { data } = await authClient.getSession();
      const avatarImgEl = document.getElementById('profile-avatar-img-header') as HTMLImageElement;
      const avatarFallbackEl = document.getElementById('profile-avatar-header');
      const fallbackIconEl = document.getElementById('profile-avatar-fallback-icon');

      if (data && data.user) {
        const user = data.user as any;
        const initial = user.name ? user.name : user.email;
        const initialChar = initial.charAt(0).toUpperCase();

        try { 
          localStorage.setItem('auth_valid', 'true'); 
          if (user.image) {
            localStorage.setItem('auth_avatar', user.image);
          } else {
            localStorage.setItem('auth_initial', initialChar);
          }
        } catch(e) {}
        
        document.documentElement.classList.add('is-auth');

        if (user.image && avatarImgEl) {
           avatarImgEl.src = user.image;
           avatarImgEl.classList.remove('hidden');
           if (avatarFallbackEl) avatarFallbackEl.classList.add('hidden');
           if (fallbackIconEl) fallbackIconEl.remove();
        } else if (avatarFallbackEl) {
           avatarFallbackEl.textContent = initialChar;
           avatarFallbackEl.classList.remove('hidden');
           if (avatarImgEl) avatarImgEl.classList.add('hidden');
           if (fallbackIconEl) fallbackIconEl.remove(); 
        }
      } else {
        try { 
          localStorage.removeItem('auth_valid'); 
          localStorage.removeItem('auth_avatar');
          localStorage.removeItem('auth_initial');
        } catch(e) {}
        document.documentElement.classList.remove('is-auth');
      }
    } catch(e) {
      try { 
        localStorage.removeItem('auth_valid'); 
        localStorage.removeItem('auth_avatar');
        localStorage.removeItem('auth_initial');
      } catch(e) {}
      document.documentElement.classList.remove('is-auth');
    }
  }
  syncAuth();

  // 2. ORIGINAL THEME TOGGLE
  const themeToggleBtns = document.querySelectorAll('.theme-toggle-btn');
  if (themeToggleBtns.length > 0) {
    themeToggleBtns.forEach(btn => {
      btn.addEventListener('click', function() {
        const isCurrentlyDark = document.documentElement.classList.contains('dark');
        if (isCurrentlyDark) {
          document.documentElement.classList.remove('dark');
          try { localStorage.setItem('theme', 'light'); } catch (e) {}
        } else {
          document.documentElement.classList.add('dark');
          try { localStorage.setItem('theme', 'dark'); } catch (e) {}
        }
      });
    });
  }

  // 3. ORIGINAL SEARCH
  const searchTrigger = document.getElementById('search-trigger');
  const searchOverlay = document.getElementById('minimal-search-overlay');
  const searchBackdrop = document.getElementById('search-overlay-backdrop');
  const searchContent = document.getElementById('search-overlay-content');
  const searchInput = document.getElementById('overlay-search-input') as HTMLInputElement;
  const closeSearchBtn = document.getElementById('close-search-overlay');
  const searchSubmitContainer = document.getElementById('search-submit-container');

  function openSearch() {
    searchOverlay?.classList.remove('opacity-0', 'invisible', 'pointer-events-none');
    searchContent?.classList.remove('scale-95', 'opacity-0');
    searchContent?.classList.add('scale-100', 'opacity-100');
    document.body.style.overflow = 'hidden';
    setTimeout(() => { searchInput?.focus(); }, 100);
  }

  function closeSearch() {
    searchOverlay?.classList.add('opacity-0', 'invisible', 'pointer-events-none');
    searchContent?.classList.remove('scale-100', 'opacity-100');
    searchContent?.classList.add('scale-95', 'opacity-0');
    document.body.style.overflow = '';
  }

  function restoreSearchState() {
    const urlParams = new URLSearchParams(window.location.search);
    const queryFromUrl = urlParams.get('q');
    
    let savedQuery = null;
    try { savedQuery = sessionStorage.getItem('lastSearchQuery'); } catch (e) {}

    if (queryFromUrl) {
      if (searchInput) searchInput.value = queryFromUrl;
      try { sessionStorage.setItem('lastSearchQuery', queryFromUrl); } catch (e) {}
      searchSubmitContainer?.classList.remove('opacity-0', 'invisible');
    } else if (savedQuery) {
      if (searchInput) searchInput.value = savedQuery;
      searchSubmitContainer?.classList.remove('opacity-0', 'invisible');
    }
  }

  searchInput?.addEventListener('input', () => {
    if (searchInput) {
      try { sessionStorage.setItem('lastSearchQuery', searchInput.value); } catch (e) {}
      if (searchInput.value.trim().length > 0) {
        searchSubmitContainer?.classList.remove('opacity-0', 'invisible');
      } else {
        searchSubmitContainer?.classList.add('opacity-0', 'invisible');
      }
    }
  });

  restoreSearchState();
  searchTrigger?.addEventListener('click', openSearch);
  searchBackdrop?.addEventListener('click', closeSearch);
  closeSearchBtn?.addEventListener('click', closeSearch);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeSearch();
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      openSearch();
    }
  });

  // 4. ORIGINAL ROUTING
  const dynamicSigninBtn = document.getElementById('dynamic-signin-btn');
  if (dynamicSigninBtn) {
    dynamicSigninBtn.addEventListener('click', () => {
      const currentPath = window.location.pathname + window.location.search;
      window.location.href = `/login?returnUrl=${encodeURIComponent(currentPath)}`;
    });
  }

  // 5. BULLETPROOF SIDEBAR TOGGLE
  const universalBtn = document.getElementById('universal-sidebar-btn');
  const siteHeader = document.getElementById('site-header');
  const closeSidebarBtn = document.getElementById('close-sidebar-btn');
  const sidebarBackdrop = document.getElementById('sidebar-backdrop');

  function toggleSidebar() {
    if (!siteHeader) return;
    
    const isClosed = siteHeader.classList.contains('-translate-x-full');
    
    if (isClosed) {
      siteHeader.classList.remove('-translate-x-full');
      sidebarBackdrop?.classList.remove('opacity-0', 'pointer-events-none');
    } else {
      siteHeader.classList.add('-translate-x-full');
      sidebarBackdrop?.classList.add('opacity-0', 'pointer-events-none');
    }
  }

  universalBtn?.addEventListener('click', toggleSidebar);
  closeSidebarBtn?.addEventListener('click', toggleSidebar);
  sidebarBackdrop?.addEventListener('click', toggleSidebar);
</script>