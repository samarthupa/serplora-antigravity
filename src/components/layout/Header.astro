---
import { getEntry } from 'astro:content';
import Search from "astro-pagefind/components/Search";
// 🟢 NEW: Define Props
interface Props {
  disableStickyHeader?: boolean;
}

// 🟢 NEW: Extract the prop
const { disableStickyHeader = false } = Astro.props;

const headerEntry = await getEntry('header', 'data');
const siteTitle = headerEntry?.data?.siteTitle || 'Serplora';
const logo = headerEntry?.data?.logo;
const logoDark = headerEntry?.data?.logoDark || logo; // Fallback to light logo if dark isn't provided
const navItems = headerEntry?.data?.navItems || [];

const primaryBtn = {
  label: headerEntry?.data?.primaryButton?.label || 'Sign up for free',
  url: `/signin?returnUrl=${Astro.url.pathname}`,
  show: headerEntry?.data?.primaryButton?.show !== false
};
---z

{/* 🟢 CHANGED: We pass the prop to a data-attribute for JS, and toggle the 'sticky top-0' classes */}
<header 
  id="site-header" 
  data-disable-sticky={disableStickyHeader ? "true" : "false"}
  {/* Added: border-b border-subtle */}
  class={`inset-x-0 w-full z-[200] h-[52px] bg-main/95 backdrop-blur-[8px] flex items-center justify-center font-['Outfit',sans-serif] transition-transform duration-300 ${disableStickyHeader ? 'relative' : 'sticky top-0'}`}
>
  <div class="w-full px-2 md:px-8 flex items-center gap-2 md:gap-10">
    
    {/* --- MOBILE: Hamburger Toggle (Leftmost) --- */}
    <button 
      type="button" 
      class="md:hidden flex flex-col justify-center items-center w-[28px] h-[30px] rounded-[10px] hover:bg-tx-muted/10 transition-colors focus:outline-none gap-[5px] cursor-pointer shrink-0 border-none p-0 -ml-2 text-tx-main" 
      id="mobile-menu-btn" 
      aria-label="Toggle mobile menu"
    >
      {/* Changed w-[16px] to w-[22px] and increased gap slightly to gap-[5px] */}
      <span class="block w-[22px] h-[1.8px] bg-current rounded-sm transition-transform duration-300 origin-center" id="ham-top"></span>
      <span class="block w-[22px] h-[1.8px] bg-current rounded-sm transition-opacity duration-300" id="ham-mid"></span>
      <span class="block w-[22px] h-[1.8px] bg-current rounded-sm transition-transform duration-300 origin-center" id="ham-bot"></span>
    </button>

    {/* Brand / Logo */}
    <a href="/" class="flex flex-col items-start justify-center gap-1 shrink-0 outline-none mr-auto md:mr-0">
      <div class="flex items-center">
        {logo && (
          <>
            {/* Light theme logo */}
            <img src={logo} alt={siteTitle} width="160" height="40" class="h-8 md:h-8 w-auto object-contain dark:hidden" />
            {/* Dark theme logo */}
            <img src={logoDark} alt={siteTitle} width="160" height="40" class="h-8 md:h-8 w-auto object-contain hidden dark:block" />
          </>
        )}
        {!logo && <span class="text-[17px] font-[800] text-tx-main tracking-[-0.5px]">{siteTitle}</span>}
      </div>
    </a>
    
    {/* Desktop Navigation Links */}
    <ul class="hidden md:flex gap-2 list-none m-0 p-0">
      {navItems.map((item, index) => {
        const hasSubItems = item.subItems && item.subItems.length > 0;
        const isLast = index === navItems.length - 1;
        
        return (
          <li class="relative group">
          <a href={item.url || '#'} class="flex items-center px-[12px] py-1.5 rounded-[6px] text-[13.5px] font-[600] text-tx-muted transition-all duration-200 hover:bg-main hover:text-tx-main">
              {item.label}
              {hasSubItems && (
                <svg class="w-4 h-4 ml-1 opacity-60 group-hover:opacity-100 transition-transform duration-200 group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
                </svg>
              )}
            </a>

            {hasSubItems && (
              <div class={`absolute ${isLast ? 'right-0' : 'left-0'} top-full pt-1 w-48 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 transform origin-top translate-y-1 group-hover:translate-y-0 z-[200]`}>
                <div class="py-1 bg-surface rounded-md shadow-sm border border-subtle">
                  {item.subItems.map((subItem: any) => (
                    <a href={subItem.url || '#'} class="block px-4 py-2 text-[14px] text-tx-muted hover:text-tx-main hover:bg-main transition-colors">
                      {subItem.label}
                    </a>
                  ))}
                </div>
              </div>
            )}
          </li>
        );
      })}
    </ul>

    {/* Right Area: Actions */}
    <div class="flex items-center justify-end gap-1 md:gap-4 md:ml-auto md:flex-1">
      
      {/* Search Button */}
      <button id="search-trigger" class="flex items-center justify-center w-[36px] h-[36px] rounded-[10px] text-tx-main hover:bg-tx-muted/10 transition-colors focus:outline-none cursor-pointer shrink-0 md:w-auto md:h-auto md:px-2 md:py-1.5 md:rounded-[8px] md:text-tx-muted md:hover:bg-transparent" aria-label="Search">
        <svg width="16" height="16" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="shrink-0">
          <circle cx="7.5" cy="7.5" r="4.75"></circle>
          <line x1="11" y1="11" x2="16" y2="16"></line>
        </svg>
        <span class="hidden md:block text-[13px] truncate text-left w-full ml-1.5">Search...</span>
      </button>

      {/* Theme Toggle Button (Hidden on Mobile, kept in drawer) */}
      <button class="theme-toggle-btn hidden md:flex p-2 rounded-full text-tx-muted hover:bg-main hover:text-tx-main transition-colors focus:outline-none cursor-pointer" aria-label="Toggle theme">
        <svg class="theme-toggle-dark-icon hidden w-5 h-5 transition-transform duration-300 hover:rotate-12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path></svg>
        <svg class="theme-toggle-light-icon hidden w-5 h-5 transition-transform duration-300 hover:rotate-90" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
      </button>

      {/* --- UNIFIED AUTH SECTION --- */}
      <div class="flex items-center">
        
        {/* Unauthenticated View: Sign In */}
        <div id="auth-signin-header" style="display: none;">
          {primaryBtn.show && (
            <a href={primaryBtn.url} class="ml-1 md:ml-2 flex items-center justify-center h-[28px] px-2 md:px-3 rounded-[7px] bg-[#5ecb6b] text-[#0d0e0c] font-['DM_Sans',sans-serif] text-[12px] md:text-[12.5px] font-[600] tracking-[0.01em] transition-all hover:opacity-85 hover:-translate-y-[1px] active:translate-y-0 cursor-pointer outline-none whitespace-nowrap">
              <span>{primaryBtn.label}</span>
            </a>
          )}
        </div>

        {/* Authenticated View: Avatar */}
        <div id="auth-profile-header" style="display: none;">
          <a href="/account" class="ml-1 md:ml-2 flex items-center justify-center h-[30px] px-2 md:px-2.5 rounded-[7px] bg-transparent text-tx-main font-['DM_Sans',sans-serif] text-[12.5px] font-[600] hover:bg-tx-muted/10 transition-colors outline-none whitespace-nowrap">
            
            {/* The Avatar Icon */}
            <div id="profile-avatar-header" class="w-5 h-5 rounded-full bg-[#5ecb6b] text-[#0d0e0c] flex items-center justify-center font-extrabold text-[10px] shrink-0"></div>
            
            {/* The Account Text */}
            <span class="hidden md:inline ml-2">Profile</span>
          </a>
        </div>
        
      </div>
    </div>

    {/* Mobile Navigation Drawer (Hamburger Menu) */}
    <div id="mobile-menu" class="hidden absolute top-[48px] left-0 w-full bg-main shadow-xl flex-col h-[calc(100dvh-48px)] overflow-y-auto z-[190]">
      <div class="flex flex-col h-full px-6 py-6 w-full max-w-[500px] mx-auto">
        
        {/* Navigation Links */}
        <nav class="flex flex-col gap-2 mb-8 mt-4">
          {navItems.map((item: any) => {
             const hasSubItems = item.subItems && item.subItems.length > 0;
             return (
               <div class="border-b border-subtle group">
                 <div class="flex items-center justify-between">
                   <a href={item.url || '#'} class="text-lg font-[800] tracking-tight text-tx-main hover:opacity-80 transition-opacity flex-1 leading-none">{item.label}</a>
                   {hasSubItems ? (
                     <button class="mobile-submenu-toggle p-2 text-tx-muted focus:outline-none" aria-expanded="false" aria-label="Toggle submenu">
                       <svg class="w-6 h-6 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
                     </button>
                   ) : (
                     <a href={item.url || '#'} class="p-2 text-tx-muted opacity-40 group-hover:opacity-100 transition-opacity" aria-label={`Go to ${item.label}`}>
                       <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M7 7h10v10" /></svg>
                     </a>
                   )}
                 </div>
                 {hasSubItems && (
                   <div class="mobile-submenu hidden flex-col gap-4 pb-6 pt-2 pl-2">
                     {item.subItems.map((subItem: any) => (
                       <a href={subItem.url || '#'} class="text-[18px] font-[500] text-tx-muted hover:text-tx-main transition-colors flex items-center gap-2">
                         <span class="w-1.5 h-1.5 rounded-full bg-blue-500/50"></span>
                         {subItem.label}
                       </a>
                     ))}
                   </div>
                 )}
               </div>
             );
          })}
        </nav>
        
        {/* Bottom Dock (Theme Switcher ONLY) */}
        <div class="mt-auto flex flex-col gap-4 pb-8">
          <button class="theme-toggle-btn flex items-center justify-between w-full py-2 px-1 bg-transparent active:scale-[0.98] transition-all focus:outline-none group mt-2" aria-label="Toggle theme">
            <div class="flex items-center gap-3 text-tx-muted opacity-80 group-hover:opacity-100 transition-opacity">
              <svg class="theme-toggle-light-icon w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
              <svg class="theme-toggle-dark-icon hidden w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path></svg>
              <span class="text-[15px] font-[500]">Appearance</span>
            </div>
            
            {/* iOS style purely CSS driven pill toggle */}
            <div class="relative w-[44px] h-[24px] rounded-full bg-main border border-subtle shrink-0 shadow-inner">
              <div class="absolute left-1 top-1 w-[14px] h-[14px] rounded-full bg-tx-muted shadow-sm transition-all duration-300 ease-spring dark:translate-x-[20px] dark:bg-blue-500"></div>
            </div>
          </button>
        </div>

      </div>
    </div>
  </div>
</header>

{/* Full-Screen Search Overlay Modal */}
<div id="search-modal" class="fixed inset-0 z-[300] bg-surface/95 backdrop-blur-xl opacity-0 invisible transition-all duration-300">
  <div class="absolute inset-0" id="search-modal-backdrop"></div>
  <div id="search-modal-content" class="absolute top-0 left-0 w-full h-full flex flex-col transform -translate-y-8 transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)]">
    
    <div class="w-full max-w-[1000px] mx-auto px-4 md:px-8 pt-6 pb-2 flex justify-end shrink-0">
      <button id="close-search" class="text-[12px] font-['JetBrains_Mono',monospace] bg-main px-3 py-1.5 rounded-full text-tx-muted border border-subtle hover:text-tx-main hover:border-tx-muted transition-all flex items-center gap-2 cursor-pointer outline-none focus:ring-2 focus:ring-blue-500/50">
        <span>ESC</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path></svg>
      </button>
    </div>

    <div class="flex-1 overflow-y-auto custom-scrollbar w-full">
      <div class="w-full max-w-[1000px] mx-auto px-4 md:px-8 pb-20 pt-4 md:pt-10">
        <Search id="site-search" className="pagefind-ui-custom" uiOptions={{ showImages: false }} />
      </div>
    </div>
  </div>
</div>

<style is:global>
  /* Custom Spring Easing for Toggle */
  .ease-spring {
    transition-timing-function: cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  /* OVERRIDE: World-Class Minimalist Search Design */
  .pagefind-ui-custom {
    --pagefind-ui-scale: 1;
    --pagefind-ui-primary: #3b82f6;
    --pagefind-ui-text: var(--color-tx-main);
    --pagefind-ui-background: transparent;
    --pagefind-ui-border: transparent; 
    --pagefind-ui-tag: var(--color-bg-main);
    --pagefind-ui-border-radius: 0px;
    --pagefind-ui-font: 'Outfit', sans-serif;
    width: 100%;
  }

  .pagefind-ui-custom .pagefind-ui__form {
    position: relative;
  }

  /* FIX: Locks the magnifying glass securely inside the input field */
  .pagefind-ui-custom .pagefind-ui__form::before {
    width: 28px;
    height: 28px;
    top: 26px !important; 
    transform: none !important;
    left: 8px;
    opacity: 0.4;
  }

  .pagefind-ui-custom .pagefind-ui__search-input {
    font-family: 'Outfit', sans-serif;
    font-weight: 600;
    font-size: 32px; 
    color: var(--color-tx-main);
    background-color: transparent;
    border: none;
    border-bottom: 2px solid var(--color-border-subtle);
    padding: 24px 24px 24px 50px; 
    border-radius: 0;
    transition: all 0.3s ease;
  }

  @media (max-width: 768px) {
    .pagefind-ui-custom .pagefind-ui__search-input {
      font-size: 20px;
      padding: 16px 16px 16px 40px;
    }
    .pagefind-ui-custom .pagefind-ui__form::before {
      width: 20px;
      height: 20px;
      top: 20px !important;
    }
  }

  .pagefind-ui-custom .pagefind-ui__search-input:focus {
    outline: none;
    border-bottom-color: var(--pagefind-ui-primary);
  }

  .pagefind-ui-custom .pagefind-ui__drawer {
    margin-top: 32px;
  }

  /* Forces layout to cleanly span 100% of the hover area */
  .pagefind-ui-custom .pagefind-ui__result {
    display: block !important; 
    padding: 24px !important;
    border: none !important;
    border-radius: 16px;
    margin-bottom: 8px;
    transition: background-color 0.2s ease;
  }

  .pagefind-ui-custom .pagefind-ui__result:hover {
    background-color: var(--color-bg-main);
  }

  .pagefind-ui-custom .pagefind-ui__result-title { 
    font-weight: 800; 
    font-size: 1.35rem;
    margin-bottom: 8px;
    letter-spacing: -0.01em;
  }

  .pagefind-ui-custom .pagefind-ui__result-link {
    text-decoration: none !important;
  }

  .pagefind-ui-custom .pagefind-ui__result-excerpt { 
    color: var(--color-tx-muted); 
    line-height: 1.6;
    font-size: 1rem;
    font-weight: 400;
    margin: 0;
  }

  .pagefind-ui-custom mark { 
    background-color: rgba(59, 130, 246, 0.15); 
    color: var(--pagefind-ui-primary); 
    font-weight: 600;
    border-radius: 4px; 
    padding: 2px 4px;
  }

  .pagefind-ui-custom .pagefind-ui__message {
    padding: 0 24px 24px 24px;
    font-size: 15px;
    color: var(--color-tx-muted);
    font-weight: 500;
  }

  .pagefind-ui-custom .pagefind-ui__result-inner {
    width: 100% !important;
    margin-top: 0 !important;
  }

  .pagefind-ui-custom .pagefind-ui__results {
    padding: 0 !important;
  }
</style>

<script>
  // Theme Toggle Logic
  const themeToggleBtns = document.querySelectorAll('.theme-toggle-btn');
  const darkIcons = document.querySelectorAll('.theme-toggle-dark-icon');
  const lightIcons = document.querySelectorAll('.theme-toggle-light-icon');

  if (themeToggleBtns.length > 0) {
    // Initial load setup
    if (document.documentElement.classList.contains('dark')) {
      lightIcons.forEach(icon => icon.classList.remove('hidden'));
    } else {
      darkIcons.forEach(icon => icon.classList.remove('hidden'));
    }

    // Click event for all theme buttons
    themeToggleBtns.forEach(btn => {
      btn.addEventListener('click', function() {
        const isCurrentlyDark = document.documentElement.classList.contains('dark');
        
        darkIcons.forEach(icon => icon.classList.toggle('hidden'));
        lightIcons.forEach(icon => icon.classList.toggle('hidden'));

        if (isCurrentlyDark) {
          document.documentElement.classList.remove('dark');
          localStorage.setItem('theme', 'light');
        } else {
          document.documentElement.classList.add('dark');
          localStorage.setItem('theme', 'dark');
        }
      });
    });
  }

  // Search Modal Logic (With Body Scroll Locking)
  const searchTrigger = document.getElementById('search-trigger');
  const searchModal = document.getElementById('search-modal');
  const searchBackdrop = document.getElementById('search-modal-backdrop');
  const searchContent = document.getElementById('search-modal-content');
  const closeSearchBtn = document.getElementById('close-search');

  function openSearch() {
    searchModal.classList.remove('opacity-0', 'invisible');
    searchContent.classList.remove('-translate-y-8');
    searchContent.classList.add('translate-y-0');
    
    document.body.style.overflow = 'hidden';

    setTimeout(() => {
      document.querySelector('.pagefind-ui__search-input')?.focus();
    }, 100);
  }

  function closeSearch() {
    searchModal.classList.add('opacity-0', 'invisible');
    searchContent.classList.remove('translate-y-0');
    searchContent.classList.add('-translate-y-8');
    
    document.body.style.overflow = '';
  }

  searchTrigger?.addEventListener('click', openSearch);
  searchBackdrop?.addEventListener('click', closeSearch);
  closeSearchBtn?.addEventListener('click', closeSearch);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeSearch();
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      openSearch();
    }
  });

  // Mobile Menu Logic
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const topBar = document.getElementById('ham-top');
  const midBar = document.getElementById('ham-mid');
  const botBar = document.getElementById('ham-bot');

  if (btn && menu && topBar && midBar && botBar) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
      menu.classList.toggle('flex');
      
      // Prevent body scroll when menu is open
      if (menu.classList.contains('hidden')) {
        document.body.style.overflow = '';
        topBar.style.transform = '';
        midBar.style.opacity = '1';
        botBar.style.transform = '';
      } else {
        document.body.style.overflow = 'hidden';
        // PERFECT MATH: 7px translation for a 5px gap + 2px line height
        topBar.style.transform = 'translateY(7px) rotate(45deg)';
        midBar.style.opacity = '0';
        botBar.style.transform = 'translateY(-7px) rotate(-45deg)';
      }
    });
  }

  const submenuToggles = document.querySelectorAll('.mobile-submenu-toggle');
  submenuToggles.forEach(toggle => {
    toggle.addEventListener('click', (e) => {
      e.preventDefault();
      const svg = toggle.querySelector('svg');
      const submenu = toggle.closest('div.group')?.querySelector('.mobile-submenu');

      if (submenu && svg) {
        submenu.classList.toggle('hidden');
        submenu.classList.toggle('flex');
        if (submenu.classList.contains('hidden')) {
          svg.style.transform = '';
          toggle.setAttribute('aria-expanded', 'false');
        } else {
          svg.style.transform = 'rotate(180deg)';
          toggle.setAttribute('aria-expanded', 'true');
        }
      }
    });
  });

  // Smart header logic
  const header = document.getElementById('site-header');
  const isStickyDisabled = header?.getAttribute('data-disable-sticky') === 'true'; // 🟢 NEW: Check if disabled
  let lastScrollY = window.scrollY;

  window.addEventListener('scroll', () => {
    if (!header || isStickyDisabled) return; // 🟢 NEW: Abort entirely if disabled
    
    const currentScrollY = window.scrollY;
    
    // Prevent jitter from minor trackpad movements
    if (Math.abs(currentScrollY - lastScrollY) < 5) return;

    // Safely check if modals are closed
    const isMenuClosed = !document.getElementById('mobile-menu')?.classList.contains('flex');
    const isSearchClosed = document.getElementById('search-modal')?.classList.contains('invisible');
    
    if (currentScrollY > 48 && isMenuClosed && isSearchClosed) {
      if (currentScrollY > lastScrollY) {
        // Scrolling down: Hide
        header.classList.add('-translate-y-full');
        document.documentElement.classList.add('header-hidden'); 
      } else {
        // Scrolling up: Show
        header.classList.remove('-translate-y-full');
        document.documentElement.classList.remove('header-hidden'); 
      }
    } else if (currentScrollY <= 48) {
      // At the absolute top: Show
      header.classList.remove('-translate-y-full');
      document.documentElement.classList.remove('header-hidden');
    }
    
    lastScrollY = currentScrollY;
  }, { passive: true });

  // --- Client-side Authentication & Page Tracking Logic ---
  const currentPath = window.location.pathname;
  const isExcluded = currentPath.includes('/signin') || currentPath.includes('/account');
  const userJson = localStorage.getItem('serplora_user');

  if (!isExcluded) {
    let cleanTitle = document.title.split('-')[0].trim();
    if (!cleanTitle || cleanTitle === '') cleanTitle = 'Home';
    
    let history = JSON.parse(localStorage.getItem('serplora_recent_pages') || '[]');
    
    // Update local immediately for snappy UI
    history = history.filter((p: any) => p.url !== currentPath);
    history.unshift({ url: currentPath, title: cleanTitle });
    if (history.length > 10) history = history.slice(0, 10);
    localStorage.setItem('serplora_recent_pages', JSON.stringify(history));

    // If logged in, sync this visit to the database!
    if (userJson) {
      fetch('/api/sync-history', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ url: currentPath, title: cleanTitle })
      }).catch(err => console.error('Failed to sync history', err));
    }
  }

  // --- REVISED AUTHENTICATION RENDER LOGIC ---
  const signinHeader = document.getElementById('auth-signin-header');
  const profileHeader = document.getElementById('auth-profile-header');

  if (userJson) {
    const user = JSON.parse(userJson);
    const avatarEl = document.getElementById('profile-avatar-header');
    
    if (avatarEl && user.name) {
       avatarEl.textContent = user.name.charAt(0).toUpperCase();
    }

    if (signinHeader) signinHeader.style.display = 'none';
    if (profileHeader) profileHeader.style.display = 'flex';
  } else {
    if (signinHeader) signinHeader.style.display = 'block';
    if (profileHeader) profileHeader.style.display = 'none';
  }
</script>