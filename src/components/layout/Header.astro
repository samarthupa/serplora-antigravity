---
import { getEntry } from 'astro:content';

// 🟢 Define Props
interface Props {
  disableStickyHeader?: boolean;
}

const { disableStickyHeader = false } = Astro.props;

const headerEntry = await getEntry('header', 'data');
const siteTitle = headerEntry?.data?.siteTitle || 'Serplora';
const logo = headerEntry?.data?.logo;
const logoDark = headerEntry?.data?.logoDark || logo;
const navItems = headerEntry?.data?.navItems || [];

const primaryBtn = {
  label: headerEntry?.data?.primaryButton?.label || 'Sign up for free',
  show: headerEntry?.data?.primaryButton?.show !== false
};
---

<!-- 🟢 INSTANT PAINT SCRIPT (Prevents Sign-In button layout shift before HTML loads) -->
<script is:inline>
  try {
    if (localStorage.getItem('auth_valid') === 'true') {
      document.documentElement.classList.add('is-auth');
    }
  } catch(e) {}
</script>

<style>
  /* 🟢 CSS TOGGLE LOGIC */
  #auth-signin-header { display: block; }
  #auth-profile-header { display: none; }
  
  html.is-auth #auth-signin-header { display: none !important; }
  html.is-auth #auth-profile-header { display: flex !important; }

  /* 🟢 DESKTOP DROPDOWN LOGIC */
  .desktop-dropdown {
    visibility: hidden;
    opacity: 0;
    transform: translateY(4px);
    transition: all 0.2s ease;
    pointer-events: none;
  }
  .group:hover .desktop-dropdown {
    visibility: visible;
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
</style>

<header 
  id="site-header" 
  data-disable-sticky={disableStickyHeader ? "true" : "false"}
  class={`inset-x-0 w-full z-[200] h-[58px] bg-main/95 backdrop-blur-[12px] shadow-sm border-b border-transparent dark:border-white/6 flex items-center font-sans transition-transform duration-300 ${disableStickyHeader ? 'relative' : 'sticky top-0'}`}
>
  <!-- 🟢 Standard Flex Layout with justify-between for perfect gap distribution -->
  <div class="w-full h-full px-3 md:px-6 flex items-center justify-between max-w-[1400px] mx-auto">
    
    <!-- 1. LEFT: Hamburger (Mobile) + Logo -->
    <div class="flex items-center gap-2 md:gap-4">
      <!-- Hamburger Menu Icon (Mobile Only) -->
      <button
        type="button"
        class="md:hidden relative z-[210] flex justify-center items-center w-[30px] h-[30px] rounded-[10px] transition-colors focus:outline-none cursor-pointer shrink-0 border-none p-0 text-tx-main hover:bg-tx-muted/10"
        id="mobile-menu-btn"
        aria-label="Toggle navigation menu"
      >
        <svg id="icon-hamburger" class="w-[24px] h-[24px] fill-current transition-transform duration-200 active:scale-95" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <rect x="2" y="5" width="20" height="2" rx="1" />
          <rect x="2" y="11" width="20" height="2" rx="1" />
          <rect x="2" y="17" width="20" height="2" rx="1" />
        </svg>
        <svg id="icon-close" class="hidden w-[24px] h-[24px] transition-transform duration-200 active:scale-95" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

      <a href="/" class="flex flex-col items-start justify-center gap-1 shrink-0 outline-none focus-visible:ring-2 focus-visible:ring-tx-muted rounded">
        <div class="flex items-center">
          {logo && (
            <>
              <img src={logo} alt={siteTitle} width="110" height="38" class="h-9 md:h-9 w-auto object-contain dark:hidden" />
              <img src={logoDark} alt={siteTitle} width="110" height="38" class="h-9 md:h-9 w-auto object-contain hidden dark:block" />
            </>
          )}
          {!logo && <span class="text-[18px] md:text-[20px] font-[800] text-tx-main tracking-[-0.5px]">{siteTitle}</span>}
        </div>
      </a>
    </div>

    <!-- 2. MIDDLE: Desktop Navigation -->
    <nav class="hidden md:flex items-center justify-center gap-2 lg:gap-4">
      {navItems.map((item: any) => {
        const hasSubItems = item.subItems && item.subItems.length > 0;
        return (
          <div class="relative group h-full flex items-center">
            <a href={item.url || '#'} class="flex items-center gap-1.5 px-3 py-2 text-[14px] font-[600] text-tx-muted hover:text-tx-main transition-colors rounded-md hover:bg-tx-muted/5 outline-none focus-visible:ring-2 focus-visible:ring-tx-muted">
              {item.label}
              {hasSubItems && (
                <svg class="w-3.5 h-3.5 opacity-70 transition-transform group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
              )}
            </a>

            {/* Desktop Submenu Dropdown */}
            {hasSubItems && (
              <div class="desktop-dropdown absolute top-[40px] left-1/2 -translate-x-1/2 flex flex-col w-[200px] bg-main border border-subtle/15 rounded-xl shadow-lg py-2 z-[250]">
                {item.subItems.map((subItem: any) => (
                  <a href={subItem.url || '#'} class="block px-4 py-2.5 text-[14px] font-[500] text-tx-muted hover:text-tx-main hover:bg-tx-muted/5 transition-colors">
                    {subItem.label}
                  </a>
                ))}
              </div>
            )}
          </div>
        );
      })}
    </nav>

    <!-- 3. RIGHT: Search, Theme, Auth -->
    <div class="flex items-center justify-end gap-1.5 md:gap-3">
      
      <!-- Search Icon Link -->
      <a href="/search" class="flex items-center justify-center w-[36px] h-[36px] md:w-[32px] md:h-[32px] rounded-full text-tx-muted hover:bg-tx-muted/10 hover:text-tx-main transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-tx-muted cursor-pointer shrink-0" aria-label="Search">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="7.5" cy="7.5" r="4.75"></circle>
          <line x1="11" y1="11" x2="16" y2="16"></line>
        </svg>
      </a>

      <!-- Theme Toggle (Hidden on Mobile) -->
      <button class="theme-toggle-btn hidden md:flex items-center justify-center w-[32px] h-[32px] rounded-full text-tx-muted hover:bg-tx-muted/10 hover:text-tx-main transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-tx-muted cursor-pointer" aria-label="Toggle theme">
        <svg class="block dark:hidden w-5 h-5 transition-transform duration-300 hover:rotate-12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path></svg>
        <svg class="hidden dark:block w-5 h-5 transition-transform duration-300 hover:rotate-90" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
      </button>

      <!-- AUTH SLOT CONTAINER -->
      <div class="flex items-center">
        
        <div id="auth-signin-header">
          {primaryBtn.show && (
            <button id="dynamic-signin-btn" type="button" class="ml-1 md:ml-3 flex items-center justify-center h-[30px] px-3 md:px-4 rounded-[8px] bg-cta text-cta-text text-[13px] md:text-[14px] font-[700] tracking-tight transition-all shadow-sm hover:shadow-md hover:bg-cta-hover hover:-translate-y-[1px] active:translate-y-0 cursor-pointer focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-cta outline-none whitespace-nowrap">
              <span>{primaryBtn.label}</span>
            </button>
          )}
        </div>

        <div id="auth-profile-header" class="items-center">
          <a href="/account" class="ml-1 md:ml-3 flex items-center justify-center gap-2 px-1.5 py-1 rounded-[8px] bg-transparent hover:bg-tx-muted/10 transition-colors focus-visible:ring-2 focus-visible:ring-offset-2 outline-none whitespace-nowrap">
            <!-- 🟢 Profile Icon fixed (flexible padding instead of fixed height) -->
            <img id="profile-avatar-img-header" src="" alt="Profile" class="w-8 h-8 rounded-full object-cover shrink-0 hidden border border-subtle/20" />
            
            <div id="profile-avatar-header" class="w-8 h-8 rounded-full bg-cta text-cta-text flex items-center justify-center font-extrabold text-[13px] shrink-0 border border-subtle/10">
              <svg id="profile-avatar-fallback-icon" class="w-4 h-4 opacity-50" fill="currentColor" viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
            </div>
            
            <span class="hidden md:inline pr-1 text-[14px] font-[600] text-tx-main">Profile</span>
          </a>
        </div>

      </div>
    </div>
  </div>
</header>


<!-- 🟢 Navigation Dropdown (Mobile Only) - Dropdown Style -->
<div 
  id="mobile-menu" 
  class="hidden md:!hidden absolute top-[58px] left-0 w-full bg-main flex-col h-[calc(100dvh-58px)] overflow-y-auto z-[190] border-t border-subtle/15 opacity-0 -translate-y-1.5 transition-[opacity,transform] duration-250 ease-out"
>
  <div class="flex flex-col h-full w-full mx-auto px-3 py-4">
    
    <!-- Accordion Navigation Area -->
    <div class="flex flex-col gap-1 flex-1">
      {navItems.map((item: any, index: number) => {
        const hasSubItems = item.subItems && item.subItems.length > 0;
        
        return (
          <div class="accordion-item w-full">
            {hasSubItems ? (
              <button
                type="button"
                data-target={`accordion-content-${index}`}
                class="accordion-btn flex items-center justify-between w-full text-left px-3 py-3 rounded-[8px] font-[600] text-[15px] text-tx-main hover:bg-tx-muted/5 transition-colors focus:outline-none"
              >
                <span>{item.label}</span>
                <svg class="accordion-arrow w-4 h-4 shrink-0 text-tx-muted transition-transform duration-200" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
            ) : (
              <a
                href={item.url || '#'}
                class="flex items-center justify-between w-full text-left px-3 py-3 rounded-[8px] font-[600] text-[15px] text-tx-main hover:bg-tx-muted/5 transition-colors focus:outline-none"
              >
                <span>{item.label}</span>
              </a>
            )}

            {/* Submenu Inline Content */}
            {hasSubItems && (
              <div id={`accordion-content-${index}`} class="accordion-content hidden flex-col pl-4 pr-2 py-1 mt-1 border-l-2 border-subtle/10 ml-4 gap-1">
                {item.subItems.map((subItem: any) => (
                  <a href={subItem.url || '#'} class="block px-3 py-2 text-[14px] font-[500] text-tx-muted hover:text-tx-main hover:bg-tx-muted/5 rounded-md transition-colors">
                    {subItem.label}
                  </a>
                ))}
                <a href={item.url || '#'} class="block px-3 py-2 mt-1 text-[14px] font-[600] text-cta hover:opacity-80 transition-opacity">
                  View all {item.label} &rarr;
                </a>
              </div>
            )}
          </div>
        );
      })}
    </div>

    <!-- Bottom Section (Theme Toggle) -->
    <div class="mt-auto pt-6 pb-8 w-full">
      <button class="theme-toggle-btn group flex items-center justify-between w-full px-4 py-3.5 rounded-[8px] bg-tx-muted/5 border border-subtle/10 text-tx-main hover:bg-tx-muted/10 transition-colors focus:outline-none cursor-pointer">
        <!-- Dynamic Text based on active theme -->
        <span class="font-[600] text-[14px] block dark:hidden">Dark Theme</span>
        <span class="font-[600] text-[14px] hidden dark:block">Light Theme</span>
        
        <div class="flex items-center justify-center">
          <svg class="block dark:hidden w-5 h-5 text-tx-muted transition-transform duration-300 group-hover:rotate-12 group-hover:text-tx-main" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path></svg>
          <svg class="hidden dark:block w-5 h-5 text-tx-muted transition-transform duration-300 group-hover:rotate-90 group-hover:text-tx-main" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
        </div>
      </button>
    </div>

  </div>
</div>

<!-- 🟢 INSTANT PROFILE RENDER SCRIPT (Prevents avatar flash) -->
<script is:inline>
  try {
    if (localStorage.getItem('auth_valid') === 'true') {
      const avatarUrl = localStorage.getItem('auth_avatar');
      const initialStr = localStorage.getItem('auth_initial');
      
      if (avatarUrl) {
        const img = document.getElementById('profile-avatar-img-header');
        const fallback = document.getElementById('profile-avatar-header');
        const fallbackIcon = document.getElementById('profile-avatar-fallback-icon');
        if (img && fallback) {
          img.src = avatarUrl;
          img.classList.remove('hidden');
          fallback.classList.add('hidden');
          if (fallbackIcon) fallbackIcon.remove();
        }
      } else if (initialStr) {
        const fallback = document.getElementById('profile-avatar-header');
        const fallbackIcon = document.getElementById('profile-avatar-fallback-icon');
        if (fallback) {
          fallback.textContent = initialStr;
          if (fallbackIcon) fallbackIcon.remove();
        }
      }
    }
  } catch(e) {}
</script>

<script>
  // 🟢 BACKGROUND SYNC LOGIC
  import { authClient } from '../../lib/auth-client';
  
  async function syncAuth() {
    try {
      const { data } = await authClient.getSession();
      const avatarImgEl = document.getElementById('profile-avatar-img-header') as HTMLImageElement;
      const avatarFallbackEl = document.getElementById('profile-avatar-header');
      const fallbackIconEl = document.getElementById('profile-avatar-fallback-icon');

      if (data && data.user) {
        const user = data.user as any;
        const initial = user.name ? user.name : user.email;
        const initialChar = initial.charAt(0).toUpperCase();

        try { 
          localStorage.setItem('auth_valid', 'true'); 
          if (user.image) {
            localStorage.setItem('auth_avatar', user.image);
          } else {
            localStorage.setItem('auth_initial', initialChar);
          }
        } catch(e) {}
        
        document.documentElement.classList.add('is-auth');

        if (user.image && avatarImgEl) {
           avatarImgEl.src = user.image;
           avatarImgEl.classList.remove('hidden');
           if (avatarFallbackEl) avatarFallbackEl.classList.add('hidden');
           if (fallbackIconEl) fallbackIconEl.remove();
        } else if (avatarFallbackEl) {
           avatarFallbackEl.textContent = initialChar;
           avatarFallbackEl.classList.remove('hidden');
           if (avatarImgEl) avatarImgEl.classList.add('hidden');
           if (fallbackIconEl) fallbackIconEl.remove(); 
        }
      } else {
        try { 
          localStorage.removeItem('auth_valid'); 
          localStorage.removeItem('auth_avatar');
          localStorage.removeItem('auth_initial');
        } catch(e) {}
        document.documentElement.classList.remove('is-auth');
      }
    } catch(e) {
      try { 
        localStorage.removeItem('auth_valid'); 
        localStorage.removeItem('auth_avatar');
        localStorage.removeItem('auth_initial');
      } catch(e) {}
      document.documentElement.classList.remove('is-auth');
    }
  }
  
  syncAuth();

  // --- THEME TOGGLE LOGIC ---
  const themeToggleBtns = document.querySelectorAll('.theme-toggle-btn');
  if (themeToggleBtns.length > 0) {
    themeToggleBtns.forEach(btn => {
      btn.addEventListener('click', function() {
        const isCurrentlyDark = document.documentElement.classList.contains('dark');
        if (isCurrentlyDark) {
          document.documentElement.classList.remove('dark');
          try { localStorage.setItem('theme', 'light'); } catch (e) {}
        } else {
          document.documentElement.classList.add('dark');
          try { localStorage.setItem('theme', 'dark'); } catch (e) {}
        }
      });
    });
  }

  // --- KEYBOARD SEARCH SHORTCUT ---
  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      window.location.href = '/search';
    }
  });

  // --- MOBILE SIDEBAR (DROP DOWN) OPEN/CLOSE LOGIC ---
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconHamburger = document.getElementById('icon-hamburger');
  const iconClose = document.getElementById('icon-close');

  function openMobileMenu() {
    if (!mobileMenu || !mobileMenuBtn) return;
    
    mobileMenu.classList.remove('hidden');
    mobileMenu.classList.add('flex');
    void mobileMenu.offsetWidth; // Force reflow
    
    mobileMenu.classList.remove('opacity-0', '-translate-y-1.5');
    document.body.style.overflow = 'hidden';
    
    // Toggle Icons
    iconHamburger?.classList.add('hidden');
    iconClose?.classList.remove('hidden');
  }

  function closeMobileMenu() {
    if (!mobileMenu || !mobileMenuBtn) return;
    
    mobileMenu.classList.add('opacity-0', '-translate-y-1.5');
    document.body.style.overflow = '';
    
    // Toggle Icons
    iconClose?.classList.add('hidden');
    iconHamburger?.classList.remove('hidden');

    window.setTimeout(() => {
      mobileMenu.classList.add('hidden');
      mobileMenu.classList.remove('flex');
    }, 250);
  }

  mobileMenuBtn?.addEventListener('click', () => {
    const isOpen = !mobileMenu?.classList.contains('hidden') && !mobileMenu?.classList.contains('opacity-0');
    if (isOpen) {
      closeMobileMenu();
    } else {
      openMobileMenu();
    }
  });

  // --- ACCORDION SUBMENU LOGIC ---
  const accordionBtns = document.querySelectorAll('.accordion-btn');
  const accordionContents = document.querySelectorAll('.accordion-content');
  const accordionArrows = document.querySelectorAll('.accordion-arrow');

  accordionBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const targetId = btn.getAttribute('data-target');
      const targetContent = document.getElementById(targetId || '');
      const arrow = btn.querySelector('.accordion-arrow');
      
      const isOpen = targetContent?.classList.contains('flex');

      // Close all submenus first
      accordionContents.forEach(content => {
        content.classList.remove('flex');
        content.classList.add('hidden');
      });
      accordionArrows.forEach(arr => {
        arr.classList.remove('-rotate-180');
      });
      accordionBtns.forEach(b => {
        b.classList.remove('bg-tx-muted/5', 'text-tx-main');
        b.classList.add('text-tx-main');
      });

      // If it wasn't open, open it
      if (!isOpen && targetContent) {
        targetContent.classList.remove('hidden');
        targetContent.classList.add('flex');
        arrow?.classList.add('-rotate-180');
        btn.classList.add('bg-tx-muted/5');
      }
    });
  });

  // --- DYNAMIC SIGN-IN ROUTING ---
  const dynamicSigninBtn = document.getElementById('dynamic-signin-btn');
  if (dynamicSigninBtn) {
    dynamicSigninBtn.addEventListener('click', () => {
      const currentPath = window.location.pathname + window.location.search;
      window.location.href = `/login?returnUrl=${encodeURIComponent(currentPath)}`;
    });
  }
</script>