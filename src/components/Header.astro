---
import { getEntry } from 'astro:content';

const headerEntry = await getEntry('header', 'data');
const siteTitle = headerEntry?.data?.siteTitle || 'Serplora';
const logo = headerEntry?.data?.logo;
const navItems = headerEntry?.data?.navItems || [];

// Fallback logic for new fields that might not exist in the old JSON yet
const primaryBtn = {
  label: headerEntry?.data?.primaryButton?.label || 'Sign up free',
  url: headerEntry?.data?.primaryButton?.url || '#',
  show: headerEntry?.data?.primaryButton?.show !== false
};
const secondaryBtn = {
  label: headerEntry?.data?.secondaryButton?.label || 'Log in',
  url: headerEntry?.data?.secondaryButton?.url || '#',
  show: headerEntry?.data?.secondaryButton?.show !== false
};
---

<header id="site-header" class="sticky top-0 z-[200] h-[64px] bg-white/95 backdrop-blur-[8px] border-b border-[#e2e8f0] flex items-center font-['Outfit',sans-serif] transition-transform duration-300">
  <div class="max-w-[1200px] mx-auto px-8 w-full flex items-center gap-10">
    
    {/* Brand / Logo */}
    <a href="/" class="text-[20px] font-[800] text-[#0f172a] tracking-[-0.5px] shrink-0 outline-none flex items-center gap-2">
      {logo && <img src={logo} alt={siteTitle} class="h-8 w-auto object-contain" />}
      {!logo && <>{siteTitle}<span class="text-[#3b82f6]">.</span></>}
    </a>

    {/* Desktop Navigation Links */}
    <ul class="hidden md:flex gap-2 list-none m-0 p-0">
      {navItems.map((item, index) => {
        const hasSubItems = item.subItems && item.subItems.length > 0;
        const isLast = index === navItems.length - 1;
        
        return (
          <li class="relative group">
            <a 
              href={item.url || '#'} 
              class="flex items-center px-[14px] py-2 rounded-[6px] text-[15px] font-[600] text-[#64748b] transition-all duration-200 hover:bg-[#f4f6f8] hover:text-[#0f172a]"
            >
              {item.label}
              {hasSubItems && (
                <svg class="w-4 h-4 ml-1 opacity-60 group-hover:opacity-100 transition-transform duration-200 group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
                </svg>
              )}
            </a>
            
            {/* Dropdown Menu Container */}
            {hasSubItems && (
              <div class={`absolute ${isLast ? 'right-0' : 'left-0'} top-full pt-1 w-48 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 transform origin-top translate-y-1 group-hover:translate-y-0 z-[200]`}>
                <div class="py-1 bg-white rounded-md shadow-sm border border-gray-100">
                  {item.subItems.map((subItem) => (
                     <a 
                      href={subItem.url || '#'} 
                      class="block px-4 py-2 text-[14px] text-gray-600 hover:text-gray-900 hover:bg-gray-50 transition-colors"
                    >
                      {subItem.label}
                    </a>
                  ))}
                </div>
              </div>
            )}
          </li>
        );
      })}
    </ul>

    {/* Right Area: Buttons */}
    <div class="ml-auto hidden md:flex items-center gap-3">
      {secondaryBtn.show && (
        <a href={secondaryBtn.url} class="px-5 py-[10px] rounded-[6px] text-[15px] font-[600] text-[#0f172a] bg-transparent hover:bg-[#f4f6f8] transition-colors cursor-pointer border-none outline-none leading-none">
          {secondaryBtn.label}
        </a>
      )}
      {primaryBtn.show && (
        <a href={primaryBtn.url} class="px-6 py-[10px] rounded-[6px] bg-[#10162f] text-white text-[15px] font-[600] transition-colors hover:bg-[#3b82f6] cursor-pointer border-none outline-none leading-none">
          {primaryBtn.label}
        </a>
      )}
    </div>

    {/* Mobile Hamburger Toggle Button */}
    <div class="md:hidden ml-auto flex flex-col justify-center items-center w-8 h-8 focus:outline-none gap-[5px] cursor-pointer" id="mobile-menu-btn" aria-label="Toggle menu">
      <span class="block w-6 h-[2.5px] bg-[#0f172a] rounded-sm transition-transform duration-300 origin-center" id="ham-top"></span>
      <span class="block w-6 h-[2.5px] bg-[#0f172a] rounded-sm transition-opacity duration-300" id="ham-mid"></span>
      <span class="block w-6 h-[2.5px] bg-[#0f172a] rounded-sm transition-transform duration-300 origin-center" id="ham-bot"></span>
    </div>

    {/* Mobile Navigation Drawer */}
    <div id="mobile-menu" class="hidden absolute top-[64px] left-0 w-full bg-white border-b border-[#e2e8f0] shadow-md flex-col max-h-[calc(100vh-64px)] overflow-y-auto z-[190]">
      <ul class="flex flex-col list-none m-0 px-6 py-4 gap-2">
        {navItems.map((item) => {
           const hasSubItems = item.subItems && item.subItems.length > 0;
           return (
             <li>
               <div class="flex items-center justify-between border-b border-gray-100">
                 <a href={item.url || '#'} class="py-3 text-[16px] font-[500] text-gray-800 flex-1">
                   {item.label}
                 </a>
                 {hasSubItems && (
                   <button class="mobile-submenu-toggle p-3 -mr-3 text-gray-400 focus:outline-none" aria-expanded="false" aria-label="Toggle submenu">
                     <svg class="w-4 h-4 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                       <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 9l-7 7-7-7" />
                     </svg>
                   </button>
                 )}
               </div>
               {hasSubItems && (
                 <ul class="mobile-submenu hidden pl-4 py-1 space-y-1 mt-1 mb-2">
                   {item.subItems.map((subItem) => (
                     <li>
                       <a href={subItem.url || '#'} class="block py-2 text-[14px] text-gray-500 hover:text-gray-900">
                         {subItem.label}
                       </a>
                     </li>
                   ))}
                 </ul>
               )}
             </li>
           );
        })}
      </ul>
      <div class="flex flex-col gap-3 px-6 pb-6 pt-2">
        {secondaryBtn.show && (
          <a href={secondaryBtn.url} class="text-center px-5 py-3 rounded-[6px] text-[15px] font-[600] text-[#0f172a] bg-[#f4f6f8] active:bg-gray-200 transition-colors">
            {secondaryBtn.label}
          </a>
        )}
        {primaryBtn.show && (
          <a href={primaryBtn.url} class="text-center px-6 py-3 rounded-[6px] bg-[#10162f] text-white text-[15px] font-[600] transition-colors active:bg-[#3b82f6]">
            {primaryBtn.label}
          </a>
        )}
      </div>
    </div>

  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const topBar = document.getElementById('ham-top');
  const midBar = document.getElementById('ham-mid');
  const botBar = document.getElementById('ham-bot');

  if (btn && menu) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
      menu.classList.toggle('flex');
      
      // Animate hamburger to X
      if (menu.classList.contains('hidden')) {
        topBar.style.transform = '';
        midBar.style.opacity = '1';
        botBar.style.transform = '';
      } else {
        topBar.style.transform = 'translateY(7.5px) rotate(45deg)';
        midBar.style.opacity = '0';
        botBar.style.transform = 'translateY(-7.5px) rotate(-45deg)';
      }
    });
  }

  // Mobile submenu toggles
  const submenuToggles = document.querySelectorAll('.mobile-submenu-toggle');
  submenuToggles.forEach(toggle => {
    toggle.addEventListener('click', (e) => {
      e.preventDefault();
      const svg = toggle.querySelector('svg');
      const submenu = toggle.closest('li')?.querySelector('.mobile-submenu');
      if (submenu && svg) {
        submenu.classList.toggle('hidden');
        if (submenu.classList.contains('hidden')) {
          svg.style.transform = '';
          toggle.setAttribute('aria-expanded', 'false');
        } else {
          svg.style.transform = 'rotate(180deg)';
          toggle.setAttribute('aria-expanded', 'true');
        }
      }
    });
  });

  // Smart header logic
  const header = document.getElementById('site-header');
  let lastScrollY = window.scrollY;

  window.addEventListener('scroll', () => {
    if (!header) return;
    const currentScrollY = window.scrollY;
    
    if (currentScrollY > 64) {
      if (currentScrollY > lastScrollY && menu?.classList.contains('hidden')) {
        // Scrolling down and mobile menu is fully closed -> hide header
        header.classList.add('-translate-y-full');
      } else {
        // Scrolling up -> show header
        header.classList.remove('-translate-y-full');
      }
    } else {
      // Near top of page -> show header
      header.classList.remove('-translate-y-full');
    }
    
    lastScrollY = currentScrollY;
  }, { passive: true });
</script>
