---
import { getEntry } from 'astro:content';

const headerEntry = await getEntry('header', 'data');
const siteTitle = headerEntry?.data?.siteTitle || 'Serplora';
const logo = headerEntry?.data?.logo;
const navItems = headerEntry?.data?.navItems || [];

const primaryBtn = {
  label: headerEntry?.data?.primaryButton?.label || 'Sign up for free',
  url: headerEntry?.data?.primaryButton?.url || '#',
  show: headerEntry?.data?.primaryButton?.show !== false
};
---

<header id="site-header" class="sticky top-0 z-[200] h-[64px] bg-surface/95 backdrop-blur-[8px] border-b border-subtle flex items-center font-['Outfit',sans-serif] transition-transform duration-300">
  <div class="max-w-[1200px] mx-auto px-4 w-full flex items-center gap-10">
    
    {/* Brand / Logo */}
    <a href="/" class="text-[20px] font-[800] text-tx-main tracking-[-0.5px] shrink-0 outline-none flex items-center gap-2">
      {logo && <img src={logo} alt={siteTitle} class="h-10 w-auto object-contain" />}
      {!logo && <>{siteTitle}<span class="text-blue-500">.</span></>}
    </a>

    {/* Desktop Navigation Links */}
    <ul class="hidden md:flex gap-2 list-none m-0 p-0">
      {navItems.map((item, index) => {
        const hasSubItems = item.subItems && item.subItems.length > 0;
        const isLast = index === navItems.length - 1;
        
        return (
          <li class="relative group">
            <a href={item.url || '#'} class="flex items-center px-[14px] py-2 rounded-[6px] text-[15px] font-[600] text-tx-muted transition-all duration-200 hover:bg-main hover:text-tx-main">
              {item.label}
              {hasSubItems && (
                <svg class="w-4 h-4 ml-1 opacity-60 group-hover:opacity-100 transition-transform duration-200 group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
                </svg>
              )}
            </a>
            
            {hasSubItems && (
              <div class={`absolute ${isLast ? 'right-0' : 'left-0'} top-full pt-1 w-48 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 transform origin-top translate-y-1 group-hover:translate-y-0 z-[200]`}>
                <div class="py-1 bg-surface rounded-md shadow-sm border border-subtle">
                  {item.subItems.map((subItem) => (
                     <a href={subItem.url || '#'} class="block px-4 py-2 text-[14px] text-tx-muted hover:text-tx-main hover:bg-main transition-colors">
                      {subItem.label}
                    </a>
                  ))}
                </div>
              </div>
            )}
          </li>
        );
      })}
    </ul>

    {/* Right Area: Actions (Toggle, Buttons, Mobile Menu) */}
    <div class="ml-auto flex items-center gap-3 md:gap-4">
      
      {/* Theme Toggle Button */}
      <button id="theme-toggle" class="p-2 rounded-full text-tx-muted hover:bg-main hover:text-tx-main transition-colors focus:outline-none cursor-pointer" aria-label="Toggle theme">
    
    <svg id="theme-toggle-dark-icon" class="hidden w-5 h-5 transition-transform duration-300 hover:rotate-12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
    </svg>
    
    <svg id="theme-toggle-light-icon" class="hidden w-5 h-5 transition-transform duration-300 hover:rotate-90" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
    </svg>
    
  </button>

      {/* Desktop Main Button */}
      <div class="hidden md:block">
        {primaryBtn.show && (
          <a href={primaryBtn.url} class="px-6 py-[10px] rounded-[6px] bg-tx-main text-main text-[15px] font-[600] transition-opacity hover:opacity-80 cursor-pointer border-none outline-none leading-none">
            {primaryBtn.label}
          </a>
        )}
      </div>

      {/* Mobile Hamburger Toggle */}
      <div class="md:hidden flex flex-col justify-center items-center w-8 h-8 focus:outline-none gap-[5px] cursor-pointer" id="mobile-menu-btn" aria-label="Toggle menu">
        <span class="block w-6 h-[2.5px] bg-tx-main rounded-sm transition-transform duration-300 origin-center" id="ham-top"></span>
        <span class="block w-6 h-[2.5px] bg-tx-main rounded-sm transition-opacity duration-300" id="ham-mid"></span>
        <span class="block w-6 h-[2.5px] bg-tx-main rounded-sm transition-transform duration-300 origin-center" id="ham-bot"></span>
      </div>
    </div>

    {/* Mobile Navigation Drawer */}
    <div id="mobile-menu" class="hidden absolute top-[64px] left-0 w-full bg-surface border-b border-subtle shadow-md flex-col max-h-[calc(100vh-64px)] overflow-y-auto z-[190]">
      <ul class="flex flex-col list-none m-0 px-6 py-4 gap-2">
        {navItems.map((item) => {
           const hasSubItems = item.subItems && item.subItems.length > 0;
           return (
             <li>
               <div class="flex items-center justify-between border-b border-subtle">
                 <a href={item.url || '#'} class="py-3 text-[16px] font-[500] text-tx-main flex-1">
                   {item.label}
                 </a>
                 {hasSubItems && (
                   <button class="mobile-submenu-toggle p-3 -mr-3 text-tx-muted focus:outline-none" aria-expanded="false" aria-label="Toggle submenu">
                     <svg class="w-4 h-4 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                       <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 9l-7 7-7-7" />
                     </svg>
                   </button>
                 )}
               </div>
               {hasSubItems && (
                 <ul class="mobile-submenu hidden pl-4 py-1 space-y-1 mt-1 mb-2">
                   {item.subItems.map((subItem) => (
                     <li>
                       <a href={subItem.url || '#'} class="block py-2 text-[14px] text-tx-muted hover:text-tx-main">
                         {subItem.label}
                       </a>
                     </li>
                   ))}
                 </ul>
               )}
             </li>
           );
        })}
      </ul>
      <div class="flex flex-col gap-3 px-6 pb-6 pt-2">
        {primaryBtn.show && (
          <a href={primaryBtn.url} class="text-center px-6 py-3 rounded-[6px] bg-tx-main text-main text-[15px] font-[600] transition-opacity active:opacity-80">
            {primaryBtn.label}
          </a>
        )}
      </div>
    </div>

  </div>
</header>

<script>
  // Theme Toggle Logic
  const themeToggleBtn = document.getElementById('theme-toggle');
  const darkIcon = document.getElementById('theme-toggle-dark-icon');
  const lightIcon = document.getElementById('theme-toggle-light-icon');

  if (themeToggleBtn && darkIcon && lightIcon) {
    if (document.documentElement.classList.contains('dark')) {
      lightIcon.classList.remove('hidden');
    } else {
      darkIcon.classList.remove('hidden');
    }

    themeToggleBtn.addEventListener('click', function() {
      darkIcon.classList.toggle('hidden');
      lightIcon.classList.toggle('hidden');

      if (document.documentElement.classList.contains('dark')) {
        document.documentElement.classList.remove('dark');
        localStorage.setItem('theme', 'light');
      } else {
        document.documentElement.classList.add('dark');
        localStorage.setItem('theme', 'dark');
      }
    });
  }

  // Mobile Menu Logic
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const topBar = document.getElementById('ham-top');
  const midBar = document.getElementById('ham-mid');
  const botBar = document.getElementById('ham-bot');

  if (btn && menu && topBar && midBar && botBar) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
      menu.classList.toggle('flex');
      
      if (menu.classList.contains('hidden')) {
        topBar.style.transform = '';
        midBar.style.opacity = '1';
        botBar.style.transform = '';
      } else {
        topBar.style.transform = 'translateY(7.5px) rotate(45deg)';
        midBar.style.opacity = '0';
        botBar.style.transform = 'translateY(-7.5px) rotate(-45deg)';
      }
    });
  }

  // Mobile submenu toggles
  const submenuToggles = document.querySelectorAll('.mobile-submenu-toggle');
  submenuToggles.forEach(toggle => {
    toggle.addEventListener('click', (e) => {
      e.preventDefault();
      const svg = toggle.querySelector('svg');
      const submenu = toggle.closest('li')?.querySelector('.mobile-submenu');
      if (submenu && svg) {
        submenu.classList.toggle('hidden');
        if (submenu.classList.contains('hidden')) {
          svg.style.transform = '';
          toggle.setAttribute('aria-expanded', 'false');
        } else {
          svg.style.transform = 'rotate(180deg)';
          toggle.setAttribute('aria-expanded', 'true');
        }
      }
    });
  });

  // Smart header logic
  const header = document.getElementById('site-header');
  let lastScrollY = window.scrollY;

  window.addEventListener('scroll', () => {
  if (!header) return;
  const currentScrollY = window.scrollY;
  
  if (currentScrollY > 64) {
    if (currentScrollY > lastScrollY && menu?.classList.contains('hidden')) {
      header.classList.add('-translate-y-full');
      // Tell the rest of the page the header is gone
      document.documentElement.classList.add('header-hidden'); 
    } else {
      header.classList.remove('-translate-y-full');
      // Tell the rest of the page the header is back
      document.documentElement.classList.remove('header-hidden'); 
    }
  } else {
    header.classList.remove('-translate-y-full');
    document.documentElement.classList.remove('header-hidden');
  }
  
  lastScrollY = currentScrollY;
}, { passive: true });
</script>