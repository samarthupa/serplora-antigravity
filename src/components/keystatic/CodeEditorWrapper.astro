---
import CodeEditorReact from '../ui/CodeEditorReact.tsx';
const { code, language } = Astro.props;

// 1. Count how many lines of code are in this specific snippet
const lineCount = code ? code.split('\n').length : 1;

// 2. Calculate the approximate pixel height. 
// Standard code font is usually ~24px per line + ~40px for the editor's top/bottom padding.
// (You can adjust these numbers slightly if your specific Ace Editor theme uses taller lines).
// We wrap it in a Math.max to ensure even 1-line snippets get a minimum decent height.
const estimatedHeight = Math.max(120, (lineCount * 24) + 40);
---

<div 
  class="editor-placeholder" 
  style={`min-height: ${estimatedHeight}px; width: 100%; display: block;`}
>
  <CodeEditorReact client:visible code={code} language={language} />
</div>