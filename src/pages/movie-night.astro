---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Movie Night">
  <div id="auth-layer" class="fixed inset-0 z-50 bg-gray-900 flex flex-col items-center justify-center text-white">
    <h1 class="text-2xl mb-4 font-mono">Restricted Access</h1>
    <input type="password" id="pass-input" class="text-black p-2 rounded mb-2 w-64" placeholder="Enter password" />
    <button id="login-btn" class="bg-blue-600 px-6 py-2 rounded font-semibold hover:bg-blue-700 transition">Enter</button>
  </div>

  <main class="flex h-screen w-screen bg-black overflow-hidden transition-all duration-300">
    
    <div id="video-container" class="flex-grow flex flex-col items-center justify-center transition-all duration-300 w-full relative">
      
      <div class="absolute top-4 left-4 z-40 flex gap-2">
        {Array.from({length: 8}, (_, i) => i + 1).map((part) => (
          <button 
            data-part={part}
            class="part-btn bg-gray-800 text-white px-3 py-1 rounded hover:bg-blue-600 transition"
          >
            Part {part}
          </button>
        ))}
      </div>

      <video id="shared-video" class="w-full max-h-screen outline-none" controls>
        <source id="video-source" src="https://pub-d3f708374417aa28062fc699618c8e83.r2.dev/oc-1.mp4" type="video/mp4" />
        Your browser does not support the video tag.
      </video>
    </div>

    <div id="chat-sidebar" class="w-96 h-screen border-l border-gray-800 transition-all duration-300 block bg-gray-950">
      <iframe 
        src="https://p2p.mirotalk.com/join/SamarthSecretMovieRoom77Xy" 
        allow="camera; microphone; speaker-selection; display-capture; fullscreen; autoplay"
        class="w-full h-full border-none">
      </iframe>
    </div>
  </main>
</Layout>

<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/mqtt/5.3.4/mqtt.min.js"></script>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const correctPassword = "2123";
    const video = document.getElementById('shared-video');
    const source = document.getElementById('video-source');
    
    // --- AUTH ---
    const authLayer = document.getElementById('auth-layer');
    const passInput = document.getElementById('pass-input');
    document.getElementById('login-btn').addEventListener('click', () => {
      if(passInput.value === correctPassword) authLayer.style.display = 'none';
      else window.location.href = '/';
    });

    // --- PART SELECTOR ---
    document.querySelectorAll('.part-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const part = e.target.dataset.part;
        source.src = `https://pub-d3f708374417aa28062fc699618c8e83.r2.dev/oc-${part}.mp4`;
        video.load();
        video.play();
      });
    });

    // --- PANIC BUTTON ---
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        const sidebar = document.getElementById('chat-sidebar');
        sidebar.style.display = (sidebar.style.display === 'none') ? 'block' : 'none';
      }
    });

    // --- SYNC ---
    const syncTopic = 'movie-sync-a8b2f9c4-7d1e-45fa-b982-c3f1e8a9d0b2';
    const client = mqtt.connect('wss://test.mosquitto.org:8081');
    let isRemoteAction = false;

    client.on('connect', () => client.subscribe(syncTopic));
    client.on('message', (topic, message) => {
      const data = JSON.parse(message.toString());
      isRemoteAction = true;
      if (Math.abs(video.currentTime - data.time) > 1) video.currentTime = data.time;
      if (data.action === 'play') video.play();
      else if (data.action === 'pause') video.pause();
      setTimeout(() => { isRemoteAction = false; }, 500);
    });

    video.addEventListener('play', () => { if (!isRemoteAction) client.publish(syncTopic, JSON.stringify({ action: 'play', time: video.currentTime })); });
    video.addEventListener('pause', () => { if (!isRemoteAction) client.publish(syncTopic, JSON.stringify({ action: 'pause', time: video.currentTime })); });
  });
</script>