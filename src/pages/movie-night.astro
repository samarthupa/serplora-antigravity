---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Movie Night">
  <main class="fixed inset-0 z-[9999] flex bg-black overflow-hidden transition-all duration-300 font-sans">
    
    {/* --- FLOATING CHAT TOAST CONTAINER --- */}
    <div id="toast-container" class="absolute top-6 left-1/2 -translate-x-1/2 z-50 flex flex-col gap-2 pointer-events-none"></div>

    {/* --- MOVIE CONTAINER --- */}
    <div id="video-container" class="group flex-grow flex flex-col items-center justify-center transition-all duration-300 h-full relative">
      
      <div class="absolute top-4 left-4 z-40 flex gap-2 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
        {Array.from({length: 8}, (_, i) => i + 1).map((part) => (
          <button 
            data-part={part}
            class="part-btn bg-gray-900/80 text-white px-4 py-1.5 rounded-md font-semibold text-sm hover:bg-blue-600 transition-colors border border-gray-800"
          >
            Part {part}
          </button>
        ))}
      </div>

      <video id="shared-video" class="w-full h-full object-contain outline-none" controls>
        <source id="video-source" src="https://pub-180d70048e494856af2392d19a5760f8.r2.dev/oc-1.mp4" type="video/mp4" />
        Your browser does not support the video tag.
      </video>
    </div>

    {/* --- SIDEBAR (50% VIDEO / 50% CHAT) --- */}
    <div id="sidebar" style="display: none;" class="w-96 h-full border-l border-gray-800 bg-gray-950 flex-col transition-all duration-300 flex-shrink-0">
      
      {/* Top Half: Native WebRTC Video Grid */}
      <div class="h-1/2 border-b border-gray-800 p-3 overflow-y-auto bg-gray-950">
        <div id="peer-videos" class="grid grid-cols-2 gap-3 auto-rows-max">
          <video id="local-video" class="w-full aspect-video object-cover bg-gray-900 rounded-lg border border-gray-800 shadow-sm" autoplay muted playsinline></video>
        </div>
      </div>

      {/* Bottom Half: Native Text Chat */}
      <div class="h-1/2 flex flex-col bg-gray-950">
        <div id="chat-messages" class="flex-grow overflow-y-auto p-4 flex flex-col gap-2 text-sm">
           <p class="text-gray-500 italic text-center text-xs mt-2">Chat connected. Press '1' to show/hide sidebar.</p>
        </div>
        <div class="p-3 border-t border-gray-800 bg-gray-900">
          <input 
            id="chat-input" 
            type="text" 
            class="w-full bg-black text-white p-2.5 rounded-md outline-none border border-gray-700 focus:border-blue-500 transition-colors text-sm" 
            placeholder="Type a message..." 
            autocomplete="off"
          />
        </div>
      </div>

    </div>
  </main>
</Layout>

<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/mqtt/5.3.4/mqtt.min.js"></script>
<script is:inline src="https://unpkg.com/peerjs@1.5.2/dist/peerjs.min.js"></script>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const video = document.getElementById('shared-video');
    const source = document.getElementById('video-source');
    const sidebar = document.getElementById('sidebar');
    const chatInput = document.getElementById('chat-input');
    const chatMessages = document.getElementById('chat-messages');
    const toastContainer = document.getElementById('toast-container');
    
    const username = `Guest-${Math.floor(Math.random() * 1000)}`;

    // --- PART SELECTOR ---
    document.querySelectorAll('.part-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const part = e.target.dataset.part;
        source.src = `https://pub-180d70048e494856af2392d19a5760f8.r2.dev/oc-${part}.mp4`;
        video.load();
        video.play();
      });
    });

    // --- TOGGLE SIDEBAR HOTKEY ('1') ---
    document.addEventListener('keydown', (e) => {
      if (e.key === '1') {
        e.preventDefault(); // Prevents typing '1' in the text box
        if (sidebar.style.display === 'none') {
          sidebar.style.display = 'flex';
          chatInput.focus(); // Auto-focus the chat when opened
        } else {
          sidebar.style.display = 'none';
          chatInput.blur(); // Remove focus when hidden so you don't keep typing
        }
      }
    });

    // --- MQTT SETUP (Sync & Signaling) ---
    const roomId = 'movie-room-a8b2f9c4'; 
    const syncTopic = `${roomId}-sync`;
    const chatTopic = `${roomId}-chat`;
    const presenceTopic = `${roomId}-presence`;

    const client = mqtt.connect('wss://test.mosquitto.org:8081');
    let isRemoteAction = false;

    client.on('connect', () => {
      client.subscribe(syncTopic);
      client.subscribe(chatTopic);
      client.subscribe(presenceTopic);
    });

    // --- MOVIE SYNCING ---
    video.addEventListener('play', () => { if (!isRemoteAction) client.publish(syncTopic, JSON.stringify({ action: 'play', time: video.currentTime })); });
    video.addEventListener('pause', () => { if (!isRemoteAction) client.publish(syncTopic, JSON.stringify({ action: 'pause', time: video.currentTime })); });

    // --- TEXT CHAT EVENT ---
    chatInput.addEventListener('keypress', (e) => {
      if (e.key === 'Enter' && chatInput.value.trim() !== '') {
        client.publish(chatTopic, JSON.stringify({ sender: username, text: chatInput.value.trim() }));
        chatInput.value = '';
      }
    });

    // --- GLOBAL MESSAGE HANDLER ---
    client.on('message', (topic, message) => {
      const data = JSON.parse(message.toString());

      // Handle Video Sync
      if (topic === syncTopic) {
        isRemoteAction = true;
        if (Math.abs(video.currentTime - data.time) > 1) video.currentTime = data.time;
        if (data.action === 'play') video.play();
        else if (data.action === 'pause') video.pause();
        setTimeout(() => { isRemoteAction = false; }, 500);
      }

      // Handle Chat Messages
      if (topic === chatTopic) {
        // 1. Add to sidebar chat list
        const msgDiv = document.createElement('div');
        msgDiv.className = 'bg-gray-900 rounded-lg p-2.5 shadow-sm border border-gray-800';
        msgDiv.innerHTML = `<span class="font-bold text-blue-400 text-xs uppercase tracking-wider block mb-0.5">${data.sender}</span><span class="text-gray-200">${data.text}</span>`;
        chatMessages.appendChild(msgDiv);
        chatMessages.scrollTop = chatMessages.scrollHeight; // Auto-scroll

        // 2. Show Toast if sidebar is hidden
        if (sidebar.style.display === 'none') {
          const toast = document.createElement('div');
          toast.className = 'bg-gray-900/90 text-white px-4 py-2 rounded-md border border-gray-700 shadow-lg backdrop-blur-sm transition-opacity duration-500 text-sm flex gap-2 items-center';
          toast.innerHTML = `<span class="font-bold text-blue-400">${data.sender}:</span> <span>${data.text}</span>`;
          toastContainer.appendChild(toast);

          // Fade out and remove after 3 seconds
          setTimeout(() => {
            toast.style.opacity = '0';
            setTimeout(() => toast.remove(), 500);
          }, 3000);
        }
      }

      // Handle WebRTC Peer Discovery
      if (topic === presenceTopic && myPeer) {
        if (data.action === 'join' && data.peerId !== myPeer.id && myStream) {
          const call = myPeer.call(data.peerId, myStream);
          const videoEl = document.createElement('video');
          call.on('stream', userVideoStream => { addVideoStream(videoEl, userVideoStream, data.peerId); });
        }
      }
    });

    // --- WEBRTC CAMERA MESH (PeerJS) ---
    let myPeer;
    let myStream;
    myPeer = new Peer(); 

    // Disabled audio (audio: false) to prevent microphone sharing
    navigator.mediaDevices.getUserMedia({ video: true, audio: false }).then(stream => {
      myStream = stream;
      document.getElementById('local-video').srcObject = stream;

      myPeer.on('open', id => {
        client.publish(presenceTopic, JSON.stringify({ action: 'join', peerId: id }));
      });

      myPeer.on('call', call => {
        call.answer(stream);
        const videoEl = document.createElement('video');
        call.on('stream', userVideoStream => {
          addVideoStream(videoEl, userVideoStream, call.peer);
        });
      });
    }).catch(err => {
      console.warn("Camera access denied or unavailable", err);
    });

    function addVideoStream(videoEl, stream, id) {
      if(document.getElementById(`video-${id}`)) return; 
      videoEl.id = `video-${id}`;
      videoEl.srcObject = stream;
      videoEl.autoplay = true;
      videoEl.playsinline = true;
      videoEl.muted = true; // Extra safety precaution
      videoEl.className = "w-full aspect-video object-cover bg-gray-900 rounded-lg border border-gray-800 shadow-sm";
      document.getElementById('peer-videos').appendChild(videoEl);
    }
  });
</script>