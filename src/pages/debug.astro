---
import { getCollection } from 'astro:content';

let error = null;
let blogCount = -1;
let tutCount = -1;

try {
  const blogs = await getCollection('blog');
  blogCount = blogs ? blogs.length : 0;
} catch (e: any) {
  error = e.message;
}

try {
  const tuts = await getCollection('tutorials');
  tutCount = tuts ? tuts.length : 0;
} catch(e) {}
---

<html>
<body>
  <h1>Debug Info</h1>
  <p id="blog">Blogs: {blogCount}</p>
  <p id="tut">Tuts: {tutCount}</p>
  <p id="err">Error: {error}</p>
</body>
</html>
