---
// src/pages/index.astro
import { getEntry, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';

// Fetch home page data from Keystatic. Note the ID is now 'index' instead of 'data'
const homeEntry = await getEntry('homePage', 'index'); 
const headline = homeEntry?.data?.headline || 'Welcome to Serplora';
const subheadline = homeEntry?.data?.subheadline || 'Building state-of-the-art tools for the web.';

// 🟢 Render the Markdoc content from the CMS!
const { Content } = homeEntry ? await render(homeEntry) : { Content: () => null };
---

{/* Pass SEO data and fallbacks to Layout */}
<Layout 
  seo={homeEntry?.data?.seo}
  titleFallback={headline}
  excerptFallback={subheadline}
>
  <main class="w-full max-w-4xl mx-auto px-6 py-20 md:py-32 flex flex-col">
    
    <header class="mb-16">
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-tight text-tx-main mb-6">
        {headline}
      </h1>
      <p class="text-lg md:text-xl text-tx-muted font-medium max-w-2xl leading-relaxed">
        {subheadline}
      </p>
    </header>

    {/* 🟢 This renders the rich text you write inside the Keystatic Editor */}
    <div class="markdown-content text-[16px] md:text-[20px] leading-[1.7] md:leading-[1.8] font-['Outfit',sans-serif]">
      {homeEntry && <Content />}
    </div>

  </main>
</Layout>