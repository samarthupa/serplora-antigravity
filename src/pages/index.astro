---
// src/pages/index.astro
import { getEntry, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';

// Fetch home page data from Keystatic.
const homeEntry = await getEntry('homePage', 'index'); 

// Render the content from the CMS!
const { Content } = homeEntry ? await render(homeEntry) : { Content: () => null };
---

{/* Pass SEO data to Layout, using basic fallbacks since the dynamic header is gone */}
<Layout 
  seo={homeEntry?.data?.seo}
  titleFallback="Serplora"
  excerptFallback="Serplora - Building state-of-the-art tools for the web."
>
  <main class="w-full max-w-4xl mx-auto px-6 py-20 md:py-32 flex flex-col">
    
    {/* This renders the custom HTML/Rich Text you write inside the Keystatic Editor */}
    <div class="html-content">
      {homeEntry && <Content />}
    </div>

  </main>
</Layout>