---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <main class="min-h-screen flex flex-col items-center justify-center p-8 text-center">
    <h1 class="text-5xl font-extrabold tracking-tight mb-4">
      Welcome to <span class="text-blue-600">Serplora Academy</span>
    </h1>
    <p class="text-lg text-slate-600 max-w-2xl mb-8">
      Your custom Astro architecture is officially online. Zero bloat. 100% control.
    </p>
    <div class="flex gap-4">
      <a href="/keystatic" class="bg-black text-white px-6 py-3 rounded-lg font-medium hover:bg-slate-800 transition-colors">
        Open CMS Dashboard
      </a>
    </div>
  </main>
</Layout>