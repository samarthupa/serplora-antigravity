---
// src/pages/authors/[author]/[...page].astro
import { getCollection, getEntry } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import Breadcrumb from '../../../components/ui/Breadcrumb.astro';

export async function getStaticPaths() {
  const allAuthors = await getCollection('authors');
  const allPosts = await getCollection('posts');
  
  // 🟢 1. Fetch the dynamic settings from the Authors Page singleton
  const pageEntry = await getEntry('authorsPage', 'data');
  const pageSize = pageEntry?.data?.postsPerPage || 9;

  // 2. Filter out the editorial team
  const individualAuthors = allAuthors.filter(author => author.id !== 'editorial-team');

  // 3. Loop through each author and manually generate their pages
  return individualAuthors.flatMap((author) => {

    // Find and sort all published posts by this specific author
    const authorPosts = allPosts
      .filter((post) => post.data.author === author.id && !post.data.draft)
      .sort((a, b) => new Date(b.data.publishDate || Date.now()).valueOf() - new Date(a.data.publishDate || Date.now()).valueOf());

    const totalPages = Math.ceil(authorPosts.length / pageSize) || 1;

    // 4. Mirror the Blog Index pagination URL logic
    return Array.from({ length: totalPages }).map((_, i) => {
      const currentPage = i + 1;
      const isFirst = currentPage === 1;
      const isLast = currentPage === totalPages;
      const start = i * pageSize;
      const end = start + pageSize;
      const data = authorPosts.slice(start, end);

      return {
        params: {
          author: author.id,
          page: isFirst ? undefined : `page/${currentPage}`
        },
        props: {
          author,
          pageEntry, // Pass settings to the component below
          pageData: {
            data,
            currentPage,
            lastPage: totalPages,
            url: {
              current: isFirst ? `/authors/${author.id}` : `/authors/${author.id}/page/${currentPage}`,
              prev: isFirst ? undefined : (currentPage === 2 ? `/authors/${author.id}` : `/authors/${author.id}/page/${currentPage - 1}`),
              next: isLast ? undefined : `/authors/${author.id}/page/${currentPage + 1}`,
            }
          }
        }
      };
    });
  });
}

const { author, pageData, pageEntry } = Astro.props;

// Determine if we are on page 2+
const isPaginated = pageData.currentPage > 1;

const generateSlug = (post: any) => post.data.slug || post.id;

// 🟢 Pagination Number Generator (Exactly as used on the Blog Index)
function getPaginationWindow(current: number, total: number) {
  if (total <= 5) return Array.from({ length: total }, (_, i) => i + 1);
  if (current <= 3) return [1, 2, 3, 4, '...', total];
  if (current >= total - 2) return [1, '...', total - 3, total - 2, total - 1, total];
  return [1, '...', current - 1, current, current + 1, '...', total];
}

const paginationList = getPaginationWindow(pageData.currentPage, pageData.lastPage);

// 🟢 5. Apply Dynamic SEO & Pagination Rules from Keystatic
let customSeo = author.data.seo ? { ...author.data.seo } : {};

// Force the schema type so it always generates the Author Schema!
customSeo.schemaType = 'ProfilePage';

if (isPaginated) {
  const template = pageEntry?.data?.paginationTitleTemplate || ' - Page {page}';
  const suffix = template.replace('{page}', String(pageData.currentPage));
  const padding = (suffix.startsWith(' ') || suffix.startsWith('-')) ? '' : ' ';

  // Apply the template
  customSeo.metaTitle = `${customSeo.metaTitle || author.data.name}${padding}${suffix}`;

  // Apply the noindex rule
  if (pageEntry?.data?.noindexPaginated) {
    customSeo.robotsIndex = false;
  }
}

const titleFallback = isPaginated 
  ? `${author.data.name} - Page ${pageData.currentPage} | Serplora` 
  : `${author.data.name} - Author Profile | Serplora`;
---

<Layout 
  seo={customSeo} 
  titleFallback={titleFallback}
  schemaData={{ id: author.id, ...author.data }}
>
  <Fragment slot="head">
    {pageData.url.prev && <link rel="prev" href={pageData.url.prev} />}
    {pageData.url.next && <link rel="next" href={pageData.url.next} />}
  </Fragment>

  <div class="w-full max-w-[1000px] mx-auto px-4 sm:px-6 py-12 md:py-20 font-['Outfit',sans-serif]">
    
    <Breadcrumb parents={[{ label: "Authors", url: "/authors" }]} current={author.data.name} />
    
    {/* Author Header Profile */}
    <div class="flex flex-col md:flex-row items-center md:items-start gap-8 mb-16 pb-12 border-b border-subtle">
      {author.data.avatar ? (
        <img src={author.data.avatar} alt={author.data.name} class="w-32 h-32 md:w-40 md:h-40 rounded-full object-cover border border-subtle shrink-0" />
      ) : (
        <div class="w-32 h-32 md:w-40 md:h-40 rounded-full bg-main border border-subtle flex items-center justify-center font-bold text-tx-main text-5xl shrink-0">
          {author.data.name.charAt(0)}
        </div>
      )}
      
      <div class="flex flex-col text-center md:text-left">
        {/* 🟢 FIXED H1: Now appends (Page X) if paginated */}
        <h1 class="text-4xl md:text-5xl font-extrabold text-tx-main tracking-tight mb-4">
          {isPaginated ? `${author.data.name} (Page ${pageData.currentPage})` : author.data.name}
        </h1>
        {author.data.bio && (
          <p class="text-lg text-tx-muted leading-relaxed mb-6 max-w-2xl">
            {author.data.bio}
          </p>
        )}
        
        {/* Social Links */}
       {/* Social Links */}
        <div class="flex flex-wrap items-center justify-center md:justify-start gap-4">
          
          {author.data.twitter && (
            <a href={author.data.twitter} target="_blank" rel="noopener noreferrer" class="text-tx-muted hover:text-brand transition-colors text-sm font-semibold flex items-center gap-1.5">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"/></svg>
              Twitter
            </a>
          )}
          
          {author.data.linkedin && (
            <a href={author.data.linkedin} target="_blank" rel="noopener noreferrer" class="text-tx-muted hover:text-brand transition-colors text-sm font-semibold flex items-center gap-1.5">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
              LinkedIn
            </a>
          )}

          {/* 🟢 NEW: GitHub */}
          {author.data.github && (
            <a href={author.data.github} target="_blank" rel="noopener noreferrer" class="text-tx-muted hover:text-brand transition-colors text-sm font-semibold flex items-center gap-1.5">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.463-1.11-1.463-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.831.092-.646.35-1.086.636-1.336-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0 1 12 6.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.161 22 16.416 22 12c0-5.523-4.477-10-10-10z"/></svg>
              GitHub
            </a>
          )}

          {/* 🟢 NEW: Kaggle */}
          {author.data.kaggle && (
            <a href={author.data.kaggle} target="_blank" rel="noopener noreferrer" class="text-tx-muted hover:text-brand transition-colors text-sm font-semibold flex items-center gap-1.5">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M18.825 23.859c-.022.092-.117.141-.281.141h-3.139c-.187 0-.351-.082-.492-.248l-5.178-6.589-1.448 1.374v5.111c0 .235-.117.352-.351.352H5.505c-.236 0-.354-.117-.354-.352V.353c0-.233.118-.353.354-.353h2.431c.234 0 .351.12.351.353v14.343l6.203-6.272c.165-.165.34-.246.526-.246h3.256c.141 0 .235.048.281.142.046.094.011.199-.105.316l-5.32 5.234 5.794 6.726c.115.14.152.235.105.281z"/></svg>
              Kaggle
            </a>
          )}

          {/* 🟢 NEW: Personal Website */}
          {author.data.website && (
            <a href={author.data.website} target="_blank" rel="noopener noreferrer" class="text-tx-muted hover:text-brand transition-colors text-sm font-semibold flex items-center gap-1.5">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
              Website
            </a>
          )}

        </div>
      </div>
    </div>

    {/* Articles by Author */}
    <div>
      <h3 class="text-2xl font-bold text-tx-main mb-8 tracking-tight font-['JetBrains_Mono',monospace]">
   Articles
      </h3>
      
      {pageData.data.length === 0 ? (
        <p class="text-tx-muted italic">This author hasn't published any articles yet.</p>
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          {pageData.data.map((post: any) => (
            <a href={`/articles/${generateSlug(post)}`} class="group flex flex-col bg-surface rounded-[12px] border border-subtle p-5 hover:border-brand/50 hover:shadow-md transition-all duration-300">
              {post.data.image && (
                <img src={post.data.image} alt={post.data.title} class="w-full h-40 object-cover rounded-[8px] mb-5 border border-subtle" />
              )}
              <h4 class="text-[18px] font-[700] text-tx-main group-hover:text-brand transition-colors mb-3 line-clamp-2 leading-tight">
                {post.data.title || generateSlug(post)}
              </h4>
              {post.data.excerpt && (
                <p class="text-[14px] text-tx-muted line-clamp-2 mt-auto">
                  {post.data.excerpt.replace(/<[^>]*>?/gm, '')}
                </p>
              )}
            </a>
          ))}
        </div>
      )}
    </div>

    {/* 🟢 PAGINATION CONTROLS (Only shows if there is > 1 page) */}
    {pageData.lastPage > 1 && (
      <nav class="mt-16 flex flex-wrap items-center justify-center gap-2 md:gap-4 border-t border-subtle pt-10 font-['JetBrains_Mono',monospace] text-base" aria-label="Pagination">
        
        {pageData.url.prev ? (
          <a href={pageData.url.prev} class="flex items-center gap-2 text-tx-main hover:text-brand transition-colors font-bold px-4 py-2 rounded-lg hover:bg-surface">
            <span>&larr;</span> Prev
          </a>
        ) : (
          <div class="px-4 py-2 opacity-30 cursor-not-allowed text-tx-muted flex items-center gap-2">
            <span>&larr;</span> Prev
          </div>
        )}

        <div class="flex items-center gap-1">
          {paginationList.map(num => {
            if (num === '...') return <span class="px-2 py-2 text-tx-muted opacity-50 font-bold">...</span>;
            
            const isCurrent = num === pageData.currentPage;
            const url = num === 1 ? `/authors/${author.id}` : `/authors/${author.id}/page/${num}`;
            
            return (
              <a 
                href={url} 
                class={`w-10 h-10 flex items-center justify-center rounded-lg transition-all duration-300 font-bold border ${
                  isCurrent 
                    ? 'border-tx-main text-tx-main bg-tx-main/10 shadow-sm' 
                    : 'border-transparent text-tx-muted hover:border-subtle hover:text-tx-main hover:bg-surface'
                }`}
                aria-current={isCurrent ? 'page' : undefined}
              >
                {num}
              </a>
            );
          })}
        </div>

        {pageData.url.next ? (
          <a href={pageData.url.next} class="flex items-center gap-2 text-tx-main hover:text-brand transition-colors font-bold px-4 py-2 rounded-lg hover:bg-surface">
            Next <span>&rarr;</span>
          </a>
        ) : (
          <div class="px-4 py-2 opacity-30 cursor-not-allowed text-tx-muted flex items-center gap-2">
            Next <span>&rarr;</span>
          </div>
        )}
      </nav>
    )}

  </div>
</Layout>