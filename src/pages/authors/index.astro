---
// src/pages/authors/index.astro
import { getCollection, getEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';

// 1. Fetch the Singleton Data
const pageEntry = await getEntry('authorsPage', 'data');
const headline = pageEntry?.data?.headline || 'Our Authors';
const subheadline = pageEntry?.data?.subheadline || 'Meet the developers and technical writers behind Serplora Academy.';
const breadcrumbLabel = pageEntry?.data?.breadcrumbTitle || headline || 'authors';

// 2. Fetch and filter the Authors
const allAuthors = await getCollection('authors');
const displayAuthors = allAuthors.filter(author => !author.id.includes('editorial-team'));
---

<Layout 
  seo={pageEntry?.data?.seo} 
  titleFallback={headline} 
  excerptFallback={subheadline}
>
  <div class="w-full max-w-[1000px] mx-auto px-4 sm:px-6 py-12 md:py-20 font-['Outfit',sans-serif]">
    
    <Breadcrumb current={breadcrumbLabel} />
    
    <div class="text-center mb-16">
      <h1 class="text-4xl md:text-5xl font-extrabold mb-6 text-tx-main tracking-tight">{headline}</h1>
      <p class="text-lg text-tx-muted max-w-2xl mx-auto">
        {subheadline}
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
      {displayAuthors.map((author) => {
        // Clean the ID for the link so it doesn't 404
        const cleanAuthorId = author.id.replace(/\/index$/, '');
        
        return (
          <a href={`/authors/${cleanAuthorId}`} class="group flex flex-col items-center text-center p-8 bg-surface border border-subtle rounded-2xl hover:border-brand/50 hover:shadow-md transition-all duration-300">
            
            {author.data.avatar ? (
              <img src={author.data.avatar} alt={author.data.name} class="w-24 h-24 rounded-full object-cover border border-subtle mb-4 group-hover:scale-105 transition-transform duration-300" />
            ) : (
              <div class="w-24 h-24 rounded-full bg-main border border-subtle flex items-center justify-center font-bold text-tx-main text-3xl mb-4 group-hover:scale-105 transition-transform duration-300">
                {author.data.name.charAt(0)}
              </div>
            )}
            
            <h2 class="text-xl font-bold text-tx-main group-hover:text-brand transition-colors mb-2">
              {author.data.name}
            </h2>
            
            {/* 🟢 Use the SEO Meta Description for the excerpt */}
            {author.data.seo?.metaDescription && (
              <p class="text-sm text-tx-muted line-clamp-2">
                {author.data.seo.metaDescription}
              </p>
            )}
          </a>
        );
      })}
    </div>

  </div>
</Layout>