---
import Layout from '../../layouts/Layout.astro';
import { getCollection, getEntry } from 'astro:content'; // 🟢 Added getEntry

// 🟢 NEW: Fetch data from Keystatic Singleton
const pageEntry = await getEntry('compilersPage', 'data');
const headline = pageEntry?.data?.headline || 'Online Compilers';
const subheadline = pageEntry?.data?.subheadline || 'Write, run, and test code directly in your browser without any installation or setup.';
const breadcrumbLabel = pageEntry?.data?.breadcrumbTitle || headline || 'compilers';

// Fetch all compilers that are not drafts
const allCompilers = await getCollection('compilers');
const liveCompilers = allCompilers.filter(compiler => !compiler.data.draft);

const seo = {
  metaTitle: "Web Compilers - Serplora",
  metaDescription: "Write, run, and test code directly in your browser with our state-of-the-art compilers."
};
---

<Layout seo={seo}>
  <div class="w-full max-w-[1000px] mx-auto px-4 sm:px-6 py-12 md:py-20 font-['Outfit',sans-serif]">
  {/* 🟢 NEW: Breadcrumb UI */}
    <nav aria-label="Breadcrumb" class="mb-8 md:mb-10 font-['JetBrains_Mono',monospace] text-[12px] md:text-[13px] text-tx-muted flex flex-wrap items-center gap-2">
      <a href="/" class="hover:text-brand transition-colors">home</a>
      <span class="opacity-40">/</span>
      <span class="text-tx-main font-medium truncate" aria-current="page">{breadcrumbLabel.toLowerCase()}</span>
    </nav>
    
    <div class="text-center mb-12">
      <h1 class="text-3xl md:text-5xl font-bold mb-4 text-gray-900 dark:text-white">Online Compilers</h1>
      <p class="text-lg text-gray-600 dark:text-gray-400 max-w-[600px] mx-auto">
        Write, run, and test code directly in your browser without any installation or setup.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {liveCompilers.map((compiler) => (
        <a href={`/compilers/${compiler.id}`} class="group block p-6 bg-white dark:bg-[#1e1e1e] border border-gray-200 dark:border-[#3c3c3c] rounded-2xl hover:border-[#007acc] dark:hover:border-[#007acc] transition-all shadow-sm hover:shadow-md">
          <div class="w-12 h-12 rounded-xl bg-[#007acc]/10 text-[#007acc] flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" /></svg>
          </div>
          <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-2 group-hover:text-[#007acc] transition-colors">{compiler.data.title}</h2>
          <p class="text-gray-600 dark:text-gray-400 text-sm leading-relaxed">
            {compiler.data.excerpt}
          </p>
        </a>
      ))}
    </div>

  </div>
</Layout>