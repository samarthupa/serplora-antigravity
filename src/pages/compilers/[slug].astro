---
import Layout from '../../layouts/Layout.astro';
import CompilerApp from '../../components/compiler/CompilerApp.tsx';
import { getCollection, getEntry, render } from 'astro:content';

export async function getStaticPaths() {
  const allCompilers = await getCollection('compilers');
  return allCompilers.map(compiler => ({
    params: { slug: compiler.id },
    props: { compiler },
  }));
}

const { compiler } = Astro.props;
const breadcrumbLabel = compiler.data.breadcrumbTitle || compiler.data.title || compiler.id;

const starterFiles = (compiler.data.starterFiles || []).map((file, index) => ({
  id: (index + 1).toString(), 
  name: file.filename || `file${index + 1}.txt`,
  content: file.content || '',
  language: file.language || 'text'
}));

const { Content } = await render(compiler);

// Dynamic Ad Fetching Logic
const adsData = await getEntry('sidebarAds', 'data');
let sidebarAdHtml = null;

if (adsData?.data) {
  const { compilerAdsGroup, globalAd } = adsData.data;
  const specificOverride = compilerAdsGroup?.specificOverrides?.find((ad: any) => ad.target === compiler.id);
  
  if (specificOverride && specificOverride.adContent) {
    sidebarAdHtml = specificOverride.adContent;
  } else if (compilerAdsGroup?.allCompilersAd) {
    sidebarAdHtml = compilerAdsGroup.allCompilersAd;
  } else if (globalAd) {
    sidebarAdHtml = globalAd;
  }
}
---

<Layout seo={compiler.data.seo} titleFallback={compiler.data.title} excerptFallback={compiler.data.excerpt}>
<div class="w-full max-w-[1920px] mx-auto px-2 sm:px-4 pb-12 mt-6 lg:mt-8 compiler-wrapper">    
<nav aria-label="Breadcrumb" class="font-['JetBrains_Mono',monospace] text-[12px] text-gray-500 dark:text-gray-400 flex items-center gap-2 mb-[30px]">      <a href="/" class="hover:text-[#007acc] transition-colors">home</a>
      <span class="opacity-40">/</span>
      <a href="/compilers" class="hover:text-[#007acc] transition-colors">compilers</a>
      <span class="opacity-40">/</span>
      <span class="text-[#007acc] font-medium" aria-current="page">{breadcrumbLabel.toLowerCase()}</span>
    </nav>

    <div class="flex-1 min-w-0 flex flex-col gap-4">
        
        {/* THE COMPILER APP WITH FALLBACK */}
        <div class="relative w-full z-10">
          <CompilerApp 
            client:only="react" 
            title={compiler.data.title}
            initialFiles={starterFiles.length > 0 ? starterFiles : [{ id: '1', name: 'untitled.txt', content: '// Write your code here', language: 'text' }]}
          >
            <div 
              slot="fallback" 
              class="flex flex-col w-full overflow-hidden transition-colors bg-white dark:bg-[#1e1e1e] h-[100dvh] my-0 rounded-none border-none md:h-[calc(100vh-160px)] md:my-0 md:rounded-xl md:border md:border-gray-300 md:dark:border-[#3c3c3c] animate-pulse"
            >
              <div class="h-[44px] md:h-[30px] bg-gray-200 dark:bg-[#3c3c3c] w-full shrink-0"></div>
              <div class="flex flex-1 w-full">
                <div class="hidden md:block w-[50px] bg-gray-100 dark:bg-[#252526] border-r border-gray-200 dark:border-[#3c3c3c]"></div>
                <div class="hidden md:block w-[240px] bg-gray-50 dark:bg-[#252526] border-r border-gray-200 dark:border-[#3c3c3c]"></div>
                <div class="flex-1 bg-white dark:bg-[#1e1e1e]"></div>
              </div>
            </div>
          </CompilerApp>
        </div>

        {/* 🟢 AD MOVED HERE: Directly below the compiler */}
        {sidebarAdHtml && (
          <div class="w-full flex justify-center mt-2 mb-4">
            <div 
              class="sidebar-ad-container bg-white dark:bg-[#1e1e1e] border border-gray-200 dark:border-[#3c3c3c] rounded-lg overflow-hidden shadow-sm block" 
              set:html={sidebarAdHtml} 
            />
          </div>
        )}

        {/* Title and Description */}
        <div class="mt-4 lg:mt-6 pb-4 border-b border-gray-200 dark:border-[#3c3c3c]">
          <h1 class="text-2xl md:text-3xl font-bold mb-2 text-gray-900 dark:text-white">{compiler.data.title}</h1>
          <p class="opacity-80 text-sm md:text-base text-gray-700 dark:text-gray-300">
            {compiler.data.excerpt}
          </p>
        </div>

        {/* The Rendered Markdown Content Container */}
        <div class="markdown-content text-[15.5px] md:text-[17px] leading-[1.7] md:leading-[1.8] mt-2">
          <Content />
        </div>
        
    </div>
  </div>
</Layout>

<style is:global>
  /* Ad Styles */
  .sidebar-ad-container img { width: 100%; height: auto; display: block; }
  .sidebar-ad-container a { text-decoration: none; display: block; }
  .sidebar-ad-container a:hover img { opacity: 0.95; transition: opacity 0.2s ease-in-out; }

  /* Custom 1400px Padding Override */
  @media (min-width: 1400px) {
    .compiler-wrapper {
      padding-left: 50px !important;
      padding-right: 50px !important;
    }
  }
</style>