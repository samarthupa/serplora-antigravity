---
import Layout from '../../layouts/Layout.astro';
import HtmlWorkspace from '../../components/compiler/HtmlWorkspace.tsx';
import PythonWorkspace from '../../components/compiler/PythonWorkspace.tsx';
// ADDED: The new JavaScript Workspace
import JsWorkspace from '../../components/compiler/JsWorkspace.tsx';

import { getCollection, getEntry, render } from 'astro:content';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';

export async function getStaticPaths() {
  const allCompilers = await getCollection('compilers');
  return allCompilers.map(compiler => ({
    params: { slug: compiler.id },
    props: { compiler },
  }));
}

const { compiler } = Astro.props;
const breadcrumbLabel = compiler.data.breadcrumbTitle || compiler.data.title || compiler.id;

// Extract the language to determine which compiler to load (defaults to html)
const compilerLang = compiler.data.language || 'html'; 

const starterFiles = (compiler.data.starterFiles || []).map((file, index) => ({
  id: (index + 1).toString(), 
  name: file.filename || `file${index + 1}.txt`,
  content: file.content || '',
  language: file.language || 'text'
}));

const { Content } = await render(compiler);

// Dynamic Ad Fetching Logic
const adsData = await getEntry('sidebarAds', 'data');
let sidebarAdHtml = null;

if (adsData?.data) {
  const { compilerAdsGroup, globalAd } = adsData.data;
  const specificOverride = compilerAdsGroup?.specificOverrides?.find((ad: any) => ad.target === compiler.id);
  
  if (specificOverride && specificOverride.adContent) {
    sidebarAdHtml = specificOverride.adContent;
  } else if (compilerAdsGroup?.allCompilersAd) {
    sidebarAdHtml = compilerAdsGroup.allCompilersAd;
  } else if (globalAd) {
    sidebarAdHtml = globalAd;
  }
}
---

<Layout seo={compiler.data.seo} titleFallback={compiler.data.title} excerptFallback={compiler.data.excerpt}>
  {/* Removed max-width, horizontal padding, and top margin */}
  <div class="w-full pb-12">    
    
    <div class="flex-1 min-w-0 flex flex-col gap-4">
        
        {/* DYNAMIC COMPILER ROUTING */}
        {/* Changed calculation to exactly 100vh minus the 48px header */}
        <div class="relative w-full z-10 h-[calc(100dvh-60px)] md:h-[calc(100vh-62px)]">
          
          {compilerLang === 'python' && (
            <PythonWorkspace 
              client:only="react" 
              title={compiler.data.title}
              initialFiles={starterFiles.length > 0 ? starterFiles : [{ id: '1', name: 'main.py', content: '# Write your Python code here', language: 'python' }]}
              showConsole={compiler.data.showConsole}
            >
              <div 
                slot="fallback" 
                class="flex flex-col w-full h-full overflow-hidden transition-colors bg-white dark:bg-[#1e1e1e] my-0 rounded-none border-none md:my-0 md:rounded-xl md:border md:border-gray-300 md:dark:border-[#3c3c3c] animate-pulse"
              >
                <div class="h-[44px] md:h-[30px] bg-gray-200 dark:bg-[#3c3c3c] w-full shrink-0"></div>
                <div class="flex flex-1 w-full h-full">
                  <div class="hidden md:block w-[50px] bg-gray-100 dark:bg-[#252526] border-r border-gray-200 dark:border-[#3c3c3c]"></div>
                  <div class="hidden md:block w-[240px] bg-gray-50 dark:bg-[#252526] border-r border-gray-200 dark:border-[#3c3c3c]"></div>
                  <div class="flex-1 bg-white dark:bg-[#1e1e1e] h-full"></div>
                </div>
              </div>
            </PythonWorkspace>
          )}

          {compilerLang === 'html' && (
            <HtmlWorkspace 
              client:only="react" 
              title={compiler.data.title}
              initialFiles={starterFiles.length > 0 ? starterFiles : [{ id: '1', name: 'index.html', content: '', language: 'html' }]}
              showConsole={compiler.data.showConsole}
            >
              <div 
                slot="fallback" 
                class="flex flex-col w-full h-full overflow-hidden transition-colors bg-white dark:bg-[#1e1e1e] my-0 rounded-none border-none md:my-0 md:rounded-xl md:border md:border-gray-300 md:dark:border-[#3c3c3c] animate-pulse"
              >
                <div class="h-[44px] md:h-[30px] bg-gray-200 dark:bg-[#3c3c3c] w-full shrink-0"></div>
                <div class="flex flex-1 w-full h-full">
                  <div class="hidden md:block w-[50px] bg-gray-100 dark:bg-[#252526] border-r border-gray-200 dark:border-[#3c3c3c]"></div>
                  <div class="hidden md:block w-[240px] bg-gray-50 dark:bg-[#252526] border-r border-gray-200 dark:border-[#3c3c3c]"></div>
                  <div class="flex-1 bg-white dark:bg-[#1e1e1e] h-full"></div>
                </div>
              </div>
            </HtmlWorkspace>
          )}

          {/* ADDED: JavaScript Compiler Block */}
          {compilerLang === 'javascript' && (
            <JsWorkspace 
              client:only="react" 
              title={compiler.data.title}
              initialFiles={starterFiles.length > 0 ? starterFiles : [{ id: '1', name: 'main.js', content: '// Write your JavaScript code here', language: 'javascript' }]}
              showConsole={compiler.data.showConsole}
            >
              <div 
                slot="fallback" 
                class="flex flex-col w-full h-full overflow-hidden transition-colors bg-white dark:bg-[#1e1e1e] my-0 rounded-none border-none md:my-0 md:rounded-xl md:border md:border-gray-300 md:dark:border-[#3c3c3c] animate-pulse"
              >
                <div class="h-[44px] md:h-[30px] bg-gray-200 dark:bg-[#3c3c3c] w-full shrink-0"></div>
                <div class="flex flex-1 w-full h-full">
                  <div class="hidden md:block w-[50px] bg-gray-100 dark:bg-[#252526] border-r border-gray-200 dark:border-[#3c3c3c]"></div>
                  <div class="hidden md:block w-[240px] bg-gray-50 dark:bg-[#252526] border-r border-gray-200 dark:border-[#3c3c3c]"></div>
                  <div class="flex-1 bg-white dark:bg-[#1e1e1e] h-full"></div>
                </div>
              </div>
            </JsWorkspace>
          )}

        </div>

        {/* BREADCRUMBS */}
        <Breadcrumb
  section="compilers"
  current={breadcrumbLabel}
  class="mt-6 ml-2 md:mt-8 mb-6 font-['JetBrains_Mono',monospace] text-[12px] text-tx-muted flex flex-wrap items-center gap-2"
/>

        {/* The Centered Reading Wrapper */}
        <div class="w-full flex justify-center mt-8 mb-20">
          
          <div class="w-full max-w-6xl px-2 md:px-0">

            {/* Ads */}
            {sidebarAdHtml && (
              <div class="w-full flex justify-center mb-10">
                <div class="sidebar-ad-container bg-[var(--color-bg-main)] border border-[var(--color-border-subtle)] rounded-lg overflow-hidden shadow-sm block" set:html={sidebarAdHtml} />
              </div>
            )}

            {/* Title and Description */}
            <div class="pb-8 mb-8 border-b border-[var(--color-border-subtle)]">
              <h1 class="text-2xl md:text-4xl font-extrabold mb-4 text-[var(--color-tx-main)] tracking-tight">
                {compiler.data.title}
              </h1>
              {compiler.data.excerpt && (
                <p class="text-[17px] md:text-lg text-[var(--color-tx-muted)] leading-relaxed">
                  {compiler.data.excerpt}
                </p>
              )}
            </div>

            {/* The Rendered Markdown Content Container */}
            <div class="markdown-content text-[16px] md:text-[17px] leading-[1.7] md:leading-[1.8] w-full text-[var(--color-tx-main)]">
              <Content />
            </div>

          </div>
        </div>
        
    </div>
  </div>
</Layout>

<style is:global>
  /* Ad Styles */
  .sidebar-ad-container img { width: 100%; height: auto; display: block; }
  .sidebar-ad-container a { text-decoration: none; display: block; }
  .sidebar-ad-container a:hover img { opacity: 0.95; transition: opacity 0.2s ease-in-out; }

  .ace_mobile-menu span{
    display: flex;
    flex-direction: column;
  }


  /* * ==============================================
   * MARKDOWN TYPOGRAPHY STYLES 
   * Powered by your global.css variables
   * ==============================================
   */
  .markdown-content {
    color: var(--color-tx-main);
  }

  .markdown-content h1, 
  .markdown-content h2, 
  .markdown-content h3, 
  .markdown-content h4 {
    font-weight: 700;
    color: var(--color-tx-main);
    margin-bottom: 0.8em;
    line-height: 1.3;
  }
  
  .markdown-content h1 { font-size: 2.25em; }
  
  .markdown-content h2 { 
    font-size: 1.75em; 
  }
  
  .markdown-content h3 { font-size: 1.35em; }
  .markdown-content h4 { font-size: 1.15em; }

  .markdown-content p {
    margin-top: 1.25em;
    margin-bottom: 1.25em;
  }

  /* 🚀 FIX: Bullet points and Numbered Lists */
  .markdown-content ul {
    list-style-type: disc;
    /* padding-left is crucial. Without it, bullets render off-screen */
    padding-left: 1.5em; 
    margin-top: 1.25em;
    margin-bottom: 1.25em;
  }

  .markdown-content ol {
    list-style-type: decimal;
    padding-left: 1.5em;
    margin-top: 1.25em;
    margin-bottom: 1.25em;
  }

  .markdown-content li {
    margin-top: 0.5em;
    margin-bottom: 0.5em;
    padding-left: 0.375em;
  }
  
  /* Support for nested lists (lists inside lists) */
  .markdown-content li > ul,
  .markdown-content li > ol {
    margin-top: 0.5em;
    margin-bottom: 0.5em;
  }

  /* Links & Highlights */
  .markdown-content a {
    color: var(--color-brand);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
    transition: opacity 0.2s ease;
  }

  .markdown-content a:hover {
    opacity: 0.8;
  }

  .markdown-content blockquote {
    font-style: italic;
    color: var(--color-tx-muted);
    border-left: 4px solid var(--color-border-subtle);
    padding-left: 1rem;
    margin-top: 1.5rem;
    margin-bottom: 1.5rem;
  }

  /* Inline Code Styles */
  .markdown-content code:not(pre code) {
    background-color: var(--color-bg-surface);
    color: var(--color-tx-main);
    padding: 0.2em 0.4em;
    border-radius: 0.25rem;
    font-size: 0.875em;
    font-family: var(--font-mono), ui-monospace, SFMono-Regular, monospace;
  }
</style>