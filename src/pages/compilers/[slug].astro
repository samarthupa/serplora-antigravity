---
import Layout from '../../layouts/Layout.astro';
import CompilerApp from '../../components/compiler/CompilerApp.tsx';
// 1. 🌟 FIXED: Added 'render' to the imports!
import { getCollection, getEntry, render } from 'astro:content';

export async function getStaticPaths() {
  const allCompilers = await getCollection('compilers');
  return allCompilers.map(compiler => ({
    params: { slug: compiler.id },
    props: { compiler },
  }));
}

const { compiler } = Astro.props;

const starterFiles = (compiler.data.starterFiles || []).map((file, index) => ({
  id: (index + 1).toString(), 
  name: file.filename || `file${index + 1}.txt`,
  content: file.content || '',
  language: file.language || 'text'
}));

// 2. 🌟 FIXED: Use the new Astro 5 standalone render function!
const { Content } = await render(compiler);

// Dynamic Ad Fetching Logic
const adsData = await getEntry('sidebarAds', 'data');
let sidebarAdHtml = null;

if (adsData?.data) {
  const { compilerAdsGroup, globalAd } = adsData.data;
  const specificOverride = compilerAdsGroup?.specificOverrides?.find((ad: any) => ad.target === compiler.id);
  
  if (specificOverride && specificOverride.adContent) {
    sidebarAdHtml = specificOverride.adContent;
  } else if (compilerAdsGroup?.allCompilersAd) {
    sidebarAdHtml = compilerAdsGroup.allCompilersAd;
  } else if (globalAd) {
    sidebarAdHtml = globalAd;
  }
}
---

<Layout seo={compiler.data.seo} titleFallback={compiler.data.title} excerptFallback={compiler.data.excerpt}>
  <div class="w-full max-w-[1440px] mx-auto px-2 sm:px-4 pb-12 mt-6 lg:mt-8">
    
    <nav aria-label="Breadcrumb" class="font-['JetBrains_Mono',monospace] text-[12px] text-gray-500 dark:text-gray-400 flex items-center gap-2 mb-4">
      <a href="/" class="hover:text-[#007acc] transition-colors">home</a>
      <span class="opacity-40">/</span>
      <a href="/compilers" class="hover:text-[#007acc] transition-colors">compilers</a>
      <span class="opacity-40">/</span>
      <span class="text-[#007acc] font-medium" aria-current="page">{compiler.data.title.toLowerCase()}</span>
    </nav>

    <div class="flex flex-col lg:flex-row gap-6 lg:gap-[20px]">
      
      <div class="flex-1 min-w-0 flex flex-col gap-4">
        
        {/* THE COMPILER APP */}
        <div class="relative w-full z-10">
          <CompilerApp 
            client:only="react" 
            title={compiler.data.title}
            initialFiles={starterFiles.length > 0 ? starterFiles : [{ id: '1', name: 'untitled.txt', content: '// Write your code here', language: 'text' }]}
          />
        </div>

        {/* Title and Description */}
        <div class="mt-4 lg:mt-6 pb-4 border-b border-gray-200 dark:border-[#3c3c3c]">
          <h1 class="text-2xl md:text-3xl font-bold mb-2 text-gray-900 dark:text-white">{compiler.data.title}</h1>
          <p class="opacity-80 text-sm md:text-base text-gray-700 dark:text-gray-300">
            {compiler.data.excerpt}
          </p>
        </div>

        {/* 🌟 The Rendered Markdown Content Container */}
        <div class="markdown-content text-[15.5px] md:text-[17px] leading-[1.7] md:leading-[1.8] mt-2">
          <Content />
        </div>
        
      </div>

      {/* RIGHT COLUMN: Ad Sidebar */}
      {sidebarAdHtml && (
        <aside class="w-full lg:w-[150px] shrink-0 mt-8 lg:mt-[37px]">
          <div class="sticky top-[88px]">
            <div 
              class="sidebar-ad-container w-full bg-white dark:bg-[#1e1e1e] border border-gray-200 dark:border-[#3c3c3c] rounded-lg overflow-hidden shadow-sm block" 
              set:html={sidebarAdHtml} 
            />
          </div>
        </aside>
      )}

    </div>
  </div>
</Layout>

<style is:global>
  /* Ad Styles */
  .sidebar-ad-container img { width: 100%; height: auto; display: block; }
  .sidebar-ad-container a { text-decoration: none; display: block; }
  .sidebar-ad-container a:hover img { opacity: 0.95; transition: opacity 0.2s ease-in-out; }
</style>