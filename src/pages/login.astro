---
// src/pages/login.astro
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div class="flex-1 flex flex-col items-center justify-center p-6 min-h-[75vh] font-['Outfit',sans-serif]">
    
    <div class="w-full max-w-md bg-surface border border-subtle rounded-2xl shadow-xl p-8 text-center flex flex-col items-center relative overflow-hidden">
      
      {/* Subtle background glow */}
      <div class="absolute top-0 inset-x-0 h-1 bg-gradient-to-r from-blue-500 to-purple-500"></div>

      <h1 class="text-2xl md:text-3xl font-[800] text-tx-main mb-2 tracking-tight">Welcome to Serplora</h1>
      <p class="text-tx-muted text-[15px] mb-8">Sign in securely to continue learning.</p>

      {/* --- SIGN IN SECTION --- */}
      <div id="login-section" class="w-full flex flex-col items-center gap-4 transition-all duration-300">
        
        {/* --- STEP 1: EMAIL INPUT --- */}
        <div id="email-step" class="w-full flex flex-col gap-3 mb-2 animate-fade-in">
          <input 
            type="email" 
            id="email-input" 
            placeholder="name@example.com" 
            class="w-full p-3 rounded-md bg-transparent border border-subtle text-tx-main focus:border-tx-main focus:ring-1 focus:ring-tx-main outline-none transition-all" 
          />
          <button 
            id="send-otp-btn"
            class="w-full py-2.5 bg-tx-main text-main rounded-md font-medium text-[15px] hover:opacity-90 transition-opacity"
          >
            Continue with Email
          </button>
        </div>

        {/* --- STEP 2: OTP VERIFICATION (Hidden by default) --- */}
        <div id="otp-step" class="w-full hidden flex-col gap-3 mb-2 animate-fade-in">
          <p class="text-sm text-tx-muted mb-1">Enter the 6-digit code sent to <span id="display-email" class="font-bold text-tx-main"></span></p>
          <input 
            type="text" 
            id="otp-input" 
            placeholder="123456" 
            maxlength="6"
            class="w-full p-3 text-center tracking-[0.5em] font-bold text-xl rounded-md bg-transparent border border-subtle text-tx-main focus:border-tx-main focus:ring-1 focus:ring-tx-main outline-none transition-all" 
          />
          <button 
            id="verify-otp-btn"
            class="w-full py-2.5 bg-tx-main text-main rounded-md font-medium text-[15px] hover:opacity-90 transition-opacity"
          >
            Verify & Sign In
          </button>
          <button id="back-to-email-btn" class="text-xs text-tx-muted hover:text-tx-main underline mt-2">
            Use a different email
          </button>
        </div>

        <div class="flex items-center w-full my-2">
          <hr class="flex-1 border-subtle" />
          <span class="px-3 text-xs text-tx-muted uppercase font-bold tracking-wider">OR</span>
          <hr class="flex-1 border-subtle" />
        </div>

        {/* --- PASSKEY BUTTON --- */}
        <button 
          id="passkey-login-btn"
          class="w-full flex items-center justify-center gap-3 py-2.5 bg-indigo-50 dark:bg-indigo-900/20 border border-indigo-200 dark:border-indigo-800 hover:bg-indigo-100 dark:hover:bg-indigo-900/40 text-indigo-700 dark:text-indigo-300 rounded-md font-medium text-[15px] transition-colors shadow-sm mb-2"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 11c0 3.517-1.009 6.799-2.753 9.571m-3.44-2.04l.054-.09A13.916 13.916 0 008 11a4 4 0 118 0c0 1.017-.07 2.019-.203 3m-2.118 6.844A21.88 21.88 0 0015.171 17m3.839 1.132c.645-2.266.99-4.659.99-7.132A8 8 0 008 4.07M3 15.364c.64-1.319 1-2.8 1-4.364 0-1.457.39-2.823 1.07-4"></path>
          </svg>
          Sign in with Passkey
        </button>

        {/* --- GOOGLE BUTTON --- */}
        <button 
          id="google-login-btn"
          class="w-full flex items-center justify-center gap-3 py-2.5 bg-white dark:bg-[#1a1a1a] border border-gray-300 dark:border-subtle hover:bg-gray-50 dark:hover:bg-[#2a2a2a] text-gray-700 dark:text-tx-main rounded-md font-medium text-[15px] transition-colors shadow-sm"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24">
            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
          </svg>
          Continue with Google
        </button>
      
        {/* --- GITHUB BUTTON --- */}
        <button 
          id="github-login-btn"
          class="w-full flex items-center justify-center gap-3 py-2.5 bg-[#24292F] hover:bg-[#24292F]/90 text-white rounded-md font-medium text-[15px] transition-colors"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"></path>
          </svg>
          Continue with GitHub
        </button>

        {/* --- MICROSOFT BUTTON --- */}
        <button 
          id="microsoft-login-btn"
          class="w-full flex items-center justify-center gap-3 py-2.5 bg-white dark:bg-[#1a1a1a] border border-gray-300 dark:border-subtle hover:bg-gray-50 dark:hover:bg-[#2a2a2a] text-gray-700 dark:text-tx-main rounded-md font-medium text-[15px] transition-colors shadow-sm"
        >
          <svg class="w-5 h-5" viewBox="0 0 21 21" aria-hidden="true">
            <path fill="#f35325" d="M0 0h10v10H0z"/>
            <path fill="#81bc06" d="M11 0h10v10H11z"/>
            <path fill="#05a6f0" d="M0 11h10v10H0z"/>
            <path fill="#ffba08" d="M11 11h10v10H11z"/>
          </svg>
          Continue with Microsoft
        </button>
      </div>

    </div>
  </div>

<script>
  import { authClient } from '../lib/auth-client';

  // 1. Safely grab the return URL
  const urlParams = new URLSearchParams(window.location.search);
  let rawReturnUrl = urlParams.get('returnUrl') || '/';
  const safeReturnUrl = (rawReturnUrl.startsWith('/') && !rawReturnUrl.startsWith('//')) 
    ? rawReturnUrl 
    : '/';

  // State Management for OTP UI
  let currentEmail = "";
  const emailStep = document.getElementById('email-step');
  const otpStep = document.getElementById('otp-step');
  const displayEmail = document.getElementById('display-email');
  const emailInput = document.getElementById('email-input') as HTMLInputElement;
  const otpInput = document.getElementById('otp-input') as HTMLInputElement;

  // --- STEP 1: SEND OTP ---
  document.getElementById('send-otp-btn')?.addEventListener('click', async (e) => {
    e.preventDefault();
    const email = emailInput.value.trim();
    const btn = e.currentTarget as HTMLButtonElement;
    
    if (!email) return;

    btn.innerHTML = 'Sending Code...';
    btn.disabled = true;
    btn.classList.add('opacity-50', 'cursor-not-allowed');

    const { data, error } = await authClient.emailOtp.sendVerificationOtp({
        email: email,
        type: "sign-in"
    });

    btn.innerHTML = 'Continue with Email';
    btn.disabled = false;
    btn.classList.remove('opacity-50', 'cursor-not-allowed');

    if (error) {
        const errorDetails = error.message || JSON.stringify(error) || "Unknown frontend error";
        alert("Failed to send code: " + errorDetails);
    } else {
        // Hide Email step, Show OTP step
        currentEmail = email;
        if(displayEmail) displayEmail.textContent = email;
        emailStep?.classList.add('hidden');
        emailStep?.classList.remove('flex');
        otpStep?.classList.remove('hidden');
        otpStep?.classList.add('flex');
        otpInput?.focus();
    }
  });

  // --- STEP 2: VERIFY OTP ---
  document.getElementById('verify-otp-btn')?.addEventListener('click', async (e) => {
    e.preventDefault();
    const otp = otpInput.value.trim();
    const btn = e.currentTarget as HTMLButtonElement;

    if (!otp || otp.length < 6) {
        alert("Please enter the full 6-digit code.");
        return;
    }

    btn.innerHTML = 'Verifying...';
    btn.disabled = true;
    btn.classList.add('opacity-50', 'cursor-not-allowed');

    const { data, error } = await authClient.signIn.emailOtp({
        email: currentEmail,
        otp: otp,
        callbackURL: safeReturnUrl
    });

    if (error) {
        alert("Invalid code: " + error.message);
        btn.innerHTML = 'Verify & Sign In';
        btn.disabled = false;
        btn.classList.remove('opacity-50', 'cursor-not-allowed');
    }
    // If successful, Better Auth automatically handles the redirect to callbackURL
  });

  // --- BACK TO EMAIL BUTTON ---
  document.getElementById('back-to-email-btn')?.addEventListener('click', () => {
      otpStep?.classList.add('hidden');
      otpStep?.classList.remove('flex');
      emailStep?.classList.remove('hidden');
      emailStep?.classList.add('flex');
      otpInput.value = '';
  });

  // --- PASSKEY LOGIN ---
  document.getElementById('passkey-login-btn')?.addEventListener('click', async (e) => {
    e.preventDefault();
    const btn = e.currentTarget as HTMLButtonElement;
    const originalText = btn.innerHTML;
    btn.innerHTML = 'Prompting Device...';
    btn.disabled = true;

    const { data, error } = await authClient.signIn.passkey({
        callbackURL: safeReturnUrl
    });

    if (error) {
        console.error("Passkey error:", error);
        alert("Passkey login failed or cancelled.");
        btn.innerHTML = originalText;
        btn.disabled = false;
    }
  });

  // --- GOOGLE LOGIN ---
  document.getElementById('google-login-btn')?.addEventListener('click', async (e) => {
    e.preventDefault();
    const btn = e.currentTarget as HTMLButtonElement;
    btn.innerHTML = 'Connecting to Google...';
    await authClient.signIn.social({ provider: "google", callbackURL: safeReturnUrl });
  });

  // --- GITHUB LOGIN ---
  document.getElementById('github-login-btn')?.addEventListener('click', async (e) => {
    e.preventDefault();
    const btn = e.currentTarget as HTMLButtonElement;
    btn.innerHTML = 'Connecting to GitHub...';
    await authClient.signIn.social({ provider: "github", callbackURL: safeReturnUrl });
  });

  // --- MICROSOFT LOGIN ---
  document.getElementById('microsoft-login-btn')?.addEventListener('click', async (e) => {
    e.preventDefault();
    const btn = e.currentTarget as HTMLButtonElement;
    btn.innerHTML = 'Connecting to Microsoft...';
    await authClient.signIn.social({ provider: "microsoft", callbackURL: safeReturnUrl });
  });
</script>
</Layout>

<style>
  .flex { display: flex; }
  .hidden { display: none !important; }
  .animate-fade-in { animation: fadeIn 0.4s ease-out forwards; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
</style>