---
// src/pages/login.astro
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div class="flex-1 flex flex-col items-center justify-center p-6 min-h-[75vh] font-['Outfit',sans-serif]">
    
    <div class="w-full max-w-md bg-surface border border-subtle rounded-2xl shadow-xl p-8 text-center flex flex-col items-center relative overflow-hidden">
      
      {/* Subtle background glow */}
      <div class="absolute top-0 inset-x-0 h-1 bg-gradient-to-r from-blue-500 to-purple-500"></div>

      <h1 class="text-2xl md:text-3xl font-[800] text-tx-main mb-2 tracking-tight">Welcome to Serplora</h1>
      <p class="text-tx-muted text-[15px] mb-8">Sign in securely to continue learning.</p>

      {/* --- SIGN IN SECTION --- */}
      <div id="login-section" class="w-full flex flex-col items-center gap-4 transition-all duration-300">
        
        {/* --- NEW STANDARD GOOGLE BUTTON (Dark Mode Optimized) --- */}
        <button 
          id="google-login-btn"
          class="w-full flex items-center justify-center gap-3 py-2.5 bg-white dark:bg-[#1a1a1a] border border-gray-300 dark:border-subtle hover:bg-gray-50 dark:hover:bg-[#2a2a2a] text-gray-700 dark:text-tx-main rounded-md font-medium text-[15px] transition-colors shadow-sm"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24">
            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
          </svg>
          Continue with Google
        </button>
      
        {/* --- GITHUB BUTTON --- */}
        <button 
          id="github-login-btn"
          class="w-full flex items-center justify-center gap-3 py-2.5 bg-[#24292F] hover:bg-[#24292F]/90 text-white rounded-md font-medium text-[15px] transition-colors"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"></path>
          </svg>
          Continue with GitHub
        </button>
      </div>

    </div>
  </div>

<script>
  import { authClient } from '../lib/auth-client';

  // 1. Safely grab the return URL
  const urlParams = new URLSearchParams(window.location.search);
  let rawReturnUrl = urlParams.get('returnUrl') || '/';
  const safeReturnUrl = (rawReturnUrl.startsWith('/') && !rawReturnUrl.startsWith('//')) 
    ? rawReturnUrl 
    : '/';

  // --- GOOGLE LOGIN (Using Better Auth) ---
  document.getElementById('google-login-btn')?.addEventListener('click', async (e) => {
    e.preventDefault();
    const btn = e.currentTarget as HTMLButtonElement;
    btn.innerHTML = 'Connecting to Google...';
    
    await authClient.signIn.social({
        provider: "google",
        callbackURL: safeReturnUrl 
    });
  });

  // --- GITHUB LOGIN (Using Better Auth) ---
  document.getElementById('github-login-btn')?.addEventListener('click', async (e) => {
    e.preventDefault();
    const btn = e.currentTarget as HTMLButtonElement;
    btn.innerHTML = 'Connecting to GitHub...';
    
    await authClient.signIn.social({
        provider: "github",
        callbackURL: safeReturnUrl 
    });
  });
</script>
</Layout>

<style>
  .animate-fade-in { animation: fadeIn 0.4s ease-out forwards; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
</style>