---
// src/pages/login.astro
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <!-- Load the Turnstile script -->
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

  <div class="flex-1 flex flex-col items-center justify-center p-6 min-h-[75vh] font-['Outfit',sans-serif] bg-neutral-50 dark:bg-[#0a0a0a]">
    
    <div class="w-full max-w-sm bg-white dark:bg-[#121212] border border-gray-200 dark:border-gray-800 rounded-xl shadow-sm p-8 flex flex-col items-center relative">
      
      <h1 class="text-2xl font-bold text-gray-900 dark:text-white mb-2 text-center tracking-tight">Welcome to Serplora</h1>
      <p class="text-gray-500 dark:text-gray-400 text-sm mb-8 text-center">Sign in or up securely to continue.</p>

      {/* --- STATE 1: SOCIAL LOGINS --- */}
      <div id="social-step" class="w-full flex flex-col gap-3 animate-fade-in">
        
        <button id="google-login-btn" class="w-full flex items-center justify-center gap-3 py-2.5 bg-transparent border border-gray-200 dark:border-gray-800 hover:bg-gray-50 dark:hover:bg-gray-900 text-gray-800 dark:text-gray-200 rounded-lg font-medium text-sm transition-colors">
          <svg class="w-5 h-5" viewBox="0 0 24 24">
            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
          </svg>
          Continue with Google
        </button>
      
        <button id="github-login-btn" class="w-full flex items-center justify-center gap-3 py-2.5 bg-transparent border border-gray-200 dark:border-gray-800 hover:bg-gray-50 dark:hover:bg-gray-900 text-gray-800 dark:text-gray-200 rounded-lg font-medium text-sm transition-colors">
          <svg class="w-5 h-5 text-black dark:text-white" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"></path>
          </svg>
          Continue with GitHub
        </button>

        <button id="microsoft-login-btn" class="w-full flex items-center justify-center gap-3 py-2.5 bg-transparent border border-gray-200 dark:border-gray-800 hover:bg-gray-50 dark:hover:bg-gray-900 text-gray-800 dark:text-gray-200 rounded-lg font-medium text-sm transition-colors">
          <svg class="w-5 h-5" viewBox="0 0 21 21" aria-hidden="true">
            <path fill="#f35325" d="M0 0h10v10H0z"/>
            <path fill="#81bc06" d="M11 0h10v10H11z"/>
            <path fill="#05a6f0" d="M0 11h10v10H0z"/>
            <path fill="#ffba08" d="M11 11h10v10H11z"/>
          </svg>
          Continue with Microsoft
        </button>

        <div class="flex items-center w-full my-3">
          <hr class="flex-1 border-gray-200 dark:border-gray-800" />
          <span class="px-4 text-xs text-gray-400 font-medium bg-white dark:bg-[#121212]">or</span>
          <hr class="flex-1 border-gray-200 dark:border-gray-800" />
        </div>

        <button id="show-email-btn" class="w-full flex items-center justify-center py-2.5 bg-gray-900 dark:bg-gray-100 hover:bg-gray-800 dark:hover:bg-white text-white dark:text-black rounded-lg font-medium text-sm transition-colors">
          Continue with Email
        </button>
      </div>

      {/* --- STATE 2: EMAIL INPUT (Hidden by default) --- */}
      <div id="email-step" class="w-full hidden flex-col gap-3 animate-fade-in">
        <input 
          type="email" 
          id="email-input" 
          placeholder="name@example.com" 
          class="w-full p-3 rounded-lg bg-gray-50 dark:bg-[#1a1a1a] border border-gray-200 dark:border-gray-800 text-gray-900 dark:text-white text-sm focus:border-gray-400 dark:focus:border-gray-600 focus:outline-none transition-colors" 
        />
        
        {/* Turnstile Widget */}
        <div id="turnstile-widget" class="cf-turnstile w-full flex justify-center mt-2" data-sitekey="YOUR_PUBLIC_SITE_KEY" data-theme="auto"></div>
        
        <p id="email-error" class="hidden text-red-500 text-xs font-medium px-1 text-center"></p>
        <button id="send-otp-btn" class="w-full py-2.5 bg-gray-900 dark:bg-gray-100 hover:bg-gray-800 dark:hover:bg-white text-white dark:text-black rounded-lg font-medium text-sm transition-colors">
          Send Code
        </button>
        <button id="back-to-social-btn" class="mt-3 text-sm text-gray-500 hover:text-gray-900 dark:hover:text-white transition-colors">
          &larr; Other login methods
        </button>
      </div>

      {/* --- STATE 3: OTP VERIFICATION (Hidden by default) --- */}
      <div id="otp-step" class="w-full hidden flex-col gap-3 animate-fade-in">
        <p class="text-sm text-gray-500 text-center mb-2">Enter the 6-digit code sent to <br/><span id="display-email" class="font-medium text-gray-900 dark:text-white"></span></p>
        <input 
          type="text" 
          id="otp-input" 
          placeholder="123456" 
          maxlength="6"
          class="w-full p-3 text-center tracking-[0.5em] font-mono font-bold text-lg rounded-lg bg-gray-50 dark:bg-[#1a1a1a] border border-gray-200 dark:border-gray-800 text-gray-900 dark:text-white focus:border-gray-400 dark:focus:border-gray-600 focus:outline-none transition-colors" 
        />
        <p id="otp-error" class="hidden text-red-500 text-xs font-medium px-1 text-center"></p>
        <button id="verify-otp-btn" class="w-full py-2.5 bg-gray-900 dark:bg-gray-100 hover:bg-gray-800 dark:hover:bg-white text-white dark:text-black rounded-lg font-medium text-sm transition-colors mt-2">
          Verify Code
        </button>

        {/* Action Links for OTP Step */}
        <div class="flex flex-col items-center gap-3 mt-4 w-full">
          <button id="resend-otp-btn" class="text-sm text-gray-500 hover:text-gray-900 dark:hover:text-white transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
            Resend Code
          </button>
          <button id="back-to-email-from-otp-btn" class="text-sm text-gray-500 hover:text-gray-900 dark:hover:text-white transition-colors">
            &larr; Change Email
          </button>
        </div>
      </div>

    </div>
  </div>

<script>
  import { authClient } from '../lib/auth-client';

  const urlParams = new URLSearchParams(window.location.search);
  let rawReturnUrl = urlParams.get('returnUrl') || '/';
  const safeReturnUrl = (rawReturnUrl.startsWith('/') && !rawReturnUrl.startsWith('//')) 
    ? rawReturnUrl 
    : '/';

  // State Variables
  let currentEmail = "";
  let failedAttempts = 0;
  const MAX_ATTEMPTS = 3;
  let resendTimer: ReturnType<typeof setInterval> | null = null;
  let countdown = 0;
  
  // UI Elements
  const socialStep = document.getElementById('social-step');
  const emailStep = document.getElementById('email-step');
  const otpStep = document.getElementById('otp-step');
  const displayEmail = document.getElementById('display-email');
  
  const emailInput = document.getElementById('email-input') as HTMLInputElement;
  const otpInput = document.getElementById('otp-input') as HTMLInputElement;
  const emailError = document.getElementById('email-error');
  const otpError = document.getElementById('otp-error');
  const resendBtn = document.getElementById('resend-otp-btn') as HTMLButtonElement;
  const verifyBtn = document.getElementById('verify-otp-btn') as HTMLButtonElement;

  // --- HELPER FUNCTIONS ---
  function showInlineError(element: HTMLElement | null, message: string) {
    if (element) {
      element.innerText = message;
      element.classList.remove('hidden');
    }
  }

  function hideInlineError(element: HTMLElement | null) {
    if (element) {
      element.innerText = '';
      element.classList.add('hidden');
    }
  }

  function startResendCooldown() {
    countdown = 60;
    resendBtn.disabled = true;
    resendBtn.innerText = `Resend Code (${countdown}s)`;
    
    if (resendTimer) clearInterval(resendTimer);
    
    resendTimer = setInterval(() => {
      countdown--;
      resendBtn.innerText = `Resend Code (${countdown}s)`;
      if (countdown <= 0) {
        clearInterval(resendTimer!);
        resendBtn.disabled = false;
        resendBtn.innerText = 'Resend Code';
      }
    }, 1000);
  }

  // --- NAVIGATION TOGGLES ---
  document.getElementById('show-email-btn')?.addEventListener('click', () => {
      socialStep?.classList.add('hidden');
      socialStep?.classList.remove('flex');
      emailStep?.classList.remove('hidden');
      emailStep?.classList.add('flex');
      emailInput?.focus();
  });

  document.getElementById('back-to-social-btn')?.addEventListener('click', () => {
      hideInlineError(emailError);
      emailStep?.classList.add('hidden');
      emailStep?.classList.remove('flex');
      socialStep?.classList.remove('hidden');
      socialStep?.classList.add('flex');
      emailInput.value = '';
  });

  document.getElementById('back-to-email-from-otp-btn')?.addEventListener('click', () => {
      hideInlineError(otpError);
      otpStep?.classList.add('hidden');
      otpStep?.classList.remove('flex');
      emailStep?.classList.remove('hidden');
      emailStep?.classList.add('flex');
      otpInput.value = '';
      failedAttempts = 0; 
      verifyBtn.disabled = false;
      verifyBtn.classList.remove('opacity-70', 'cursor-not-allowed');
      // Reset turnstile when changing email so they can solve it again if needed
      if ((window as any).turnstile) (window as any).turnstile.reset();
  });

  // --- SEND OTP ---
  async function requestOTP(emailAddress: string, isResend = false) {
    const btnToUpdate = isResend ? resendBtn : (document.getElementById('send-otp-btn') as HTMLButtonElement);
    
    // Capture Turnstile Token
    const turnstileInput = document.querySelector('[name="cf-turnstile-response"]') as HTMLInputElement;
    const token = turnstileInput?.value;

    if (!token) {
        showInlineError(emailError, "Please complete the security check.");
        return false;
    }

    hideInlineError(emailError);
    hideInlineError(otpError);

    btnToUpdate.innerText = 'Sending...';
    btnToUpdate.disabled = true;
    btnToUpdate.classList.add('opacity-70', 'cursor-not-allowed');

    const { data, error } = await authClient.emailOtp.sendVerificationOtp({
        email: emailAddress,
        type: "sign-in",
        fetchOptions: {
            headers: {
                "X-Turnstile-Token": token
            }
        }
    });

    // Reset Turnstile widget after requesting so it doesn't use a stale token
    if ((window as any).turnstile) {
        (window as any).turnstile.reset();
    }

    if (!isResend) {
        btnToUpdate.innerText = 'Send Code';
        btnToUpdate.disabled = false;
        btnToUpdate.classList.remove('opacity-70', 'cursor-not-allowed');
    }

    if (error) {
        if (isResend) {
            showInlineError(otpError, "Failed to resend: " + (error.message || "Unknown error"));
            btnToUpdate.innerText = 'Resend Code';
            btnToUpdate.disabled = false;
        } else {
            const errorMsg = error.status === 403 ? "Security check failed. Please try again." : error.message;
            showInlineError(emailError, errorMsg || "Failed to send code. Try again.");
        }
        return false;
    } 
    
    return true;
  }

  // Trigger Send
  document.getElementById('send-otp-btn')?.addEventListener('click', async (e) => {
    e.preventDefault();
    const email = emailInput.value.trim();
    if (!email) {
      showInlineError(emailError, "Please enter a valid email address.");
      return;
    }

    const success = await requestOTP(email, false);
    if (success) {
        currentEmail = email;
        if(displayEmail) displayEmail.textContent = email;
        emailStep?.classList.add('hidden');
        emailStep?.classList.remove('flex');
        otpStep?.classList.remove('hidden');
        otpStep?.classList.add('flex');
        otpInput?.focus();
        
        failedAttempts = 0;
        verifyBtn.disabled = false;
        verifyBtn.classList.remove('opacity-70', 'cursor-not-allowed');
        startResendCooldown();
    }
  });

  // Trigger Resend
  resendBtn?.addEventListener('click', async (e) => {
    e.preventDefault();
    if (countdown > 0) return; 
    
    const success = await requestOTP(currentEmail, true);
    if (success) {
        failedAttempts = 0;
        otpInput.value = '';
        verifyBtn.disabled = false;
        verifyBtn.classList.remove('opacity-70', 'cursor-not-allowed');
        startResendCooldown();
        showInlineError(otpError, "A new code has been sent."); 
        setTimeout(() => hideInlineError(otpError), 4000);
    }
  });


  // --- VERIFY OTP ---
  verifyBtn?.addEventListener('click', async (e) => {
    e.preventDefault();
    const otp = otpInput.value.trim();

    hideInlineError(otpError);

    if (!otp || otp.length < 6) {
        showInlineError(otpError, "Please enter the 6-digit code.");
        return;
    }

    verifyBtn.innerText = 'Verifying...';
    verifyBtn.disabled = true;
    verifyBtn.classList.add('opacity-70', 'cursor-not-allowed');

    const { data, error } = await authClient.signIn.emailOtp({
        email: currentEmail,
        otp: otp
    });

    if (error) {
        failedAttempts++;
        
        if (failedAttempts >= MAX_ATTEMPTS) {
            showInlineError(otpError, "Too many failed attempts. Please request a new code.");
            verifyBtn.innerText = 'Verify Code';
        } else {
            showInlineError(otpError, `Invalid code. ${MAX_ATTEMPTS - failedAttempts} attempts remaining.`);
            verifyBtn.innerText = 'Verify Code';
            verifyBtn.disabled = false;
            verifyBtn.classList.remove('opacity-70', 'cursor-not-allowed');
            otpInput.value = ''; 
            otpInput.focus();
        }
    } else {
        verifyBtn.innerText = 'Success!';
        window.location.href = safeReturnUrl; 
    }
  });

  // --- SOCIAL LOGINS ---
  const handleSocialLogin = async (provider: 'google' | 'github' | 'microsoft', btn: HTMLButtonElement) => {
    btn.innerHTML = 'Connecting...';
    btn.disabled = true;
    btn.classList.add('opacity-70');
    await authClient.signIn.social({ provider, callbackURL: safeReturnUrl });
  };

  document.getElementById('google-login-btn')?.addEventListener('click', (e) => handleSocialLogin('google', e.currentTarget as HTMLButtonElement));
  document.getElementById('github-login-btn')?.addEventListener('click', (e) => handleSocialLogin('github', e.currentTarget as HTMLButtonElement));
  document.getElementById('microsoft-login-btn')?.addEventListener('click', (e) => handleSocialLogin('microsoft', e.currentTarget as HTMLButtonElement));

</script>
</Layout>

<style>
  .flex { display: flex; }
  .hidden { display: none !important; }
  .animate-fade-in { animation: fadeIn 0.3s ease-out forwards; }
  @keyframes fadeIn { 
    from { opacity: 0; transform: translateY(4px); } 
    to { opacity: 1; transform: translateY(0); } 
  }
</style>