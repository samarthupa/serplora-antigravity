---
// src/pages/account.astro
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div class="max-w-[960px] mx-auto px-6 py-12 md:py-16 font-['Outfit',sans-serif] min-h-[80vh]">
    
    <header class="mb-8 flex items-center justify-between border-b border-subtle pb-6">
      <h1 class="text-3xl font-[800] text-tx-main tracking-tight">Account Settings</h1>
      <button id="signout-btn" class="px-4 py-2 text-sm font-semibold text-tx-muted hover:text-red-500 transition-colors focus:outline-none cursor-pointer">
        Sign Out
      </button>
    </header>

    <div class="flex flex-col sm:flex-row items-center sm:items-start gap-6 mb-12 p-6 rounded-2xl bg-tx-muted/5 border border-subtle">
      <img id="acc-avatar" src="" alt="Profile Picture" class="w-20 h-20 sm:w-24 sm:h-24 rounded-full border border-subtle hidden object-cover shadow-sm" />
      <div id="acc-avatar-fallback" class="w-20 h-20 sm:w-24 sm:h-24 rounded-full bg-tx-main text-main flex items-center justify-center text-3xl sm:text-4xl font-bold hidden shadow-sm"></div>
      
      <div class="text-center sm:text-left sm:mt-3 flex-1">
        <h2 id="acc-display-name" class="text-2xl font-bold text-tx-main mb-1.5">Loading...</h2>
        <p id="acc-email" class="text-sm font-mono text-tx-muted bg-main px-3 py-1 rounded-lg inline-block border border-subtle"></p>
      </div>
    </div>

    <form id="profile-form" class="flex flex-col gap-8">
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12">
        
        <!-- Personal Info Section -->
        <section>
          <h3 class="text-sm font-bold text-tx-muted uppercase tracking-wider mb-5 pb-2 border-b border-subtle/50">Personal Information</h3>
          <div class="flex flex-col gap-5">
            <div>
              <label class="block text-sm font-semibold text-tx-main mb-1.5">Full Name</label>
              <input type="text" id="acc-name" required class="w-full p-3 rounded-md bg-transparent border border-subtle text-tx-main focus:border-tx-main focus:ring-1 focus:ring-tx-main outline-none transition-all" />
            </div>

            <div class="relative" id="country-container">
              <label class="block text-sm font-semibold text-tx-main mb-1.5">Country</label>
              <input type="hidden" id="acc-country-code" />
              <div class="relative">
                <input type="text" id="acc-country-search" placeholder="Search for a country..." autocomplete="off" class="w-full p-3 pr-10 rounded-md bg-transparent border border-subtle text-tx-main focus:border-tx-main focus:ring-1 focus:ring-tx-main outline-none transition-all cursor-text" />
                
                <!-- Cross / Clear Button -->
                <button type="button" id="clear-country-btn" class="absolute right-3 top-1/2 -translate-y-1/2 text-tx-muted hover:text-tx-main hidden transition-colors focus:outline-none cursor-pointer" title="Clear Country">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                </button>
              </div>

              <div id="country-dropdown" class="absolute z-50 w-full mt-1 max-h-60 overflow-y-auto bg-surface border border-subtle rounded-md shadow-lg hidden custom-scrollbar">
                <!-- Populated by JS -->
              </div>
              <p id="country-hint" class="text-xs text-tx-muted mt-2 hidden">Auto-detected for your convenience.</p>
            </div>
          </div>
        </section>

        <!-- Contact Info Section -->
        <section>
          <h3 class="text-sm font-bold text-tx-muted uppercase tracking-wider mb-5 pb-2 border-b border-subtle/50">Contact Details</h3>
          <div class="flex flex-col gap-5">
            
            <div>
              <label class="block text-sm font-semibold text-tx-main mb-1.5">Phone Number</label>
              <div class="flex gap-2">
                <select id="acc-phone-dial" class="w-[120px] p-3 rounded-md bg-transparent border border-subtle text-tx-main focus:border-tx-main outline-none custom-select-arrow cursor-pointer font-mono text-xs truncate"></select>
                <input type="tel" id="acc-phone" placeholder="9876543210" class="flex-1 p-3 rounded-md bg-transparent border border-subtle text-tx-main focus:border-tx-main focus:ring-1 focus:ring-tx-main outline-none transition-all" />
              </div>
              <p id="phone-error" class="text-xs text-red-500 mt-1.5 hidden">Please enter a valid phone number.</p>
            </div>

            <div class="flex items-center gap-2 mt-1 mb-2">
              <input type="checkbox" id="acc-same-whatsapp" class="w-4 h-4 rounded-sm border-subtle text-tx-main focus:ring-tx-main bg-transparent cursor-pointer" />
              <label for="acc-same-whatsapp" class="text-sm font-medium text-tx-muted cursor-pointer select-none">WhatsApp is the same as Phone</label>
            </div>

            <div id="whatsapp-container" class="transition-all duration-300 overflow-hidden" style="height: 0px; opacity: 0;">
              <label class="block text-sm font-semibold text-tx-main mb-1.5">WhatsApp Number</label>
              <div class="flex gap-2">
                <select id="acc-whatsapp-dial" class="w-[120px] p-3 rounded-md bg-transparent border border-subtle text-tx-main focus:border-tx-main outline-none custom-select-arrow cursor-pointer font-mono text-xs truncate"></select>
                <input type="tel" id="acc-whatsapp" placeholder="9876543210" class="flex-1 p-3 rounded-md bg-transparent border border-subtle text-tx-main focus:border-tx-main focus:ring-1 focus:ring-tx-main outline-none transition-all" />
              </div>
            </div>

          </div>
        </section>
      </div>

      <div class="pt-8 mt-2 border-t border-subtle flex flex-col items-center md:items-end">
        <button type="submit" id="acc-submit-btn" class="w-full md:w-auto md:px-12 py-3 bg-tx-main text-main rounded-md font-bold text-[15px] hover:opacity-90 transition-opacity active:scale-[0.98] outline-none cursor-pointer">
          Save Profile
        </button>
        <p id="save-success" class="text-green-500 text-sm font-semibold mt-3 opacity-0 transition-opacity md:mr-4">Profile saved successfully.</p>
      </div>

    </form>
  </div>

  <style>
    .custom-select-arrow {
      appearance: none;
      background-image: url("data:image/svg+xml,%3Csvg width='10' height='6' viewBox='0 0 10 6' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1L5 5L9 1' stroke='currentColor' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");
      background-repeat: no-repeat;
      background-position: right 12px center;
      padding-right: 28px;
    }
    .custom-scrollbar::-webkit-scrollbar { width: 6px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background-color: var(--color-border-subtle); border-radius: 10px; }
  </style>

