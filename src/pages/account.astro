    async function initAccount() {
      const { data, error } = await authClient.getSession();

      if (!data || !data.user) return;

      const user = data.user as any; 
      let isSaving = false;

      // 1. Populate Avatar & Header with Error Fallback
      const avatarImg = document.getElementById('acc-avatar') as HTMLImageElement;
      const avatarFallback = document.getElementById('acc-avatar-fallback');
      const displayName = document.getElementById('acc-display-name');
      const emailEl = document.getElementById('acc-email');

      if (user.image && avatarImg) {
        avatarImg.src = user.image;
        avatarImg.classList.remove('hidden');
        avatarImg.onerror = () => {
            avatarImg.classList.add("hidden");
            if(avatarFallback) avatarFallback.classList.remove("hidden");
        };
      } else if (avatarFallback && (user.name || user.email)) {
        const initial = user.name ? user.name : user.email;
        avatarFallback.textContent = initial.charAt(0).toUpperCase();
        avatarFallback.classList.remove('hidden');
      }

      if (displayName) displayName.textContent = user.name;
      if (emailEl) emailEl.textContent = user.email;

      // 2. Setup Form Elements
      const nameInput = document.getElementById('acc-name') as HTMLInputElement;
      const countrySearch = document.getElementById('acc-country-search') as HTMLInputElement;
      const countryCodeInput = document.getElementById('acc-country-code') as HTMLInputElement;
      const countryDropdown = document.getElementById('country-dropdown');
      const clearCountryBtn = document.getElementById('clear-country-btn');
      const countryContainer = document.getElementById('country-container');
      
      const phoneDialSelect = document.getElementById('acc-phone-dial') as HTMLSelectElement;
      const phoneInput = document.getElementById('acc-phone') as HTMLInputElement;
      const phoneError = document.getElementById('phone-error');
      
      const whatsappDialSelect = document.getElementById('acc-whatsapp-dial') as HTMLSelectElement;
      const whatsappInput = document.getElementById('acc-whatsapp') as HTMLInputElement;
      const sameCheckbox = document.getElementById('acc-same-whatsapp') as HTMLInputElement;
      const whatsappContainer = document.getElementById('whatsapp-container');

      if (nameInput) nameInput.value = user.name || '';

      // Populate Dial Code Selects with Context (using unique country code as value)
      countryData.forEach(c => {
        const opt1 = document.createElement('option');
        opt1.text = `${c.name} (${c.dial})`;
        opt1.value = c.code; // Store country code to prevent US / Antigua collisions
        opt1.dataset.dial = c.dial;
        phoneDialSelect.add(opt1);

        const opt2 = document.createElement('option');
        opt2.text = `${c.name} (${c.dial})`;
        opt2.value = c.code; 
        opt2.dataset.dial = c.dial;
        whatsappDialSelect.add(opt2);
      });

      // Robust Phone Parsing
      function parsePhone(fullString: string) {
        if (!fullString) return { dial: '', num: '' };
        const match = fullString.match(/^(\+\d+)[-\s]*(.*)$/);
        if (match) return { dial: match[1], num: match[2].replace(/\D/g, '') };
        return { dial: '', num: fullString.replace(/\D/g, '') };
      }

      const parsedPhone = parsePhone(user.phone);
      const parsedWhatsapp = parsePhone(user.whatsapp);
      
      // Auto-select the proper option mapped to user's country if possible
      if (parsedPhone.dial) {
         let match = countryData.find(c => c.code === user.country && c.dial === parsedPhone.dial) 
                  || countryData.find(c => c.dial === parsedPhone.dial);
         if (match) phoneDialSelect.value = match.code;
      }
      phoneInput.value = parsedPhone.num;

      if (parsedWhatsapp.dial) {
         let match = countryData.find(c => c.code === user.country && c.dial === parsedWhatsapp.dial) 
                  || countryData.find(c => c.dial === parsedWhatsapp.dial);
         if (match) whatsappDialSelect.value = match.code;
      }
      whatsappInput.value = parsedWhatsapp.num;

      // Checkbox Logic Initial State
      if (user.phone && user.whatsapp && user.phone === user.whatsapp) {
          sameCheckbox.checked = true;
          if (whatsappContainer) {
            whatsappContainer.style.height = '0px';
            whatsappContainer.style.opacity = '0';
          }
      } else if (whatsappContainer) {
          whatsappContainer.style.height = whatsappContainer.scrollHeight + 'px';
          whatsappContainer.style.opacity = '1';
      }

      // 3. Searchable Country Dropdown Logic with Keyboard Nav
      let activeIndex = -1;
      let currentFiltered: typeof countryData = [];

      function renderDropdown(filterText = '') {
        if (!countryDropdown) return;
        countryDropdown.innerHTML = '';
        const lowerFilter = filterText.toLowerCase();
        
        currentFiltered = countryData.filter(c => 
          c.name.toLowerCase().includes(lowerFilter) || 
          c.code.toLowerCase().includes(lowerFilter) ||
          c.aliases?.some(alias => alias.includes(lowerFilter))
        );
        
        if (currentFiltered.length === 0) {
          countryDropdown.innerHTML = `<div class="p-3 text-sm text-tx-muted">No countries found</div>`;
          return;
        }

        currentFiltered.forEach((c, index) => {
          const div = document.createElement('div');
          div.className = 'country-item p-3 text-sm text-tx-main hover:bg-tx-main hover:text-main cursor-pointer transition-colors';
          div.textContent = c.name;
          div.setAttribute('data-index', index.toString());
          
          div.addEventListener('mousedown', (e) => { 
            e.preventDefault();
            selectCountry(c);
          });
          countryDropdown.appendChild(div);
        });
        activeIndex = -1; 
      }

      function updateActiveItem() {
        const items = countryDropdown?.querySelectorAll('.country-item');
        if (!items) return;
        
        items.forEach((item, i) => {
          if (i === activeIndex) {
            item.classList.add('bg-tx-main', 'text-main');
            (item as HTMLElement).scrollIntoView({ block: 'nearest' });
          } else {
            item.classList.remove('bg-tx-main', 'text-main');
          }
        });
      }

      function selectCountry(country: typeof countryData[0]) {
        countrySearch.value = country.name;
        countryCodeInput.value = country.code;
        countryDropdown?.classList.add('hidden');
        
        // Select country code logically to ensure it maps to the correct duplicate dial (e.g. US vs Antigua)
        phoneDialSelect.value = country.code;
        if (!sameCheckbox.checked) whatsappDialSelect.value = country.code;

        // Lock the Input
        countrySearch.readOnly = true;
        countrySearch.classList.add('bg-tx-muted/10', 'text-tx-muted', 'cursor-default');
        countrySearch.classList.remove('bg-transparent', 'cursor-text');
        clearCountryBtn?.classList.remove('hidden');
      }

      clearCountryBtn?.addEventListener('click', (e) => {
        e.preventDefault();
        countrySearch.value = '';
        countryCodeInput.value = '';
        
        // Unlock the Input
        countrySearch.readOnly = false;
        countrySearch.classList.remove('bg-tx-muted/10', 'text-tx-muted', 'cursor-default');
        countrySearch.classList.add('bg-transparent', 'cursor-text');
        clearCountryBtn.classList.add('hidden');
        document.getElementById('country-hint')?.classList.add('hidden');
        
        countrySearch.focus();
        renderDropdown('');
        countryDropdown?.classList.remove('hidden');
      });

      countrySearch.addEventListener('focus', () => {
        if (countrySearch.readOnly) return; 
        renderDropdown(countrySearch.value);
        countryDropdown?.classList.remove('hidden');
      });

      countrySearch.addEventListener('input', (e) => {
        renderDropdown((e.target as HTMLInputElement).value);
      });

      countrySearch.addEventListener('keydown', (e) => {
        if (countrySearch.readOnly) return; 
        if (countryDropdown?.classList.contains('hidden')) return;
        
        if (e.key === 'ArrowDown') {
          e.preventDefault();
          activeIndex = (activeIndex + 1) % currentFiltered.length;
          updateActiveItem();
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          activeIndex = (activeIndex - 1 + currentFiltered.length) % currentFiltered.length;
          updateActiveItem();
        } else if (e.key === 'Enter') {
          e.preventDefault();
          if (activeIndex >= 0 && currentFiltered[activeIndex]) {
            selectCountry(currentFiltered[activeIndex]);
          }
        }
      });

      // Handle clicking outside the custom country dropdown container
      document.addEventListener('mousedown', (e) => {
        if (countryContainer && !countryContainer.contains(e.target as Node)) {
          if (!countryDropdown?.classList.contains('hidden')) {
            countryDropdown?.classList.add('hidden');
            
            // Revert invalid typing if they clicked away without selecting
            if (!countrySearch.readOnly) {
              if (!countryCodeInput.value) {
                countrySearch.value = ''; 
              } else {
                const matchingCountry = countryData.find(c => c.code === countryCodeInput.value);
                if (matchingCountry && countrySearch.value !== matchingCountry.name) {
                  countrySearch.value = matchingCountry.name;
                }
              }
            }
          }
        }
      });

      // 4. Handle Country Auto-Detection safely
      if (!user.country) {
        try {
          fetch('/api/get-location').then(res => res.json()).then(locData => {
             const detected = countryData.find(c => c.code === locData.country);
             
             // Only auto-fill if the user hasn't already made a selection or started typing something!
             if (detected && !countryCodeInput.value && !countrySearch.value && !countrySearch.readOnly) {
               selectCountry(detected);
               document.getElementById('country-hint')?.classList.remove('hidden');
             }
          }).catch(() => {});
        } catch (err) {}
      } else {
        const existing = countryData.find(c => c.code === user.country);
        if (existing) selectCountry(existing);
      }

      // 5. ScrollHeight Toggle Logic
      sameCheckbox.addEventListener('change', (e) => {
        const isChecked = (e.target as HTMLInputElement).checked;
        if (!whatsappContainer) return;

        if (isChecked) {
          whatsappContainer.style.height = '0px';
          whatsappContainer.style.opacity = '0';
          whatsappInput.value = phoneInput.value; 
          whatsappDialSelect.value = phoneDialSelect.value;
        } else {
          whatsappContainer.style.height = whatsappContainer.scrollHeight + 'px';
          whatsappContainer.style.opacity = '1';
          if (whatsappInput.value === phoneInput.value) whatsappInput.value = '';
        }
      });

      phoneInput.addEventListener('input', () => {
        if (sameCheckbox.checked) whatsappInput.value = phoneInput.value;
      });
      phoneDialSelect.addEventListener('change', () => {
        if (sameCheckbox.checked) whatsappDialSelect.value = phoneDialSelect.value;
      });

      // 6. Handle Form Submission
      const form = document.getElementById('profile-form');
      const submitBtn = document.getElementById('acc-submit-btn');
      const successMsg = document.getElementById('save-success');
      
      const phoneRegex = /^[0-9\-\s]{6,15}$/;

      form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        if (isSaving || !submitBtn) return;

        // Validation
        const rawPhone = phoneInput.value.trim();
        if (rawPhone && !phoneRegex.test(rawPhone)) {
            if (phoneError) phoneError.classList.remove('hidden');
            phoneInput.focus();
            return;
        }
        if (phoneError) phoneError.classList.add('hidden');

        isSaving = true;
        const originalText = submitBtn.innerHTML;
        submitBtn.innerHTML = 'Saving...';
        (submitBtn as HTMLButtonElement).disabled = true;
        submitBtn.classList.add('opacity-50', 'cursor-not-allowed');

        try {
            // Get proper dial codes stored in dataset
            const pOpt = phoneDialSelect.options[phoneDialSelect.selectedIndex];
            const wOpt = whatsappDialSelect.options[whatsappDialSelect.selectedIndex];
            const pDial = pOpt ? pOpt.dataset.dial : '';
            const wDial = wOpt ? wOpt.dataset.dial : '';

            const finalPhone = rawPhone ? `${pDial} ${rawPhone}` : '';
            let finalWhatsapp = whatsappInput.value.trim() ? `${wDial} ${whatsappInput.value.trim()}` : '';
            
            if (sameCheckbox.checked) finalWhatsapp = finalPhone;

            const { error: updateError } = await authClient.updateUser({
              name: nameInput.value,
              country: countryCodeInput.value,
              phone: finalPhone,
              whatsapp: finalWhatsapp
            });

            if (updateError) {
              alert("Failed to save profile: " + updateError.message);
            } else {
              if (displayName) displayName.textContent = nameInput.value;
              if (successMsg) {
                  successMsg.style.opacity = '1';
                  setTimeout(() => successMsg.style.opacity = '0', 3000);
              }
            }
        } finally {
            isSaving = false;
            submitBtn.innerHTML = originalText;
            (submitBtn as HTMLButtonElement).disabled = false;
            submitBtn.classList.remove('opacity-50', 'cursor-not-allowed');
        }
      });

      // 7. Handle Sign Out
      document.getElementById('signout-btn')?.addEventListener('click', async () => {
        await authClient.signOut({
          fetchOptions: { onSuccess: () => { window.location.href = '/login'; } }
        });
      });
    }

    initAccount();
  </script>
</Layout>