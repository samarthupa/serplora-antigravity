---
// src/pages/account.astro
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div class="max-w-[800px] mx-auto px-6 py-12 md:py-20 font-['Outfit',sans-serif] min-h-[75vh]">
    
    <header class="mb-10 flex items-center justify-between">
      <h1 class="text-3xl md:text-4xl font-[800] text-tx-main tracking-tight">Your Account</h1>
      <button id="signout-btn" class="px-5 py-2.5 rounded-lg bg-red-500/10 text-red-500 font-semibold hover:bg-red-500/20 transition-colors">
        Sign Out
      </button>
    </header>

    {/* Centered Profile Card (History section removed as requested) */}
    <div class="max-w-md mx-auto bg-surface border border-subtle rounded-2xl p-8 shadow-sm flex flex-col items-center text-center">
      <div id="acc-avatar" class="w-24 h-24 rounded-full bg-blue-600 text-white flex items-center justify-center text-4xl font-bold mb-4 shadow-md"></div>
      <h2 id="acc-name" class="text-2xl font-bold text-tx-main mb-1">Loading...</h2>
      <p id="acc-email" class="text-md text-tx-muted mb-6"></p>
      
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-main border border-subtle">
        <svg class="w-5 h-5 text-tx-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        <span id="acc-country" class="text-sm font-bold text-tx-muted uppercase tracking-wider"></span>
      </div>
    </div>

  </div>

  <script>
    import { authClient } from '../lib/auth-client';

    async function initAccount() {
      // 1. Fetch user using Better Auth Session
      const { data, error } = await authClient.getSession();

      if (error || !data || !data.session) {
        // Redirect to login if not authenticated
        window.location.href = '/login';
        return;
      }

      const user = data.user;

      // Populate Profile Info
      const avatarEl = document.getElementById('acc-avatar');
      if (avatarEl && user.name) avatarEl.textContent = user.name.charAt(0).toUpperCase();
      
      const nameEl = document.getElementById('acc-name');
      if (nameEl) nameEl.textContent = user.name;
      
      const emailEl = document.getElementById('acc-email');
      if (emailEl) emailEl.textContent = user.email;
      
      const countryEl = document.getElementById('acc-country');
      // Custom schema columns like country might require Better Auth plugin config to surface in session,
      // but we safely bind it here if it exists.
      if (countryEl) countryEl.textContent = (user as any).country || 'Not specified';

      // 2. Handle Sign Out via Better Auth
      const signoutBtn = document.getElementById('signout-btn');
      if (signoutBtn) {
        signoutBtn.addEventListener('click', async () => {
          signoutBtn.textContent = 'Signing out...';
          await authClient.signOut({
            fetchOptions: {
              onSuccess: () => {
                window.location.href = '/login';
              }
            }
          });
        });
      }
    }

    // Run the initialization
    initAccount();
  </script>
</Layout>