---
import { getCollection, render } from 'astro:content';
import { BM25Utils } from 'relatinator';
import Layout from '../../layouts/Layout.astro';

export const prerender = true;

export async function getStaticPaths() {
  const allPosts = await getCollection('posts');
  const publishedPosts = allPosts.filter((entry) => !entry.data.draft);

  // 1. Prepare documents for Relatinator to read
  const documents = publishedPosts.map((post) => {
    // Combine all text data into one string (Title, Excerpt, Category, Tags, Body)
    const contentToAnalyze = [
      post.data.title,
      post.data.excerpt,
      post.data.category,
      post.data.tags ? post.data.tags.join(' ') : '',
      post.body || ''
    ].filter(Boolean).join(' ');

    return {
      id: post.id,
      content: contentToAnalyze,
    };
  });

  // 2. Reset and Train the BM25 model (Reset is important for dev-mode live reloads)
  await BM25Utils.resetInstance();
  await BM25Utils.train(documents);

  // 3. Generate pages and find related posts for each one
  const paths = await Promise.all(publishedPosts.map(async (entry) => {
    
    // Reconstruct the current post's text to compare against the model
    const contentToCompare = [
      entry.data.title,
      entry.data.excerpt,
      entry.data.category,
      entry.data.tags ? entry.data.tags.join(' ') : '',
      entry.body || ''
    ].filter(Boolean).join(' ');

    // 4. Ask Relatinator for the top 6 related document IDs
    const relatedIds = await BM25Utils.findRelated(contentToCompare, entry.id, 6);

    // 5. Convert those IDs back into actual post objects
    const relatedPosts = relatedIds
      .map(id => publishedPosts.find(p => p.id === id))
      .filter(Boolean); // removes any undefined

    return {
      params: { slug: entry.id },
      props: { entry, relatedPosts },
    };
  }));

  return paths;
}

// Now we simply receive the relatedPosts that were calculated during the build!
const { entry, relatedPosts } = Astro.props;
const { Content } = await render(entry);

// --- DATE LOGIC ---
const displayDate = entry.data.updatedDate || entry.data.publishDate || new Date();
const formattedDate = new Date(displayDate).toISOString().split('T')[0]; // YYYY-MM-DD
---

<Layout>
  {/* Dev-style fading grid background */}
  <div class="absolute inset-0 bg-[linear-gradient(to_right,#80808012_1px,transparent_1px),linear-gradient(to_bottom,#80808012_1px,transparent_1px)] bg-[size:24px_24px] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)] -z-10 h-[600px] pointer-events-none"></div>

  <main class="w-full bg-transparent py-10 md:py-20 font-['Outfit',sans-serif]">
    <article class="max-w-[900px] mx-auto px-6">
      
      {/* 1. Terminal Breadcrumbs */}
      <nav aria-label="Breadcrumb" class="mb-8 md:mb-10 font-['JetBrains_Mono',monospace] text-[12px] md:text-[13px] text-tx-muted flex items-center gap-2">
        <a href="/" class="hover:text-blue-500 transition-colors">~</a>
        <span class="opacity-40">/</span>
        <a href="/blog" class="hover:text-blue-500 transition-colors">blog</a>
        <span class="opacity-40">/</span>
        <span class="text-tx-main truncate font-medium" aria-current="page">{entry.id}.md</span>
      </nav>

      {/* 2. Header (Title & Excerpt) */}
      <header class="mb-10 md:mb-12">
        <h1 class="text-3xl md:text-5xl font-[800] text-tx-main tracking-tight leading-[1.2] md:leading-[1.15] mb-6">
          {entry.data.title || entry.id}
        </h1>
        {/* Excerpt Section */}
        {entry.data.excerpt && (
          <div class="markdown-content text-[16px] md:text-[20px] font-[400] leading-[1.7] md:leading-[1.8]" set:html={entry.data.excerpt} />
        )}
      </header>

      {/* 3. Featured Image (EXACT 16:9 / 1200x675 RATIO) */}
      {entry.data.image && (
        <figure class="mb-10 w-full rounded-[12px] md:rounded-[16px] border border-subtle bg-surface shadow-sm overflow-hidden">
          <img 
            src={entry.data.image} 
            alt={entry.data.title} 
            class="w-full aspect-video object-cover"
          />
        </figure>
      )}

      {/* 4. Git-Style Meta Block */}
      <div class="flex flex-wrap items-center gap-x-8 gap-y-4 py-5 border-y border-subtle mb-12 font-['JetBrains_Mono',monospace] text-[12px] md:text-[13px]">
        <div class="flex items-center gap-3">
          {entry.data.authorImage ? (
            <img src={entry.data.authorImage} alt={entry.data.authorName} class="w-9 h-9 rounded-md object-cover border border-subtle" />
          ) : (
            <div class="w-9 h-9 rounded-md bg-main border border-subtle flex items-center justify-center font-bold text-tx-main text-[14px]">
              {entry.data.authorName.charAt(0)}
            </div>
          )}
          <div class="flex flex-col">
            <span class="text-tx-muted text-[10px] uppercase tracking-wider">Author</span>
            <span class="text-tx-main font-medium">{entry.data.authorName}</span>
          </div>
        </div>
        
        <div class="w-[1px] h-8 bg-subtle hidden sm:block"></div>
        
        <div class="flex flex-col">
          <span class="text-tx-muted text-[10px] uppercase tracking-wider">Last Commit</span>
          <span class="text-tx-main font-medium">{formattedDate}</span>
        </div>
      </div>

      {/* 5. Main Content Area */}
      <div class="markdown-content text-[16px] md:text-[20px] leading-[1.7] md:leading-[1.8] pb-16 border-b border-subtle font-['Outfit',sans-serif]">
        <Content />
      </div>

      {/* 6. FAQ Section */}
      {entry.data.faqs && entry.data.faqs.length > 0 && (
        <section class="mt-16 pb-16 border-b border-subtle">
          <h2 class="text-2xl font-[800] text-tx-main mb-8 tracking-tight flex items-center gap-3">
            <svg class="w-6 h-6 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M4 12a8 8 0 1116 0 8 8 0 01-16 0z" /></svg>
            FAQ.md
          </h2>
          <div class="flex flex-col gap-3 md:gap-4">
            {entry.data.faqs.map((faq: any) => (
              <details class="group bg-surface border border-subtle rounded-[8px] overflow-hidden [&_summary::-webkit-details-marker]:hidden">
                <summary class="flex items-center justify-between cursor-pointer px-4 md:px-5 py-4 font-[600] text-[16px] md:text-[17px] text-tx-main bg-surface hover:bg-main transition-colors outline-none select-none">
                  <span class="flex items-center gap-3 pr-4">
                    <span class="text-blue-500 font-['JetBrains_Mono',monospace] font-bold">?</span>
                    {faq.question}
                  </span>
                  <span class="transition-transform duration-300 group-open:rotate-180 text-tx-muted font-['JetBrains_Mono',monospace] shrink-0">
                    ↓
                  </span>
                </summary>
                <div class="faq-content px-4 md:px-5 pb-5 pt-3 text-[15px] md:text-[16px] font-[400] text-tx-muted leading-[1.6] md:leading-[1.7] bg-surface border-t border-subtle/50 md:ml-6">
                  <div set:html={faq.answer} />
                </div>
              </details>
            ))}
          </div>
        </section>
      )}

      {/* 7. Related Articles (Now maps up to 6 items perfectly!) */}
      {relatedPosts.length > 0 && (
        <section class="mt-16">
          <h3 class="text-xl font-[800] text-tx-main mb-6 tracking-tight font-['JetBrains_Mono',monospace]">ls ./related-posts</h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 md:gap-6">
            {relatedPosts.map((post) => (
              <a 
                href={`/blog/${post.id}`}
                class="group flex flex-col bg-surface rounded-[12px] border border-subtle p-4 md:p-5 hover:border-blue-500/50 hover:shadow-md hover:shadow-blue-500/5 transition-all duration-300"
              >
                {post.data.image && (
                  <img src={post.data.image} alt={post.data.title} class="w-full h-32 md:h-36 object-cover rounded-[8px] mb-4 border border-subtle" />
                )}
                <h4 class="text-[16px] md:text-[17px] font-[700] text-tx-main group-hover:text-blue-500 transition-colors mb-2 line-clamp-2 leading-tight">
                  {post.data.title || post.id}
                </h4>
                {post.data.excerpt && (
                  <p class="text-[13px] md:text-[14px] font-[400] text-tx-muted line-clamp-2 mt-auto">
                    {post.data.excerpt.replace(/<[^>]*>?/gm, '')}
                  </p>
                )}
              </a>
            ))}
          </div>
        </section>
      )}
      
    </article>
  </main>
  {entry.data.customJs && (
    <script is:inline set:html={entry.data.customJs}></script>
  )}
</Layout>

<style is:global>
  /* Fixes native details tag jumping */
  details > summary { list-style: none; }

  /* --- DEV-STYLE MARKDOWN FORMATTING --- */

  /* Headings */
  .markdown-content h1, .markdown-content h2, .markdown-content h3, .markdown-content h4 {
    color: var(--color-tx-main);
    font-weight: 800;
    letter-spacing: -0.025em;
    margin-top: 2em;
    margin-bottom: 0.75em;
  }
  .markdown-content h2 { font-size: 1.75rem; line-height: 1.3; }
  .markdown-content h3 { font-size: 1.4rem; line-height: 1.3; }
  
  @media (min-width: 768px) {
    .markdown-content h2 { font-size: 2rem; }
    .markdown-content h3 { font-size: 1.5rem; }
  }
  
  /* Paragraphs & Text */
  .markdown-content p, .faq-content p { 
    color: var(--color-tx-muted);
    margin-bottom: 1.5em; 
    opacity: 0.8;
  }
  .markdown-content p:last-child {
    margin-bottom: 0;
  }
  .markdown-content strong, .faq-content strong {
    color: var(--color-tx-main);
    font-weight: 700;
  }
  
  /* Links */
  .markdown-content a, .faq-content a { 
    color: #3b82f6; 
    text-decoration: none; 
    font-weight: 500;
  }
  .markdown-content a:hover, .faq-content a:hover { 
    text-decoration: underline; 
  }

  /* Lists */
  .markdown-content ul, .faq-content ul { 
    list-style-type: disc; 
    padding-left: 1.2em; 
    margin-bottom: 1.5em; 
    color: var(--color-tx-muted);
    opacity: 0.8;
  }
  .markdown-content ol, .faq-content ol { 
    list-style-type: decimal; 
    padding-left: 1.2em; 
    margin-bottom: 1.5em; 
    color: var(--color-tx-muted);
    opacity: 0.8;
  }
  .markdown-content li, .faq-content li { 
    margin-bottom: 0.5em; 
    padding-left: 0.25em;
  }

  /* Blockquotes */
  .markdown-content blockquote { 
    border-left: 4px solid #3b82f6; 
    padding-left: 1.25em; 
    color: var(--color-tx-main); 
    font-style: italic; 
    margin-bottom: 1.5em; 
    background-color: var(--color-bg-surface);
    padding-top: 0.5em;
    padding-bottom: 0.5em;
    border-radius: 0 0.5rem 0.5rem 0;
  }

/* Code Blocks */
  .markdown-content pre { 
    background-color: var(--color-bg-surface); 
    border: 1px solid var(--color-border-subtle); 
    border-radius: 0.75rem; 
    padding: 1.25rem; 
    overflow-x: auto; 
    margin-bottom: 1.75em; 
    box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
    position: relative; 
    /* 🟢 Apply font sizing directly to the PRE tag */
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.85em; 
    line-height: 1.6;
    color: var(--color-tx-main);
    opacity: 0.9;
  }
  
  /* Inline code snippets (e.g. `setTimeout()`) */
  .markdown-content code { 
    font-family: 'JetBrains Mono', monospace; 
    font-size: 0.85em; 
    color: #3b82f6; 
    background-color: rgba(59, 130, 246, 0.1); 
    padding: 0.2em 0.4em; 
    border-radius: 0.25rem; 
  }

  /* 🟢 Copy Button Styles */
  .copy-code-btn {
    position: absolute;
    top: 8px;
    right: 8px;
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border-subtle);
    color: var(--color-tx-muted);
    border-radius: 6px;
    padding: 4px 10px;
    font-size: 10px;
    font-family: 'JetBrains Mono', monospace;
    font-weight: 600;
    cursor: pointer;
    opacity: 0; 
    transition: all 0.2s ease;
  }
  .markdown-content pre:hover .copy-code-btn {
    opacity: 1; 
  }
  .copy-code-btn:hover {
    background: var(--color-bg-main);
    color: var(--color-tx-main);
  }
  /* Active "Copied!" state */
  .copy-code-btn.copied {
    color: #10b981; 
    border-color: #10b981;
  }

  /* Images inside content */
  .markdown-content img { 
    border-radius: 0.75rem; 
    border: 1px solid var(--color-border-subtle); 
    margin-bottom: 1.75em; 
    margin-top: 1.75em;
    width: 100%;
    height: auto;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Find every code block on the page
    const codeBlocks = document.querySelectorAll('.markdown-content pre');

    codeBlocks.forEach((preBlock: any) => {
      // 🟢 1. Grab the raw code text BEFORE we inject the button into the HTML
      const textToCopy = preBlock.innerText || preBlock.textContent;

      // 2. Create the button element
      const copyButton = document.createElement('button');
      copyButton.className = 'copy-code-btn';
      copyButton.textContent = 'Copy';

      // 3. Append the button inside the <pre> tag
      preBlock.appendChild(copyButton);

      // 4. Add click event to copy text
      copyButton.addEventListener('click', async () => {
        try {
          // Use the modern clipboard API to copy the saved text
          await navigator.clipboard.writeText(textToCopy);
          
          // Visual feedback (Change to Copied!)
          copyButton.textContent = 'Copied!';
          copyButton.classList.add('copied');

          // Reset back to normal after 2 seconds
          setTimeout(() => {
            copyButton.textContent = 'Copy';
            copyButton.classList.remove('copied');
          }, 2000);

        } catch (err) {
          console.error('Failed to copy code: ', err);
          copyButton.textContent = 'Error';
        }
      });
    });
  });
</script>