---
import { getCollection, getEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import UtilityActions from '../../components/ui/UtilityActions.astro'; 

const pageData = await getEntry('projectsPage', 'data');
const headline = pageData?.data?.headline || 'Our Projects';
const subheadline = pageData?.data?.subheadline || 'Explore our latest builds and tools.';
const seo = pageData?.data?.seo || {};

const categories = await getCollection('projectCategories');
---

<Layout 
  title={seo?.metaTitle || headline} 
  description={seo?.metaDescription || subheadline}
  hasNewsletterModal={true} 
>
  <main class="w-full bg-main text-tx-main font-['Outfit',sans-serif] px-4 pt-8 pb-20 sm:px-8 md:px-12 lg:px-14 lg:pt-10 lg:pb-32 max-w-[1600px] mx-auto min-h-screen">
    
    <Breadcrumb 
      section="projects" 
      current={pageData?.data?.breadcrumbTitle || 'Projects'} 
      class="flex items-center gap-1.5 text-[12px] md:text-[13px] text-tx-muted mb-10 font-['JetBrains_Mono',monospace]"
    />

    <div class="flex flex-col items-center text-center pb-8 mb-8">
      <h1 class="text-3xl md:text-4xl font-[800] tracking-tight mb-4 text-tx-main">
        {headline}
      </h1>
      <p class="text-[16px] sm:text-[18px] text-tx-muted leading-relaxed max-w-3xl mx-auto mb-6">
        {subheadline}
      </p>
      
      <div class="flex justify-center items-center gap-3 flex-wrap text-tx-muted">
        <UtilityActions showShare={true} showNewsletter={true} showGoogle={true} />
      </div>
    </div>

    <!-- Updated Grid: Starts left on mobile, centers on md screens and up -->
    <!-- Grid Container (Removed justify-items classes) -->
<div class="grid grid-cols-[repeat(auto-fill,minmax(320px,1fr))] gap-5 md:gap-6 relative z-10">
  {categories.length > 0 ? (
    categories.map((cat) => (
      <a 
        href={`/projects/${cat.id}`} 
        /* ADDED mx-auto lg:mx-0 HERE */
        class="group bg-surface border border-subtle rounded-[20px] md:rounded-[24px] p-6 md:p-8 flex flex-col hover:border-brand/50 transition-all duration-300 shadow-sm hover:shadow-lg hover:-translate-y-1.5 outline-none w-full max-w-[480px] mx-auto lg:mx-0"
      >
        
        <div class="w-12 h-12 md:w-14 md:h-14 rounded-2xl flex items-center justify-center mb-5 md:mb-6 text-brand bg-gradient-to-br from-brand/10 to-brand/5 border border-brand/10 shadow-sm transition-transform duration-300 group-hover:scale-110 origin-left [&>svg]:w-6 [&>svg]:h-6 md:[&>svg]:w-7 md:[&>svg]:h-7 [&>svg]:object-contain">
          <Fragment set:html={cat.data.iconSvg || '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10" /></svg>'} />
        </div>
        
        <h2 class="text-2xl font-[800] text-tx-main mb-3 tracking-tight group-hover:text-brand transition-colors duration-300">
          {cat.data.title}
        </h2>
        
        <p class="text-tx-muted text-[15px] leading-relaxed md:mb-auto">
          {cat.data.description}
        </p>
      
      </a>
    ))
  ) : (
    <div class="col-span-full w-full bg-surface border border-subtle rounded-[24px] p-12 text-center">
      <h2 class="text-2xl font-[800] text-tx-main mb-2">No Categories Found</h2>
      <p class="text-tx-muted">Create a Project Category in the CMS to get started.</p>
    </div>
  )}
</div>
    
  </main>
</Layout>