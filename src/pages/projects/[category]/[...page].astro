---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import Breadcrumb from '../../../components/ui/Breadcrumb.astro';
import UtilityActions from '../../../components/ui/UtilityActions.astro'; // 🟢 ADDED THIS

export async function getStaticPaths() {
  const categories = await getCollection('projectCategories');
  const allProjects = await getCollection('projects', ({ data }) => {
    return import.meta.env.PROD ? !data.draft : true;
  });

  return categories.flatMap((category) => {
    // 1. Filter projects for this specific category
    const filteredProjects = allProjects.filter(p => p.data.categories.includes(category.id));
    
    // 2. Grab the specific page size from the category collection
    const pageSize = category.data.postsPerPage || 9;
    const totalPages = Math.ceil(filteredProjects.length / pageSize) || 1;

    // 3. Manually construct pagination paths to include "/page/"
    return Array.from({ length: totalPages }).map((_, i) => {
      const currentPage = i + 1;
      const isFirst = currentPage === 1;
      const isLast = currentPage === totalPages;
      const start = i * pageSize;
      const end = start + pageSize;
      const data = filteredProjects.slice(start, end);

      return {
        params: { 
          category: category.id,
          page: isFirst ? undefined : `page/${currentPage}`
        },
        props: { 
          category,
          page: {
            data,
            currentPage,
            lastPage: totalPages,
            url: {
              prev: isFirst ? undefined : (currentPage === 2 ? `/projects/${category.id}` : `/projects/${category.id}/page/${currentPage - 1}`),
              next: isLast ? undefined : `/projects/${category.id}/page/${currentPage + 1}`,
            }
          }
        }
      };
    });
  });
}

const { category, page } = Astro.props;
const projects = page.data; 

// --- Calculate counts directly in the component safely ---
const allLiveProjects = await getCollection('projects', ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});

const categoryProjects = allLiveProjects.filter(p => p.data.categories.includes(category.id));

const counts = {
  all: categoryProjects.length,
  beginner: categoryProjects.filter(p => p.data.difficulty === 'beginner').length,
  intermediate: categoryProjects.filter(p => p.data.difficulty === 'intermediate').length,
  advanced: categoryProjects.filter(p => p.data.difficulty === 'advanced').length,
};
// -------------------------------------------------------------

// Dynamic SEO explicitly controlled by the Category
let pageTitle = category.data.seo?.metaTitle || category.data.title;
let robotsIndex = category.data.seo?.robotsIndex !== false;

if (page.currentPage > 1) {
  const template = category.data.paginationTitleTemplate || ' - Page {page}';
  pageTitle += template.replace('{page}', String(page.currentPage));
  
  if (category.data.noindexPaginated) {
    robotsIndex = false;
  }
}

const dynamicSeo = {
  ...category.data.seo,
  metaTitle: pageTitle,
  robotsIndex: robotsIndex
};

const gradients = [
  'from-[#f5f7fa] to-[#c3cfe2]',
  'from-[#e0c3fc] to-[#8ec5fc]',
  'from-[#fdfbfb] to-[#ebedee]'
];
---

<Layout 
  title={dynamicSeo.metaTitle} 
  description={category.data.seo?.metaDescription || category.data.description} 
  seo={dynamicSeo}
  hasNewsletterModal={true} 
>
  <main class="w-full max-w-[1200px] mx-auto px-5 pt-12 pb-20 md:pt-16 md:pb-20 font-['Outfit',sans-serif] min-h-screen relative">
    
    <Breadcrumb 
      section="projects" 
      parents={[{ label: 'Projects', url: '/projects' }]}
      current={category.data.breadcrumbTitle || category.data.title} 
    />
    
    <header class="mb-10 flex flex-col md:flex-row md:items-start justify-between gap-6">
      <div>
        <h1 class="text-4xl md:text-[40px] font-[800] text-tx-main tracking-tight mb-3">
          {category.data.title} Projects
        </h1>
        <p class="text-base text-tx-muted max-w-2xl">
          {category.data.description}
        </p>
      </div>

      <div class="flex items-center gap-2 w-full md:w-auto justify-between md:justify-end">
        
        <UtilityActions />
        
        <button onclick="toggleBottomSheet()" class="md:hidden flex items-center justify-center gap-1.5 px-4 h-9 rounded-full bg-tx-main text-main font-[500] text-[13px] hover:opacity-80 transition-opacity">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="21" x2="4" y2="14"></line><line x1="4" y1="10" x2="4" y2="3"></line><line x1="12" y1="21" x2="12" y2="12"></line><line x1="12" y1="8" x2="12" y2="3"></line><line x1="20" y1="21" x2="20" y2="16"></line><line x1="20" y1="12" x2="20" y2="3"></line><line x1="1" y1="14" x2="7" y2="14"></line><line x1="9" y1="8" x2="15" y2="8"></line><line x1="17" y1="16" x2="23" y2="16"></line></svg>
          Filters
        </button>
      </div>
    </header>

    <div class="hidden md:flex flex-wrap gap-3 mb-10" id="desktop-filters">
      <button class="filter-btn active px-4 py-2 text-[14px] font-[500] text-tx-muted rounded-full transition-all hover:bg-tx-muted/10 [&.active]:bg-tx-main [&.active]:text-main" data-filter="all" onclick="applyFilter('all')">
        All projects ({counts.all})
      </button>
      
      {counts.beginner > 0 && (
        <button class="filter-btn px-4 py-2 text-[14px] font-[500] text-tx-muted rounded-full transition-all hover:bg-tx-muted/10 [&.active]:bg-tx-main [&.active]:text-main" data-filter="beginner" onclick="applyFilter('beginner')">
          Beginner ({counts.beginner})
        </button>
      )}
      
      {counts.intermediate > 0 && (
        <button class="filter-btn px-4 py-2 text-[14px] font-[500] text-tx-muted rounded-full transition-all hover:bg-tx-muted/10 [&.active]:bg-tx-main [&.active]:text-main" data-filter="intermediate" onclick="applyFilter('intermediate')">
          Intermediate ({counts.intermediate})
        </button>
      )}
      
      {counts.advanced > 0 && (
        <button class="filter-btn px-4 py-2 text-[14px] font-[500] text-tx-muted rounded-full transition-all hover:bg-tx-muted/10 [&.active]:bg-tx-main [&.active]:text-main" data-filter="advanced" onclick="applyFilter('advanced')">
          Advanced ({counts.advanced})
        </button>
      )}
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-16 transition-opacity duration-300" id="project-grid">
      {projects.length > 0 ? projects.map((project, index) => (
        <a 
          href={`/projects/${category.id}/${project.id}`} 
          class="project-card flex flex-col bg-surface border border-subtle rounded-xl overflow-hidden hover:-translate-y-1 hover:shadow-xl transition-all duration-300 group"
          data-level={project.data.difficulty}
        >
          {project.data.image ? (
            <div class="w-full aspect-video overflow-hidden border-b border-subtle">
              <img 
                src={project.data.image} 
                alt={project.data.title} 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
            </div>
          ) : (
            <div class={`w-full aspect-video bg-gradient-to-br ${gradients[index % 3]}`}></div>
          )}
          
          <div class="p-6 flex flex-col flex-grow">
            <span class="text-[12px] font-[600] uppercase text-tx-muted mb-2 tracking-widest">
              {project.data.difficulty}
            </span>
            <h2 class="text-[18px] font-[600] text-tx-main mb-2 group-hover:text-brand transition-colors line-clamp-2">
              {project.data.title}
            </h2>
            {project.data.excerpt && (
              <p class="text-[14px] text-tx-muted mb-6 flex-grow line-clamp-3 leading-relaxed">
                {project.data.excerpt}
              </p>
            )}
            <div class="mt-auto flex items-center text-[14px] font-[500] text-tx-main group-hover:text-brand transition-colors">
              View project 
              <svg class="w-4 h-4 ml-1.5 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </div>
          </div>
        </a>
      )) : (
        <div class="col-span-full py-12 text-center text-tx-muted bg-surface rounded-xl border border-subtle">
          No projects found in this category.
        </div>
      )}
    </div>

    {page.lastPage > 1 && (
      <nav class="flex justify-center items-center gap-2 mb-20" aria-label="Pagination">
        
        {page.url.prev && (
          <a href={page.url.prev} class="px-4 h-10 flex items-center justify-center gap-1 rounded-lg text-[14px] font-[500] text-tx-muted bg-surface border border-subtle hover:border-tx-main transition-all">
          <svg class="w-4 h-4 rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
  <path d="M5 12h14M12 5l7 7-7 7"/>
</svg>
            Prev
          </a>
        )}

        {Array.from({ length: page.lastPage }, (_, i) => i + 1).map((num) => (
          <a 
            href={num === 1 ? `/projects/${category.id}` : `/projects/${category.id}/page/${num}`}
            class={`w-10 h-10 flex items-center justify-center rounded-lg text-[14px] font-[500] transition-all ${
              page.currentPage === num 
                ? 'bg-tx-main text-main' 
                : 'text-tx-muted hover:bg-surface border border-transparent hover:border-subtle'
            }`}
          >
            {num}
          </a>
        ))}

        {page.url.next && (
          <a href={page.url.next} class="px-4 h-10 flex items-center justify-center gap-1 rounded-lg text-[14px] font-[500] text-tx-muted bg-surface border border-subtle hover:border-tx-main transition-all">
            Next 
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
  <path d="M5 12h14M12 5l7 7-7 7"/>
</svg>
          </a>
        )}
        
      </nav>
    )}

    <section class="border-t border-subtle pt-16">
      <h2 class="text-2xl font-[700] text-tx-main mb-8">More {category.data.title} Resources</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        
        <a href={`/tutorials`} class="flex items-center gap-4 p-5 bg-surface border border-subtle rounded-xl hover:-translate-y-0.5 hover:shadow-md hover:border-tx-muted transition-all">
          <div class="w-12 h-12 rounded-lg bg-main flex items-center justify-center text-tx-main shrink-0">
          <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg>
          </div>
          <div>
            <h3 class="text-[16px] font-[600] text-tx-main mb-1">{category.data.title} Tutorials</h3>
            <p class="text-[13px] text-tx-muted">Step-by-step concepts</p>
          </div>
        </a>

        <a href={`/quizzes`} class="flex items-center gap-4 p-5 bg-surface border border-subtle rounded-xl hover:-translate-y-0.5 hover:shadow-md hover:border-tx-muted transition-all">
          <div class="w-12 h-12 rounded-lg bg-main flex items-center justify-center text-tx-main shrink-0">
          <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
          </div>
          <div>
            <h3 class="text-[16px] font-[600] text-tx-main mb-1">Interactive Quizzes</h3>
            <p class="text-[13px] text-tx-muted">Test your knowledge</p>
          </div>
        </a>

        <a href={`/compilers`} class="flex items-center gap-4 p-5 bg-surface border border-subtle rounded-xl hover:-translate-y-0.5 hover:shadow-md hover:border-tx-muted transition-all">
          <div class="w-12 h-12 rounded-lg bg-main flex items-center justify-center text-tx-main shrink-0">
          <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>
          </div>
          <div>
            <h3 class="text-[16px] font-[600] text-tx-main mb-1">Online Compiler</h3>
            <p class="text-[13px] text-tx-muted">Run code in browser</p>
          </div>
        </a>

      </div>
    </section>

  </main>

  <div id="page-overlay" class="fixed inset-0 bg-main/60 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300 z-[250] cursor-pointer" onclick="closeAll()"></div>
  
  <div id="filter-sheet" class="fixed bottom-0 left-0 right-0 bg-surface rounded-t-[24px] p-8 pb-10 transform translate-y-full transition-transform duration-300 z-[251] shadow-[0_-10px_40px_rgba(0,0,0,0.1)]">
    <div class="text-[18px] font-[600] mb-6 text-tx-main">Filter Projects</div>
    <div class="flex flex-col gap-2">
      <button class="sheet-filter-btn active w-full text-left p-4 text-[16px] rounded-xl text-tx-muted bg-main hover:opacity-80 transition-opacity [&.active]:bg-tx-main [&.active]:text-main [&.active]:font-[500]" data-filter="all" onclick="applyFilter('all'); toggleBottomSheet();">
        All projects ({counts.all})
      </button>
      
      {counts.beginner > 0 && (
        <button class="sheet-filter-btn w-full text-left p-4 text-[16px] rounded-xl text-tx-muted bg-main hover:opacity-80 transition-opacity [&.active]:bg-tx-main [&.active]:text-main [&.active]:font-[500]" data-filter="beginner" onclick="applyFilter('beginner'); toggleBottomSheet();">
          Beginner ({counts.beginner})
        </button>
      )}
      
      {counts.intermediate > 0 && (
        <button class="sheet-filter-btn w-full text-left p-4 text-[16px] rounded-xl text-tx-muted bg-main hover:opacity-80 transition-opacity [&.active]:bg-tx-main [&.active]:text-main [&.active]:font-[500]" data-filter="intermediate" onclick="applyFilter('intermediate'); toggleBottomSheet();">
          Intermediate ({counts.intermediate})
        </button>
      )}
      
      {counts.advanced > 0 && (
        <button class="sheet-filter-btn w-full text-left p-4 text-[16px] rounded-xl text-tx-muted bg-main hover:opacity-80 transition-opacity [&.active]:bg-tx-main [&.active]:text-main [&.active]:font-[500]" data-filter="advanced" onclick="applyFilter('advanced'); toggleBottomSheet();">
          Advanced ({counts.advanced})
        </button>
      )}
    </div>
  </div>
  
  </Layout>

<script is:inline>
  // DOM Elements
  const grid = document.getElementById('project-grid');
  const cards = document.querySelectorAll('.project-card');
  const overlay = document.getElementById('page-overlay');
  const filterSheet = document.getElementById('filter-sheet');
  const desktopBtns = document.querySelectorAll('.filter-btn');
  const mobileBtns = document.querySelectorAll('.sheet-filter-btn');

  // Filtering Logic
  function applyFilter(filterValue) {
    if (!grid) return;
    
    // Fade out
    grid.style.opacity = '0';
    
    setTimeout(() => {
      cards.forEach(card => {
        if (filterValue === 'all' || card.getAttribute('data-level') === filterValue) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
      
      // Update button states
      [desktopBtns, mobileBtns].forEach(group => {
        group.forEach(btn => {
          if(btn.getAttribute('data-filter') === filterValue) {
            btn.classList.add('active');
          } else {
            btn.classList.remove('active');
          }
        });
      });
      
      // Fade in
      grid.style.opacity = '1';
    }, 300);
  }

  // Modal / Overlay Management
  function toggleBottomSheet() {
    const isActive = filterSheet.classList.contains('translate-y-0');
    
    if (isActive) {
      filterSheet.classList.remove('translate-y-0');
      filterSheet.classList.add('translate-y-full');
      overlay.classList.remove('opacity-100', 'pointer-events-auto');
      overlay.classList.add('opacity-0', 'pointer-events-none');
      document.body.style.overflow = '';
    } else {
      filterSheet.classList.remove('translate-y-full');
      filterSheet.classList.add('translate-y-0');
      overlay.classList.remove('opacity-0', 'pointer-events-none');
      overlay.classList.add('opacity-100', 'pointer-events-auto');
      document.body.style.overflow = 'hidden';
    }
  }

  // 🟢 CLEANED UP: Only keeping the relevant logic for this specific page
  function closeAll() {
    if(!filterSheet.classList.contains('translate-y-full')) toggleBottomSheet();
  }

  // Accessibility
  document.addEventListener('keydown', function(event) {
    if (event.key === 'Escape') closeAll();
  });
</script>