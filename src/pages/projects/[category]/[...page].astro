---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import Breadcrumb from '../../../components/ui/Breadcrumb.astro';
import UtilityActions from '../../../components/ui/UtilityActions.astro';

export async function getStaticPaths() {
  const categories = await getCollection('projectCategories');
  const allProjects = await getCollection('projects', ({ data }) => {
    return import.meta.env.PROD ? !data.draft : true;
  });

  return categories.flatMap((category) => {
    const categoryProjects = allProjects.filter(p => p.data.categories.includes(category.id));
    
    // Calculate counts once at build time to save resources
    const counts = {
      all: categoryProjects.length,
      beginner: categoryProjects.filter(p => p.data.difficulty === 'beginner').length,
      intermediate: categoryProjects.filter(p => p.data.difficulty === 'intermediate').length,
      advanced: categoryProjects.filter(p => p.data.difficulty === 'advanced').length,
    };

    const pageSize = category.data.postsPerPage || 9;
    const totalPages = Math.ceil(categoryProjects.length / pageSize) || 1;
    const paths = [];

    // Generate static routes only for the base category pagination (No difficulty routes)
    for (let i = 0; i < totalPages; i++) {
      const currentPage = i + 1;
      const isFirst = currentPage === 1;
      const isLast = currentPage === totalPages;
      const start = i * pageSize;
      const end = start + pageSize;
      const data = categoryProjects.slice(start, end);

      const baseUrl = `/projects/${category.id}`;
      const prevUrl = isFirst ? undefined : (currentPage === 2 ? baseUrl : `${baseUrl}/page/${currentPage - 1}`);
      const nextUrl = isLast ? undefined : `${baseUrl}/page/${currentPage + 1}`;

      paths.push({
        params: { 
          category: category.id,
          page: isFirst ? undefined : `page/${currentPage}`
        },
        props: { 
          category,
          counts,
          page: {
            data,
            currentPage,
            lastPage: totalPages,
            url: { prev: prevUrl, next: nextUrl }
          }
        }
      });
    }

    return paths;
  });
}

const { 
  category, 
  page, 
  counts = { all: 0, beginner: 0, intermediate: 0, advanced: 0 } 
} = Astro.props;

const projects = page?.data || [];

// Dynamic SEO
let pageTitle = category?.data?.seo?.metaTitle || category?.data?.title || 'Projects';
let robotsIndex = category?.data?.seo?.robotsIndex !== false;

if (page?.currentPage > 1) {
  const template = category?.data?.paginationTitleTemplate || ' - Page {page}';
  pageTitle += template.replace('{page}', String(page.currentPage));
  
  if (category?.data?.noindexPaginated) {
    robotsIndex = false;
  }
}

const dynamicSeo = {
  ...category?.data?.seo,
  metaTitle: pageTitle,
  robotsIndex: robotsIndex
};
---

<Layout 
  title={dynamicSeo.metaTitle} 
  description={category?.data?.seo?.metaDescription || category?.data?.description} 
  seo={dynamicSeo}
  hasNewsletterModal={true} 
>
  <main class="w-full bg-main text-tx-main font-['Outfit',sans-serif] px-4 py-8 sm:px-8 md:px-12 lg:px-14 lg:py-10 max-w-[1600px] mx-auto min-h-screen">
    
    <!-- Top Breadcrumb -->
    <Breadcrumb 
      section="projects"
      parents={[{ label: 'Projects', url: '/projects' }]} 
      current={category?.data?.breadcrumbTitle || category?.data?.title} 
      class="flex items-center gap-1.5 text-[12px] md:text-[13px] text-tx-muted md:mt-2 mb-6 font-['JetBrains_Mono',monospace]"
    />

    <!-- Header Section with Utilities Below -->
    <div class="flex flex-col items-center text-center pb-8 mb-8">
      <h1 id="countHeading" class="text-3xl sm:text-4xl md:text-5xl font-[800] tracking-tight mb-4 text-tx-main">
          {category?.data?.title} 
      </h1>
      <p class="text-[16px] sm:text-[18px] text-tx-muted leading-relaxed max-w-3xl mx-auto mb-6">
        {category?.data?.description || 'Hands-on projects to build real skills, from your first script to production-ready apps.'}
      </p>
      <!-- Centered Utility Icons -->
      <div class="flex justify-center items-center gap-3 flex-wrap text-tx-muted">
        <UtilityActions showShare={true} showNewsletter={true} showGoogle={true} />
      </div>
    </div>

    <!-- Filter Section (Inline Selectable Pills - Justified Start) -->
    <div class="flex flex-wrap items-center justify-start gap-2 sm:gap-2.5 mb-8 relative z-20" id="filter-container">
      
      <!-- Using buttons and data-attributes for client side JS filtering -->
      <button 
        data-filter="all"
        class="filter-btn inline-flex items-center justify-center px-3.5 py-1.5 sm:px-4 sm:py-2 rounded-lg border text-[14px] sm:text-[15px] transition-all duration-200 outline-none focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-offset-2 focus-visible:ring-offset-main bg-tx-main border-tx-main text-main font-[600] shadow-sm"
      >
        All <span class="ml-1.5 text-[11px] text-main/80">({counts.all})</span>
      </button>

      {counts.beginner > 0 && (
        <button 
          data-filter="beginner"
          class="filter-btn inline-flex items-center justify-center px-3.5 py-1.5 sm:px-4 sm:py-2 rounded-lg border text-[14px] sm:text-[15px] transition-all duration-200 outline-none focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-offset-2 focus-visible:ring-offset-main bg-surface border-subtle text-tx-main font-[500] hover:bg-tx-muted/5"
        >
          Beginner <span class="ml-1.5 text-[11px] text-tx-muted">({counts.beginner})</span>
        </button>
      )}

      {counts.intermediate > 0 && (
        <button 
          data-filter="intermediate"
          class="filter-btn inline-flex items-center justify-center px-3.5 py-1.5 sm:px-4 sm:py-2 rounded-lg border text-[14px] sm:text-[15px] transition-all duration-200 outline-none focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-offset-2 focus-visible:ring-offset-main bg-surface border-subtle text-tx-main font-[500] hover:bg-tx-muted/5"
        >
          Intermediate <span class="ml-1.5 text-[11px] text-tx-muted">({counts.intermediate})</span>
        </button>
      )}

      {counts.advanced > 0 && (
        <button 
          data-filter="advanced"
          class="filter-btn inline-flex items-center justify-center px-3.5 py-1.5 sm:px-4 sm:py-2 rounded-lg border text-[14px] sm:text-[15px] transition-all duration-200 outline-none focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-offset-2 focus-visible:ring-offset-main bg-surface border-subtle text-tx-main font-[500] hover:bg-tx-muted/5"
        >
          Advanced <span class="ml-1.5 text-[11px] text-tx-muted">({counts.advanced})</span>
        </button>
      )}
    </div>

    <!-- Main Grid -->
    <div id="project-grid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6 items-start relative z-10">
      {projects.length > 0 ? projects.map((project, index) => (
        <a 
          href={`/projects/${category?.id}/${project.id}`} 
          data-difficulty={project.data.difficulty}
          class="project-card group bg-surface rounded-xl overflow-hidden border border-subtle transition-transform duration-150 hover:-translate-y-1 hover:shadow-lg flex flex-col h-full w-full outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-brand focus-visible:ring-offset-2 focus-visible:ring-offset-main"
        >
          <!-- Graphic Area with Top-Left Badge -->
          <div class="relative w-full aspect-video min-h-[100px] bg-gradient-to-br from-[#241f18] to-[#3a352b] flex items-center justify-center overflow-hidden shrink-0">
             
             <!-- Floating Badge -->
             <div class="absolute top-3 left-3 z-10 inline-flex items-center gap-1.5 text-[10px] font-[700] uppercase tracking-wider bg-surface/95 backdrop-blur-sm px-2 py-1 rounded shadow-sm border border-subtle text-tx-main">
               <span class={`w-1.5 h-1.5 rounded-full ${project.data.difficulty === 'beginner' ? 'bg-emerald-500' : project.data.difficulty === 'intermediate' ? 'bg-amber-500' : 'bg-rose-500'}`}></span>
               <span>{project.data.difficulty}</span>
             </div>

             {(project.data.image && !project.data.hideImage) ? (
               <img 
                 src={project.data.image} 
                 alt={project.data.title} 
                 loading={index < 4 ? "eager" : "lazy"} 
                 decoding="async"
                 class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105" 
               />
             ) : (
               <div class="w-14 h-14 flex items-center justify-center opacity-90 drop-shadow-md text-main [&>svg]:w-full [&>svg]:h-full [&>svg]:object-contain">
                 <Fragment set:html={category?.data?.iconSvg || '💻'} />
               </div>
             )}
          </div>
          
          <!-- Body Area (Centred Action Link) -->
          <div class="p-4 sm:p-5 flex flex-col flex-1 bg-surface">
            <h3 class="text-[17px] font-[800] mb-2 text-tx-main leading-snug line-clamp-2">
              {project.data.title}
            </h3>
            {project.data.excerpt && (
              <p class="text-[14px] text-tx-muted leading-relaxed line-clamp-3 mb-4">{project.data.excerpt}</p>
            )}
            
            <div class="mt-auto pt-4 flex justify-center w-full">
              <span class="text-brand font-[600] text-[15px] transition-all group-hover:underline decoration-2 underline-offset-4">View Project</span>
            </div>
          </div>
        </a>
      )) : (
        <div class="col-span-full py-16 px-4 text-center bg-surface rounded-2xl border border-subtle flex flex-col items-center justify-center">
          <span class="text-4xl mb-4 block">🔍</span>
          <h3 class="text-lg font-bold text-tx-main mb-2">No projects found</h3>
          <p class="text-tx-muted max-w-md mx-auto">There are currently no projects in this category.</p>
        </div>
      )}
    </div>

    <!-- Pagination -->
    {page?.lastPage > 1 && (
      <div id="pagination" class="flex flex-wrap items-center justify-center gap-1.5 mt-10 sm:mt-12">
        {page?.url?.prev ? (
          <a href={page.url.prev} aria-label="Previous page" class="w-11 h-11 sm:w-10 sm:h-10 flex items-center justify-center rounded-lg text-tx-muted border border-subtle bg-surface hover:bg-tx-muted/10 transition-colors outline-none focus-visible:ring-2 focus-visible:ring-brand">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"/></svg>
          </a>
        ) : (
          <span class="w-11 h-11 sm:w-10 sm:h-10 flex items-center justify-center rounded-lg text-tx-muted border border-subtle bg-surface opacity-40 cursor-not-allowed">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"/></svg>
          </span>
        )}

        {Array.from({ length: page.lastPage }, (_, i) => i + 1).map((num) => {
          const isFirst = num === 1;
          const baseUrl = `/projects/${category?.id}`;
          const targetUrl = isFirst ? baseUrl : `${baseUrl}/page/${num}`;

          return (
            <a 
              href={targetUrl}
              aria-current={page.currentPage === num ? 'page' : undefined}
              class={`w-11 h-11 sm:w-10 sm:h-10 flex items-center justify-center rounded-lg text-sm transition-colors outline-none border border-transparent focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-offset-main ${
                page.currentPage === num 
                  ? 'font-[600] bg-brand text-main focus-visible:ring-brand' 
                  : 'font-[500] text-tx-muted hover:bg-tx-muted/10 focus-visible:ring-tx-muted'
              }`}
            >
              {num}
            </a>
          );
        })}

        {page?.url?.next ? (
          <a href={page.url.next} aria-label="Next page" class="w-11 h-11 sm:w-10 sm:h-10 flex items-center justify-center rounded-lg text-tx-muted border border-subtle bg-surface hover:bg-tx-muted/10 transition-colors outline-none focus-visible:ring-2 focus-visible:ring-brand">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
          </a>
        ) : (
          <span class="w-11 h-11 sm:w-10 sm:h-10 flex items-center justify-center rounded-lg text-tx-muted border border-subtle bg-surface opacity-40 cursor-not-allowed">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
          </span>
        )}
      </div>
    )}

    <!-- Dynamic FAQs -->
    {category?.data?.faqs && category.data.faqs.length > 0 && (
      <div class="mt-20 sm:mt-24 max-w-[800px] mx-auto">
        <div class="text-center mb-10">
          <h2 class="text-2xl sm:text-3xl md:text-4xl font-[800] tracking-tight mb-3 text-tx-main">Frequently asked questions</h2>
          <p class="text-base text-tx-muted">Everything you need to know before you start building.</p>
        </div>

        <div class="flex flex-col border-t border-subtle">
          {category.data.faqs.map((faq) => (
            <details class="faq group py-5 md:py-6 border-b border-subtle">
              <summary class="flex items-center justify-between gap-6 cursor-pointer list-none font-[600] text-[16px] md:text-[18px] text-tx-main outline-none focus-visible:ring-2 focus-visible:ring-brand hover:text-brand transition-colors rounded-lg">
                {faq.question}
                <div class="w-8 h-8 rounded-full border border-subtle flex items-center justify-center shrink-0 text-tx-muted group-hover:border-brand group-hover:text-brand group-hover:bg-brand/5 transition-all group-open:rotate-45">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
                </div>
              </summary>
              <p class="text-[15px] md:text-[16px] text-tx-muted leading-relaxed mt-4 md:mt-5 pr-12">{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    )}
  </main>
</Layout>

<style>
  .faq summary::-webkit-details-marker { display:none; }
</style>

<script>
  function initClientSideFilter() {
    const btns = document.querySelectorAll('.filter-btn');
    const cards = document.querySelectorAll('.project-card');

    if (btns.length === 0 || cards.length === 0) return;

    btns.forEach(btn => {
      btn.addEventListener('click', () => {
        const targetFilter = btn.getAttribute('data-filter');

        // 1. Update active states on buttons
        btns.forEach(b => {
          const isSelected = b === btn;
          
          if (isSelected) {
            b.className = 'filter-btn inline-flex items-center justify-center px-3.5 py-1.5 sm:px-4 sm:py-2 rounded-lg border text-[14px] sm:text-[15px] transition-all duration-200 outline-none focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-offset-2 focus-visible:ring-offset-main bg-tx-main border-tx-main text-main font-[600] shadow-sm';
            b.querySelector('span').className = 'ml-1.5 text-[11px] text-main/80';
          } else {
            b.className = 'filter-btn inline-flex items-center justify-center px-3.5 py-1.5 sm:px-4 sm:py-2 rounded-lg border text-[14px] sm:text-[15px] transition-all duration-200 outline-none focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-offset-2 focus-visible:ring-offset-main bg-surface border-subtle text-tx-main font-[500] hover:bg-tx-muted/5';
            b.querySelector('span').className = 'ml-1.5 text-[11px] text-tx-muted';
          }
        });

        // 2. Hide/Show Cards locally
        cards.forEach(card => {
          if (targetFilter === 'all' || card.getAttribute('data-difficulty') === targetFilter) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  }

  // Runs on the very first page load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initClientSideFilter);
  } else {
    initClientSideFilter();
  }

  // Re-runs after Astro View Transitions swap the DOM (if enabled on this site)
  document.addEventListener('astro:page-load', initClientSideFilter);
</script>