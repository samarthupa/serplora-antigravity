---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import Breadcrumb from '../../../components/ui/Breadcrumb.astro';

export async function getStaticPaths({ paginate }) {
  const categories = await getCollection('projectCategories');
  const allProjects = await getCollection('projects', ({ data }) => {
    return import.meta.env.PROD ? !data.draft : true;
  });

  return categories.flatMap((category) => {
    // 1. Filter projects for this specific category
    const filteredProjects = allProjects.filter(p => p.data.categories.includes(category.id));
    
    // 2. Grab the specific page size from the category collection
    const pageSize = category.data.postsPerPage || 9;
    
    // 3. Trigger Astro pagination
    return paginate(filteredProjects, {
      params: { category: category.id },
      props: { category },
      pageSize: pageSize,
    });
  });
}

const { category, page } = Astro.props;
const projects = page.data; 

// Dynamic SEO explicitly controlled by the Category
let pageTitle = category.data.seo?.metaTitle || category.data.title;
let robotsIndex = category.data.seo?.robotsIndex !== false;

if (page.currentPage > 1) {
  const template = category.data.paginationTitleTemplate || ' - Page {page}';
  pageTitle += template.replace('{page}', String(page.currentPage));
  
  if (category.data.noindexPaginated) {
    robotsIndex = false;
  }
}

const dynamicSeo = {
  ...category.data.seo,
  metaTitle: pageTitle,
  robotsIndex: robotsIndex
};

const gradients = [
  'from-[#f5f7fa] to-[#c3cfe2]',
  'from-[#e0c3fc] to-[#8ec5fc]',
  'from-[#fdfbfb] to-[#ebedee]'
];
---

<Layout title={dynamicSeo.metaTitle} description={category.data.seo?.metaDescription || category.data.description} seo={dynamicSeo}>
  <main class="w-full max-w-[1200px] mx-auto px-5 pt-12 pb-20 md:pt-16 md:pb-20 font-['Outfit',sans-serif] min-h-screen relative">
    
    <Breadcrumb 
      section="projects" 
      parents={[{ label: 'Projects', url: '/projects' }]}
      current={category.data.breadcrumbTitle || category.data.title} 
    />
    
    <!-- Header & Toolbar -->
    <header class="mb-10 flex flex-col md:flex-row md:items-start justify-between gap-6">
      <div>
        <h1 class="text-4xl md:text-[40px] font-[800] text-tx-main tracking-tight mb-3">
          {category.data.title} Projects
        </h1>
        <p class="text-base text-tx-muted max-w-2xl">
          {category.data.description}
        </p>
      </div>

      <!-- Utilities -->
      <div class="flex items-center gap-2 w-full md:w-auto justify-between md:justify-end">
        <div class="flex items-center gap-2">
          <a href="https://www.google.com/preferences/source?q=serplora.com" target="_blank" rel="noopener" class="w-11 h-11 rounded-full border border-subtle bg-surface text-tx-muted flex items-center justify-center hover:text-tx-main hover:border-tx-main hover:-translate-y-0.5 transition-all shadow-sm group relative" aria-label="Follow on Google">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
              <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" />
              <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" />
              <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" />
              <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" />
            </svg>
            <span class="absolute bottom-[-30px] text-[12px] bg-tx-main text-main px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap pointer-events-none z-10">Follow on Google</span>
          </a>
          <button onclick="alert('Link copied!')" class="w-11 h-11 rounded-full border border-subtle bg-surface text-tx-muted flex items-center justify-center hover:text-tx-main hover:border-tx-main hover:-translate-y-0.5 transition-all shadow-sm group relative" aria-label="Share Page">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line></svg>
            <span class="absolute bottom-[-30px] text-[12px] bg-tx-main text-main px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap pointer-events-none z-10">Share Page</span>
          </button>
          <button onclick="openModal()" class="w-11 h-11 rounded-full border border-subtle bg-surface text-tx-muted flex items-center justify-center hover:text-tx-main hover:border-tx-main hover:-translate-y-0.5 transition-all shadow-sm group relative" aria-label="Newsletter">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            <span class="absolute bottom-[-30px] text-[12px] bg-tx-main text-main px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap pointer-events-none z-10">Newsletter</span>
          </button>
        </div>

        <button onclick="toggleBottomSheet()" class="md:hidden flex items-center justify-center gap-2 px-4 h-11 rounded-full bg-tx-main text-main font-[500] text-[14px] hover:opacity-80 transition-opacity">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="21" x2="4" y2="14"></line><line x1="4" y1="10" x2="4" y2="3"></line><line x1="12" y1="21" x2="12" y2="12"></line><line x1="12" y1="8" x2="12" y2="3"></line><line x1="20" y1="21" x2="20" y2="16"></line><line x1="20" y1="12" x2="20" y2="3"></line><line x1="1" y1="14" x2="7" y2="14"></line><line x1="9" y1="8" x2="15" y2="8"></line><line x1="17" y1="16" x2="23" y2="16"></line></svg>
          Filters
        </button>
      </div>
    </header>

    <!-- Desktop Filters -->
    <div class="hidden md:flex flex-wrap gap-3 mb-10" id="desktop-filters">
      <button class="filter-btn active px-4 py-2 text-[14px] font-[500] text-tx-muted rounded-full transition-all hover:bg-tx-muted/10 [&.active]:bg-tx-main [&.active]:text-main" data-filter="all" onclick="applyFilter('all')">All projects</button>
      <button class="filter-btn px-4 py-2 text-[14px] font-[500] text-tx-muted rounded-full transition-all hover:bg-tx-muted/10 [&.active]:bg-tx-main [&.active]:text-main" data-filter="beginner" onclick="applyFilter('beginner')">Beginner</button>
      <button class="filter-btn px-4 py-2 text-[14px] font-[500] text-tx-muted rounded-full transition-all hover:bg-tx-muted/10 [&.active]:bg-tx-main [&.active]:text-main" data-filter="intermediate" onclick="applyFilter('intermediate')">Intermediate</button>
      <button class="filter-btn px-4 py-2 text-[14px] font-[500] text-tx-muted rounded-full transition-all hover:bg-tx-muted/10 [&.active]:bg-tx-main [&.active]:text-main" data-filter="advanced" onclick="applyFilter('advanced')">Advanced</button>
    </div>

    <!-- Project Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-16 transition-opacity duration-300" id="project-grid">
      {projects.length > 0 ? projects.map((project, index) => (
        <a 
          href={`/projects/${category.id}/${project.id}`} 
          class="project-card flex flex-col bg-surface border border-subtle rounded-xl overflow-hidden hover:-translate-y-1 hover:shadow-xl transition-all duration-300 group"
          data-level={project.data.difficulty}
        >
          <div class={`w-full aspect-video bg-gradient-to-br ${gradients[index % 3]}`}></div>
          
          <div class="p-6 flex flex-col flex-grow">
            <span class="text-[12px] font-[600] uppercase text-tx-muted mb-2 tracking-widest">
              {project.data.difficulty}
            </span>
            <h2 class="text-[18px] font-[600] text-tx-main mb-2 group-hover:text-brand transition-colors line-clamp-2">
              {project.data.title}
            </h2>
            {project.data.excerpt && (
              <p class="text-[14px] text-tx-muted mb-6 flex-grow line-clamp-3 leading-relaxed">
                {project.data.excerpt}
              </p>
            )}
            <div class="mt-auto flex items-center text-[14px] font-[500] text-tx-main group-hover:text-brand transition-colors">
              View project 
              <svg class="w-4 h-4 ml-1.5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </div>
          </div>
        </a>
      )) : (
        <div class="col-span-full py-12 text-center text-tx-muted bg-surface rounded-xl border border-subtle">
          No projects found in this category.
        </div>
      )}
    </div>

    <!-- Dynamic Pagination -->
    {page.lastPage > 1 && (
      <nav class="flex justify-center items-center gap-2 mb-20" aria-label="Pagination">
        
        <!-- Previous Button -->
        {page.url.prev && (
          <a href={page.url.prev} class="px-4 h-10 flex items-center justify-center gap-1 rounded-lg text-[14px] font-[500] text-tx-muted bg-surface border border-subtle hover:border-tx-main transition-all">
            <svg class="w-4 h-4 rotate-180" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            Prev
          </a>
        )}

        <!-- Numbered Page Links -->
        {Array.from({ length: page.lastPage }, (_, i) => i + 1).map((num) => (
          <a 
            href={num === 1 ? `/projects/${category.id}` : `/projects/${category.id}/${num}`}
            class={`w-10 h-10 flex items-center justify-center rounded-lg text-[14px] font-[500] transition-all ${
              page.currentPage === num 
                ? 'bg-tx-main text-main' 
                : 'text-tx-muted hover:bg-surface border border-transparent hover:border-subtle'
            }`}
          >
            {num}
          </a>
        ))}

        <!-- Next Button -->
        {page.url.next && (
          <a href={page.url.next} class="px-4 h-10 flex items-center justify-center gap-1 rounded-lg text-[14px] font-[500] text-tx-muted bg-surface border border-subtle hover:border-tx-main transition-all">
            Next 
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        )}
        
      </nav>
    )}

    <!-- Internal Resources Section (Unchanged) -->
    <section class="border-t border-subtle pt-16">
      <h2 class="text-2xl font-[700] text-tx-main mb-8">More {category.data.title} Resources</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        
        <a href={`/tutorials`} class="flex items-center gap-4 p-5 bg-surface border border-subtle rounded-xl hover:-translate-y-0.5 hover:shadow-md hover:border-tx-muted transition-all">
          <div class="w-12 h-12 rounded-lg bg-main flex items-center justify-center text-tx-main shrink-0">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg>
          </div>
          <div>
            <h3 class="text-[16px] font-[600] text-tx-main mb-1">{category.data.title} Tutorials</h3>
            <p class="text-[13px] text-tx-muted">Step-by-step concepts</p>
          </div>
        </a>

        <a href={`/quizzes`} class="flex items-center gap-4 p-5 bg-surface border border-subtle rounded-xl hover:-translate-y-0.5 hover:shadow-md hover:border-tx-muted transition-all">
          <div class="w-12 h-12 rounded-lg bg-main flex items-center justify-center text-tx-main shrink-0">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
          </div>
          <div>
            <h3 class="text-[16px] font-[600] text-tx-main mb-1">Interactive Quizzes</h3>
            <p class="text-[13px] text-tx-muted">Test your knowledge</p>
          </div>
        </a>

        <a href={`/compilers`} class="flex items-center gap-4 p-5 bg-surface border border-subtle rounded-xl hover:-translate-y-0.5 hover:shadow-md hover:border-tx-muted transition-all">
          <div class="w-12 h-12 rounded-lg bg-main flex items-center justify-center text-tx-main shrink-0">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>
          </div>
          <div>
            <h3 class="text-[16px] font-[600] text-tx-main mb-1">Online Compiler</h3>
            <p class="text-[13px] text-tx-muted">Run code in browser</p>
          </div>
        </a>

      </div>
    </section>

  </main>

  <!-- OVERLAYS & MODALS -->
  <div id="page-overlay" class="fixed inset-0 bg-main/60 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300 z-[100]" onclick="closeAll()"></div>
  
  <!-- Mobile Bottom Sheet (Filters) -->
  <div id="filter-sheet" class="fixed bottom-0 left-0 right-0 bg-surface rounded-t-[24px] p-8 pb-10 transform translate-y-full transition-transform duration-300 z-[101] shadow-[0_-10px_40px_rgba(0,0,0,0.1)]">
    <div class="text-[18px] font-[600] mb-6 text-tx-main">Filter Projects</div>
    <div class="flex flex-col gap-2">
      <button class="sheet-filter-btn active w-full text-left p-4 text-[16px] rounded-xl text-tx-muted bg-main hover:opacity-80 transition-opacity [&.active]:bg-tx-main [&.active]:text-main [&.active]:font-[500]" data-filter="all" onclick="applyFilter('all'); toggleBottomSheet();">All projects</button>
      <button class="sheet-filter-btn w-full text-left p-4 text-[16px] rounded-xl text-tx-muted bg-main hover:opacity-80 transition-opacity [&.active]:bg-tx-main [&.active]:text-main [&.active]:font-[500]" data-filter="beginner" onclick="applyFilter('beginner'); toggleBottomSheet();">Beginner</button>
      <button class="sheet-filter-btn w-full text-left p-4 text-[16px] rounded-xl text-tx-muted bg-main hover:opacity-80 transition-opacity [&.active]:bg-tx-main [&.active]:text-main [&.active]:font-[500]" data-filter="intermediate" onclick="applyFilter('intermediate'); toggleBottomSheet();">Intermediate</button>
      <button class="sheet-filter-btn w-full text-left p-4 text-[16px] rounded-xl text-tx-muted bg-main hover:opacity-80 transition-opacity [&.active]:bg-tx-main [&.active]:text-main [&.active]:font-[500]" data-filter="advanced" onclick="applyFilter('advanced'); toggleBottomSheet();">Advanced</button>
    </div>
  </div>

  <!-- Newsletter Modal -->
  <div id="newsletter-modal" class="fixed top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-[40%] bg-surface w-[90%] max-w-[400px] rounded-2xl p-8 shadow-2xl opacity-0 pointer-events-none transition-all duration-300 z-[102] border border-subtle">
    <button onclick="closeModal()" class="absolute top-4 right-4 w-8 h-8 flex items-center justify-center text-tx-muted hover:bg-main hover:text-tx-main rounded-full transition-colors" aria-label="Close modal">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
    </button>
    <h3 class="text-[20px] font-[600] mb-2 text-tx-main">Stay Updated</h3>
    <p class="text-[14px] color-tx-muted mb-6">Get one new {category.data.title} project delivered to your inbox every week.</p>
    <form class="flex flex-col gap-3" onsubmit="event.preventDefault(); alert('Subscribed!'); closeModal();">
      <input type="email" id="newsletter-input" class="w-full px-4 py-3 border border-subtle rounded-lg text-[15px] bg-main text-tx-main focus:outline-none focus:border-tx-main transition-colors" placeholder="Your email address" required>
      <button type="submit" class="w-full py-3 bg-tx-main text-main rounded-lg font-[500] text-[15px] hover:opacity-90 transition-opacity">Subscribe</button>
    </form>
  </div>

</Layout>

<script is:inline>
  // DOM Elements
  const grid = document.getElementById('project-grid');
  const cards = document.querySelectorAll('.project-card');
  const overlay = document.getElementById('page-overlay');
  const filterSheet = document.getElementById('filter-sheet');
  const newsletterModal = document.getElementById('newsletter-modal');
  const desktopBtns = document.querySelectorAll('.filter-btn');
  const mobileBtns = document.querySelectorAll('.sheet-filter-btn');

  // Filtering Logic
  function applyFilter(filterValue) {
    if (!grid) return;
    
    // Fade out
    grid.style.opacity = '0';
    
    setTimeout(() => {
      cards.forEach(card => {
        if (filterValue === 'all' || card.getAttribute('data-level') === filterValue) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
      
      // Update button states
      [desktopBtns, mobileBtns].forEach(group => {
        group.forEach(btn => {
          if(btn.getAttribute('data-filter') === filterValue) {
            btn.classList.add('active');
          } else {
            btn.classList.remove('active');
          }
        });
      });
      
      // Fade in
      grid.style.opacity = '1';
    }, 300);
  }

  // Modal / Overlay Management
  function toggleBottomSheet() {
    const isActive = filterSheet.classList.contains('translate-y-0');
    
    if (isActive) {
      filterSheet.classList.remove('translate-y-0');
      filterSheet.classList.add('translate-y-full');
      overlay.classList.remove('opacity-100', 'pointer-events-auto');
      document.body.style.overflow = '';
    } else {
      filterSheet.classList.remove('translate-y-full');
      filterSheet.classList.add('translate-y-0');
      overlay.classList.add('opacity-100', 'pointer-events-auto');
      document.body.style.overflow = 'hidden';
    }
  }

  function openModal() {
    newsletterModal.classList.remove('opacity-0', 'pointer-events-none', '-translate-y-[40%]');
    newsletterModal.classList.add('opacity-100', 'pointer-events-auto', '-translate-y-1/2');
    overlay.classList.add('opacity-100', 'pointer-events-auto');
    document.body.style.overflow = 'hidden';
    setTimeout(() => document.getElementById('newsletter-input')?.focus(), 300);
  }

  function closeModal() {
    newsletterModal.classList.add('opacity-0', 'pointer-events-none', '-translate-y-[40%]');
    newsletterModal.classList.remove('opacity-100', 'pointer-events-auto', '-translate-y-1/2');
    overlay.classList.remove('opacity-100', 'pointer-events-auto');
    
    // Only restore body scrolling if the bottom sheet isn't also open
    if (filterSheet.classList.contains('translate-y-full')) {
      document.body.style.overflow = '';
    }
  }

  function closeAll() {
    if(!filterSheet.classList.contains('translate-y-full')) toggleBottomSheet();
    if(newsletterModal.classList.contains('opacity-100')) closeModal();
  }

  // Accessibility
  document.addEventListener('keydown', function(event) {
    if (event.key === 'Escape') closeAll();
  });
</script>