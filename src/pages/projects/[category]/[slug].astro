---
import { getCollection, render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
// 🟢 IMPORTED COMPONENTS
import Breadcrumb from '../../../components/ui/Breadcrumb.astro';
import UtilityActions from '../../../components/ui/UtilityActions.astro';

export async function getStaticPaths() {
  const allProjects = await getCollection('projects', ({ data }) => {
    return import.meta.env.PROD ? !data.draft : true;
  });

  return allProjects.flatMap((project) => {
    return project.data.categories.map((catId) => ({
      params: { category: catId, slug: project.id },
      props: { project, currentCategory: catId },
    }));
  });
}

const { project, currentCategory } = Astro.props;
const { Content } = await render(project);

const difficultyEmoji = {
  beginner: '🌱',
  intermediate: '⚡',
  advanced: '🔥'
};

const primaryCategory = project.data.categories[0];
const canonicalOverride = `/projects/${primaryCategory}/${project.id}`;
---

<Layout 
  title={project.data.seo?.metaTitle || project.data.title} 
  description={project.data.seo?.metaDescription || project.data.excerpt}
  image={project.data.image}
>
  <main class="max-w-[900px] mx-auto mt-10 px-6 pb-20 font-sans text-tx-main animate-[fadeIn_0.6s_ease-out]">
    
    <Breadcrumb 
      parents={[
        { label: 'projects', url: '/projects' },
        { label: currentCategory, url: `/projects/${currentCategory}` }
      ]} 
      current={project.data.breadcrumbTitle || project.data.title} 
    />

    <header>
        <h1 class="text-[28px] sm:text-[32px] font-bold tracking-tight leading-tight mb-6">
            {project.data.title}
        </h1>
        
        <div class="flex justify-between items-center flex-wrap gap-4 mb-8 max-sm:flex-row max-sm:flex-nowrap max-sm:pb-6 max-[360px]:flex-wrap">
            
            <!-- Left Side: Difficulty & Timer -->
            <div class="flex flex-wrap gap-2 max-sm:flex-1">
                <span class="text-[13px] font-medium px-2 py-1 bg-transparent border border-subtle/60 rounded-md inline-flex items-center gap-1.5 opacity-90 text-tx-main">
                    <span class="capitalize">{project.data.difficulty}</span>
                </span>
                <span class="text-[13px] font-medium px-2 py-1 bg-transparent border border-subtle/60 rounded-md inline-flex items-center gap-1.5 opacity-90 text-tx-main">
                    <span class="opacity-60">⏱️</span> {project.data.duration}
                </span>
            </div>

            <!-- 🟢 Right Side: Utility Actions -->
            <div class="flex items-center gap-2 flex-shrink-0 text-tx-muted">
                <UtilityActions showShare={true} />
            </div>

        </div>
    </header>

    <!-- TERMINAL HERO CODE -->
    {project.data.heroCode && (
        <figure class="w-full h-[300px] sm:aspect-video sm:h-auto bg-[#0D1117] rounded-xl overflow-hidden mb-12 shadow-[0_20px_40px_rgba(0,0,0,0.08)] flex flex-col">
            <div class="h-10 bg-white/5 flex items-center px-4 gap-2">
                <div class="w-2.5 h-2.5 rounded-full bg-[#FF5F56]"></div>
                <div class="w-2.5 h-2.5 rounded-full bg-[#FFBD2E]"></div>
                <div class="w-2.5 h-2.5 rounded-full bg-[#27C93F]"></div>
            </div>
            <div class="p-6 font-mono text-[14px] text-[#C9D1D9] leading-relaxed">
                <pre style="margin:0; font-family:inherit; color:inherit; white-space:pre-wrap;"><code>{project.data.heroCode}</code></pre>
            </div>
        </figure>
    )}

    <!-- FALLBACK IMAGE -->
    {!project.data.heroCode && project.data.image && !project.data.hideImage && (
        <div class="mb-12">
            <img 
                src={project.data.image} 
                alt={project.data.title} 
                class="w-full h-auto rounded-xl border border-subtle shadow-sm object-cover"
            />
        </div>
    )}

    <!-- PROSE CONTENT -->
    <article class="prose">
        <Content />
    </article>

    <!-- LARGE BOTTOM GITHUB CTA BUTTON -->
    {project.data.githubUrl && (
        <footer class="mt-16 pt-10 border-t border-subtle/50 flex justify-center">
            <a href={project.data.githubUrl} target="_blank" rel="noopener noreferrer" 
               class="text-[16px] font-[500] px-8 py-3.5 rounded-lg bg-transparent text-tx-main border border-subtle/80 inline-flex items-center gap-3 transition-all duration-300 hover:border-tx-main hover:-translate-y-0.5 hover:shadow-sm max-sm:w-full max-sm:justify-center">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
                View Source Code on GitHub
            </a>
        </footer>
    )}
  </main>
</Layout>

<style>
    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .prose :global(h2) { font-size: 24px; font-weight: 600; margin-top: 48px; margin-bottom: 16px; color: var(--color-tx-main); }
    .prose :global(p) { margin-bottom: 24px; color: var(--color-tx-main); opacity: 0.85; line-height: 1.6; font-size: 18px; }
    .prose :global(ul) { margin-bottom: 24px; padding-left: 24px; color: var(--color-tx-main); opacity: 0.85; }
    .prose :global(li) { margin-bottom: 12px; font-size: 18px; }
    
    .prose :global(code) {
        font-family: var(--font-mono, monospace); font-size: 14px;
        background-color: var(--color-bg-surface); 
        border: 1px solid var(--color-border-subtle);
        padding: 2px 6px; border-radius: 4px; color: var(--color-tx-main);
    }
</style>s