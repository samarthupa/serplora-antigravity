---
const postsGlob = import.meta.glob('../content/posts/*/*.{md,mdoc}', { eager: true });
const rawGlob = import.meta.glob('../content/posts/*/*.{md,mdoc}', { eager: true, query: '?raw', import: 'default' });

const allPosts = Object.entries(postsGlob).map(([filepath, module]: any) => {
  const rawText = rawGlob[filepath] as string || '';
  const slugMatch = rawText.match(/^slug:\s*(.+)$/m);
  const match = filepath.match(/posts\/([^/]+)\//);
  const id = match ? match[1] : '';

  let rawSlug = String(slugMatch ? slugMatch[1].trim() : id);
  const cleanSlug = rawSlug.trim().replace(/\s+/g, '-').replace(/[^a-zA-Z0-9-]/g, '').toLowerCase();

  return { id, filepath, rawSlug, cleanSlug };
});
---
<pre id="paths">{JSON.stringify(allPosts, null, 2)}</pre>
