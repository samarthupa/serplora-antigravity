---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export const prerender = true;

export async function getStaticPaths() {
  const allTutorials = await getCollection('tutorials');
  
  const publishedTutorials = allTutorials.filter((entry) => !entry.data.draft);
  
  const paths: any[] = [];

  publishedTutorials.forEach((entry) => {
    const cleanSlug = entry.data.slug || entry.id;

    paths.push({
      params: { slug: cleanSlug },
      props: { entry },
    });
  });

  return paths;
}

const { entry } = Astro.props;
// 🟢 THE FIX: Use the new Astro 5 render function
const { Content } = await render(entry); 
---

<Layout>
  <main class="max-w-3xl mx-auto px-4 py-8">
    <article class="prose prose-lg dark:prose-invert">
      <h1 class="text-4xl font-bold mb-4">{entry.data?.title}</h1>
      {entry.data?.excerpt && <div class="text-xl text-gray-500 mb-8" set:html={entry.data.excerpt} />}
      <div class="mt-8">
        <Content />
      </div>
    </article>
  </main>
</Layout>