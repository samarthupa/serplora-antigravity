---
// Note: Adjust this import to match the actual path to your global layout wrapper
import Layout from '../layouts/Layout.astro';

// We explicitly tell Google NOT to index search result pages to prevent infinite empty URLs
---

<Layout title="Search Results | Serplora">
  <!-- SEO Protection -->
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow" />
  </Fragment>

  <main class="min-h-screen bg-main pt-10 pb-20 px-4 md:px-8 font-['Outfit',sans-serif]">
    <div class="max-w-4xl mx-auto w-full">

      <!-- 🟢 Tab Navigation -->
      <div class="flex items-center border-b border-subtle mb-6 overflow-x-auto hide-scrollbar">
        <div class="flex items-center gap-6 md:gap-8" id="search-tabs">
          
          <!-- All (SVG Removed, dynamically handles opacity-100) -->
          <button data-tab="all" class="search-tab group relative pb-3 flex items-center gap-2 text-tx-main font-[600] outline-none cursor-pointer">
            All
            <span class="tab-indicator absolute bottom-0 left-0 w-full h-[3px] bg-tx-main rounded-t-sm opacity-100 transition-opacity duration-200"></span>
          </button>
          
          <!-- Tutorials -->
          <button data-tab="tutorials" class="search-tab group relative pb-3 flex items-center gap-2 text-tx-muted hover:text-tx-main font-[500] transition-colors outline-none cursor-pointer">
            <svg class="w-4 h-4 opacity-70 group-hover:opacity-100" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
            Tutorials
            <span class="tab-indicator absolute bottom-0 left-0 w-full h-[3px] bg-tx-main rounded-t-sm opacity-0 transition-opacity duration-200"></span>
          </button>

          <!-- Projects -->
          <button data-tab="projects" class="search-tab group relative pb-3 flex items-center gap-2 text-tx-muted hover:text-tx-main font-[500] transition-colors outline-none cursor-pointer">
            <svg class="w-4 h-4 opacity-70 group-hover:opacity-100" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg>
            Projects
            <span class="tab-indicator absolute bottom-0 left-0 w-full h-[3px] bg-tx-main rounded-t-sm opacity-0 transition-opacity duration-200"></span>
          </button>

          <!-- Quizzes -->
          <button data-tab="quizzes" class="search-tab group relative pb-3 flex items-center gap-2 text-tx-muted hover:text-tx-main font-[500] transition-colors outline-none cursor-pointer">
            <svg class="w-4 h-4 opacity-70 group-hover:opacity-100" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            Quizzes
            <span class="tab-indicator absolute bottom-0 left-0 w-full h-[3px] bg-tx-main rounded-t-sm opacity-0 transition-opacity duration-200"></span>
          </button>

          <!-- Articles -->
          <button data-tab="articles" class="search-tab group relative pb-3 flex items-center gap-2 text-tx-muted hover:text-tx-main font-[500] transition-colors outline-none cursor-pointer">
            <svg class="w-4 h-4 opacity-70 group-hover:opacity-100" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"></path></svg>
            Articles
            <span class="tab-indicator absolute bottom-0 left-0 w-full h-[3px] bg-tx-main rounded-t-sm opacity-0 transition-opacity duration-200"></span>
          </button>
        </div>
      </div>

      <!-- Results Header -->
      <div class="flex items-center justify-between mb-6">
        <span id="search-count" class="text-[15px] font-[400] text-tx-muted">About 0 search results</span>
      </div>

      <!-- Loading State -->
      <div id="search-loading" class="hidden flex-col gap-6">
        {[1, 2, 3].map(() => (
          <div class="w-full bg-transparent animate-pulse">
            <div class="h-6 bg-tx-muted/20 rounded-md w-2/3 mb-3"></div>
            <div class="h-4 bg-tx-muted/10 rounded-md w-full mb-1"></div>
            <div class="h-4 bg-tx-muted/10 rounded-md w-4/5"></div>
          </div>
        ))}
      </div>

      <!-- Results Container -->
      <div id="search-results" class="flex flex-col gap-8">
        <!-- JS will inject results here -->
      </div>

      <!-- Empty State (Hidden by default) -->
      <div id="search-empty" class="hidden flex-col items-center justify-center py-20 text-center">
        <svg class="w-16 h-16 text-tx-muted/50 mb-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <h2 class="text-xl font-bold text-tx-main mb-2">No results found</h2>
        <p class="text-tx-muted" id="empty-state-message">We couldn't find anything matching your query.</p>
      </div>

    </div>
  </main>
</Layout>

<script>
  const resultsContainer = document.getElementById('search-results');
  const loadingIndicator = document.getElementById('search-loading');
  const emptyState = document.getElementById('search-empty');
  const emptyStateMessage = document.getElementById('empty-state-message');
  const countDisplay = document.getElementById('search-count');
  const searchTabs = document.querySelectorAll('.search-tab');

  let pagefindInstance: any = null;
  let allFetchedResults: any[] = []; 
  let currentTab = 'all'; 
  let currentQuery = ''; // 🟢 Added this to track the active search term

  // 1. Load Pagefind dynamically
  async function initPagefind() {
    if (pagefindInstance) return pagefindInstance;
    try {
      const pagefindUrl = '/pagefind/pagefind.js';
      // @ts-ignore
      pagefindInstance = await import(/* @vite-ignore */ pagefindUrl);
      await pagefindInstance.init();
      return pagefindInstance;
    } catch (e) {
      console.error("Pagefind failed to load.", e);
      return null;
    }
  }

  // 2. Perform the actual search
  async function performSearch(query: string) {
    if (!query.trim()) {
      clearResults();
      return;
    }

    currentQuery = query; // 🟢 Save the query to our global variable
    showLoading();

    const pf = await initPagefind();
    if (!pf) {
      showEmpty();
      return;
    }

    const searchResult = await pf.search(query);
    allFetchedResults = await Promise.all(searchResult.results.map((r: any) => r.data()));

    renderResults();
  }

  // 3. Render and Filter HTML dynamically
  function renderResults() {
    hideLoading();

    const filteredResults = currentTab === 'all' 
      ? allFetchedResults 
      : allFetchedResults.filter(item => item.url.includes(`/${currentTab}/`));

    if (filteredResults.length === 0) {
      showEmpty(currentTab);
      // 🟢 Updated the empty count display to include the query
      if (countDisplay) countDisplay.textContent = `About 0 search results for "${currentQuery}"`;
      return;
    }

    // 🟢 Updated the successful count display to include the query
    if (countDisplay) {
      countDisplay.textContent = `About ${filteredResults.length.toLocaleString()} search results for "${currentQuery}"`;
    }
    
    if (emptyState) emptyState.classList.add('hidden');
    
    if (resultsContainer) {
      resultsContainer.innerHTML = filteredResults.map(item => `
        <div class="flex flex-col group">
          <a href="${item.url}" class="inline-block focus:outline-none mb-1">
            <h2 class="text-[20px] md:text-[22px] font-[500] text-[#1a0dab] dark:text-[#8ab4f8] group-hover:underline">${item.meta.title || 'Untitled'}</h2>
          </a>
          <p class="text-tx-main text-[14px] leading-snug line-clamp-2">${item.excerpt}</p>
        </div>
      `).join('');
    }
  }

  // 4. Tab Click Listeners
  searchTabs.forEach(tab => {
    tab.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLElement;
      const clickedTab = target.getAttribute('data-tab') || 'all';

      if (currentTab === clickedTab) return;
      currentTab = clickedTab;

      // Reset styling for all tabs securely
      searchTabs.forEach(t => {
        t.classList.remove('text-tx-main', 'font-[600]');
        t.classList.add('text-tx-muted', 'font-[500]');
        const indicator = t.querySelector('.tab-indicator');
        if (indicator) {
          indicator.classList.remove('opacity-100');
          indicator.classList.add('opacity-0');
        }
      });

      // Apply active styling to clicked tab securely
      target.classList.remove('text-tx-muted', 'font-[500]');
      target.classList.add('text-tx-main', 'font-[600]');
      const targetIndicator = target.querySelector('.tab-indicator');
      if (targetIndicator) {
        targetIndicator.classList.remove('opacity-0');
        targetIndicator.classList.add('opacity-100');
      }

      renderResults();
    });
  });

  // --- UI Helpers ---
  function showLoading() {
    if (resultsContainer) resultsContainer.innerHTML = '';
    if (emptyState) emptyState.classList.add('hidden');
    if (loadingIndicator) loadingIndicator.classList.remove('hidden');
    if (loadingIndicator) loadingIndicator.classList.add('flex');
  }

  function hideLoading() {
    if (loadingIndicator) loadingIndicator.classList.add('hidden');
    if (loadingIndicator) loadingIndicator.classList.remove('flex');
  }

  function showEmpty(tab: string = 'all') {
    if (resultsContainer) resultsContainer.innerHTML = '';
    if (emptyState) emptyState.classList.remove('hidden');
    if (emptyState) emptyState.classList.add('flex');
    
    if (emptyStateMessage) {
      if (tab === 'all') {
        emptyStateMessage.textContent = "We couldn't find anything matching your query.";
      } else {
        emptyStateMessage.textContent = `No ${tab} found for this query.`;
      }
    }
  }

  function clearResults() {
    hideLoading();
    if (emptyState) emptyState.classList.add('hidden');
    if (countDisplay) countDisplay.textContent = '';
    if (resultsContainer) resultsContainer.innerHTML = '';
  }

  // --- Initialization ---
  const urlParams = new URLSearchParams(window.location.search);
  const initialQuery = urlParams.get('q');

  if (initialQuery) {
    performSearch(initialQuery);
  } else {
    showEmpty();
  }

</script>

<style is:global>
  /* Pagefind mark highlighting matching Yahoo/Google standard bolding */
  #search-results mark {
    background-color: transparent;
    color: inherit;
    font-weight: 700;
  }
  
  /* Hide scrollbar for the tab navigation on mobile */
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .hide-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>