---
// Note: Adjust this import to match the actual path to your global layout wrapper
import Layout from '../layouts/Layout.astro';

// We explicitly tell Google NOT to index search result pages to prevent infinite empty URLs
---

<Layout title="Search | Serplora">
  <!-- SEO Protection -->
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow" />
  </Fragment>

  <!-- We use min-h-screen and flex-col to control the layout shift -->
  <main class="min-h-[100dvh] bg-main px-4 md:px-8 font-['Outfit',sans-serif] flex flex-col">
    
    <!-- 🔍 Big Search Bar Area (Shifts up when searching) -->
    <!-- pt-[25vh] puts it in the center like the image. pt-12 shifts it up for results. -->
    <div id="search-view-wrapper" class="w-full max-w-3xl mx-auto transition-all duration-500 ease-out pt-[25vh]">
      
      <!-- Design exactly matches Header.astro overlay (no back button) -->
      <form id="search-page-form" action="/search" method="GET" class="w-full">
        <div class="border-b border-tx-muted/20 pb-3 focus-within:border-tx-main transition-colors">
          <input 
            type="search" 
            name="q" 
            id="search-page-input" 
            placeholder="Search..." 
            autocomplete="off" 
            spellcheck="true" 
            autocorrect="on" 
            autocapitalize="off" 
            class="w-full bg-transparent border-none outline-none appearance-none p-0 text-2xl md:text-3xl font-semibold tracking-tight text-tx-main placeholder:text-tx-muted/40" 
            autofocus
          />
        </div>
        
        <!-- Submit Button (Fades in when typing) -->
        <div id="search-submit-container" class="mt-6 flex justify-end opacity-0 invisible transition-all duration-200">
          <button type="submit" class="inline-flex items-center gap-2 rounded-sm border border-subtle px-4 py-2 text-sm font-medium text-tx-main transition-all duration-200 hover:border-tx-main hover:bg-tx-muted/5 focus:outline-none focus:ring-2 focus:ring-tx-main/20">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
            <span>Search</span>
          </button>
        </div>
      </form>
    </div>

    <!-- 🟢 RESULTS UI CONTAINER (Hidden until search is explicitly submitted) -->
    <div id="search-results-wrapper" class="hidden w-full max-w-3xl mx-auto mt-8 pb-20 transition-all duration-500 opacity-0">

      <!-- 🟢 Tab Navigation -->
      <div class="relative w-full mb-6">
        <div class="flex items-center border-b border-subtle overflow-x-auto hide-scrollbar">
          <div class="flex items-center gap-6 md:gap-8 pr-12 md:pr-0" id="search-tabs">
            
            <button data-tab="all" class="search-tab group relative pb-3 flex items-center gap-2 text-tx-main font-[600] outline-none cursor-pointer">
              All
              <span class="tab-indicator absolute bottom-0 left-0 w-full h-[3px] bg-tx-main rounded-t-sm opacity-100 transition-opacity duration-200"></span>
            </button>
            
            <button data-tab="tutorials" class="search-tab group relative pb-3 flex items-center gap-2 text-tx-muted hover:text-tx-main font-[500] transition-colors outline-none cursor-pointer">
              Tutorials
              <span class="tab-indicator absolute bottom-0 left-0 w-full h-[3px] bg-tx-main rounded-t-sm opacity-0 transition-opacity duration-200"></span>
            </button>

            <button data-tab="projects" class="search-tab group relative pb-3 flex items-center gap-2 text-tx-muted hover:text-tx-main font-[500] transition-colors outline-none cursor-pointer">
              Projects
              <span class="tab-indicator absolute bottom-0 left-0 w-full h-[3px] bg-tx-main rounded-t-sm opacity-0 transition-opacity duration-200"></span>
            </button>

            <button data-tab="quizzes" class="search-tab group relative pb-3 flex items-center gap-2 text-tx-muted hover:text-tx-main font-[500] transition-colors outline-none cursor-pointer">
              Quizzes
              <span class="tab-indicator absolute bottom-0 left-0 w-full h-[3px] bg-tx-main rounded-t-sm opacity-0 transition-opacity duration-200"></span>
            </button>

            <button data-tab="articles" class="search-tab group relative pb-3 flex items-center gap-2 text-tx-muted hover:text-tx-main font-[500] transition-colors outline-none cursor-pointer">
              Articles
              <span class="tab-indicator absolute bottom-0 left-0 w-full h-[3px] bg-tx-main rounded-t-sm opacity-0 transition-opacity duration-200"></span>
            </button>
          </div>
        </div>
        <div class="absolute right-0 top-0 bottom-[1px] w-14 bg-gradient-to-l from-main to-transparent pointer-events-none md:hidden z-10"></div>
      </div>

      <!-- Results Header -->
      <div class="flex items-center justify-between mb-6">
        <span id="search-count" class="text-[15px] font-[400] text-tx-muted"></span>
      </div>

      <!-- Loading State -->
      <div id="search-loading" class="hidden flex-col gap-6">
        {[1, 2, 3].map(() => (
          <div class="w-full bg-transparent animate-pulse">
            <div class="h-6 bg-tx-muted/20 rounded-md w-2/3 mb-3"></div>
            <div class="h-4 bg-tx-muted/10 rounded-md w-full mb-1"></div>
            <div class="h-4 bg-tx-muted/10 rounded-md w-4/5"></div>
          </div>
        ))}
      </div>

      <!-- Results Container -->
      <div id="search-results" class="flex flex-col gap-8">
        <!-- JS will inject results here -->
      </div>

      <!-- Empty State (No Matches) -->
      <div id="search-empty" class="hidden flex-col items-center justify-center py-10 text-center">
        <svg class="w-12 h-12 text-tx-muted/50 mb-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <h2 class="text-lg font-bold text-tx-main mb-1">No results found</h2>
        <p class="text-[15px] text-tx-muted" id="empty-state-message">We couldn't find anything matching your query.</p>
      </div>

    </div>
  </main>
</Layout>

<script>
  // Elements
  const searchViewWrapper = document.getElementById('search-view-wrapper');
  const searchResultsWrapper = document.getElementById('search-results-wrapper');
  const searchInput = document.getElementById('search-page-input') as HTMLInputElement;
  const searchForm = document.getElementById('search-page-form') as HTMLFormElement;
  const submitContainer = document.getElementById('search-submit-container');
  
  const resultsContainer = document.getElementById('search-results');
  const loadingIndicator = document.getElementById('search-loading');
  const emptyState = document.getElementById('search-empty');
  const emptyStateMessage = document.getElementById('empty-state-message');
  const countDisplay = document.getElementById('search-count');
  const searchTabs = document.querySelectorAll('.search-tab');

  let pagefindInstance: any = null;
  let allFetchedResults: any[] = []; 
  let currentTab = 'all'; 
  let currentQuery = ''; 

  // Synonym Dictionary
  const searchSynonyms: Record<string, string> = {
    "how to": "tutorial", "how do i": "tutorial", "learn": "tutorial", "learning": "tutorial",
    "beginner": "tutorial", "beginners": "tutorial", "starting": "tutorial", "starter": "tutorial",
    "intro": "tutorial", "introduction": "tutorial", "basics": "tutorial", "basic": "tutorial",
    "fundamentals": "tutorial", "handbook": "guide", "cheat sheet": "guide", "cheatsheet": "guide",
    "roadmap": "guide", "course": "tutorial", "courses": "tutorial", "class": "tutorial",
    "lesson": "tutorial", "lessons": "tutorial", "walkthrough": "tutorial", "how to build": "project",
    "how to make": "project", "how to create": "project", "build": "project", "building": "project",
    "make": "project", "making": "project", "create": "project", "creating": "project", "clone": "project",
    "app": "project", "application": "project", "demo": "project", "example": "project", "examples": "project",
    "sample": "project", "exercise": "project", "exercises": "project", "hands on": "project",
    "hands-on": "project", "interview questions": "quiz", "practice questions": "quiz", "test": "quiz",
    "tests": "quiz", "testing": "quiz", "exam": "quiz", "exams": "quiz", "assessment": "quiz",
    "practice": "quiz", "questions": "quiz", "question": "quiz", "mcq": "quiz", "mcqs": "quiz",
    "challenge": "quiz", "challenges": "quiz", "difference between": "vs", "comparison": "vs",
    "versus": "vs", "blog": "article", "blogs": "article", "news": "article", "post": "article",
    "posts": "article", "explained": "article", "explanation": "article", "overview": "article",
    "understanding": "article", "deep dive": "article", "how to fix": "guide", "fix": "guide",
    "solve": "guide", "error": "guide", "bug": "guide", "issue": "guide", "solution": "guide",
    "py": "python", "py3": "python", "js": "javascript", "ts": "typescript", "reactjs": "react",
    "nodejs": "node", "nextjs": "next", "astrojs": "astro", "tailwind": "tailwindcss", "css3": "css",
    "html5": "html"
  };

  function optimizeSearchQuery(rawQuery: string): string {
    let query = rawQuery.toLowerCase();
    const sortedKeys = Object.keys(searchSynonyms).sort((a, b) => b.length - a.length);
    for (const phrase of sortedKeys) {
      const replacement = searchSynonyms[phrase];
      const escapedPhrase = phrase.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
      const regex = new RegExp(`\\b${escapedPhrase}\\b`, 'gi');
      query = query.replace(regex, replacement);
    }
    return query;
  }

  async function initPagefind() {
    if (pagefindInstance) return pagefindInstance;
    try {
      const pagefindUrl = '/pagefind/pagefind.js';
      // @ts-ignore
      pagefindInstance = await import(/* @vite-ignore */ pagefindUrl);
      await pagefindInstance.init();
      return pagefindInstance;
    } catch (e) {
      console.error("Pagefind failed to load.", e);
      return null;
    }
  }

  // --- Layout Transitions ---
  function shiftLayoutToResults() {
    if (searchViewWrapper) {
      searchViewWrapper.classList.remove('pt-[25vh]');
      searchViewWrapper.classList.add('pt-12');
    }
    if (searchResultsWrapper) {
      searchResultsWrapper.classList.remove('hidden');
      setTimeout(() => searchResultsWrapper.classList.remove('opacity-0'), 50); // slight delay for smooth fade
    }
  }

  function revertLayoutToCentered() {
    if (searchViewWrapper) {
      searchViewWrapper.classList.add('pt-[25vh]');
      searchViewWrapper.classList.remove('pt-12');
    }
    if (searchResultsWrapper) {
      searchResultsWrapper.classList.add('opacity-0');
      setTimeout(() => searchResultsWrapper.classList.add('hidden'), 300); // Wait for fade out
    }
  }

  // --- Core Search Logic ---
  async function performSearch(query: string) {
    currentQuery = query; 
    
    // Shift the UI up and show results container
    shiftLayoutToResults();
    showLoading();

    const optimizedQuery = optimizeSearchQuery(query);
    const pf = await initPagefind();
    
    if (!pf) {
      showEmpty();
      return;
    }

    const searchResult = await pf.search(optimizedQuery);
    allFetchedResults = await Promise.all(searchResult.results.map((r: any) => r.data()));
    renderResults();
  }

  function renderResults() {
    hideLoading();

    const filteredResults = currentTab === 'all' 
      ? allFetchedResults 
      : allFetchedResults.filter(item => item.url.includes(`/${currentTab}/`));

    if (filteredResults.length === 0) {
      showEmpty(currentTab);
      if (countDisplay) countDisplay.textContent = `About 0 results for "${currentQuery}"`;
      return;
    }

    if (countDisplay) countDisplay.textContent = `About ${filteredResults.length.toLocaleString()} results for "${currentQuery}"`;
    if (emptyState) emptyState.classList.add('hidden');
    
    if (resultsContainer) {
      resultsContainer.innerHTML = filteredResults.map(item => `
        <div class="flex flex-col group">
          <a href="${item.url}" class="inline-block focus:outline-none mb-1">
            <h2 class="text-[20px] md:text-[22px] font-[500] text-[#1a0dab] dark:text-[#8ab4f8] group-hover:underline">${item.meta.title || 'Untitled'}</h2>
          </a>
          <p class="text-tx-main text-[14px] leading-snug line-clamp-2">${item.excerpt}</p>
        </div>
      `).join('');
    }
  }

  // --- UI Helpers ---
  function showLoading() {
    if (countDisplay) countDisplay.textContent = 'Searching...';
    if (resultsContainer) resultsContainer.innerHTML = '';
    if (emptyState) emptyState.classList.add('hidden');
    if (loadingIndicator) {
      loadingIndicator.classList.remove('hidden');
      loadingIndicator.classList.add('flex');
    }
  }

  function hideLoading() {
    if (loadingIndicator) {
      loadingIndicator.classList.add('hidden');
      loadingIndicator.classList.remove('flex');
    }
  }

  function showEmpty(tab: string = 'all') {
    if (resultsContainer) resultsContainer.innerHTML = '';
    if (emptyState) {
      emptyState.classList.remove('hidden');
      emptyState.classList.add('flex');
    }
    if (emptyStateMessage) {
      emptyStateMessage.textContent = tab === 'all' 
        ? "We couldn't find anything matching your query. Try modifying your search terms." 
        : `No ${tab} found for this query.`;
    }
  }

  // --- Input & Form Handlers ---

  // 1. Show/Hide submit button on typing (No auto-search)
  searchInput?.addEventListener('input', (e) => {
    const target = e.target as HTMLInputElement;
    const val = target.value.trim();
    if (val.length > 0) {
      submitContainer?.classList.remove('opacity-0', 'invisible');
    } else {
      submitContainer?.classList.add('opacity-0', 'invisible');
    }
  });

  // 2. Handle explicit submission (pressing Enter or clicking button)
  searchForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const query = searchInput?.value.trim() || '';
    
    const newUrl = new URL(window.location.href);
    if (query) {
      newUrl.searchParams.set('q', query);
      window.history.replaceState({}, '', newUrl);
      performSearch(query); // Trigger search
    } else {
      newUrl.searchParams.delete('q');
      window.history.replaceState({}, '', newUrl);
      revertLayoutToCentered(); // Revert to center if they search an empty string
    }
  });

  // 3. Tab Listeners
  searchTabs.forEach(tab => {
    tab.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLElement;
      const clickedTab = target.getAttribute('data-tab') || 'all';

      if (currentTab === clickedTab) return;
      currentTab = clickedTab;

      searchTabs.forEach(t => {
        t.classList.remove('text-tx-main', 'font-[600]');
        t.classList.add('text-tx-muted', 'font-[500]');
        const indicator = t.querySelector('.tab-indicator');
        if (indicator) {
          indicator.classList.remove('opacity-100');
          indicator.classList.add('opacity-0');
        }
      });

      target.classList.remove('text-tx-muted', 'font-[500]');
      target.classList.add('text-tx-main', 'font-[600]');
      const targetIndicator = target.querySelector('.tab-indicator');
      if (targetIndicator) {
        targetIndicator.classList.remove('opacity-0');
        targetIndicator.classList.add('opacity-100');
      }

      renderResults();
    });
  });

  // --- Initialization on Load ---
  const urlParams = new URLSearchParams(window.location.search);
  const initialQuery = urlParams.get('q');

  if (initialQuery) {
    if (searchInput) searchInput.value = initialQuery;
    if (submitContainer) submitContainer.classList.remove('opacity-0', 'invisible');
    performSearch(initialQuery); // Directly show results
  } else {
    // Starts in the default centered state
    revertLayoutToCentered(); 
  }

</script>

<style is:global>
  #search-results mark {
    background-color: transparent;
    color: inherit;
    font-weight: 700;
  }
  
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .hide-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  
  /* Removes default webkit search input icons */
  input[type="search"]::-webkit-search-decoration,
  input[type="search"]::-webkit-search-cancel-button,
  input[type="search"]::-webkit-search-results-button,
  input[type="search"]::-webkit-search-results-decoration {
    -webkit-appearance: none;
  }
</style>