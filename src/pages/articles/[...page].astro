---
import { getCollection, getEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const pageEntry = await getEntry('blogPage', 'data');
  const hiddenPosts = pageEntry?.data?.hiddenPosts || [];
  const pageSize = pageEntry?.data?.postsPerPage || 9;

  const allPosts = await getCollection('posts');
  
  const publishedPosts = allPosts.filter((post) => {
    if (post.data.draft === true) return false;
    const slug = post.data.slug || post.id;
    if (hiddenPosts.includes(slug)) return false;
    return true;
  }).sort((a, b) => {
    const dateA = new Date(a.data.publishDate || Date.now()).valueOf();
    const dateB = new Date(b.data.publishDate || Date.now()).valueOf();
    return dateB - dateA;
  });

  const totalPages = Math.ceil(publishedPosts.length / pageSize) || 1;

  return Array.from({ length: totalPages }).map((_, i) => {
    const currentPage = i + 1;
    const isFirst = currentPage === 1;
    const isLast = currentPage === totalPages;

    const start = i * pageSize;
    const end = start + pageSize;
    const data = publishedPosts.slice(start, end);

    return {
      // 🟢 This correctly maps to /articles and /articles/page/2 (Requires [...page].astro filename)
      params: {
        page: isFirst ? undefined : `page/${currentPage}`
      },
      props: {
        page: {
          data,
          currentPage,
          lastPage: totalPages,
          url: {
            current: isFirst ? '/articles' : `/articles/page/${currentPage}`,
            prev: isFirst ? undefined : (currentPage === 2 ? '/articles' : `/articles/page/${currentPage - 1}`),
            next: isLast ? undefined : `/articles/page/${currentPage + 1}`,
          }
        },
        pageEntry
      }
    };
  });
}

const { page, pageEntry } = Astro.props;

const headline = pageEntry?.data?.headline || 'Writing & Updates';
const subheadline = pageEntry?.data?.subheadline || 'Thoughts, stories, and ideas from our team.';

const isPaginated = page.currentPage > 1;
let customSeo = pageEntry?.data?.seo ? { ...pageEntry.data.seo } : {};

if (isPaginated) {
  const template = pageEntry?.data?.paginationTitleTemplate || ' - Page {page}';
  const suffix = template.replace('{page}', String(page.currentPage));
  const padding = (suffix.startsWith(' ') || suffix.startsWith('-')) ? '' : ' ';
  customSeo.metaTitle = `${customSeo.metaTitle || ''}${padding}${suffix}`;
  
  if (pageEntry?.data?.noindexPaginated) {
    customSeo.robotsIndex = false; 
  }
}

const titleFallback = isPaginated ? `${headline} - Page ${page.currentPage}` : headline;
const generateSlug = (post: any) => post.data.slug || post.id;

function getPaginationWindow(current: number, total: number) {
  if (total <= 5) return Array.from({ length: total }, (_, i) => i + 1);
  if (current <= 3) return [1, 2, 3, 4, '...', total];
  if (current >= total - 2) return [1, '...', total - 3, total - 2, total - 1, total];
  return [1, '...', current - 1, current, current + 1, '...', total];
}
const paginationList = getPaginationWindow(page.currentPage, page.lastPage);
---

<Layout 
  seo={customSeo}
  titleFallback={titleFallback}
  excerptFallback={subheadline}
>
  <Fragment slot="head">
    {page.url.prev && <link rel="prev" href={page.url.prev} />}
    {page.url.next && <link rel="next" href={page.url.next} />}
  </Fragment>

  <main class="w-full max-w-4xl mx-auto px-6 py-20 md:py-32 flex flex-col">
    
    <header class="mb-20 md:mb-28">
      <div class="w-12 h-1 bg-tx-main mb-8 rounded-full opacity-20"></div>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-tight text-tx-main mb-6">
        {isPaginated ? `${headline} (Page ${page.currentPage})` : headline}
      </h1>
      <p class="text-lg md:text-xl text-tx-muted font-medium max-w-2xl leading-relaxed">
        {subheadline}
      </p>
    </header>

    <section>
      {page.data.length === 0 ? (
        <div class="py-12 border-t border-subtle">
          <p class="text-tx-muted text-lg">No posts available right now.</p>
        </div>
      ) : (
        <div class="flex flex-col border-t border-subtle">
          {page.data.map((post) => {
            const slug = generateSlug(post);
            return (
              <a 
                href={`/articles/${slug}`}
                class="group flex flex-col md:flex-row md:items-baseline justify-between py-10 md:py-12 border-b border-subtle -mx-6 px-6 hover:bg-surface transition-colors duration-300 rounded-2xl md:rounded-none"
              >
                <div class="md:w-2/3 pr-0 md:pr-8">
                  <h2 class="text-2xl md:text-3xl font-bold text-tx-main mb-3 tracking-tight group-hover:translate-x-2 transition-transform duration-300">
                    {post.data?.title || slug}
                  </h2>
                  {post.data?.excerpt && (
                    <div 
                      class="text-tx-muted text-base md:text-lg leading-relaxed line-clamp-2 md:line-clamp-3 group-hover:translate-x-2 transition-transform duration-300 delay-75" 
                      set:html={post.data.excerpt} 
                    />
                  )}
                </div>
                <div class="mt-6 md:mt-0 md:w-1/3 flex items-center md:justify-end text-sm font-bold tracking-widest uppercase text-tx-main opacity-60 group-hover:opacity-100 transition-opacity duration-300">
                  <span class="mr-3">Read Article</span>
                  <svg class="w-5 h-5 -rotate-45 group-hover:rotate-0 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </div>
              </a>
            );
          })}
        </div>
      )}
    </section>

    {/* 🟢 FIXED: Un-squishable Flexbox layout with high-contrast active state */}
    {page.lastPage > 1 && (
      <nav class="mt-20 flex flex-wrap items-center justify-center gap-2 md:gap-4 border-t border-subtle pt-10 font-['JetBrains_Mono',monospace] text-base" aria-label="Pagination">
        
        {page.url.prev ? (
          <a href={page.url.prev} class="flex items-center gap-2 text-tx-main hover:text-brand transition-colors font-bold px-4 py-2 rounded-lg hover:bg-surface">
            <span>&larr;</span> Prev
          </a>
        ) : (
          <div class="px-4 py-2 opacity-30 cursor-not-allowed text-tx-muted flex items-center gap-2">
            <span>&larr;</span> Prev
          </div>
        )}

        <div class="flex items-center gap-1">
          {paginationList.map(num => {
            if (num === '...') return <span class="px-2 py-2 text-tx-muted opacity-50 font-bold">...</span>;
            
            const isCurrent = num === page.currentPage;
            const url = num === 1 ? '/articles' : `/articles/page/${num}`;
            
            return (
              <a 
                href={url} 
                class={`w-10 h-10 flex items-center justify-center rounded-lg transition-all duration-300 font-bold border ${
                  isCurrent 
                    ? 'border-tx-main text-tx-main bg-tx-main/10 shadow-sm' 
                    : 'border-transparent text-tx-muted hover:border-subtle hover:text-tx-main hover:bg-surface'
                }`}
                aria-current={isCurrent ? 'page' : undefined}
              >
                {num}
              </a>
            );
          })}
        </div>

        {page.url.next ? (
          <a href={page.url.next} class="flex items-center gap-2 text-tx-main hover:text-brand transition-colors font-bold px-4 py-2 rounded-lg hover:bg-surface">
            Next <span>&rarr;</span>
          </a>
        ) : (
          <div class="px-4 py-2 opacity-30 cursor-not-allowed text-tx-muted flex items-center gap-2">
            Next <span>&rarr;</span>
          </div>
        )}

      </nav>
    )}
  </main>
</Layout>