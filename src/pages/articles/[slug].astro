---
import { getCollection, getEntry, render } from 'astro:content';
import { BM25Utils } from 'relatinator';
import Layout from '../../layouts/Layout.astro';

export const prerender = true;

export async function getStaticPaths() {
  const allPosts = await getCollection('posts');
  const publishedPosts = allPosts.filter((entry) => !entry.data.draft);

  const documents = publishedPosts.map((post) => {
    const contentToAnalyze = [
      post.data.title,
      post.data.excerpt,
      post.data.category,
      post.data.tags ? post.data.tags.join(' ') : '',
      post.body || ''
    ].filter(Boolean).join(' ');

    return { id: post.id, content: contentToAnalyze };
  });

  await BM25Utils.resetInstance();
  await BM25Utils.train(documents);

  const paths = await Promise.all(publishedPosts.map(async (entry) => {
    const contentToCompare = [
      entry.data.title,
      entry.data.excerpt,
      entry.data.category,
      entry.data.tags ? entry.data.tags.join(' ') : '',
      entry.body || ''
    ].filter(Boolean).join(' ');

    const relatedIds = await BM25Utils.findRelated(contentToCompare, entry.id, 6);
    const relatedPosts = relatedIds.map(id => publishedPosts.find(p => p.id === id)).filter(Boolean); 

    return { params: { slug: entry.id }, props: { entry, relatedPosts } };
  }));

  return paths;
}

const { entry, relatedPosts } = Astro.props;
const { Content } = await render(entry);

// 🟢 NEW: Fetch the home page data to get the custom root breadcrumb
const homeEntry = await getEntry('homePage', 'index');
const rootBreadcrumb = homeEntry?.data?.breadcrumbTitle || 'home';

const displayDate = entry.data.updatedDate || entry.data.publishDate || new Date();
const formattedDate = new Date(displayDate).toISOString().split('T')[0];
const breadcrumbLabel = entry.data.breadcrumbTitle || entry.data.title || entry.id;
---

<Layout seo={entry.data.seo} titleFallback={entry.data.title} excerptFallback={entry.data.excerpt}>
  <main class="w-full bg-transparent py-10 md:py-20 font-['Outfit',sans-serif]">
    <article class="max-w-[900px] mx-auto px-6" data-pagefind-body>
      
      <nav aria-label="Breadcrumb" data-pagefind-ignore class="mb-8 md:mb-10 font-['JetBrains_Mono',monospace] text-[12px] md:text-[13px] text-tx-muted flex flex-wrap items-center gap-2">
        {/* 🟢 FIXED: Using rootBreadcrumb */}
        <a href="/" class="hover:text-brand transition-colors">{rootBreadcrumb.toLowerCase()}</a>
        <span class="opacity-40">/</span>
        <a href="/articles" class="hover:text-brand transition-colors">articles</a>
        <span class="opacity-40">/</span>
        <span class="text-tx-main font-medium truncate" aria-current="page">{breadcrumbLabel.toLowerCase()}</span>
      </nav>

      <header class="mb-10 md:mb-12">
        <h1 data-pagefind-weight="10" class="text-3xl md:text-5xl font-[800] text-tx-main tracking-tight leading-[1.2] md:leading-[1.15] mb-6">
          {entry.data.title || entry.id}
        </h1>
        {entry.data.excerpt && (
          <div class="markdown-content text-[16px] md:text-[20px] font-[400] leading-[1.7] md:leading-[1.8]" set:html={entry.data.excerpt} />
        )}
      </header>

      {entry.data.image && (
        <figure data-pagefind-ignore class="mb-10 w-full rounded-[12px] md:rounded-[16px] border border-subtle bg-surface shadow-sm overflow-hidden">
          <img src={entry.data.image} alt={entry.data.title} class="w-full aspect-video object-cover" />
        </figure>
      )}

      <div data-pagefind-ignore class="flex flex-wrap items-center gap-x-8 gap-y-4 py-5 border-y border-subtle mb-12 font-['JetBrains_Mono',monospace] text-[12px] md:text-[13px]">
        <div class="flex items-center gap-3">
          {entry.data.authorImage ? (
            <img src={entry.data.authorImage} alt={entry.data.authorName} class="w-9 h-9 rounded-md object-cover border border-subtle" />
          ) : (
            <div class="w-9 h-9 rounded-md bg-main border border-subtle flex items-center justify-center font-bold text-tx-main text-[14px]">
              {entry.data.authorName.charAt(0)}
            </div>
          )}
          <div class="flex flex-col">
            <span class="text-tx-muted text-[10px] uppercase tracking-wider">Author</span>
            <span class="text-tx-main font-medium">{entry.data.authorName}</span>
          </div>
        </div>
        
        <div class="w-[1px] h-8 bg-subtle hidden sm:block"></div>
        
        <div class="flex flex-col">
          <span class="text-tx-muted text-[10px] uppercase tracking-wider">Last Commit</span>
          <span class="text-tx-main font-medium">{formattedDate}</span>
        </div>
      </div>

      <div class="markdown-content text-[16px] md:text-[20px] leading-[1.7] md:leading-[1.8] pb-16 border-b border-subtle font-['Outfit',sans-serif]">
        <Content />
      </div>

      {entry.data.faqs && entry.data.faqs.length > 0 && (
        <section class="mt-16 pb-16 border-b border-subtle">
          <h2 class="text-2xl font-[800] text-tx-main mb-8 tracking-tight flex items-center gap-3">
            <svg class="w-6 h-6 text-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M4 12a8 8 0 1116 0 8 8 0 01-16 0z" /></svg>
            FAQs
          </h2>
          <div class="flex flex-col gap-3 md:gap-4">
            {entry.data.faqs.map((faq: any) => (
              <details class="group bg-surface border border-subtle rounded-[8px] overflow-hidden [&_summary::-webkit-details-marker]:hidden">
                <summary class="flex items-center justify-between cursor-pointer px-4 md:px-5 py-4 font-[600] text-[16px] md:text-[17px] text-tx-main bg-surface hover:bg-main transition-colors outline-none select-none">
                  <span class="flex items-center gap-3 pr-4">
                    <span class="text-brand font-['JetBrains_Mono',monospace] font-bold">?</span>
                    {faq.question}
                  </span>
                  <span class="transition-transform duration-300 group-open:rotate-180 text-tx-muted font-['JetBrains_Mono',monospace] shrink-0">
                    ↓
                  </span>
                </summary>
                <div class="faq-content px-4 md:px-5 pb-5 pt-3 text-[15px] md:text-[16px] font-[400] text-tx-muted leading-[1.6] md:leading-[1.7] bg-surface border-t border-subtle/50 md:ml-6">
                  <div set:html={faq.answer} />
                </div>
              </details>
            ))}
          </div>
        </section>
      )}

      {relatedPosts.length > 0 && (
        <section data-pagefind-ignore class="mt-16">
        <h3 class="text-xl font-[800] text-tx-main mb-6 tracking-tight font-['JetBrains_Mono',monospace]">ls ./related-articles</h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 md:gap-6">
            {relatedPosts.map((post) => (
              <a href={`/articles/${post.id}`} class="group flex flex-col bg-surface rounded-[12px] border border-subtle p-4 md:p-5 hover:border-brand/50 hover:shadow-md hover:shadow-brand/5 transition-all duration-300">
                {post.data.image && (
                  <img src={post.data.image} alt={post.data.title} class="w-full h-32 md:h-36 object-cover rounded-[8px] mb-4 border border-subtle" />
                )}
                <h4 class="text-[16px] md:text-[17px] font-[700] text-tx-main group-hover:text-brand transition-colors mb-2 line-clamp-2 leading-tight">
                  {post.data.title || post.id}
                </h4>
                {post.data.excerpt && (
                  <p class="text-[13px] md:text-[14px] font-[400] text-tx-muted line-clamp-2 mt-auto">
                    {post.data.excerpt.replace(/<[^>]*>?/gm, '')}
                  </p>
                )}
              </a>
            ))}
          </div>
        </section>
      )}
    </article>
  </main>
  {entry.data.customJs && ( <script is:inline set:html={entry.data.customJs}></script> )}
</Layout>

<style is:global>
  details > summary { list-style: none; }

  .markdown-content h1, .markdown-content h2, .markdown-content h3, .markdown-content h4 {
    color: var(--color-tx-main); font-weight: 800; letter-spacing: -0.025em; margin-top: 2em; margin-bottom: 0.75em;
  }
  .markdown-content h2 { font-size: 1.75rem; line-height: 1.3; }
  .markdown-content h3 { font-size: 1.4rem; line-height: 1.3; }
  
  @media (min-width: 768px) {
    .markdown-content h2 { font-size: 2rem; }
    .markdown-content h3 { font-size: 1.5rem; }
  }
  
  .markdown-content p, .faq-content p { color: var(--color-tx-main); margin-bottom: 1.5em; opacity: 0.8; }
  .markdown-content p:last-child { margin-bottom: 0; }
  .markdown-content strong, .faq-content strong { color: var(--color-tx-main); font-weight: 700; }
  
  .markdown-content a, .faq-content a { color: var(--color-brand); text-decoration: none; font-weight: 500; }
  .markdown-content a:hover, .faq-content a:hover { text-decoration: underline; }

  .markdown-content ul, .faq-content ul { list-style-type: disc; padding-left: 1.2em; margin-bottom: 1.5em; color: var(--color-tx-main); opacity: 0.8; }
  .markdown-content ol, .faq-content ol { list-style-type: decimal; padding-left: 1.2em; margin-bottom: 1.5em; color: var(--color-tx-main); opacity: 0.8; }
  .markdown-content li, .faq-content li { margin-bottom: 0.5em; padding-left: 0.25em; }

  /* --- NEW: Dark mode text overrides --- */
  .dark .markdown-content h1,
  .dark .markdown-content h2,
  .dark .markdown-content h3,
  .dark .markdown-content h4,
  .dark .markdown-content p,
  .dark .faq-content p,
  .dark .markdown-content ul,
  .dark .faq-content ul,
  .dark .markdown-content ol,
  .dark .faq-content ol {
    color: var(--color-tx-muted);
  }

  .markdown-content blockquote { 
    border-left: 4px solid var(--color-brand); padding-left: 1.25em; color: var(--color-tx-main); 
    font-style: italic; margin-bottom: 1.5em; background-color: var(--color-bg-surface);
    padding-top: 0.5em; padding-bottom: 0.5em; border-radius: 0 0.5rem 0.5rem 0;
  }

  .markdown-content pre { 
    background-color: var(--color-bg-surface); border: 1px solid var(--color-border-subtle); 
    border-radius: 0.75rem; padding: 1.25rem; overflow-x: auto; margin-bottom: 1.75em; 
    box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05); position: relative; 
    font-family: 'JetBrains Mono', monospace; font-size: 0.85em; line-height: 1.6;
    color: var(--color-tx-main); opacity: 0.9;
  }
  
  .markdown-content code { 
    font-family: 'JetBrains Mono', monospace; font-size: 0.85em; 
    color: var(--color-tx-main); /* 🟢 Guaranteed WCAG AAA Contrast */
    background-color: rgba(128, 128, 128, 0.12); /* Neutral background */
    border: 1px solid rgba(128, 128, 128, 0.2); 
    padding: 0.15em 0.3em; border-radius: 0.25rem;
  }

  .markdown-content pre code { 
    background-color: transparent !important; color: inherit !important; 
    font-size: inherit !important; padding: 0 !important; border: none !important; 
  }

  .copy-code-btn {
    position: absolute; top: 8px; right: 8px; background: var(--color-bg-surface);
    border: 1px solid var(--color-border-subtle); color: var(--color-tx-muted);
    border-radius: 6px; padding: 4px 10px; font-size: 10px;
    font-family: 'JetBrains Mono', monospace; font-weight: 600; cursor: pointer;
    opacity: 0; transition: all 0.2s ease;
  }
  .markdown-content pre:hover .copy-code-btn { opacity: 1; }
  .copy-code-btn:hover { background: var(--color-bg-main); color: var(--color-tx-main); }
  .copy-code-btn.copied { color: var(--color-brand); border-color: var(--color-brand); }

  .markdown-content img { border-radius: 0.75rem; border: 1px solid var(--color-border-subtle); margin-bottom: 1.75em; margin-top: 1.75em; width: 100%; height: auto; }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const codeBlocks = document.querySelectorAll('.markdown-content pre');

    codeBlocks.forEach((preBlock: any) => {
      const textToCopy = preBlock.innerText || preBlock.textContent;
      const copyButton = document.createElement('button');
      copyButton.className = 'copy-code-btn';
      copyButton.textContent = 'Copy';
      preBlock.appendChild(copyButton);

      copyButton.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(textToCopy);
          copyButton.textContent = 'Copied!';
          copyButton.classList.add('copied');
          setTimeout(() => {
            copyButton.textContent = 'Copy';
            copyButton.classList.remove('copied');
          }, 2000);
        } catch (err) {
          console.error('Failed to copy code: ', err);
          copyButton.textContent = 'Error';
        }
      });
    });
  });
</script>