---
// src/layouts/SidebarSeriesLayout.astro
import Layout from './Layout.astro';
import { getEntry } from 'astro:content';
import Breadcrumb from '../components/ui/Breadcrumb.astro';

const { parent, items, currentSlug, basePath } = Astro.props;

// 1. Determine active data for SEO and titles
const currentActiveData = currentSlug === 'overview' 
  ? parent.data 
  : items.find((i: any) => i.data.urlSlug === currentSlug)?.data || parent.data;

// 2. Clean Title Helper
const cleanTitle = (title: string) => {
  let cleaned = title.includes('-') ? title.split(' - ')[1].trim() : title;
  return cleaned.replace(/^[\d.]+\s*/, '').trim(); 
};

// 3. Calculate Breadcrumb Titles
const parentBreadcrumb = (parent.data.breadcrumbTitle || parent.data.title).toLowerCase();
const currentBreadcrumb = (currentActiveData.breadcrumbTitle || cleanTitle(currentActiveData.title)).toLowerCase();

// 4. Calculate Prev / Next Navigation dynamically
let prevLink = null;
let nextLink = null;

if (currentSlug === 'overview') {
  if (items.length > 0) {
    nextLink = {
      title: cleanTitle(items[0].data.title),
      url: `/${basePath}/${parent.id}/${items[0].data.urlSlug}`
    };
  }
} else {
  const currentIndex = items.findIndex((i: any) => i.data.urlSlug === currentSlug);
  if (currentIndex !== -1) {
    if (currentIndex === 0) {
      prevLink = { title: cleanTitle(parent.data.title), url: `/${basePath}/${parent.id}` };
    } else {
      prevLink = {
        title: cleanTitle(items[currentIndex - 1].data.title),
        url: `/${basePath}/${parent.id}/${items[currentIndex - 1].data.urlSlug}`
      };
    }
    if (currentIndex < items.length - 1) {
      nextLink = {
        title: cleanTitle(items[currentIndex + 1].data.title),
        url: `/${basePath}/${parent.id}/${items[currentIndex + 1].data.urlSlug}`
      };
    }
  }
}

// 5. Resolve Sidebar Ads safely
const adsData = await getEntry('sidebarAds', 'data');
let adHtml = null;
if (adsData?.data) {
  const specificAd = adsData.data.tutorialAdsGroup?.specificOverrides?.find((ad: any) => ad.target === parent.id);
  if (specificAd && specificAd.adContent) {
    adHtml = specificAd.adContent;
  } else if (basePath === 'tutorials' && adsData.data.tutorialAdsGroup?.allTutorialsAd) {
    adHtml = adsData.data.tutorialAdsGroup.allTutorialsAd;
  } else if (adsData.data.globalAd) {
    adHtml = adsData.data.globalAd;
  }
}

// 6. Sidebar Mixed Items Logic (Blocks)
const sidebarItems = parent.data.sidebarItems || [];
const hasItems = sidebarItems.length > 0;
---

<Layout 
  seo={currentActiveData.seo} 
  titleFallback={currentActiveData.title} 
  excerptFallback={currentActiveData.excerpt}
  schemaData={currentActiveData}
>
  
  {/* --- MODAL BACKDROP --- */}
  <div id="nav-backdrop" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-[140] opacity-0 pointer-events-none transition-opacity duration-300"></div>
  
  {/* --- NAVIGATION DRAWER (Full height, Slides from BOTTOM) --- */}
  <aside id="series-nav-modal" class="fixed bottom-0 left-0 w-full h-[100dvh] bg-main z-[150] transform translate-y-full transition-transform duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] flex flex-col">
    
    {/* Constrained Inner Wrapper (Keeps it readable on Ultra-Wide Desktop monitors) */}
    <div class="w-full max-w-[800px] mx-auto flex flex-col h-full pt-4 relative">
      
      {/* Header (Text Removed, Right-Aligned Button) */}
      <div class="px-5 pt-2 pb-4 flex justify-end items-center shrink-0">
        {/* Minimize Button */}
        <button id="modal-close-btn" class="p-2.5 text-tx-muted hover:text-tx-main  hover:border-subtle rounded-xl transition-all active:scale-95 shrink-0" aria-label="Minimize Menu">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" /></svg>
        </button>
      </div>

      {/* Scrollable Nav Items */}
      <nav id="sidebar-nav-container" class="flex-1 overflow-y-auto px-4 py-6 custom-scrollbar flex flex-col gap-1.5 relative">
        
        {/* Overview Link */}
        <a href={`/${basePath}/${parent.id}`} class={`block px-4 py-3 rounded-xl text-[14.5px] transition-all ${currentSlug === 'overview' ? 'bg-brand/10 text-brand font-semibold active-item' : 'text-tx-main hover:bg-surface hover:text-brand'}`}>
          {cleanTitle(parent.data.title)} Overview
        </a>

        {/* Grouped Links & Standalone Links */}
        {hasItems ? (
          sidebarItems.map((block: any) => {
            
            if (block.discriminant === 'group') {
              const group = block.value;
              const isGroupActive = group.lessons.some((lessonId: string) => {
                const item = items.find((i: any) => i.data.urlSlug === lessonId || i.id === lessonId);
                return item && item.data.urlSlug === currentSlug;
              });

              return (
                <details class="group mt-2" open={isGroupActive || undefined}>
                  <summary class="flex items-center justify-between cursor-pointer px-4 py-2.5 rounded-xl text-[14.5px] text-tx-main font-medium hover:bg-surface transition-colors list-none">
                    <span>{group.groupTitle}</span>
                    <svg class="w-4 h-4 transition-transform duration-200 group-open:rotate-180 opacity-50" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                  </summary>
                  
                  <ul class="flex flex-col ml-4 pl-3 border-l border-subtle mt-1.5 mb-3 gap-1">
                    {group.lessons.map((lessonId: string) => {
                      const item = items.find((i: any) => i.data.urlSlug === lessonId || i.id === lessonId);
                      if (!item) return null;
                      const isActive = currentSlug === item.data.urlSlug;
                      
                      return (
                        <li>
                          <a 
                            href={`/${basePath}/${parent.id}/${item.data.urlSlug}`} 
                            class={`block px-4 py-2.5 rounded-lg text-[14.5px] transition-all ${
                              isActive 
                                ? 'text-brand font-semibold active-item' 
                                : 'text-tx-muted hover:bg-surface hover:text-tx-main'
                            }`}
                          >
                            {cleanTitle(item.data.title)}
                          </a>
                        </li>
                      )
                    })}
                  </ul>
                </details>
              )
            }
            
            else if (block.discriminant === 'link') {
              const lessonId = block.value.lesson;
              const item = items.find((i: any) => i.data.urlSlug === lessonId || i.id === lessonId);
              if (!item) return null;
              const isActive = currentSlug === item.data.urlSlug;
              
              return (
                <a 
                  href={`/${basePath}/${parent.id}/${item.data.urlSlug}`} 
                  class={`block px-4 py-3 rounded-xl text-[14.5px] transition-all ${
                    isActive 
                      ? 'text-brand font-semibold active-item' 
                      : 'text-tx-main hover:bg-surface hover:text-brand'
                  }`}
                >
                  {cleanTitle(item.data.title)}
                </a>
              )
            }
          })
        ) : (
          items.map((item: any) => (
            <a href={`/${basePath}/${parent.id}/${item.data.urlSlug}`} class={`block px-4 py-3 rounded-xl text-[14.5px] transition-all ${currentSlug === item.data.urlSlug ? 'bg-brand/10 text-brand font-semibold active-item' : 'text-tx-main hover:bg-surface hover:text-brand'}`}>
              {cleanTitle(item.data.title)}
            </a>
          ))
        )}
      </nav>
      
      {/* Optional Ad inside drawer */}
      {adHtml && (
        <div class="lg:hidden shrink-0 pt-4 border-t border-subtle px-4 pb-8">
          <div class="ad-container w-full" set:html={adHtml} />
        </div>
      )}
    </div>
  </aside>

  {/* --- PAGE CONTENT LAYOUT (Perfectly Centered Container) --- */}
  <div class="max-w-[1400px] mx-auto flex flex-col min-[1264px]:flex-row w-full justify-between items-start relative font-['Outfit',sans-serif]">
    
    {/* 1. Dummy Left Counterweight (Crucial for perfect centering!) */}
    <div class="hidden min-[1264px]:block w-[300px] shrink-0"></div>

    {/* 2. Main Content Area */}
    <main class="flex-1 min-w-0 w-full max-w-[800px] shrink mx-auto flex flex-col pt-6 md:pt-8 px-4 md:px-6 lg:px-8">
      
      {/* Breadcrumbs */}
      {currentSlug === 'overview' ? (
        <Breadcrumb 
          section={basePath as any} 
          current={parentBreadcrumb} 
          class="mb-6 font-['JetBrains_Mono',monospace] text-[11px] text-tx-muted flex items-center gap-1.5 flex-wrap" 
        />
      ) : (
        <Breadcrumb 
          section={basePath as any} 
          parents={[{ label: parentBreadcrumb, url: `/${basePath}/${parent.id}` }]} 
          current={currentBreadcrumb} 
          class="mb-6 font-['JetBrains_Mono',monospace] text-[11px] text-tx-muted flex items-center gap-1.5 flex-wrap" 
        />
      )}

      {/* 
        Sleek Minimalist TOC Button. 
        It renders hidden here, and a script moves it EXACTLY below the markdown <h1> title.
      */}
      <button id="toc-trigger-btn" style="display: none;" class="items-center gap-1.5 text-[12px] font-bold uppercase tracking-wider text-tx-muted hover:text-brand transition-colors w-fit pb-6 pt-1 cursor-pointer">
        <svg class="w-4 h-4 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" /></svg>
        Browse All Lessons
      </button>

      {/* Markdown Body */}
      <div class="w-full">
        <div class="markdown-content text-[15.5px] md:text-[17px] leading-[1.7] md:leading-[1.8] pb-8">
          <slot />
        </div>

        {/* Bottom Pagination */}
        <div class="mt-8 pt-6 border-t border-subtle flex flex-col-reverse sm:flex-row items-center justify-between gap-3 pb-12">
          {prevLink ? (
            <a href={prevLink.url} class="group flex items-center justify-start gap-3 py-3.5 w-full sm:w-auto sm:max-w-[48%] sm:ml-auto">
              <div class="w-8 h-8 rounded-full bg-main border border-subtle flex items-center justify-center shrink-0 group-hover:bg-brand/10 group-hover:text-brand transition-colors">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
              </div>
              <div class="flex flex-col text-left overflow-hidden">
                <span class="text-[11px] uppercase tracking-widest text-tx-muted font-bold mb-0.5">Previous</span>
                <span class="text-[14px] text-tx-main font-semibold group-hover:text-brand transition-colors truncate">{prevLink.title}</span>
              </div>
            </a>
          ) : <div class="hidden sm:block"></div>}

          {nextLink ? (
            <a href={nextLink.url} class="group flex items-center gap-3 py-3.5 w-fit max-w-[100%] sm:max-w-[48%] ml-auto">
              <div class="flex flex-col text-right overflow-hidden">
                <span class="text-[11px] uppercase tracking-widest text-tx-muted font-bold mb-0.5">Up Next</span>
                <span class="text-[14px] text-tx-main font-semibold group-hover:text-brand transition-colors truncate">{nextLink.title}</span>
              </div>
              <div class="w-8 h-8 rounded-full bg-main border border-subtle flex items-center justify-center shrink-0 group-hover:bg-brand/10 group-hover:text-brand transition-colors">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
              </div>
            </a>
          ) : <div class="hidden sm:block"></div>}
        </div>
      </div>
      
    </main>

    {/* 3. Right Sidebar (Ads for Desktop) */}
    <aside class="hidden min-[1264px]:flex flex-col w-[300px] shrink-0 sticky top-[64px] h-[calc(100vh-64px)] py-10 pl-6 pr-4 z-30">
      {adHtml && (
        <div class="ad-container w-full flex-1 overflow-y-auto custom-scrollbar min-h-0" set:html={adHtml} />
      )}
    </aside>

  </div>
</Layout>

<style is:global>
  details > summary { list-style: none; }
  details > summary::-webkit-details-marker { display: none; }

  .custom-scrollbar::-webkit-scrollbar { width: 4px; }
  .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
  .custom-scrollbar::-webkit-scrollbar-thumb { background-color: var(--color-border-subtle); border-radius: 20px; }
  .custom-scrollbar:hover::-webkit-scrollbar-thumb { background-color: #94a3b8; }
  
  .markdown-content h1, .markdown-content h2, .markdown-content h3, .markdown-content h4 { color: var(--color-tx-main); font-weight: 800; letter-spacing: -0.015em; margin-top: 1.6em; margin-bottom: 0.6em; }
  
  /* Reduced bottom margin on h1 so the minimalist button sits closer to it */
  .markdown-content h1 { font-size: 1.75rem; line-height: 1.25; margin-top: 0; margin-bottom: 0.3em; }
  .markdown-content h2 { font-size: 1.4rem; line-height: 1.3; padding-bottom: 0.25em; }
  .markdown-content h3 { font-size: 1.25rem; line-height: 1.3; }
  
  @media (min-width: 768px) {
    .markdown-content h1 { font-size: 2.25rem; }
    .markdown-content h2 { font-size: 1.75rem; }
    .markdown-content h3 { font-size: 1.4rem; }
  }
  
  .markdown-content p { color: var(--color-tx-main); margin-bottom: 1.4em; opacity: 0.9; }
  .markdown-content strong { color: var(--color-tx-main); font-weight: 700; }
  .markdown-content a { color: var(--color-brand); text-decoration: none; font-weight: 500; border-bottom: 1px solid transparent; transition: border-color 0.2s;}
  .markdown-content a:hover { border-bottom-color: var(--color-brand); }
  
  .markdown-content ul { list-style-type: disc; padding-left: 1.2em; margin-bottom: 1.4em; color: var(--color-tx-main); opacity: 0.9; }
  .markdown-content ol { list-style-type: decimal; padding-left: 1.2em; margin-bottom: 1.4em; color: var(--color-tx-main); opacity: 0.9; }
  .markdown-content li { margin-bottom: 0.4em; }

  .dark .markdown-content h1, .dark .markdown-content h2, .dark .markdown-content h3, .dark .markdown-content h4, .dark .markdown-content h5, .dark .markdown-content h6, .dark .markdown-content p, .dark .markdown-content ul, .dark .markdown-content ol { color: var(--color-tx-muted); }

  .markdown-content blockquote { border-left: 3px solid var(--color-brand); padding-left: 1em; color: var(--color-tx-main); font-style: italic; background-color: var(--color-bg-surface); padding-top: 0.75em; padding-bottom: 0.75em; border-radius: 0 0.5rem 0.5rem 0; margin-bottom: 1.4em; }

  .markdown-content pre { background-color: var(--color-bg-surface); border: 1px solid var(--color-border-subtle); border-radius: 0.75rem; padding: 1.25rem; overflow-x: auto; margin-bottom: 1.75em; box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05); position: relative; font-family: 'JetBrains Mono', monospace; font-size: 0.85em; line-height: 1.6; color: var(--color-tx-main); opacity: 0.9; }
  .markdown-content code { font-family: 'JetBrains Mono', monospace; font-size: 0.85em; color: var(--color-tx-main); background-color: rgba(128, 128, 128, 0.12); border: 1px solid rgba(128, 128, 128, 0.2); padding: 0.15em 0.3em; border-radius: 0.25rem; }
  .markdown-content pre code { background-color: transparent !important; color: inherit !important; font-size: inherit !important; padding: 0 !important; border: none !important; }

  .copy-code-btn { position: absolute; top: 8px; right: 8px; background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); color: #e2e8f0; border-radius: 4px; padding: 3px 8px; font-size: 10px; font-family: 'JetBrains Mono', monospace; cursor: pointer; opacity: 0; transition: all 0.2s ease; }
  .markdown-content pre:hover .copy-code-btn { opacity: 1; }
  .copy-code-btn:hover { background: rgba(255,255,255,0.2); }
  .copy-code-btn.copied { color: var(--color-brand); border-color: var(--color-brand); background: var(--color-brand-alpha); }
  .markdown-content img { border-radius: 0.5rem; border: 1px solid var(--color-border-subtle); margin: 1.5em 0; width: 100%; height: auto; }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    
    // --- 1. Move Minimalist TOC Button Below H1 ---
    const tocBtn = document.getElementById('toc-trigger-btn');
    const mdTitle = document.querySelector('.markdown-content h1');
    
    if (tocBtn) {
      if (mdTitle) {
        mdTitle.insertAdjacentElement('afterend', tocBtn);
      }
      tocBtn.style.display = 'flex';
    }

    // --- 2. Drawer Logic (Sliding UP from Bottom) ---
    const closeBtn = document.getElementById('modal-close-btn');
    const modal = document.getElementById('series-nav-modal');
    const navContainer = document.getElementById('sidebar-nav-container');
    const backdrop = document.getElementById('nav-backdrop');
    const activeItem = document.querySelector('.active-item');

    if (activeItem && navContainer) {
      const navRect = navContainer.getBoundingClientRect();
      const itemRect = activeItem.getBoundingClientRect();
      const scrollAmount = itemRect.top - navRect.top - (navRect.height / 2) + (itemRect.height / 2);
      navContainer.scrollTop += scrollAmount;
    }

    function openModal() {
      if (!modal || !backdrop) return;
      document.body.style.overflow = 'hidden'; 
      backdrop.classList.remove('opacity-0', 'pointer-events-none');
      
      // Animate up from bottom
      modal.classList.remove('translate-y-full');
      modal.classList.add('translate-y-0');
    }

    function closeModal() {
      if (!modal || !backdrop) return;
      document.body.style.overflow = ''; 
      backdrop.classList.add('opacity-0', 'pointer-events-none');
      
      // Animate down to bottom
      modal.classList.remove('translate-y-0');
      modal.classList.add('translate-y-full');
    }

    if (tocBtn) tocBtn.addEventListener('click', openModal);
    if (closeBtn) closeBtn.addEventListener('click', closeModal);
    if (backdrop) backdrop.addEventListener('click', closeModal);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeModal();
    });

    // --- 3. Copy Code Buttons ---
    const codeBlocks = document.querySelectorAll('.markdown-content pre');
    codeBlocks.forEach((preBlock) => {
      const textToCopy = preBlock.innerText || preBlock.textContent;
      const copyButton = document.createElement('button');
      copyButton.className = 'copy-code-btn';
      copyButton.textContent = 'Copy';
      preBlock.appendChild(copyButton);

      copyButton.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(textToCopy);
          copyButton.textContent = 'Copied!';
          copyButton.classList.add('copied');
          setTimeout(() => { copyButton.textContent = 'Copy'; copyButton.classList.remove('copied'); }, 2000);
        } catch (err) { copyButton.textContent = 'Error'; }
      });
    });
  });
</script>