---
import Layout from './Layout.astro';
import { getEntry } from 'astro:content';

const { parent, items, currentSlug, basePath } = Astro.props;

// 1. Determine active data for SEO and titles
const currentActiveData = currentSlug === 'overview' 
  ? parent.data 
  : items.find((i: any) => i.data.urlSlug === currentSlug)?.data || parent.data;

// 2. Clean Title Helper
const cleanTitle = (title: string) => {
  let cleaned = title.includes('-') ? title.split(' - ')[1].trim() : title;
  return cleaned.replace(/^[\d.]+\s*/, '').trim(); 
};

// 3. Calculate Breadcrumb Titles (Use custom field if available, fallback to cleaned title)
const parentBreadcrumb = (parent.data.breadcrumbTitle || parent.data.title).toLowerCase();
const currentBreadcrumb = (currentActiveData.breadcrumbTitle || cleanTitle(currentActiveData.title)).toLowerCase();

// 4. Calculate Prev / Next Navigation dynamically
let prevLink = null;
let nextLink = null;

if (currentSlug === 'overview') {
  if (items.length > 0) {
    nextLink = {
      title: cleanTitle(items[0].data.title),
      url: `/${basePath}/${parent.id}/${items[0].data.urlSlug}`
    };
  }
} else {
  const currentIndex = items.findIndex((i: any) => i.data.urlSlug === currentSlug);
  if (currentIndex !== -1) {
    if (currentIndex === 0) {
      prevLink = { title: cleanTitle(parent.data.title), url: `/${basePath}/${parent.id}` };
    } else {
      prevLink = {
        title: cleanTitle(items[currentIndex - 1].data.title),
        url: `/${basePath}/${parent.id}/${items[currentIndex - 1].data.urlSlug}`
      };
    }
    if (currentIndex < items.length - 1) {
      nextLink = {
        title: cleanTitle(items[currentIndex + 1].data.title),
        url: `/${basePath}/${parent.id}/${items[currentIndex + 1].data.urlSlug}`
      };
    }
  }
}

// 5. Resolve Sidebar Ads safely
const adsData = await getEntry('sidebarAds', 'data');
let adHtml = null;
if (adsData?.data) {
  const specificAd = adsData.data.tutorialAdsGroup?.specificOverrides?.find((ad: any) => ad.target === parent.id);
  if (specificAd && specificAd.adContent) {
    adHtml = specificAd.adContent;
  } else if (basePath === 'tutorials' && adsData.data.tutorialAdsGroup?.allTutorialsAd) {
    adHtml = adsData.data.tutorialAdsGroup.allTutorialsAd;
  } else if (adsData.data.globalAd) {
    adHtml = adsData.data.globalAd;
  }
}
---

<Layout seo={currentActiveData.seo} titleFallback={currentActiveData.title} excerptFallback={currentActiveData.excerpt}>
  <div class="flex flex-col lg:flex-row w-full max-w-[1440px] mx-auto justify-center items-start relative font-['Outfit',sans-serif]">
    
    {/* --- MOBILE: Top Breadcrumbs & Minimalist App Bar --- */}
    <div class="lg:hidden w-full flex flex-col px-4 sm:px-6 pt-4">
      <nav aria-label="Breadcrumb" class="pt-4 pb-4 font-['JetBrains_Mono',monospace] text-[11px] text-tx-muted flex items-center gap-1.5 flex-wrap md:max-w-[720px] md:mx-auto md:w-full">
        <a href="/" class="hover:text-brand transition-colors">home</a>
        <span class="opacity-40">/</span>
        <a href={`/${basePath}`} class="hover:text-brand transition-colors">{basePath}</a>
        <span class="opacity-40">/</span>
        
        {currentSlug === 'overview' ? (
          <span class="text-brand font-medium truncate max-w-[120px]" aria-current="page">{parentBreadcrumb}</span>
        ) : (
          <>
            <a href={`/${basePath}/${parent.id}`} class="hover:text-brand transition-colors truncate max-w-[100px]">{parentBreadcrumb}</a>
            <span class="opacity-40">/</span>
            <span class="text-brand font-medium truncate max-w-[120px]" aria-current="page">{currentBreadcrumb}</span>
          </>
        )}
      </nav>

      <div class="sticky top-0 bg-main/95 backdrop-blur-md py-2 flex items-center justify-between -mx-4 px-4 sm:-mx-6 sm:px-6 z-40">
        <button id="sidebar-toggle-btn" class="p-2.5 rounded-lg bg-surface border border-subtle text-tx-main hover:border-brand/50 transition-all active:scale-95 shadow-sm" aria-label="Toggle Menu">
          <svg class="w-5 h-5 text-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" /></svg>
        </button>

        <div class="flex items-center gap-2">
          {prevLink && (
            <a href={prevLink.url} class="p-2.5 rounded-lg bg-surface border border-subtle text-tx-muted hover:text-brand transition-colors active:scale-95 shadow-sm" aria-label="Previous">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
            </a>
          )}
          {nextLink && (
            <a href={nextLink.url} class="p-2.5 rounded-lg bg-brand border border-brand text-white hover:brightness-90 transition-all active:scale-95 shadow-sm" aria-label="Next">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
            </a>
          )}
        </div>
      </div>
    </div>

    <div id="mobile-sidebar-backdrop" class="fixed top-[64px] inset-x-0 bottom-0 [.header-hidden_&]:top-0 bg-black/60 backdrop-blur-sm z-[90] hidden lg:hidden opacity-0 transition-opacity duration-300"></div>
    
    {/* Left Sidebar */}
    <aside id="series-sidebar" class="fixed top-[64px] h-[calc(100dvh-64px)] left-0 z-[300] lg:z-[150] w-[85vw] max-w-[260px] bg-main shadow-2xl transform -translate-x-full transition-all duration-300 ease-in-out lg:translate-x-0 lg:static lg:sticky lg:w-[260px] lg:shrink-0 [.header-hidden_&]:top-0 [.header-hidden_&]:h-[100dvh] border-r border-subtle py-5 px-4 lg:pt-16 lg:pb-6 lg:px-4 lg:bg-transparent lg:shadow-none flex flex-col">       
      <div class="mb-5 px-1.5 flex justify-between items-center shrink-0">
        <div>
          <h3 class="text-[11px] uppercase tracking-widest font-['JetBrains_Mono',monospace] text-tx-muted mb-1 font-bold">
            {basePath === 'tutorials' ? 'Tutorial Series' : 'Quiz Series'}
          </h3>
          <p class="text-[18px] font-black text-tx-main leading-tight">{parent.data.title}</p>
        </div>
        <button id="sidebar-close-btn" class="lg:hidden p-2 text-tx-muted hover:text-tx-main bg-main rounded-lg border border-subtle active:scale-95 transition-all">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
        </button>
      </div>

      <nav class="flex-1 overflow-y-auto min-h-0 custom-scrollbar flex flex-col space-y-0.5 pr-1.5">
        <a href={`/${basePath}/${parent.id}`} class={`px-2.5 py-1.5 text-[14px] rounded-lg transition-all flex items-center gap-2 border ${currentSlug === 'overview' ? 'text-brand border-brand/20 font-bold active-item' : 'border-transparent text-tx-muted hover:bg-[rgba(128,128,128,0.08)] hover:text-tx-main'}`}>
          {cleanTitle(parent.data.title)}
        </a>

        {items.map((item: any) => (
          <a href={`/${basePath}/${parent.id}/${item.data.urlSlug}`} class={`px-2.5 py-1.5 text-[14px] rounded-lg transition-all flex items-center gap-2 border ${currentSlug === item.data.urlSlug ? 'text-brand border-brand/20 font-bold active-item' : 'border-transparent text-tx-muted hover:bg-[rgba(128,128,128,0.08)] hover:text-tx-main'}`}>
            {cleanTitle(item.data.title)}
          </a>
        ))}
      </nav>
      {adHtml && (
        <div class="lg:hidden shrink-0 mt-4 pt-4 border-t border-subtle">
          <div class="ad-container w-full" set:html={adHtml} />
        </div>
      )}
    </aside>

    {/* Main Content */}
    <main class="flex-1 min-w-0 w-full max-w-[800px] px-4 sm:px-6 lg:px-6 xl:px-12 py-6 lg:py-8">       
      <nav aria-label="Breadcrumb" class="hidden lg:flex mb-8 font-['JetBrains_Mono',monospace] text-[12px] text-tx-muted items-center gap-2 flex-wrap bg-surface border border-subtle px-3 py-1.5 rounded-md w-fit">
        <a href="/" class="hover:text-brand transition-colors">home</a>
        <span class="opacity-40">/</span>
        <a href={`/${basePath}`} class="hover:text-brand transition-colors">{basePath}</a>
        <span class="opacity-40">/</span>
        
        {currentSlug === 'overview' ? (
          <span class="text-brand font-medium" aria-current="page">{parentBreadcrumb}</span>
        ) : (
          <>
            <a href={`/${basePath}/${parent.id}`} class="hover:text-brand transition-colors truncate max-w-[150px]">{parentBreadcrumb}</a>
            <span class="opacity-40">/</span>
            <span class="text-brand font-medium" aria-current="page">{currentBreadcrumb}</span>
          </>
        )}
      </nav>

      <div class="markdown-content text-[15.5px] md:text-[17px] leading-[1.7] md:leading-[1.8] pb-8">
        <slot />
      </div>

      {/* Pagination Footer */}
      <div class="mt-8 pt-6 border-t border-subtle flex flex-col sm:flex-row items-center justify-between gap-3">
        {prevLink ? (
          <a href={prevLink.url} class="group flex items-center gap-3 px-5 py-3.5 rounded-xl bg-surface border border-subtle hover:border-brand/50 hover:shadow-sm transition-all w-full sm:w-auto sm:max-w-[48%]">
            <div class="w-8 h-8 rounded-full bg-main border border-subtle flex items-center justify-center shrink-0 group-hover:bg-brand/10 group-hover:text-brand transition-colors">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
            </div>
            <div class="flex flex-col text-left overflow-hidden">
              <span class="text-[11px] uppercase tracking-widest text-tx-muted font-bold mb-0.5">Previous</span>
              <span class="text-[14px] text-tx-main font-semibold group-hover:text-brand transition-colors truncate">{prevLink.title}</span>
            </div>
          </a>
        ) : <div class="hidden sm:block"></div>}

        {nextLink ? (
          <a href={nextLink.url} class="group flex items-center justify-end gap-3 px-5 py-3.5 rounded-xl bg-surface border border-subtle hover:border-brand/50 hover:shadow-sm transition-all w-full sm:w-auto sm:max-w-[48%] sm:ml-auto">
            <div class="flex flex-col text-right overflow-hidden">
              <span class="text-[11px] uppercase tracking-widest text-tx-muted font-bold mb-0.5">Up Next</span>
              <span class="text-[14px] text-tx-main font-semibold group-hover:text-brand transition-colors truncate">{nextLink.title}</span>
            </div>
            <div class="w-8 h-8 rounded-full bg-main border border-subtle flex items-center justify-center shrink-0 group-hover:bg-brand/10 group-hover:text-brand transition-colors">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
            </div>
          </a>
        ) : <div class="hidden sm:block"></div>}
      </div>
    </main>

    {/* Right Sidebar */}
    <aside class="hidden lg:flex flex-col w-[260px] shrink-0 sticky top-[64px] h-[calc(100vh-64px)] py-10 lg:py-16 pl-4 pr-4 z-30">
      {adHtml && (
        <div class="ad-container w-full flex-1 overflow-y-auto custom-scrollbar min-h-0" set:html={adHtml} />
      )}
    </aside>

  </div>
</Layout>

<style is:global>
  .custom-scrollbar::-webkit-scrollbar { width: 4px; }
  .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
  .custom-scrollbar::-webkit-scrollbar-thumb { background-color: var(--color-border-subtle); border-radius: 20px; }
  .custom-scrollbar:hover::-webkit-scrollbar-thumb { background-color: #94a3b8; }
  
  .markdown-content h1, .markdown-content h2, .markdown-content h3, .markdown-content h4 { color: var(--color-tx-main); font-weight: 800; letter-spacing: -0.015em; margin-top: 1.6em; margin-bottom: 0.6em; }
  .markdown-content h1 { font-size: 1.75rem; line-height: 1.25; margin-top: 0; margin-bottom: 0.8em; }
  .markdown-content h2 { font-size: 1.4rem; line-height: 1.3; border-bottom: 1px solid var(--color-border-subtle); padding-bottom: 0.25em; }
  .markdown-content h3 { font-size: 1.25rem; line-height: 1.3; }
  
  @media (min-width: 768px) {
    .markdown-content h1 { font-size: 2.25rem; }
    .markdown-content h2 { font-size: 1.75rem; }
    .markdown-content h3 { font-size: 1.4rem; }
  }
  
  .markdown-content p { color: var(--color-tx-main); margin-bottom: 1.4em; opacity: 0.9; }
  .markdown-content strong { color: var(--color-tx-main); font-weight: 700; }
  .markdown-content a { color: var(--color-brand); text-decoration: none; font-weight: 500; border-bottom: 1px solid transparent; transition: border-color 0.2s;}
  .markdown-content a:hover { border-bottom-color: var(--color-brand); }
  
  .markdown-content ul { list-style-type: disc; padding-left: 1.2em; margin-bottom: 1.4em; color: var(--color-tx-main); opacity: 0.9; }
  .markdown-content ol { list-style-type: decimal; padding-left: 1.2em; margin-bottom: 1.4em; color: var(--color-tx-main); opacity: 0.9; }
  .markdown-content li { margin-bottom: 0.4em; }

  .dark .markdown-content h1, .dark .markdown-content h2, .dark .markdown-content h3, .dark .markdown-content h4, .dark .markdown-content h5, .dark .markdown-content h6, .dark .markdown-content p, .dark .markdown-content ul, .dark .markdown-content ol { color: var(--color-tx-muted); }

  .markdown-content blockquote { border-left: 3px solid var(--color-brand); padding-left: 1em; color: var(--color-tx-main); font-style: italic; background-color: var(--color-bg-surface); padding-top: 0.75em; padding-bottom: 0.75em; border-radius: 0 0.5rem 0.5rem 0; margin-bottom: 1.4em; }

  .markdown-content pre { background-color: var(--color-bg-surface); border: 1px solid var(--color-border-subtle); border-radius: 0.75rem; padding: 1.25rem; overflow-x: auto; margin-bottom: 1.75em; box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05); position: relative; font-family: 'JetBrains Mono', monospace; font-size: 0.85em; line-height: 1.6; color: var(--color-tx-main); opacity: 0.9; }
  .markdown-content code { font-family: 'JetBrains Mono', monospace; font-size: 0.85em; color: var(--color-tx-main); background-color: rgba(128, 128, 128, 0.12); border: 1px solid rgba(128, 128, 128, 0.2); padding: 0.15em 0.3em; border-radius: 0.25rem; }
  .markdown-content pre code { background-color: transparent !important; color: inherit !important; font-size: inherit !important; padding: 0 !important; border: none !important; }

  .copy-code-btn { position: absolute; top: 8px; right: 8px; background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); color: #e2e8f0; border-radius: 4px; padding: 3px 8px; font-size: 10px; font-family: 'JetBrains Mono', monospace; cursor: pointer; opacity: 0; transition: all 0.2s ease; }
  .markdown-content pre:hover .copy-code-btn { opacity: 1; }
  .copy-code-btn:hover { background: rgba(255,255,255,0.2); }
  .copy-code-btn.copied { color: var(--color-brand); border-color: var(--color-brand); background: var(--color-brand-alpha); }
  .markdown-content img { border-radius: 0.5rem; border: 1px solid var(--color-border-subtle); margin: 1.5em 0; width: 100%; height: auto; }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const toggleBtn = document.getElementById('sidebar-toggle-btn');
    const closeBtn = document.getElementById('sidebar-close-btn');
    const sidebar = document.getElementById('series-sidebar');
    const backdrop = document.getElementById('mobile-sidebar-backdrop');
    const activeItem = document.querySelector('.active-item');

    function openSidebar() {
      if (!sidebar || !backdrop) return;
      backdrop.classList.remove('hidden');
      void backdrop.offsetWidth; 
      backdrop.classList.remove('opacity-0');
      sidebar.classList.remove('-translate-x-full');

      if (activeItem) {
        setTimeout(() => activeItem.scrollIntoView({ behavior: 'smooth', block: 'center' }), 150); 
      }
    }

    function closeSidebar() {
      if (!sidebar || !backdrop) return;
      backdrop.classList.add('opacity-0');
      sidebar.classList.add('-translate-x-full');
      setTimeout(() => backdrop.classList.add('hidden'), 300);
    }

    if (toggleBtn) toggleBtn.addEventListener('click', openSidebar);
    if (closeBtn) closeBtn.addEventListener('click', closeSidebar);
    if (backdrop) backdrop.addEventListener('click', closeSidebar);

    const codeBlocks = document.querySelectorAll('.markdown-content pre');
    codeBlocks.forEach((preBlock) => {
      const textToCopy = preBlock.innerText || preBlock.textContent;
      const copyButton = document.createElement('button');
      copyButton.className = 'copy-code-btn';
      copyButton.textContent = 'Copy';
      preBlock.appendChild(copyButton);

      copyButton.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(textToCopy);
          copyButton.textContent = 'Copied!';
          copyButton.classList.add('copied');
          setTimeout(() => { copyButton.textContent = 'Copy'; copyButton.classList.remove('copied'); }, 2000);
        } catch (err) { copyButton.textContent = 'Error'; }
      });
    });
  });
</script>