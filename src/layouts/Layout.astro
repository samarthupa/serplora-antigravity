---
// src/layouts/Layout.astro

// Only importing the 3 weights you actually need for the UI
import '@fontsource/outfit/400.css';
import '@fontsource/outfit/600.css';
import '@fontsource/outfit/700.css';

// Only importing standard code weight
import '@fontsource/jetbrains-mono/400.css';

import { getEntry } from 'astro:content';
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import 'photoswipe/style.css';

// 🟢 Import GTM, Cookie Banner, and new Schema Injector
import GoogleTagManager from '../components/layout/GoogleTagManager.astro';
import CookieBanner from '../components/ui/CookieBanner.astro';
import SchemaInjector from '../schemas/SchemaInjector.astro';

// 🟢 Accept dynamic SEO props from individual pages
interface Props {
  seo?: {
    metaTitle?: string;
    metaDescription?: string;
    canonicalUrl?: string;
    robotsIndex?: boolean;
    robotsFollow?: boolean;
    schemaType?: string; // <-- Accepts the schema type from CMS
    disableStickyHeader?: boolean;
  };
  titleFallback?: string;
  excerptFallback?: string;
  schemaData?: any; // <-- Accepts the raw page data for the schema compiler
  hasNewsletterModal?: boolean; // 🟢 NEW: Controls the Newsletter Modal
}

const { seo, titleFallback, excerptFallback, schemaData, hasNewsletterModal = false } = Astro.props;

// Fetch the header data from Keystatic to get the Favicon and Site Title
const headerEntry = await getEntry('header', 'data');
const favicon = headerEntry?.data?.favicon || '/favicon.svg'; // Fallback just in case
const siteTitle = headerEntry?.data?.siteTitle || 'Serplora';

// 🟢 SMART FALLBACKS
// 1. Title falls back to the page's H1 (titleFallback), then to Site Title
const finalTitle = seo?.metaTitle || titleFallback || siteTitle;

// 2. Strip HTML tags from excerpt for the description fallback
const rawExcerpt = excerptFallback?.replace(/<[^>]*>?/gm, ''); 
// 3. Set description to null if no metaDescription and no excerpt exist
const finalDescription = seo?.metaDescription || null;

// Handle Canonical URL (defaults to the current request URL if blank)
// Strip out .html from the pathname to ensure clean canonicals even when built with format: 'file'
let rawPathname = Astro.url.pathname.replace(/\.html$/, '');

// Strip trailing '/index' for all directory index pages globally (including homepage)
rawPathname = rawPathname.replace(/\/index$/, '');

// Ensure the root homepage resolves correctly to '/' rather than an empty string
if (rawPathname === '') {
  rawPathname = '/';
}

const canonicalURL = seo?.canonicalUrl || new URL(rawPathname, Astro.site || Astro.url.origin).toString();

// Handle Robots format
const robotsParams = [
  seo?.robotsIndex === false ? 'noindex' : 'index',
  seo?.robotsFollow === false ? 'nofollow' : 'follow'
].join(', ');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    {/* 🟢 SEO META TAGS */}
    <title>{finalTitle}</title>
    
    {/* Only render description tag if we actually have a description */}
    {finalDescription && <meta name="description" content={finalDescription} />}
    
    <link rel="canonical" href={canonicalURL} />
    <meta name="robots" content={robotsParams} />
    
    {/* 🟢 Open Graph (Social Sharing) */}
    <meta property="og:title" content={finalTitle} />
    {finalDescription && <meta property="og:description" content={finalDescription} />}
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    
    <link rel="icon" href={favicon} />

    {/* 🟢 DYNAMIC SCHEMA INJECTION */}
    <SchemaInjector 
       schemaType={seo?.schemaType} 
       schemaData={{ title: finalTitle, description: finalDescription, ...schemaData }} 
    />

    {/* 🟢 GTM INJECTION - Removed isEurope prop */}
    <GoogleTagManager gtmId="GTM-MVZN25KT" />

    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();

      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
      window.localStorage.setItem('theme', theme);
    </script>

    {/* 🟢 GOOGLE ADSENSE */}
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-8449940185848128" crossorigin="anonymous"></script>
  </head>
  <body class="bg-main text-tx-main font-sans antialiased min-h-screen flex flex-col transition-colors duration-300">
    {/* 🟢 GTM NOSCRIPT FALLBACK (Required by Google) */}
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-MVZN25KT"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>

    <Header disableStickyHeader={seo?.disableStickyHeader} />
    {/* 5px gap on mobile, perfectly aligned 32px gap on desktop */}
    <main class="flex-1 w-full md:px-4 flex flex-col">
      <slot />
    </main>
    <Footer />
    
    {/* 🟢 EU COOKIE BANNER COMPONENT - Rendered unconditionally in HTML */}
    {/* The JavaScript inside this component will fetch the location and hide/show it */}
    <CookieBanner />
    
    {/* 🟢 Client-Side Scripts (Bundled by Astro) */}
    <script>
      import PhotoSwipeLightbox from 'photoswipe/lightbox';
      import { syncUserHistory } from '../lib/api';
      import { getLocalUser } from '../lib/auth';

      // --- PHOTOSWIPE INITIALIZATION ---
      document.addEventListener('DOMContentLoaded', () => {
        const lightbox = new PhotoSwipeLightbox({
          gallery: 'main', 
          children: 'img', 
          pswpModule: () => import('photoswipe'),
          bgOpacity: 0.9,
        });

        lightbox.addFilter('itemData', (itemData, index) => {
          const img = itemData.element;
          if (img) {
              itemData.src = img.src;
              itemData.w = img.naturalWidth || img.width;
              itemData.h = img.naturalHeight || img.height;
              itemData.msrc = img.src; 
          }
          return itemData;
        });

        lightbox.init();
      });

      // --- HISTORY SYNCHRONIZATION ---
      // Only attempt to sync history if the user is actually logged in
      const user = getLocalUser();
      
      if (user) {
        // Get the current page title (cleaning up any appended site name like " | Serplora")
        const pageTitle = document.title.split(' | ')[0]; 
        const pageUrl = window.location.pathname;

        // Don't track system pages in the history
        if (pageUrl !== '/account' && pageUrl !== '/login' && pageUrl !== '/') {
          syncUserHistory(pageUrl, pageTitle);
        }
      }
    </script>

    {/* 🟢 NEW: Global External Link Interceptor */}
    <script>
      function setExternalLinks() {
        const currentHost = window.location.host;
        const links = document.querySelectorAll('a');

        links.forEach(link => {
          if (link.host && link.host !== currentHost) {
            link.setAttribute('target', '_blank');
            link.setAttribute('rel', 'noopener noreferrer');
          }
        });
      }

      document.addEventListener('DOMContentLoaded', setExternalLinks);
      // Optional: If you use View Transitions later
      document.addEventListener('astro:page-load', setExternalLinks);
    </script>

    {/* 🟢 CONDITIONAL NEWSLETTER MODAL */}
    {hasNewsletterModal && (
        <div class="modal-overlay" id="globalNewsletterModal">
            <div class="modal-content">
                <button class="modal-close" id="closeNewsletterModal" aria-label="Close modal">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                </button>
                <h3 class="modal-title" style="font-size: 20px; font-weight: 600; margin-bottom: 8px;">Stay Updated</h3>
                <p style="font-size: 14px; color: #444444; margin-bottom: 24px;">Get one new technical guide delivered to your inbox every week.</p>
                <form class="newsletter-form" onsubmit="event.preventDefault(); alert('Subscribed!'); document.getElementById('globalNewsletterModal').classList.remove('active'); document.body.style.overflow = '';">
                    <input type="email" class="newsletter-input" placeholder="Your email address" required />
                    <button type="submit" class="btn-submit">Subscribe</button>
                </form>
            </div>
        </div>

        <script is:inline>
            const modal = document.getElementById('globalNewsletterModal');
            const closeBtn = document.getElementById('closeNewsletterModal');

            // Listen for the custom event fired by UtilityActions.astro
            window.addEventListener('open-newsletter-modal', () => {
                if(modal) {
                    modal.classList.add('active');
                    document.body.style.overflow = 'hidden'; // Stop background scrolling
                    setTimeout(() => document.querySelector('.newsletter-input').focus(), 300);
                }
            });

            // Close logic
            function closeModal() {
                if(modal) {
                    modal.classList.remove('active');
                    document.body.style.overflow = '';
                }
            }

            if(closeBtn) closeBtn.addEventListener('click', closeModal);
            if(modal) modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });
            document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && modal.classList.contains('active')) closeModal(); });
        </script>
    )}

  </body>
</html>

<style is:global>
    /* 🟢 NEWSLETTER MODAL STYLES */
    .modal-overlay {
        position: fixed; top: 0; left: 0; width: 100%; height: 100%;
        background: rgba(0,0,0,0.4); backdrop-filter: blur(4px);
        display: flex; align-items: center; justify-content: center;
        opacity: 0; pointer-events: none; transition: opacity 0.3s ease; z-index: 9999;
    }
    .modal-overlay.active { opacity: 1; pointer-events: auto; }
    
    .modal-content {
        background: #FFFFFF; width: 100%; max-width: 400px;
        border-radius: 16px; padding: 32px; position: relative;
        transform: translateY(20px); transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        box-shadow: 0 24px 48px rgba(0,0,0,0.1); color: #111111;
    }
    .modal-overlay.active .modal-content { transform: translateY(0); }
    
    .modal-close {
        position: absolute; top: 16px; right: 16px; width: 32px; height: 32px; 
        display: flex; align-items: center; justify-content: center;
        color: #888888; border-radius: 50%; transition: background 0.2s;
        border: none; background: transparent; cursor: pointer;
    }
    .modal-close:hover { background: #FAFAFA; color: #111111; }

    .newsletter-form { display: flex; flex-direction: column; gap: 12px; }
    .newsletter-input { padding: 12px 16px; border: 1px solid #EAEAEA; border-radius: 8px; font-size: 15px; font-family: inherit; outline: none; }
    .newsletter-input:focus { border-color: #111111; }
    .btn-submit { padding: 12px; background: #111111; color: white; border-radius: 8px; font-weight: 500; font-size: 15px; border: none; cursor: pointer; transition: background 0.2s;}
    .btn-submit:hover { background: #333333; }
</style>