---
// src/layouts/Layout.astro

// Only importing the 3 weights you actually need for the UI
import '@fontsource/outfit/400.css';
import '@fontsource/outfit/600.css';
import '@fontsource/outfit/700.css';

// Only importing standard code weight
import '@fontsource/jetbrains-mono/400.css';

import { getEntry } from 'astro:content';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import 'photoswipe/style.css';

// 🟢 NEW: Accept dynamic SEO props from individual pages
interface Props {
  seo?: {
    metaTitle?: string;
    metaDescription?: string;
    canonicalUrl?: string;
    robotsIndex?: boolean;
    robotsFollow?: boolean;
  };
  titleFallback?: string;
  excerptFallback?: string;
}

const { seo, titleFallback, excerptFallback } = Astro.props;

// Fetch the header data from Keystatic to get the Favicon and Site Title
const headerEntry = await getEntry('header', 'data');
const favicon = headerEntry?.data?.favicon || '/favicon.svg'; // Fallback just in case
const siteTitle = headerEntry?.data?.siteTitle || 'Serplora';

// 🟢 SMART FALLBACKS
// 1. Title falls back to the page's H1 (titleFallback), then to Site Title
const finalTitle = seo?.metaTitle || titleFallback || siteTitle;

// 2. Strip HTML tags from excerpt for the description fallback
const rawExcerpt = excerptFallback?.replace(/<[^>]*>?/gm, ''); 
// 3. Set description to null if no metaDescription and no excerpt exist
const finalDescription = seo?.metaDescription || null;

// Handle Canonical URL (defaults to the current request URL if blank)
const canonicalURL = seo?.canonicalUrl || new URL(Astro.url.pathname, Astro.site || Astro.url.origin).toString();

// Handle Robots format
const robotsParams = [
  seo?.robotsIndex === false ? 'noindex' : 'index',
  seo?.robotsFollow === false ? 'nofollow' : 'follow'
].join(', ');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    {/* 🟢 SEO META TAGS */}
    <title>{finalTitle}</title>
    
    {/* Only render description tag if we actually have a description */}
    {finalDescription && <meta name="description" content={finalDescription} />}
    
    <link rel="canonical" href={canonicalURL} />
    <meta name="robots" content={robotsParams} />
    
    {/* 🟢 Open Graph (Social Sharing) */}
    <meta property="og:title" content={finalTitle} />
    {finalDescription && <meta property="og:description" content={finalDescription} />}
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    
    <link rel="icon" href={favicon} />

    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();

      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
      window.localStorage.setItem('theme', theme);
    </script>
  </head>
  <body class="bg-main text-tx-main font-sans antialiased min-h-screen flex flex-col transition-colors duration-300">
    <Header />
    <main class="flex-1 w-full flex flex-col">
      <slot />
    </main>
    <Footer />
   <script>
  import PhotoSwipeLightbox from 'photoswipe/lightbox';

  // Wait for the page to load
  document.addEventListener('DOMContentLoaded', () => {
    
    // Initialize PhotoSwipe
    const lightbox = new PhotoSwipeLightbox({
      gallery: 'main', 
      children: 'img', 
      pswpModule: () => import('photoswipe'),
      bgOpacity: 0.9,
    });

    lightbox.addFilter('itemData', (itemData, index) => {
      const img = itemData.element;
      if (img) {
          itemData.src = img.src;
          itemData.w = img.naturalWidth || img.width;
          itemData.h = img.naturalHeight || img.height;
          itemData.msrc = img.src; 
      }
      return itemData;
    });

    lightbox.init();
  });
</script>

  </body>
</html>