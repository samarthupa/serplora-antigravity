---
// src/layouts/Layout.astro

import '@fontsource/outfit/400.css';
import '@fontsource/outfit/600.css';
import '@fontsource/outfit/700.css';
import '@fontsource/jetbrains-mono/400.css';

import { getEntry } from 'astro:content';
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import 'photoswipe/style.css';

import GoogleTagManager from '../components/layout/GoogleTagManager.astro';
import CookieBanner from '../components/ui/CookieBanner.astro';
import SchemaInjector from '../schemas/SchemaInjector.astro';

interface Props {
  seo?: {
    metaTitle?: string;
    metaDescription?: string;
    canonicalUrl?: string;
    robotsIndex?: boolean;
    robotsFollow?: boolean;
    schemaType?: string; 
    disableStickyHeader?: boolean;
  };
  titleFallback?: string;
  excerptFallback?: string;
  schemaData?: any; 
}

const { seo, titleFallback, excerptFallback, schemaData } = Astro.props;

const headerEntry = await getEntry('header', 'data');
const favicon = headerEntry?.data?.favicon || '/favicon.svg'; 
const siteTitle = headerEntry?.data?.siteTitle || 'Serplora';

const finalTitle = seo?.metaTitle || titleFallback || siteTitle;
const rawExcerpt = excerptFallback?.replace(/<[^>]*>?/gm, ''); 
const finalDescription = seo?.metaDescription || null;

let rawPathname = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '');
if (rawPathname === '') rawPathname = '/';

const canonicalURL = seo?.canonicalUrl || new URL(rawPathname, Astro.site || Astro.url.origin).toString();

const robotsParams = [
  seo?.robotsIndex === false ? 'noindex' : 'index',
  seo?.robotsFollow === false ? 'nofollow' : 'follow'
].join(', ');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <title>{finalTitle}</title>
    {finalDescription && <meta name="description" content={finalDescription} />}
    
    <link rel="canonical" href={canonicalURL} />
    <meta name="robots" content={robotsParams} />
    
    <meta property="og:title" content={finalTitle} />
    {finalDescription && <meta property="og:description" content={finalDescription} />}
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    
    <link rel="icon" href={favicon} />

    <SchemaInjector 
       schemaType={seo?.schemaType} 
       schemaData={{ title: finalTitle, description: finalDescription, ...schemaData }} 
    />

    <GoogleTagManager gtmId="GTM-MVZN25KT" />

    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();

      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
      window.localStorage.setItem('theme', theme);
    </script>

    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-8449940185848128" crossorigin="anonymous"></script>
  </head>
  <body class="bg-main text-tx-main font-sans antialiased min-h-screen flex flex-col transition-colors duration-300">
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-MVZN25KT" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>

    <Header disableStickyHeader={seo?.disableStickyHeader} />
    
    <main class="flex-1 w-full md:px-4 flex flex-col">
      <slot />
    </main>
    
    <Footer />
    <CookieBanner />
    
    <script>
      import PhotoSwipeLightbox from 'photoswipe/lightbox';

      document.addEventListener('DOMContentLoaded', () => {
        const lightbox = new PhotoSwipeLightbox({
          gallery: 'main', 
          children: 'img', 
          pswpModule: () => import('photoswipe'),
          bgOpacity: 0.9,
        });

        lightbox.addFilter('itemData', (itemData, index) => {
          const img = itemData.element;
          if (img) {
              itemData.src = img.src;
              itemData.w = img.naturalWidth || img.width;
              itemData.h = img.naturalHeight || img.height;
              itemData.msrc = img.src; 
          }
          return itemData;
        });

        lightbox.init();
      });
    </script>

    <script>
      function setExternalLinks() {
        const currentHost = window.location.host;
        const links = document.querySelectorAll('a');

        links.forEach(link => {
          if (link.host && link.host !== currentHost) {
            link.setAttribute('target', '_blank');
            link.setAttribute('rel', 'noopener noreferrer');
          }
        });
      }

      document.addEventListener('DOMContentLoaded', setExternalLinks);
      document.addEventListener('astro:page-load', setExternalLinks);
    </script>
  </body>
</html>