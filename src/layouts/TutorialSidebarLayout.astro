---
import Layout from './Layout.astro';
import { getEntry } from 'astro:content';

const { series, lessons, currentSlug } = Astro.props;

// --- Helper: Aggressive Clean Title ---
const cleanTitle = (title: string) => {
  let cleaned = title.includes('-') ? title.split(' - ')[1].trim() : title;
  return cleaned.replace(/^[\d.]+\s*/, '').trim(); 
};

// --- Helper: Calculate Prev / Next Navigation ---
let prevLink = null;
let nextLink = null;

if (currentSlug === 'intro') {
  if (lessons.length > 0) {
    nextLink = {
      title: cleanTitle(lessons[0].data.title),
      url: `/tutorials/${series.id}/${lessons[0].data.urlSlug}`
    };
  }
} else {
  const currentIndex = lessons.findIndex((l: any) => l.data.urlSlug === currentSlug);
  if (currentIndex !== -1) {
    if (currentIndex === 0) {
      prevLink = { title: 'Introduction', url: `/tutorials/${series.id}` };
    } else {
      prevLink = {
        title: cleanTitle(lessons[currentIndex - 1].data.title),
        url: `/tutorials/${series.id}/${lessons[currentIndex - 1].data.urlSlug}`
      };
    }
    if (currentIndex < lessons.length - 1) {
      nextLink = {
        title: cleanTitle(lessons[currentIndex + 1].data.title),
        url: `/tutorials/${series.id}/${lessons[currentIndex + 1].data.urlSlug}`
      };
    }
  }
}

// --- NEW: Ad Resolution Logic ---
const adsData = await getEntry('sidebarAds', 'data');
let adHtml = null;

if (adsData?.data) {
  // 1. Check if there is an ad specifically assigned to this tutorial parent
  const specificAd = adsData.data.tutorialAds.find((ad: any) => ad.tutorial === series.id);
  
  if (specificAd && specificAd.htmlContent) {
    adHtml = specificAd.htmlContent;
  } else if (adsData.data.globalAd) {
    // 2. Fallback to global ad if no specific one exists
    adHtml = adsData.data.globalAd;
  }
}
---

<Layout>
  {/* FIXED BACKGROUND GRID: strictly limited to the top 200px */}
  <div class="absolute top-0 inset-x-0 bg-[linear-gradient(to_right,#80808012_1px,transparent_1px),linear-gradient(to_bottom,#80808012_1px,transparent_1px)] bg-[size:24px_24px] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_100%,transparent_100%)] -z-10 h-[200px] pointer-events-none"></div>

  {/* WRAPPER: 3-Column Flex Layout on Desktop */}
  <div class="max-w-[1600px] 2xl:max-w-[1700px] mx-auto w-full px-4 sm:px-6 lg:px-0 flex flex-col lg:flex-row lg:justify-start xl:justify-between items-start font-['Outfit',sans-serif] relative">
    
    {/* --- MOBILE: Top Breadcrumbs & Minimalist App Bar --- */}
    <div class="lg:hidden w-full flex flex-col">
      <nav aria-label="Breadcrumb" class="pt-6 pb-3 font-['JetBrains_Mono',monospace] text-[11px] text-tx-muted flex items-center gap-1.5 flex-wrap md:max-w-[720px] md:mx-auto md:w-full">
        <a href="/tutorials" class="hover:text-blue-500 transition-colors">tutorials</a>
        <span class="opacity-40">/</span>
        <a href={`/tutorials/${series.id}`} class="hover:text-blue-500 transition-colors truncate max-w-[100px]">{series.id}</a>
        <span class="opacity-40">/</span>
        <span class="text-blue-500 font-medium truncate max-w-[120px]" aria-current="page">{currentSlug}.md</span>
      </nav>

      <div class="sticky top-0 bg-main/95 backdrop-blur-md py-2 flex items-center justify-between -mx-4 px-4 sm:-mx-6 sm:px-6">
        <button id="sidebar-toggle-btn" class="p-2.5 rounded-lg bg-surface border border-subtle text-tx-main hover:border-blue-500/50 transition-all active:scale-95 shadow-sm" aria-label="Toggle Menu">
          <svg class="w-5 h-5 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" /></svg>
        </button>

        <div class="flex items-center gap-2">
          {prevLink && (
            <a href={prevLink.url} class="p-2.5 rounded-lg bg-surface border border-subtle text-tx-muted hover:text-blue-500 transition-colors active:scale-95 shadow-sm" aria-label="Previous Lesson">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
            </a>
          )}
          {nextLink && (
            <a href={nextLink.url} class="p-2.5 rounded-lg bg-blue-600 border border-blue-600 text-white hover:bg-blue-700 transition-colors active:scale-95 shadow-sm" aria-label="Next Lesson">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
            </a>
          )}
        </div>
      </div>
    </div>

    {/* --- MOBILE SIDEBAR BACKDROP OVERLAY --- */}
    <div id="mobile-sidebar-backdrop" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-[90] hidden lg:hidden opacity-0 transition-opacity duration-300"></div>

    {/* --- LEFT SIDEBAR (Sticky, Left-Locked) --- */}
    <aside id="tutorial-sidebar" class="fixed inset-y-0 left-0 z-[300] lg:z-[150] w-[85vw] max-w-[280px] bg-surface shadow-2xl transform -translate-x-full transition-all duration-300 ease-in-out lg:translate-x-0 lg:static lg:sticky lg:w-[280px] lg:shrink-0 lg:top-[64px] lg:h-[calc(100vh-64px)] [.header-hidden_&]:lg:top-0 [.header-hidden_&]:lg:h-screen overflow-y-auto border-r border-subtle py-5 px-4 lg:py-6 lg:px-2 lg:pr-4 custom-scrollbar lg:bg-surface lg:[box-shadow:-50vw_0px_0px_0px_var(--color-bg-surface)]">
      <div class="mb-5 px-1.5 mt-2 lg:mt-0 flex justify-between items-center">
        <div>
          <h3 class="text-[11px] uppercase tracking-widest font-['JetBrains_Mono',monospace] text-tx-muted mb-1 font-bold">Tutorial Series</h3>
          <p class="text-[18px] font-black text-tx-main leading-tight">{series.data.title}</p>
        </div>
        <button id="sidebar-close-btn" class="lg:hidden p-2 text-tx-muted hover:text-tx-main bg-main rounded-lg border border-subtle active:scale-95 transition-all">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
        </button>
      </div>

      <nav class="flex flex-col space-y-0.5">
        <a 
          href={`/tutorials/${series.id}`} 
          class={`px-2.5 py-1.5 text-[14px] rounded-lg transition-all flex items-center gap-2 border ${currentSlug === 'intro' ? 'text-blue-600 border-blue-500/20 font-bold active-lesson' : 'border-transparent text-tx-muted hover:bg-[rgba(128,128,128,0.08)] hover:text-tx-main'}`}
        >
          Introduction
        </a>

        {lessons.map((lesson: any) => (
          <a 
            href={`/tutorials/${series.id}/${lesson.data.urlSlug}`}
            class={`px-2.5 py-1.5 text-[14px] rounded-lg transition-all flex items-center gap-2 border ${currentSlug === lesson.data.urlSlug ? 'text-blue-600 border-blue-500/20 font-bold active-lesson' : 'border-transparent text-tx-muted hover:bg-[rgba(128,128,128,0.08)] hover:text-tx-main'}`}
          >
            {cleanTitle(lesson.data.title)}
          </a>
        ))}
      </nav>
    </aside>

    {/* --- RIGHT MAIN CONTENT (Centered on Tablet, Max-Width on Desktop) --- */}
    <main class="flex-1 min-w-0 w-full md:max-w-[720px] md:mx-auto lg:mx-0 lg:max-w-[900px] xl:max-w-[1050px] lg:pl-6 xl:pl-10 lg:pr-8 xl:pr-10 py-6 lg:py-8">      
      
      <nav aria-label="Breadcrumb" class="hidden lg:flex mb-6 font-['JetBrains_Mono',monospace] text-[12px] text-tx-muted items-center gap-2 flex-wrap bg-surface border border-subtle px-3 py-1.5 rounded-md w-fit">
        <a href="/tutorials" class="hover:text-blue-500 transition-colors">tutorials</a>
        <span class="opacity-40">/</span>
        <a href={`/tutorials/${series.id}`} class="hover:text-blue-500 transition-colors truncate max-w-[150px]">{series.id}</a>
        <span class="opacity-40">/</span>
        <span class="text-blue-500 font-medium" aria-current="page">{currentSlug}.md</span>
      </nav>

      <div class="markdown-content text-[15.5px] md:text-[17px] leading-[1.7] md:leading-[1.8] pb-8">
        <slot />
      </div>

      <div class="mt-8 pt-6 border-t border-subtle flex flex-col sm:flex-row items-center justify-between gap-3">
        {prevLink ? (
          <a href={prevLink.url} class="group flex items-center gap-3 px-5 py-3.5 rounded-xl bg-surface border border-subtle hover:border-blue-500/50 hover:shadow-sm transition-all w-full sm:w-auto sm:max-w-[48%]">
            <div class="w-8 h-8 rounded-full bg-main border border-subtle flex items-center justify-center shrink-0 group-hover:bg-blue-500/10 group-hover:text-blue-500 transition-colors">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
            </div>
            <div class="flex flex-col text-left overflow-hidden">
              <span class="text-[11px] uppercase tracking-widest text-tx-muted font-bold mb-0.5">Previous</span>
              <span class="text-[14px] text-tx-main font-semibold group-hover:text-blue-500 transition-colors truncate">{prevLink.title}</span>
            </div>
          </a>
        ) : <div class="hidden sm:block"></div>}

        {nextLink ? (
          <a href={nextLink.url} class="group flex items-center justify-end gap-3 px-5 py-3.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white shadow-md hover:shadow-blue-500/25 transition-all w-full sm:w-auto sm:max-w-[48%] sm:ml-auto">
            <div class="flex flex-col text-right overflow-hidden">
              <span class="text-[11px] uppercase tracking-widest text-blue-200 font-bold mb-0.5">Up Next</span>
              <span class="text-[14px] font-semibold truncate text-white">{nextLink.title}</span>
            </div>
            <div class="w-8 h-8 rounded-full bg-white/20 flex items-center justify-center shrink-0 group-hover:bg-white group-hover:text-blue-600 transition-colors">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
            </div>
          </a>
        ) : <div class="hidden sm:block"></div>}
      </div>

    </main>

    {/* --- RIGHT BANNER / AD SIDEBAR (Visible on XL screens only) --- */}
    <aside class="hidden xl:block w-[260px] 2xl:w-[300px] shrink-0 sticky top-[64px] h-[calc(100vh-64px)] overflow-y-auto py-8 pr-6 2xl:pr-8 custom-scrollbar z-30">
      
      {/* Dynamic Ad Injection - Only shows if adHtml exists, otherwise leaves an invisible empty column */}
      {adHtml && (
        <div class="ad-container w-full" set:html={adHtml} />
      )}

    </aside>

  </div>
</Layout>

<style is:global>
  .custom-scrollbar::-webkit-scrollbar { width: 4px; }
  .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
  .custom-scrollbar::-webkit-scrollbar-thumb { background-color: var(--color-border-subtle); border-radius: 20px; }
  .custom-scrollbar:hover::-webkit-scrollbar-thumb { background-color: #94a3b8; }

  .markdown-content h1, .markdown-content h2, .markdown-content h3, .markdown-content h4 {
    color: var(--color-tx-main); font-weight: 800; letter-spacing: -0.015em; margin-top: 1.6em; margin-bottom: 0.6em;
  }
  
  .markdown-content h1 { font-size: 1.75rem; line-height: 1.25; margin-top: 0; margin-bottom: 0.8em; }
  .markdown-content h2 { font-size: 1.4rem; line-height: 1.3; border-bottom: 1px solid var(--color-border-subtle); padding-bottom: 0.25em; }
  .markdown-content h3 { font-size: 1.25rem; line-height: 1.3; }
  
  @media (min-width: 768px) {
    .markdown-content h1 { font-size: 2.25rem; }
    .markdown-content h2 { font-size: 1.75rem; }
    .markdown-content h3 { font-size: 1.4rem; }
  }
  
  .markdown-content p { color: var(--color-tx-muted); margin-bottom: 1.4em; opacity: 0.9; }
  .markdown-content strong { color: var(--color-tx-main); font-weight: 700; }
  .markdown-content a { color: #3b82f6; text-decoration: none; font-weight: 500; border-bottom: 1px solid transparent; transition: border-color 0.2s;}
  .markdown-content a:hover { border-bottom-color: #3b82f6; }
  
  .markdown-content ul { list-style-type: disc; padding-left: 1.2em; margin-bottom: 1.4em; color: var(--color-tx-muted); opacity: 0.9; }
  .markdown-content ol { list-style-type: decimal; padding-left: 1.2em; margin-bottom: 1.4em; color: var(--color-tx-muted); opacity: 0.9; }
  .markdown-content li { margin-bottom: 0.4em; }

  .markdown-content blockquote { 
    border-left: 3px solid #3b82f6; padding-left: 1em; color: var(--color-tx-main); 
    font-style: italic; background-color: var(--color-bg-surface);
    padding-top: 0.75em; padding-bottom: 0.75em; border-radius: 0 0.5rem 0.5rem 0; margin-bottom: 1.4em;
  }

  .markdown-content pre { 
    background-color: #0f172a; border: 1px solid var(--color-border-subtle); border-radius: 0.5rem;
    padding: 1rem; overflow-x: auto; margin-bottom: 1.5em; 
    position: relative; font-family: 'JetBrains Mono', monospace;
    font-size: 0.85em; line-height: 1.6; color: #e2e8f0;
  }
  
  .markdown-content code { 
    font-family: 'JetBrains Mono', monospace; font-size: 0.85em; 
    color: #ef4444; background-color: var(--color-bg-surface); border: 1px solid var(--color-border-subtle);
    padding: 0.15em 0.3em; border-radius: 0.25rem;
  }
  .markdown-content pre code { color: inherit; background: transparent; border: none; padding: 0; }

  .copy-code-btn {
    position: absolute; top: 8px; right: 8px;
    background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2);
    color: #e2e8f0; border-radius: 4px; padding: 3px 8px; font-size: 10px;
    font-family: 'JetBrains Mono', monospace; cursor: pointer; opacity: 0; transition: all 0.2s ease;
  }
  .markdown-content pre:hover .copy-code-btn { opacity: 1; }
  .copy-code-btn:hover { background: rgba(255,255,255,0.2); }
  .copy-code-btn.copied { color: #10b981; border-color: #10b981; background: rgba(16, 185, 129, 0.1); }

  .markdown-content img { border-radius: 0.5rem; border: 1px solid var(--color-border-subtle); margin: 1.5em 0; width: 100%; height: auto; }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Mobile Sidebar Drawer Toggle & Auto-Scroll
    const toggleBtn = document.getElementById('sidebar-toggle-btn');
    const closeBtn = document.getElementById('sidebar-close-btn');
    const sidebar = document.getElementById('tutorial-sidebar');
    const backdrop = document.getElementById('mobile-sidebar-backdrop');
    const activeLesson = document.querySelector('.active-lesson');

    function openSidebar() {
      if (!sidebar || !backdrop) return;
      
      backdrop.classList.remove('hidden');
      void backdrop.offsetWidth; 
      backdrop.classList.remove('opacity-0');
      
      sidebar.classList.remove('-translate-x-full');

      if (activeLesson) {
        setTimeout(() => {
          activeLesson.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }, 150); 
      }
    }

    function closeSidebar() {
      if (!sidebar || !backdrop) return;
      
      backdrop.classList.add('opacity-0');
      sidebar.classList.add('-translate-x-full');
      
      setTimeout(() => {
        backdrop.classList.add('hidden');
      }, 300);
    }

    if (toggleBtn) toggleBtn.addEventListener('click', openSidebar);
    if (closeBtn) closeBtn.addEventListener('click', closeSidebar);
    if (backdrop) backdrop.addEventListener('click', closeSidebar);

    // 2. Copy Code Buttons
    const codeBlocks = document.querySelectorAll('.markdown-content pre');
    codeBlocks.forEach((preBlock) => {
      const textToCopy = preBlock.innerText || preBlock.textContent;
      const copyButton = document.createElement('button');
      copyButton.className = 'copy-code-btn';
      copyButton.textContent = 'Copy';

      preBlock.appendChild(copyButton);

      copyButton.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(textToCopy);
          copyButton.textContent = 'Copied!';
          copyButton.classList.add('copied');
    
          setTimeout(() => {
            copyButton.textContent = 'Copy';
            copyButton.classList.remove('copied');
          }, 2000);
        } catch (err) {
          copyButton.textContent = 'Error';
        }
      });
    });
  });
</script>