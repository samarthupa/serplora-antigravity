---
title: HTML Compiler
draft: false
seo:
  robotsIndex: true
  robotsFollow: true
starterFiles:
  - filename: index.html
    language: html
    content: |-
      <!DOCTYPE html>
      <html>
      <head>
        <link rel="stylesheet" href="style.css">
      </head>
      <body>
        <h1>Online HTML Editor and Compiler</h1>
      <p>Click the Run button or press Ctrl/Cmd + Enter to run the code.</p>
      <button onclick="sayHi()">Click Me to Test Console!</button>
      <p>You can open the console by clicking the ">" button.</p>
        <script src="script.js"></script>
      </body>
      </html>
  - filename: style.css
    language: css
    content: |
      body{background: #f5f5f5; padding: 5px;}
      h1 { color: #000; }
      button { padding: 10px; cursor: pointer; }
  - filename: script.js
    language: javascript
    content: |-
      console.log("App Started Successfully!");

      function sayHi() {
        console.warn("User clicked the button!");
      }
---
