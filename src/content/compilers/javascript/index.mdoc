title: SerJS - JavaScript Compiler
breadcrumbTitle: JavaScript Compiler
draft: false
excerpt: Write, Edit, and Run JavaScript Code Instantly in your Browser.
language: javascript
showConsole: false
seo:
  robotsIndex: true
  robotsFollow: true
  disableStickyHeader: false
  schemaType: none
starterFiles:
  - filename: main.js
    language: javascript
    content: |-
      console.log("System initialized...");

      async function main() {
          // Native Prompt Support
          let name = await prompt("What is your name?");
          console.log(`Hello, ${name}!`);
          
          // Arrays
          let colors = ['Red', 'Green', 'Blue'];
          console.warn("Generating colors...");
          
          colors.forEach(c => {
              console.log(`Color: ${c}`);
          });
      }

      main();
  - filename: main2.js
    language: javascript
    content: |2-
        console.log("Normal log");

        console.info("Info log");

        console.warn("Warning log");

        console.error("Error log");

        console.table([
          { name: "Alice", age: 20 },
          { name: "Bob", age: 25 }
        ]);

        for (let i = 1; i <= 10; i++) {
          console.log("Counter:", i);
        }

        try {
          undefinedFunction();
        } catch (error) {
          console.error("Caught Error:", error.message);
        }

        console.time("smallLoop");

        for (let i = 0; i < 1000; i++) {
          Math.sqrt(i);
        }

        console.timeEnd("smallLoop");

        console.log("%cStyled message", "color: green; font-size: 18px;");
