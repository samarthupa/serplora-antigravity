  - filename: main2.py
    language: python
    content: |-
      import matplotlib.pyplot as plt
      import numpy as np

      x = np.linspace(0, 10, 100)
      y = np.sin(x)

      plt.plot(x, y)
      plt.title('Sine Wave')
      plt.show()
