{% rawHtml
   html="<!-- HERO SECTION -->\n<section class=\"w-full max-w-[1000px] mx-auto px-5 pt-12 pb-8 md:pt-32 md:pb-14 flex flex-col items-center text-center font-['Outfit',sans-serif]\">\n  \n\n  <h1 class=\"text-4xl md:text-7xl font-[800] text-tx-main tracking-tight leading-[1.15] md:leading-[1.1] mb-5 md:mb-6\">\n    Master Programming.<br class=\"hidden md:block\" /> \n    <!-- Updated gradient to adapt in dark mode -->\n    <span class=\"text-transparent bg-clip-text bg-gradient-to-r from-brand to-purple-600 dark:to-purple-400\">Zero Setup Required.</span>\n  </h1>\n  \n  <p class=\"text-base md:text-xl text-tx-muted max-w-[650px] leading-relaxed mb-8 md:mb-10\">\n    Write, run, and test code directly in your browser. Combine structured tutorials with instant execution and challenging quizzes to accelerate your learning.\n  </p>\n  \n</section>\n\n<!-- BENTO BOX GRID SECTION -->\n<section class=\"w-full max-w-[1200px] mx-auto px-5 md:px-6 pb-20 md:pb-24 font-['Outfit',sans-serif]\">\n  <div class=\"grid grid-cols-1 md:grid-cols-3 gap-5 md:gap-6 auto-rows-auto md:auto-rows-[250px]\">\n    \n    <!-- 1. COMPILERS (Large Block) -->\n    <div class=\"group md:col-span-2 md:row-span-2 bg-surface border border-subtle rounded-[20px] md:rounded-[24px] p-6 md:p-10 flex flex-col relative overflow-hidden hover:border-brand/40 transition-all duration-300\">\n      <div class=\"absolute top-0 right-0 p-8 opacity-10 group-hover:opacity-20 group-hover:scale-110 group-hover:-rotate-6 transition-all duration-500 pointer-events-none\">\n        <svg class=\"w-40 h-40 md:w-48 md:h-48 text-brand\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"1\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M8 9l3 3-3 3m5 0h3M4 12a8 8 0 1116 0 8 8 0 01-16 0z\" /></svg>\n      </div>\n      <div class=\"w-12 h-12 md:w-14 md:h-14 rounded-2xl bg-brand/10 text-brand flex items-center justify-center mb-5 md:mb-6\">\n        <svg class=\"w-6 h-6 md:w-7 md:h-7\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4\" /></svg>\n      </div>\n      <h2 class=\"text-2xl md:text-3xl font-[800] text-tx-main mb-3 tracking-tight\">Interactive Compilers</h2>\n      <p class=\"text-tx-muted text-base md:text-lg max-w-md mb-8 md:mb-auto relative z-10\">Stop wasting hours installing environments. Write Python, C++, Java, and HTML instantly in a world-class browser editor.</p>\n      \n      <a href=\"/compilers\" class=\"inline-flex items-center gap-2 text-brand font-bold bg-brand/10 hover:bg-brand/20 px-5 py-2.5 rounded-lg w-max transition-colors z-10\">\n        <span>Start coding now</span>\n        <svg class=\"w-5 h-5 group-hover:translate-x-1 transition-transform\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2.5\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M14 5l7 7m0 0l-7 7m7-7H3\" /></svg>\n      </a>\n    </div>\n\n    <!-- 2. TUTORIALS (Medium Block) -->\n    <div class=\"group bg-surface border border-subtle rounded-[20px] md:rounded-[24px] p-6 md:p-8 flex flex-col hover:border-brand/40 transition-all duration-300\">\n      <!-- Dark mode adjusted purple -->\n      <div class=\"w-10 h-10 md:w-12 md:h-12 rounded-xl bg-purple-600/10 text-purple-600 dark:bg-purple-400/10 dark:text-purple-400 flex items-center justify-center mb-4 md:mb-5\">\n        <svg class=\"w-5 h-5 md:w-6 md:h-6\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253\" /></svg>\n      </div>\n      <h3 class=\"text-xl font-[800] text-tx-main mb-2 tracking-tight\">Structured Tutorials</h3>\n      <p class=\"text-tx-muted text-[14px] md:text-[15px] mb-6 md:mb-auto\">Step-by-step curriculum designed to take you from absolute beginner to advanced developer.</p>\n      \n      <a href=\"/tutorials\" class=\"inline-flex items-center gap-1.5 text-sm font-bold text-tx-main hover:text-brand transition-colors w-max mt-auto\">\n        Explore Tutorials\n        <svg class=\"w-4 h-4 group-hover:translate-x-1 transition-transform\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2.5\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M9 5l7 7-7 7\" /></svg>\n      </a>\n    </div>\n\n    <!-- 3. QUIZZES (Medium Block) -->\n    <div class=\"group bg-surface border border-subtle rounded-[20px] md:rounded-[24px] p-6 md:p-8 flex flex-col hover:border-brand/40 transition-all duration-300\">\n      <!-- Dark mode adjusted emerald -->\n      <div class=\"w-10 h-10 md:w-12 md:h-12 rounded-xl bg-emerald-600/10 text-emerald-600 dark:bg-emerald-400/10 dark:text-emerald-400 flex items-center justify-center mb-4 md:mb-5\">\n        <svg class=\"w-5 h-5 md:w-6 md:h-6\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z\" /></svg>\n      </div>\n      <h3 class=\"text-xl font-[800] text-tx-main mb-2 tracking-tight\">Skill Quizzes</h3>\n      <p class=\"text-tx-muted text-[14px] md:text-[15px] mb-6 md:mb-auto\">Test your knowledge with interactive assessments and get immediate, detailed explanations.</p>\n      \n      <a href=\"/quizzes\" class=\"inline-flex items-center gap-1.5 text-sm font-bold text-tx-main hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors w-max mt-auto\">\n        Take a Quiz\n        <svg class=\"w-4 h-4 group-hover:translate-x-1 transition-transform\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2.5\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M9 5l7 7-7 7\" /></svg>\n      </a>\n    </div>\n\n    <!-- 4. ARTICLES (Wide Bottom Block) -->\n    <div class=\"group md:col-span-3 bg-main border border-subtle rounded-[20px] md:rounded-[24px] p-6 md:p-10 flex flex-col sm:flex-row items-start sm:items-center justify-between hover:border-brand/40 transition-all duration-300\">\n      <div class=\"flex flex-col sm:flex-row items-start sm:items-center gap-4 sm:gap-6 mb-6 sm:mb-0\">\n        <div class=\"w-12 h-12 md:w-14 md:h-14 rounded-2xl bg-tx-main/5 text-tx-main flex items-center justify-center shrink-0\">\n          <svg class=\"w-6 h-6 md:w-7 md:h-7\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z\" /></svg>\n        </div>\n        <div>\n          <h3 class=\"text-xl md:text-2xl font-[800] text-tx-main mb-2 tracking-tight\">Articles & Technical Guides</h3>\n          <p class=\"text-tx-muted text-[14px] md:text-[16px] max-w-2xl\">Read deep-dives into algorithms, web architecture, career advice, and framework comparisons from our editorial team.</p>\n        </div>\n      </div>\n      \n      <!-- PERFECT CONTRAST BUTTON: hover:text-main -->\n      <a href=\"/articles\" class=\"w-full sm:w-auto px-6 py-3 rounded-xl bg-surface border border-subtle text-tx-main font-bold text-sm hover:bg-brand hover:text-main hover:border-brand transition-colors text-center whitespace-nowrap shrink-0\">\n        Read the Blog\n      </a>\n    </div>\n\n  </div>\n</section>" /%}
