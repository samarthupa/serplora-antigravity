{% rawHtml
   html="<div><p></p><div><div class=\"sl-promo-container\"><style>/* Scoped Styles with sl-promo prefix to avoid conflicts */\n    .sl-promo-container {\n      display: flex;\n      flex-direction: column;\n      gap: 24px;\n      font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;\n      margin: 20px auto;\n      width: 100%;\n      max-width: 800px;\n      box-sizing: border-box;\n      padding: 0 30px;\n    }\n\n    .sl-promo-container * {\n      box-sizing: border-box;\n    }\n\n    /* Welcome Header Styles */\n    .sl-welcome-header {\n      padding: 20px 0 10px 0;\n      text-align: left;\n    }\n\n    .sl-welcome-title {\n      font-size: 28px;\n      font-weight: 800;\n      color: #111827;\n      margin: 0 0 8px 0;\n      letter-spacing: -0.025em;\n    }\n\n    .sl-welcome-subtitle {\n      font-size: 18px;\n      color: #4b5563;\n      margin: 0;\n      font-weight: 400;\n    }\n\n    .sl-promo-card {\n      position: relative;\n      background: #ffffff;\n      border: 1px solid #f1f5f9;\n      border-radius: 12px;\n      padding: 32px;\n      display: flex;\n      flex-direction: column;\n      justify-content: space-between;\n      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n      text-decoration: none;\n      color: #1f2937;\n      min-height: 280px;\n      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);\n    }\n\n    .sl-promo-card:hover {\n      transform: translateY(-2px);\n      box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.08), 0 4px 6px -2px rgba(0, 0, 0, 0.04);\n      border-color: #e2e8f0;\n    }\n\n    .sl-promo-content {\n      position: relative;\n      z-index: 2;\n    }\n\n    .sl-promo-icon-box {\n      width: 44px;\n      height: 44px;\n      border-radius: 10px;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      margin-bottom: 20px;\n    }\n\n    /* --- Minimalist color accents --- */\n    \n    /* SQL (Teal) */\n    .sl-promo-sql .sl-promo-icon-box { \n      background: #f0fdfa; \n      color: #0d9488; \n    }\n    \n    /* Python (Indigo - New Added Style) */\n    .sl-promo-python .sl-promo-icon-box { \n      background: #eef2ff; \n      color: #4338ca; \n    }\n\n    /* Compiler (Rose) */\n    .sl-promo-compiler .sl-promo-icon-box { \n      background: #fff1f2; \n      color: #e11d48; \n    }\n\n    .sl-promo-title {\n      font-size: 22px;\n      font-weight: 700;\n      margin: 0 0 12px 0;\n      color: #111827;\n      letter-spacing: -0.01em;\n    }\n\n    .sl-promo-description {\n      font-size: 15px;\n      line-height: 1.6;\n      color: #4b5563;\n      margin-bottom: 24px;\n      max-width: 650px;\n    }\n\n    .sl-promo-features {\n      list-style: none;\n      padding: 0;\n      margin: 0 0 28px 0;\n      display: flex;\n      flex-wrap: wrap;\n      gap: 16px;\n    }\n\n    .sl-promo-features li {\n      display: flex;\n      align-items: center;\n      font-size: 14px;\n      color: #6b7280;\n      font-weight: 500;\n    }\n\n    .sl-promo-dot {\n      width: 6px;\n      height: 6px;\n      border-radius: 50%;\n      margin-right: 8px;\n      flex-shrink: 0;\n    }\n\n    .sl-promo-sql .sl-promo-dot { background: #0d9488; }\n    .sl-promo-python .sl-promo-dot { background: #4338ca; } /* Python dot */\n    .sl-promo-compiler .sl-promo-dot { background: #e11d48; }\n\n    .sl-promo-cta {\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      padding: 10px 24px;\n      border-radius: 6px;\n      font-weight: 600;\n      font-size: 14px;\n      transition: all 0.2s ease;\n      align-self: flex-start;\n      border: 1px solid transparent;\n    }\n\n    /* Buttons */\n    .sl-promo-sql .sl-promo-cta { \n      background: #0d9488; \n      color: #ffffff; \n    }\n    \n    .sl-promo-python .sl-promo-cta { \n      background: #4338ca; \n      color: #ffffff; \n    }\n\n    .sl-promo-compiler .sl-promo-cta { \n      background: #e11d48; \n      color: #ffffff; \n    }\n\n    .sl-promo-cta:hover {\n      opacity: 0.9;\n      transform: scale(1.02);\n    }\n\n    @media (max-width: 640px) {\n      .sl-promo-card {\n        padding: 24px;\n        min-height: auto;\n      }\n      .sl-promo-features {\n        flex-direction: column;\n        gap: 8px;\n      }\n      .sl-welcome-title {\n        font-size: 24px;\n      }\n      .sl-welcome-subtitle {\n        font-size: 16px;\n      }\n    }</style><div class=\"sl-welcome-header\"><h1 class=\"sl-welcome-title\">Welcome to Serplora!</h1><p class=\"sl-welcome-subtitle\">Don’t just learn. Apply it.</p></div><a href=\"https://serplora.com/quizzes/sql-quiz/\" class=\"sl-promo-card\"><div class=\"sl-promo-content sl-promo-sql\"><div class=\"sl-promo-icon-box\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><ellipse cx=\"12\" cy=\"5\" rx=\"9\" ry=\"3\"></ellipse><path d=\"M21 12c0 1.66-4 3-9 3s-9-1.34-9-3\"></path><path d=\"M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5\"></path></svg></div><h3 class=\"sl-promo-title\">Interactive SQL Quiz</h3><p class=\"sl-promo-description\">Test your skills with real-world database scenarios. Get instant explanations and share your personalized results link.</p><ul class=\"sl-promo-features\"><li><span class=\"sl-promo-dot\"></span>Detailed Explanations</li><li><span class=\"sl-promo-dot\"></span>Performance Review</li><li><span class=\"sl-promo-dot\"></span>Shareable Links</li></ul><span class=\"sl-promo-cta\">Test Your Knowledge</span></div></a><a href=\"https://serplora.com/quizzes/python-quiz/\" class=\"sl-promo-card\"><div class=\"sl-promo-content sl-promo-python\"><div class=\"sl-promo-icon-box\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z\"></path><polyline points=\"14 2 14 8 20 8\"></polyline><line x1=\"16\" y1=\"13\" x2=\"8\" y2=\"13\"></line><line x1=\"16\" y1=\"17\" x2=\"8\" y2=\"17\"></line><polyline points=\"10 9 9 9 8 9\"></polyline></svg></div><h3 class=\"sl-promo-title\">Interactive Python Quiz</h3><p class=\"sl-promo-description\">Master Python syntax, loops, OOP, and data structures. Validate your skills with topic-specific challenges.</p><ul class=\"sl-promo-features\"><li><span class=\"sl-promo-dot\"></span>Topic-wise Tests</li><li><span class=\"sl-promo-dot\"></span>Instant Feedback</li><li><span class=\"sl-promo-dot\"></span>Beginner to Advanced</li></ul><span class=\"sl-promo-cta\">Start Python Quiz</span></div></a><a href=\"https://serplora.com/compilers/\" class=\"sl-promo-card\"><div class=\"sl-promo-content sl-promo-compiler\"><div class=\"sl-promo-icon-box\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"16 18 22 12 16 6\"></polyline><polyline points=\"8 6 2 12 8 18\"></polyline></svg></div><h3 class=\"sl-promo-title\">Online Compilers</h3><p class=\"sl-promo-description\">Write and execute code instantly. No setup required, pre-installed libraries included, and easy project sharing.</p><ul class=\"sl-promo-features\"><li><span class=\"sl-promo-dot\"></span>No Download Required</li><li><span class=\"sl-promo-dot\"></span>Pre-installed Libraries</li><li><span class=\"sl-promo-dot\"></span>Instant Project Sharing</li></ul><span class=\"sl-promo-cta\">Code and Run in Browser</span></div></a><div><p>More Assets Coming Soon....</p></div></div></div><p></p></div>" /%}
