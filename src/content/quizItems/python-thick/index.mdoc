    {
      "questionText": "What is the correct syntax to create a variable named <code>score</code> with the integer value 10?",
      "options": [
        { "text": "<code>int score = 10</code>", "isCorrect": false },
        { "text": "<code>variable score = 10</code>", "isCorrect": false },
        { "text": "<code>score = 10</code>", "isCorrect": true },
        { "text": "<code>score : 10</code>", "isCorrect": false }
      ],
      "explanation": "Python uses dynamic typing, so you simply write the variable name, the equals sign, and the value. The type is inferred automatically."
    },
    {
      "questionText": "Which of the following is a valid string definition in Python?",
      "options": [
        { "text": "<code>'Hello World\"</code>", "isCorrect": false },
        { "text": "<code>\"Hello World\"</code>", "isCorrect": true },
        { "text": "<code>Hello World</code>", "isCorrect": false },
        { "text": "<code>`Hello World`</code>", "isCorrect": false }
      ],
      "explanation": "Double quotes are a standard and valid way to define a string literal in Python, provided they match at the beginning and end."
    },
    {
      "questionText": "Which of these variable names is invalid (illegal) in Python?",
      "options": [
        { "text": "<code>my_variable</code>", "isCorrect": false },
        { "text": "<code>_value</code>", "isCorrect": false },
        { "text": "<code>2nd_score</code>", "isCorrect": true },
        { "text": "<code>SCORE</code>", "isCorrect": false }
      ],
      "explanation": "Python variable names cannot begin with a number. They must start with a letter (a-z, A-Z) or an underscore."
    },
    {
      "questionText": "What is the data type of the value <code>5.0</code>?",
      "options": [
        { "text": "Integer", "isCorrect": false },
        { "text": "Float", "isCorrect": true },
        { "text": "String", "isCorrect": false },
        { "text": "Boolean", "isCorrect": false }
      ],
      "explanation": "In Python, any number that contains a decimal point is automatically stored as a floating-point number (float)."
    },
    {
      "questionText": "Which function is used to check the data type of a variable in Python?",
      "options": [
        { "text": "<code>typeof(variable)</code>", "isCorrect": false },
        { "text": "<code>check(variable)</code>", "isCorrect": false },
        { "text": "<code>class(variable)</code>", "isCorrect": false },
        { "text": "<code>type(variable)</code>", "isCorrect": true }
      ],
      "explanation": "The built-in <code>type()</code> function returns the class type of the argument passed to it (e.g., <code>&lt;class 'int'&gt;</code>)."
    },
    {
      "questionText": "What is the correct way to define a Boolean value representing truth?",
