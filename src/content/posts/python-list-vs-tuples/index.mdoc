      converted_to_tuple = tuple(my_list)

      print(type(converted_to_tuple))  # &lt;class 'tuple'&gt;


      my_tuple = (4, 5, 6)

      converted_to_list = list(my_tuple)

      print(type(converted_to_list))  # &lt;class 'list'&gt;

