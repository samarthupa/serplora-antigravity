---
// src/schemas/SchemaInjector.astro
import { getGlobalSchema, getArticleSchema, getWebAppSchema, getQuizSchema, getAuthorSchema } from './generators';

const { schemaType, schemaData } = Astro.props;
const currentUrl = Astro.url.href;

let graph: any[] = [...getGlobalSchema()];

// Append specific schemas based on Keystatic selection
if (schemaData) {
  if (schemaType === 'TechArticle' || schemaType === 'BlogPosting') {
    graph.push(getArticleSchema(schemaType, schemaData, currentUrl));
  } else if (schemaType === 'WebApplication') {
    graph.push(getWebAppSchema(schemaData, currentUrl));
  } else if (schemaType === 'Quiz') {
    graph.push(getQuizSchema(schemaData, currentUrl));
  } else if (schemaType === 'ProfilePage') { // 🟢 ADD THIS BLOCK
    graph.push(getAuthorSchema(schemaData, currentUrl));
  }
}

const jsonLD = {
  "@context": "https://schema.org",
  "@graph": graph
};
---

<script type="application/ld+json" set:html={JSON.stringify(jsonLD)} />