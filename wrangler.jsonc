{
    "compatibility_date": "2026-03-17",
    "compatibility_flags": [
        "global_fetch_strictly_public",
        "nodejs_compat"
    ],
    "name": "serplora",
    "pages_build_output_dir": "./dist",
    "observability": {
        "enabled": true
    },
    // 🟢 NEW: Add your plain-text variables here
    "vars": {
        "AWS_REGION": "us-east-1",
        // IMPORTANT: Because you are in the SES Sandbox, change this to the exact 
        // Gmail address you verified in the AWS console to prevent a crash.
        "EMAIL_FROM": "yourverified@gmail.com" 
    },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "serplora-users",
            "database_id": "ec0bf5e6-e3ee-4e3c-a478-c8c6eb7c67de"
        }
    ]
}