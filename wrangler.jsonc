{
    "compatibility_date": "2026-03-17",
    "compatibility_flags": ["global_fetch_strictly_public"],
    "name": "serplora",
    "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "404-page"
    },
    "observability": {
        "enabled": true
    }
}