{
    "compatibility_date": "2026-03-17",
    "compatibility_flags": [
        "global_fetch_strictly_public",
        "nodejs_compat" 
    ],
    "name": "serplora",
    "pages_build_output_dir": "./dist",
    "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "404-page"
    },
    "observability": {
        "enabled": true
    }
}